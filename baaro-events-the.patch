diff --git a/src/features/events/EventsTab.jsx b/src/features/events/EventsTab.jsx
new file mode 100644
index 0000000..0580e85
--- /dev/null
+++ b/src/features/events/EventsTab.jsx
@@ -0,0 +1,239 @@
+/**
+ * BAARO Events — « Qui va au concert samedi ? »
+ * Crée un événement → « Je viens » → groupe créé automatiquement → photos partagées après.
+ */
+import { useRef, useState } from "react";
+import { CalendarDays, MapPin, Users, Plus, Camera, Trash2, X, MessageCircle, Images } from "lucide-react";
+import { useEvents, eventEnd } from "./hooks/useEvents.js";
+
+const card = "rounded-2xl border border-white/10 bg-white/[.04] p-4";
+const input =
+  "w-full rounded-xl border border-white/10 bg-black/30 px-3 py-2 text-sm text-white placeholder-white/30 outline-none focus:border-white/30";
+
+function formatWhen(iso) {
+  try {
+    return new Date(iso).toLocaleString("fr-FR", {
+      weekday: "long",
+      day: "numeric",
+      month: "long",
+      hour: "2-digit",
+      minute: "2-digit",
+    });
+  } catch {
+    return iso;
+  }
+}
+
+function CreateForm({ onCreate, onClose }) {
+  const [f, setF] = useState({ title: "", description: "", location: "", city: "Bamako", startsAt: "", endsAt: "" });
+  const [busy, setBusy] = useState(false);
+  const [err, setErr] = useState("");
+  const set = (k) => (e) => setF((p) => ({ ...p, [k]: e.target.value }));
+
+  const submit = async (e) => {
+    e.preventDefault();
+    setBusy(true);
+    setErr("");
+    try {
+      await onCreate(f);
+      onClose();
+    } catch (ex) {
+      setErr(ex?.message || "Création impossible.");
+      setBusy(false);
+    }
+  };
+
+  return (
+    <form onSubmit={submit} className={`${card} space-y-2`}>
+      <div className="flex items-center justify-between">
+        <h3 className="text-sm font-black text-white">Nouvel événement</h3>
+        <button type="button" onClick={onClose} aria-label="Fermer" className="text-white/50">
+          <X size={16} />
+        </button>
+      </div>
+      <input className={input} placeholder="Ex. Concert de Sidiki Diabaté" value={f.title} onChange={set("title")} maxLength={120} required />
+      <textarea className={input} placeholder="Détails (facultatif)" rows={2} value={f.description} onChange={set("description")} maxLength={2000} />
+      <div className="grid grid-cols-2 gap-2">
+        <input className={input} placeholder="Lieu" value={f.location} onChange={set("location")} maxLength={200} />
+        <input className={input} placeholder="Ville" value={f.city} onChange={set("city")} maxLength={80} />
+      </div>
+      <label className="block text-[11px] font-bold text-white/50">
+        Début
+        <input type="datetime-local" className={`${input} mt-1`} value={f.startsAt} onChange={set("startsAt")} required />
+      </label>
+      <label className="block text-[11px] font-bold text-white/50">
+        Fin (facultatif)
+        <input type="datetime-local" className={`${input} mt-1`} value={f.endsAt} onChange={set("endsAt")} />
+      </label>
+      {err && <div className="text-xs text-red-300">{err}</div>}
+      <button disabled={busy} className="w-full rounded-xl bg-amber-400 py-2 text-sm font-black text-black disabled:opacity-60">
+        {busy ? "Création…" : "Créer l'événement et son groupe"}
+      </button>
+    </form>
+  );
+}
+
+function EventCard({ ev, isGoing, count, isMine, userId, actions, onOpenCommunity }) {
+  const fileRef = useRef(null);
+  const [busy, setBusy] = useState(false);
+  const [msg, setMsg] = useState("");
+  const [photos, setPhotos] = useState(null); // null = album fermé
+  const over = Date.now() > eventEnd(ev).getTime();
+
+  const refreshPhotos = async () => setPhotos(await actions.loadPhotos(ev));
+
+  const run = async (fn, ok) => {
+    setBusy(true);
+    setMsg("");
+    try {
+      const r = await fn();
+      if (ok) setMsg(ok(r));
+    } catch (e) {
+      setMsg(e?.message || "Action impossible.");
+    } finally {
+      setBusy(false);
+    }
+  };
+
+  return (
+    <div className={card}>
+      <div className="text-base font-black text-white">{ev.title}</div>
+      <div className="mt-2 space-y-1 text-xs text-white/60">
+        <div className="flex items-center gap-1.5"><CalendarDays size={13} /> {formatWhen(ev.starts_at)}</div>
+        {(ev.location || ev.city) && (
+          <div className="flex items-center gap-1.5"><MapPin size={13} /> {[ev.location, ev.city].filter(Boolean).join(", ")}</div>
+        )}
+        <div className="flex items-center gap-1.5"><Users size={13} /> {count} {count > 1 ? "participants" : "participant"}</div>
+      </div>
+      {ev.description && <p className="mt-2 text-xs leading-5 text-white/70">{ev.description}</p>}
+
+      <div className="mt-3 flex flex-wrap gap-2">
+        {!over && (
+          <button
+            disabled={busy}
+            onClick={() => run(() => actions.setAttending(ev, !isGoing))}
+            className={`rounded-xl px-3 py-2 text-xs font-black disabled:opacity-60 ${isGoing ? "border border-amber-400/60 text-amber-300" : "bg-amber-400 text-black"}`}
+          >
+            {isGoing ? "✓ Je viens" : "Je viens"}
+          </button>
+        )}
+        {isGoing && ev.group_id && (
+          <button onClick={onOpenCommunity} className="flex items-center gap-1.5 rounded-xl border border-white/10 px-3 py-2 text-xs font-bold text-white/80">
+            <MessageCircle size={14} /> Groupe
+          </button>
+        )}
+        {over && isGoing && (
+          <>
+            <button
+              disabled={busy}
+              onClick={() => fileRef.current?.click()}
+              className="flex items-center gap-1.5 rounded-xl bg-amber-400 px-3 py-2 text-xs font-black text-black disabled:opacity-60"
+            >
+              <Camera size={14} /> {busy ? "Envoi…" : "Partager mes photos"}
+            </button>
+            <input
+              ref={fileRef}
+              type="file"
+              accept="image/*"
+              multiple
+              hidden
+              onChange={(e) => {
+                const files = e.target.files;
+                e.target.value = "";
+                run(
+                  async () => {
+                    const n = await actions.sharePhotos(ev, files);
+                    if (photos) await refreshPhotos();
+                    return n;
+                  },
+                  (n) => `${n} photo${n > 1 ? "s" : ""} partagée${n > 1 ? "s" : ""} dans le groupe.`
+                );
+              }}
+            />
+          </>
+        )}
+        {over && isGoing && ev.group_id && (
+          <button
+            disabled={busy}
+            onClick={() => (photos ? setPhotos(null) : run(refreshPhotos))}
+            className="flex items-center gap-1.5 rounded-xl border border-white/10 px-3 py-2 text-xs font-bold text-white/80 disabled:opacity-60"
+          >
+            <Images size={14} /> {photos ? "Masquer l'album" : "Album"}
+          </button>
+        )}
+        {isMine && (
+          <button
+            disabled={busy}
+            onClick={() => window.confirm("Supprimer cet événement ?") && run(() => actions.deleteEvent(ev))}
+            aria-label="Supprimer"
+            className="rounded-xl border border-white/10 px-2.5 py-2 text-white/50"
+          >
+            <Trash2 size={14} />
+          </button>
+        )}
+      </div>
+      {msg && <div className="mt-2 text-[11px] text-amber-200">{msg}</div>}
+      {photos && (
+        photos.length ? (
+          <div className="mt-3 grid grid-cols-3 gap-1.5">
+            {photos.map((p) => (
+              <a key={p.id} href={p.url} target="_blank" rel="noopener noreferrer">
+                <img src={p.url} alt="Photo de l'événement" loading="lazy" className="aspect-square w-full rounded-lg object-cover" />
+              </a>
+            ))}
+          </div>
+        ) : (
+          <div className="mt-3 text-[11px] text-white/50">Aucune photo pour l'instant. Sois le premier à en partager !</div>
+        )
+      )}
+    </div>
+  );
+}
+
+export function EventsTab({ id, onOpenCommunity }) {
+  const ev = useEvents(id);
+  const [creating, setCreating] = useState(false);
+
+  const upcoming = ev.events.filter((e) => Date.now() <= eventEnd(e).getTime());
+  const past = ev.events.filter((e) => Date.now() > eventEnd(e).getTime()).reverse();
+
+  return (
+    <div className="mx-auto max-w-xl space-y-3 p-4 pb-24">
+      <div className="flex items-center justify-between">
+        <div>
+          <h2 className="text-lg font-black text-white">Événements</h2>
+          <p className="text-xs text-white/50">Retrouve Bamako dans la vraie vie.</p>
+        </div>
+        {!creating && (
+          <button onClick={() => setCreating(true)} className="flex items-center gap-1.5 rounded-xl bg-amber-400 px-3 py-2 text-xs font-black text-black">
+            <Plus size={14} /> Créer
+          </button>
+        )}
+      </div>
+
+      {creating && <CreateForm onCreate={ev.createEvent} onClose={() => setCreating(false)} />}
+      {ev.error && <div className="text-xs text-red-300">{ev.error}</div>}
+      {ev.loading && <div className="text-xs text-white/40">Chargement…</div>}
+      {!ev.loading && !ev.events.length && !ev.error && (
+        <div className={`${card} text-center text-xs text-white/60`}>Aucun événement pour l'instant. Crée le premier !</div>
+      )}
+
+      {upcoming.map((e) => (
+        <EventCard key={e.id} ev={e} userId={id} isGoing={ev.going.has(e.id)} count={ev.counts[e.id] || 0}
+          isMine={e.creator_id === id} actions={ev} onOpenCommunity={onOpenCommunity} />
+      ))}
+
+      {past.length > 0 && (
+        <>
+          <div className="pt-2 text-[10px] font-black uppercase tracking-wider text-white/40">Terminés récemment</div>
+          {past.map((e) => (
+            <EventCard key={e.id} ev={e} userId={id} isGoing={ev.going.has(e.id)} count={ev.counts[e.id] || 0}
+              isMine={e.creator_id === id} actions={ev} onOpenCommunity={onOpenCommunity} />
+          ))}
+        </>
+      )}
+    </div>
+  );
+}
+
+export default EventsTab;
diff --git a/src/features/events/hooks/useEvents.js b/src/features/events/hooks/useEvents.js
new file mode 100644
index 0000000..6c64d20
--- /dev/null
+++ b/src/features/events/hooks/useEvents.js
@@ -0,0 +1,238 @@
+/**
+ * BAARO Events — événements réels (concerts, mariages, tournois…).
+ * - Créer un événement crée automatiquement un groupe communauté pour l'événement.
+ * - « Je viens » = participation + adhésion au groupe.
+ * - Après l'événement, les participants partagent leurs photos dans le groupe.
+ */
+import { useCallback, useEffect, useState } from "react";
+import { supabase } from "../../../supabaseClient.js";
+import { uploadExternalMedia } from "../../../lib/externalMedia.js";
+
+const COLUMNS =
+  "id, creator_id, title, description, location, city, starts_at, ends_at, cover_url, group_id, created_at";
+
+function groupIdOf(data) {
+  if (!data) return null;
+  if (typeof data === "string") return data;
+  return data.id || data.group_id || (Array.isArray(data) ? groupIdOf(data[0]) : null);
+}
+
+export function eventEnd(ev) {
+  const end = ev.ends_at ? new Date(ev.ends_at) : new Date(new Date(ev.starts_at).getTime() + 6 * 3600 * 1000);
+  return end;
+}
+
+export function useEvents(userId) {
+  const [events, setEvents] = useState([]);
+  const [going, setGoing] = useState(() => new Set());
+  const [counts, setCounts] = useState({});
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState(null);
+
+  const load = useCallback(async () => {
+    if (!userId) return;
+    setError(null);
+    // On garde les événements des 3 derniers jours (pour partager les photos après)
+    const since = new Date(Date.now() - 3 * 24 * 3600 * 1000).toISOString();
+    const { data, error: err } = await supabase
+      .from("events")
+      .select(COLUMNS)
+      .gte("starts_at", since)
+      .order("starts_at", { ascending: true })
+      .limit(100);
+    if (err) {
+      setError(err.message || "Chargement impossible");
+      setLoading(false);
+      return;
+    }
+    const list = data || [];
+    setEvents(list);
+
+    if (list.length) {
+      const ids = list.map((e) => e.id);
+      const { data: att } = await supabase
+        .from("event_attendees")
+        .select("event_id, user_id")
+        .in("event_id", ids);
+      const c = {};
+      const mine = new Set();
+      for (const a of att || []) {
+        c[a.event_id] = (c[a.event_id] || 0) + 1;
+        if (a.user_id === userId) mine.add(a.event_id);
+      }
+      setCounts(c);
+      setGoing(mine);
+    } else {
+      setCounts({});
+      setGoing(new Set());
+    }
+    setLoading(false);
+  }, [userId]);
+
+  useEffect(() => {
+    void load();
+  }, [load]);
+
+  const createEvent = useCallback(
+    async ({ title, description, location, city, startsAt, endsAt }) => {
+      if (!userId) throw new Error("Non connecté");
+      const cleanTitle = String(title || "").trim();
+      if (cleanTitle.length < 3) throw new Error("Donne un titre à l'événement.");
+      if (!startsAt || Number.isNaN(new Date(startsAt).getTime())) throw new Error("Date invalide.");
+
+      // 1. Groupe automatique de l'événement
+      const { data: gData, error: gErr } = await supabase.rpc("create_community_group", {
+        p_name: cleanTitle.slice(0, 60),
+        p_description: `Groupe de l'événement : ${cleanTitle}`.slice(0, 200),
+        p_is_public: true,
+        p_category: "event",
+      });
+      if (gErr) throw gErr;
+      const groupId = groupIdOf(gData);
+
+      // 2. L'événement
+      const { data, error: err } = await supabase
+        .from("events")
+        .insert({
+          creator_id: userId,
+          title: cleanTitle,
+          description: description?.trim() || null,
+          location: location?.trim() || null,
+          city: city?.trim() || null,
+          starts_at: new Date(startsAt).toISOString(),
+          ends_at: endsAt ? new Date(endsAt).toISOString() : null,
+          group_id: groupId,
+        })
+        .select(COLUMNS)
+        .single();
+      if (err) throw err;
+
+      // Le créateur participe d'office
+      await supabase.from("event_attendees").upsert({ event_id: data.id, user_id: userId });
+      await load();
+      return data;
+    },
+    [userId, load]
+  );
+
+  const setAttending = useCallback(
+    async (ev, attending) => {
+      if (!userId || !ev?.id) return;
+      // Optimiste
+      setGoing((prev) => {
+        const next = new Set(prev);
+        attending ? next.add(ev.id) : next.delete(ev.id);
+        return next;
+      });
+      setCounts((prev) => ({
+        ...prev,
+        [ev.id]: Math.max(0, (prev[ev.id] || 0) + (attending ? 1 : -1)),
+      }));
+      try {
+        if (attending) {
+          const { error: err } = await supabase
+            .from("event_attendees")
+            .upsert({ event_id: ev.id, user_id: userId });
+          if (err) throw err;
+          if (ev.group_id) {
+            // « Je viens » → on entre dans le groupe de l'événement
+            await supabase.rpc("join_community_group", { p_group: ev.group_id, p_code: null });
+          }
+        } else {
+          const { error: err } = await supabase
+            .from("event_attendees")
+            .delete()
+            .eq("event_id", ev.id)
+            .eq("user_id", userId);
+          if (err) throw err;
+          if (ev.group_id && ev.creator_id !== userId) {
+            await supabase.from("group_members").delete().eq("group_id", ev.group_id).eq("user_id", userId);
+          }
+        }
+      } catch (e) {
+        await load(); // on revient à l'état réel
+        throw e;
+      }
+    },
+    [userId, load]
+  );
+
+  const deleteEvent = useCallback(
+    async (ev) => {
+      const { error: err } = await supabase.from("events").delete().eq("id", ev.id).eq("creator_id", userId);
+      if (err) throw err;
+      await load();
+    },
+    [userId, load]
+  );
+
+  /** Après l'événement : poste les photos dans le premier canal du groupe. */
+  const sharePhotos = useCallback(
+    async (ev, files) => {
+      if (!ev?.group_id) throw new Error("Cet événement n'a pas de groupe.");
+      if (!files?.length) return 0;
+
+      let { data: chans } = await supabase
+        .from("channels")
+        .select("id")
+        .eq("group_id", ev.group_id)
+        .order("created_at", { ascending: true })
+        .limit(1);
+      let channelId = chans?.[0]?.id;
+      if (!channelId) {
+        const { data: created, error: cErr } = await supabase.rpc("create_community_channel", {
+          p_group_id: ev.group_id,
+          p_name: "photos",
+          p_type: "text",
+          p_description: "Photos de l'événement",
+        });
+        if (cErr) throw cErr;
+        channelId = groupIdOf(created);
+      }
+      if (!channelId) throw new Error("Canal introuvable.");
+
+      let sent = 0;
+      for (const file of Array.from(files).slice(0, 10)) {
+        if (!file.type.startsWith("image/")) continue;
+        const { url } = await uploadExternalMedia(file, {
+          folder: "events",
+          user_id: userId,
+          maxBytes: 8 * 1024 * 1024,
+        });
+        const { error: mErr } = await supabase
+          .from("channel_messages")
+          .insert({ channel_id: channelId, sender_id: userId, text: `📷 ${url}` });
+        if (mErr) throw mErr;
+        sent += 1;
+      }
+      return sent;
+    },
+    [userId]
+  );
+
+  /** Album de l'événement : les photos partagées (📷 url) dans le groupe, les plus récentes d'abord. */
+  const loadPhotos = useCallback(async (ev) => {
+    if (!ev?.group_id) return [];
+    const { data: chans } = await supabase
+      .from("channels")
+      .select("id")
+      .eq("group_id", ev.group_id)
+      .order("created_at", { ascending: true })
+      .limit(1);
+    const channelId = chans?.[0]?.id;
+    if (!channelId) return [];
+    const { data, error: err } = await supabase
+      .from("channel_messages")
+      .select("id, text, created_at")
+      .eq("channel_id", channelId)
+      .like("text", "📷 %")
+      .order("created_at", { ascending: false })
+      .limit(60);
+    if (err) throw err;
+    return (data || [])
+      .map((m) => ({ id: m.id, url: String(m.text).replace(/^📷\s+/, "").trim() }))
+      .filter((p) => /^https:\/\//i.test(p.url));
+  }, []);
+
+  return { events, going, counts, loading, error, reload: load, createEvent, setAttending, deleteEvent, sharePhotos, loadPhotos };
+}
