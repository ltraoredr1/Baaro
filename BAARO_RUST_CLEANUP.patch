+++ b/worker/test/rust-sniff.mjs
@@ -0,0 +1,39 @@
+// Vérifie le résultat du détecteur Rust sur des signatures de fichiers connues.
+// Usage : BAARO_MEDIA_BIN=rust/baaro-media/target/release/baaro-media node test/rust-sniff.mjs
+import assert from "node:assert/strict";
+import { mkdtemp, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { sniffFile } from "../lib/native.mjs";
+
+let checks = 0;
+const dir = await mkdtemp(join(tmpdir(), "baaro-sniff-"));
+try {
+  const cases = [
+    ["a.mp4", Buffer.from("\0\0\0\x20ftypisom\0\0\0\0"), { kind: "mp4", media: true, danger: false }],
+    ["b.jpg", Buffer.from([0xff, 0xd8, 0xff, 0xe0]), { kind: "jpg", media: true, danger: false }],
+    ["c.mp4", Buffer.from("\x7fELF\x02\x01\x01"), { kind: "elf", media: false, danger: true }],
+    ["d.mp4", Buffer.from("<html><script>alert(1)</script>"), { kind: "html", media: false, danger: true }],
+    ["e.mp4", Buffer.from("PK\x03\x04rest"), { kind: "zip", media: false, danger: true }],
+    ["f.bin", Buffer.from("rien de connu"), { kind: "unknown", media: false, danger: false }],
+  ];
+
+  for (const [name, bytes, want] of cases) {
+    const path = join(dir, name);
+    await writeFile(path, bytes);
+    const got = await sniffFile(path);
+    assert.ok(got, `sniff ${name} : pas de résultat`);
+    assert.equal(got.kind, want.kind, `sniff ${name}`);
+    assert.equal(got.media, want.media, `sniff ${name} media`);
+    assert.equal(got.danger, want.danger, `sniff ${name} danger`);
+    assert.equal(got.size, bytes.length, `sniff ${name} size`);
+    checks++;
+  }
+
+  assert.equal(await sniffFile(join(dir, "inexistant")), null);
+  checks++;
+} finally {
+  await rm(dir, { recursive: true, force: true });
+}
+
+console.log(`OK : ${checks} vérifications de signatures Rust`);
diff --git a/worker/test/benchmark-rust.mjs b/worker/test/benchmark-rust.mjs
new file mode 100644
index 0000000..f9af104
--- /dev/null
+++ b/worker/test/benchmark-rust.mjs
@@ -0,0 +1,63 @@
+// Benchmark local du détecteur de signatures Rust réellement utilisé par le worker.
+// Usage : BAARO_MEDIA_BIN=rust/baaro-media/target/release/baaro-media node test/benchmark-rust.mjs
+import { mkdtemp, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { performance } from "node:perf_hooks";
+import { execFile as execFileCallback } from "node:child_process";
+import { promisify } from "node:util";
+import os from "node:os";
+import { sniffFile } from "../lib/native.mjs";
+
+const execFile = promisify(execFileCallback);
+const iterations = Number(process.env.BENCH_SNIFF_ITERS || 200);
+const warmupIterations = 10;
+const rustBin = process.env.BAARO_MEDIA_BIN || "baaro-media";
+const { stdout: versionOutput } = await execFile(rustBin, ["--version"], { timeout: 5000 });
+const version = versionOutput.trim();
+
+function percentile(values, fraction) {
+  const sorted = [...values].sort((a, b) => a - b);
+  return sorted[Math.min(sorted.length - 1, Math.ceil(fraction * sorted.length) - 1)];
+}
+
+async function measure(fn) {
+  for (let i = 0; i < warmupIterations; i++) await fn();
+  const timings = [];
+  for (let i = 0; i < iterations; i++) {
+    const start = performance.now();
+    await fn();
+    timings.push(performance.now() - start);
+  }
+  const meanMs = timings.reduce((sum, value) => sum + value, 0) / timings.length;
+  return {
+    samples: iterations,
+    median_ms: Number(percentile(timings, 0.5).toFixed(3)),
+    p95_ms: Number(percentile(timings, 0.95).toFixed(3)),
+    mean_ms: Number(meanMs.toFixed(3)),
+    operations_per_second: Number((1000 / meanMs).toFixed(1)),
+  };
+}
+
+const fixtureDir = await mkdtemp(join(tmpdir(), "baaro-rust-bench-"));
+try {
+  const sampleFile = join(fixtureDir, "sample.mp4");
+  await writeFile(sampleFile, Buffer.from("\0\0\0\x20ftypisom\0\0\0\0"));
+  const result = await measure(async () => {
+    const sniffed = await sniffFile(sampleFile);
+    if (!sniffed || sniffed.kind !== "mp4") throw new Error("sniff Rust incorrect");
+  });
+
+  console.log(JSON.stringify({
+    benchmark: "BAARO media worker Rust signature detector",
+    timestamp: new Date().toISOString(),
+    platform: `${os.platform()} ${os.release()} (${os.arch()})`,
+    node: process.version,
+    rust: version,
+    rustBinary: rustBin,
+    note: "Microbenchmark local; à compléter par une mesure avec l’image et la charge Cloud Run réelles.",
+    result,
+  }, null, 2));
+} finally {
+  await rm(fixtureDir, { recursive: true, force: true });
+}
