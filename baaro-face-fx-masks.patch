--- /dev/null
+++ b/src/features/videos/components/EffectsPanel.jsx
@@ -0,0 +1,39 @@
+import { useState } from "react";
+import FaceFxPicker from "./FaceFxPicker.jsx";
+import FilterPicker from "./FilterPicker.jsx";
+
+// Panneau unique : « Filtres » (ambiances, infinies) et « Visage & corps » (déformations, âge).
+// filter = objet fusionné de VideosTab { ...useVideoFilter(), face: useFaceFx(), anyActive, reset }.
+export default function EffectsPanel({ filter, disabled = false, faceEnabled = true, className = "" }) {
+  const [tab, setTab] = useState("filters");
+  const showFace = faceEnabled && !!filter?.face;
+  const current = showFace ? tab : "filters";
+
+  return (
+    <div className={`space-y-3 ${className}`}>
+      {showFace && (
+        <div className="grid grid-cols-2 gap-1 rounded-2xl bg-white/5 p-1">
+          {[
+            ["filters", "🎨 Filtres", filter.active],
+            ["face", "🧬 Visage & corps", filter.face.active],
+          ].map(([id, label, on]) => (
+            <button
+              key={id}
+              type="button"
+              onClick={() => setTab(id)}
+              className={`rounded-xl py-2 text-xs font-bold ${current === id ? "bg-white text-black" : "text-white/60"}`}
+            >
+              {label}
+              {on ? " •" : ""}
+            </button>
+          ))}
+        </div>
+      )}
+      {current === "filters" ? (
+        <FilterPicker filter={filter} disabled={disabled} />
+      ) : (
+        <FaceFxPicker fx={filter.face} disabled={disabled} />
+      )}
+    </div>
+  );
+}
diff --git a/src/features/videos/components/FaceFxCanvas.jsx b/src/features/videos/components/FaceFxCanvas.jsx
new file mode 100644
index 0000000..1281516
--- /dev/null
+++ b/src/features/videos/components/FaceFxCanvas.jsx
@@ -0,0 +1,51 @@
+import { useEffect, useRef } from "react";
+import { FaceFxProcessor } from "../faceFx/processor.js";
+
+// Calque d'aperçu : redessine la vidéo avec les déformations. Posé au-dessus de la
+// <video> (pointer-events: none), il laisse la vidéo visible tant que le suivi n'est pas prêt.
+export default function FaceFxCanvas({ videoRef, fx, mirror = false, fit = "contain", maxSide = 720, cssFilter = "none" }) {
+  const canvasRef = useRef(null);
+  const fxRef = useRef(fx);
+  fxRef.current = fx;
+  const enabled = !!fx?.active;
+
+  useEffect(() => {
+    if (!enabled) return undefined;
+    const processor = new FaceFxProcessor();
+    let raf = 0;
+    const loop = () => {
+      const canvas = canvasRef.current;
+      const video = videoRef.current;
+      const resolved = fxRef.current?.resolved;
+      if (canvas && video && video.readyState >= 2 && video.videoWidth) {
+        const r = processor.process(video, video.videoWidth, video.videoHeight, resolved, { maxSide });
+        const ctx = canvas.getContext("2d");
+        if (r.source === video) {
+          ctx.clearRect(0, 0, canvas.width, canvas.height);
+        } else {
+          if (canvas.width !== r.w || canvas.height !== r.h) {
+            canvas.width = r.w;
+            canvas.height = r.h;
+          }
+          ctx.drawImage(r.source, 0, 0);
+        }
+      }
+      raf = requestAnimationFrame(loop);
+    };
+    raf = requestAnimationFrame(loop);
+    return () => {
+      cancelAnimationFrame(raf);
+      processor.dispose();
+    };
+  }, [enabled, videoRef, maxSide]);
+
+  if (!enabled) return null;
+  return (
+    <canvas
+      ref={canvasRef}
+      aria-hidden="true"
+      className="pointer-events-none absolute inset-0 h-full w-full"
+      style={{ objectFit: fit, transform: mirror ? "scaleX(-1)" : "none", filter: cssFilter }}
+    />
+  );
+}
