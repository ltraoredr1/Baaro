diff --git a/src/features/videos/faceFx/geometry.js b/src/features/videos/faceFx/geometry.js
new file mode 100644
index 0000000..1480617
--- /dev/null
+++ b/src/features/videos/faceFx/geometry.js
@@ -0,0 +1,130 @@
+// Points-clés du visage (maillage MediaPipe, 468/478 points) et du corps (33 points)
+// convertis en « espace aspect » : x * (largeur/hauteur), y inchangé.
+
+const avg = (a, b) => ({ x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 });
+const dist = (a, b) => Math.hypot(a.x - b.x, a.y - b.y);
+const sub = (a, b) => ({ x: a.x - b.x, y: a.y - b.y });
+const norm = (v) => {
+  const l = Math.hypot(v.x, v.y) || 1;
+  return { x: v.x / l, y: v.y / l };
+};
+
+export function analyzeFace(lm, aspect) {
+  if (!lm || lm.length < 400) return null;
+  const P = (i) => ({ x: lm[i].x * aspect, y: lm[i].y });
+  const top = P(10);
+  const chin = P(152);
+  const sideA = P(234);
+  const sideB = P(454);
+  const W = dist(sideA, sideB);
+  const H = dist(top, chin);
+  if (!(W > 0.02) || !(H > 0.02)) return null;
+  const right = norm(sub(sideB, sideA)); // axe « droite » du visage
+  const up = norm(sub(top, chin)); // axe « haut » du visage
+  const center = {
+    x: (top.x + chin.x + sideA.x + sideB.x) / 4,
+    y: (top.y + chin.y + sideA.y + sideB.y) / 4,
+  };
+  const eyeA = avg(P(33), P(133));
+  const eyeB = avg(P(263), P(362));
+  const browMid = avg(P(105), P(334));
+  const rot = Math.atan2(right.y, right.x);
+  const half = W / 2;
+  const clamp01 = (v) => Math.min(1, Math.max(0, v));
+  // Repère « unité » du masque : 1 = demi-largeur du visage, x vers la droite du visage, y vers le bas.
+  const unit = (p) => ({
+    x: ((p.x - center.x) * right.x + (p.y - center.y) * right.y) / half,
+    y: -((p.x - center.x) * up.x + (p.y - center.y) * up.y) / half,
+  });
+  const lid = (u, l, a, b) => dist(P(u), P(l)) / Math.max(dist(P(a), P(b)), 1e-6);
+  const eyeRatio = (lid(159, 145, 33, 133) + lid(386, 374, 263, 362)) / 2;
+  const mouthGap = dist(P(13), P(14)) / W;
+  const noseU = unit(P(1));
+  return {
+    unit,
+    blink: clamp01((0.2 - eyeRatio) / 0.1),
+    mouthOpen: clamp01((mouthGap - 0.03) / 0.25),
+    yaw: Math.min(1, Math.max(-1, noseU.x)),
+    roll: Math.atan2(up.x, -up.y),
+    unitPx: half,
+    W,
+    H,
+    right,
+    up,
+    center,
+    top,
+    chin,
+    sideA,
+    sideB,
+    eyes: [eyeA, eyeB],
+    brows: [P(105), P(334)],
+    browMid,
+    forehead: avg(top, browMid),
+    noseTip: P(1),
+    nostrils: [P(129), P(358)],
+    mouthC: avg(P(13), P(14)),
+    mouthCorners: [P(61), P(291)],
+    jaw: [P(172), P(397)],
+    cheeks: [P(50), P(280)],
+    shader: {
+      cx: center.x,
+      cy: center.y,
+      rx: (W / 2) * 1.08,
+      ry: (H / 2) * 1.08,
+      rot,
+      hair: { cx: top.x + up.x * H * 0.18, cy: top.y + up.y * H * 0.18, rx: W * 0.95, ry: H * 0.62 },
+      eyeL: eyeA,
+      eyeR: eyeB,
+      noseL: P(129),
+      noseR: P(358),
+      mouthL: P(61),
+      mouthR: P(291),
+    },
+  };
+}
+
+export function analyzeBody(lm, aspect) {
+  if (!lm || lm.length < 29) return null;
+  const P = (i) => ({ x: lm[i].x * aspect, y: lm[i].y, v: lm[i].visibility ?? 1 });
+  const sh = [P(11), P(12)];
+  const hip = [P(23), P(24)];
+  if (sh.some((p) => p.v < 0.4) || dist(sh[0], sh[1]) < 0.03) return null;
+  const shMid = avg(sh[0], sh[1]);
+  const torsoLen = hip.every((p) => p.v > 0.3) ? dist(shMid, avg(hip[0], hip[1])) : dist(sh[0], sh[1]) * 1.3;
+  const hipMid = hip.every((p) => p.v > 0.3) ? avg(hip[0], hip[1]) : { x: shMid.x, y: shMid.y + torsoLen };
+  const lerp = (a, b, t) => ({ x: a.x + (b.x - a.x) * t, y: a.y + (b.y - a.y) * t });
+  const shoulderW = dist(sh[0], sh[1]);
+  const hipPts = hip.every((p) => p.v > 0.3) ? hip : [
+    { x: hipMid.x - shoulderW * 0.35, y: hipMid.y },
+    { x: hipMid.x + shoulderW * 0.35, y: hipMid.y },
+  ];
+  const knees = [P(25), P(26)];
+  const ankles = [P(27), P(28)];
+  const hasLegs = knees.every((p) => p.v > 0.4) && ankles.every((p) => p.v > 0.3);
+  return {
+    shoulders: sh,
+    shMid,
+    hips: hipPts,
+    hipMid,
+    shoulderW,
+    torsoLen,
+    waist: [lerp(sh[0], hipPts[0], 0.62), lerp(sh[1], hipPts[1], 0.62)],
+    belly: lerp(shMid, hipMid, 0.7),
+    elbows: [P(13), P(14)].map((p) => (p.v > 0.4 ? p : null)),
+    head: { x: P(0).x, y: P(0).y - torsoLen * 0.08, r: torsoLen * 0.42 },
+    knees: hasLegs ? knees : null,
+    ankles: hasLegs ? ankles : null,
+  };
+}
+
+// Lissage exponentiel des points entre deux images (évite le tremblement).
+export function smoothLandmarks(prev, next, alpha = 0.55) {
+  if (!next) return null;
+  if (!prev || prev.length !== next.length) return next.map((p) => ({ ...p }));
+  return next.map((p, i) => ({
+    x: prev[i].x + (p.x - prev[i].x) * alpha,
+    y: prev[i].y + (p.y - prev[i].y) * alpha,
+    z: p.z,
+    visibility: p.visibility,
+  }));
+}
diff --git a/src/features/videos/faceFx/masks.js b/src/features/videos/faceFx/masks.js
new file mode 100644
index 0000000..a50282a
--- /dev/null
+++ b/src/features/videos/faceFx/masks.js
@@ -0,0 +1,656 @@
+import { makeRng, rgbToHex, rotateHue, toRgb } from "../filters/utils.js";
+
+// Têtes d'animaux et accessoires dessinés en vectoriel (aucune image à charger).
+// Repère de dessin : 1 unité = demi-largeur du visage, y vers le bas, origine = centre du
+// visage. Les yeux / nez / bouche sont posés sur les vrais points du visage (F).
+
+const TAU = Math.PI * 2;
+const tint = (hex, hue) => (hue ? rgbToHex(rotateHue(toRgb(hex), hue)) : hex);
+
+const ell = (c, x, y, rx, ry, color, rot = 0) => {
+  c.beginPath();
+  c.ellipse(x, y, rx, ry, rot, 0, TAU);
+  c.fillStyle = color;
+  c.fill();
+};
+const poly = (c, pts, color) => {
+  c.beginPath();
+  pts.forEach(([x, y], i) => (i ? c.lineTo(x, y) : c.moveTo(x, y)));
+  c.closePath();
+  c.fillStyle = color;
+  c.fill();
+};
+const line = (c, pts, color, w) => {
+  c.beginPath();
+  pts.forEach(([x, y], i) => (i ? c.lineTo(x, y) : c.moveTo(x, y)));
+  c.strokeStyle = color;
+  c.lineWidth = w;
+  c.lineCap = "round";
+  c.lineJoin = "round";
+  c.stroke();
+};
+const vgrad = (c, y0, y1, a, b) => {
+  const g = c.createLinearGradient(0, y0, 0, y1);
+  g.addColorStop(0, a);
+  g.addColorStop(1, b);
+  return g;
+};
+const rgrad = (c, r, a, b) => {
+  const g = c.createRadialGradient(0, -r * 0.3, r * 0.1, 0, 0, r);
+  g.addColorStop(0, a);
+  g.addColorStop(1, b);
+  return g;
+};
+
+// Les visages plus longs que la moyenne allongent un peu la tête de l'animal.
+let stretch = 1;
+
+// Tête de base (ellipse dégradée).
+const head = (c, P, rx = 1.3, ry0 = 1.4, y0 = -0.05) => {
+  const ry = ry0 * stretch;
+  const y = y0 * stretch;
+  c.beginPath();
+  c.ellipse(0, y, rx, ry, 0, 0, TAU);
+  c.fillStyle = vgrad(c, y - ry, y + ry, P.light || P.fur, P.fur);
+  c.fill();
+};
+
+const eye = (c, F, side, r, P, opts = {}) => {
+  const e = F.eyes[side];
+  const x = opts.x ?? e.x;
+  const y = opts.y ?? e.y;
+  if (F.blink > 0.55) {
+    line(c, [[x - r, y], [x, y + r * 0.35], [x + r, y]], P.line || "#2a1a14", r * 0.28);
+    return;
+  }
+  ell(c, x, y, r, r * 1.08, opts.sclera || "#fff");
+  const look = -Math.sign(x) * r * 0.12;
+  ell(c, x + look, y + r * 0.05, r * 0.62, r * 0.7, opts.iris || P.iris || "#2b1b12");
+  ell(c, x + look, y + r * 0.05, r * 0.32, r * 0.38, "#000");
+  ell(c, x + look + r * 0.2, y - r * 0.22, r * 0.2, r * 0.2, "#fff");
+};
+
+const mouth = (c, F, x, y, w, P, opts = {}) => {
+  const open = F.mouth;
+  if (open < 0.12) {
+    line(c, [[x - w * 0.5, y - w * 0.04], [x - w * 0.22, y + w * 0.12], [x, y], [x + w * 0.22, y + w * 0.12], [x + w * 0.5, y - w * 0.04]], P.line || "#3a1d14", w * 0.09);
+    return;
+  }
+  const h = w * (0.12 + open * 0.75);
+  c.beginPath();
+  c.ellipse(x, y + h * 0.45, w * 0.5, h * 0.55 + w * 0.05, 0, 0, TAU);
+  c.fillStyle = "#4a0f1a";
+  c.fill();
+  if (opts.tongue !== false) ell(c, x, y + h * 0.85, w * 0.28, h * 0.28 + 0.02, "#ff7a8e");
+};
+
+const whiskers = (c, x, y, len, color = "#ffffffcc", w = 0.035) => {
+  [-1, 1].forEach((s) => {
+    [-0.14, 0, 0.14].forEach((dy) => {
+      line(c, [[s * x, y], [s * (x + len), y + dy * len * 1.6]], color, w);
+    });
+  });
+};
+
+const earPair = (c, fn) => [-1, 1].forEach((s) => {
+  c.save();
+  c.scale(s, 1);
+  fn();
+  c.restore();
+});
+
+// ───────────────────────── Animaux ─────────────────────────
+// Chaque dessinateur : (c, F, P) avec P = palette déjà teintée.
+const ANIMALS = {
+  chat: {
+    emoji: "🐱", label: "Chat", sw: ["#ffc27a", "#d9822b"],
+    pal: { fur: "#f0a64a", light: "#ffc680", dark: "#c9772a", inner: "#ff9fb2", nose: "#ff7a95", iris: "#3c8a3a" },
+    draw(c, F, P) {
+      earPair(c, () => {
+        poly(c, [[0.35, -1.0], [1.15, -1.75], [1.35, -0.45]], P.fur);
+        poly(c, [[0.55, -0.95], [1.08, -1.4], [1.2, -0.62]], P.inner);
+      });
+      head(c, P);
+      [-1, 1].forEach((s) => [0, 1, 2].forEach((i) => {
+        line(c, [[s * (0.2 + i * 0.22), -1.3], [s * (0.2 + i * 0.22) + s * 0.04, -0.95]], P.dark, 0.09);
+      }));
+      ell(c, 0, 0.55, 0.62, 0.5, P.light === P.fur ? "#fff" : "#fff1dd");
+      eye(c, F, 0, 0.23, P);
+      eye(c, F, 1, 0.23, P);
+      poly(c, [[-0.13, 0.28], [0.13, 0.28], [0, 0.42]], P.nose);
+      mouth(c, F, 0, 0.68, 0.55, P);
+      whiskers(c, 0.55, 0.52, 0.85);
+    },
+  },
+  chien: {
+    emoji: "🐶", label: "Chien", sw: ["#e8c9a0", "#8a5a2b"],
+    pal: { fur: "#d9a066", light: "#efc896", dark: "#7a4a22", nose: "#1f1612", iris: "#4a2a12" },
+    draw(c, F, P) {
+      earPair(c, () => {
+        c.save();
+        c.rotate(0.25);
+        ell(c, 1.35, -0.2, 0.42, 0.95, P.dark);
+        c.restore();
+      });
+      head(c, P);
+      ell(c, -0.62, -0.2, 0.42, 0.45, P.dark);
+      ell(c, 0, 0.58, 0.72, 0.58, "#f8e7cf");
+      eye(c, F, 0, 0.22, P);
+      eye(c, F, 1, 0.22, P);
+      ell(c, 0, 0.32, 0.26, 0.19, P.nose);
+      ell(c, -0.07, 0.27, 0.07, 0.04, "#ffffff88");
+      mouth(c, F, 0, 0.78, 0.55, P);
+    },
+  },
+  lapin: {
+    emoji: "🐰", label: "Lapin", sw: ["#fbe6ef", "#e9a3c0"],
+    pal: { fur: "#f4efe9", light: "#ffffff", dark: "#d8cfc5", inner: "#ffb6cc", nose: "#ff8fb0", iris: "#7a2a3a" },
+    draw(c, F, P) {
+      earPair(c, () => {
+        ell(c, 0.5, -2.25, 0.34, 1.15, P.fur, 0.1);
+        ell(c, 0.5, -2.2, 0.19, 0.92, P.inner, 0.1);
+      });
+      head(c, P);
+      ell(c, 0, 0.55, 0.55, 0.42, "#fff");
+      eye(c, F, 0, 0.21, P);
+      eye(c, F, 1, 0.21, P);
+      poly(c, [[-0.1, 0.3], [0.1, 0.3], [0, 0.4]], P.nose);
+      mouth(c, F, 0, 0.62, 0.42, P, { tongue: false });
+      if (F.mouth < 0.12) {
+        c.fillStyle = "#fff";
+        c.fillRect(-0.12, 0.64, 0.11, 0.2);
+        c.fillRect(0.01, 0.64, 0.11, 0.2);
+        c.strokeStyle = "#cfc4ba";
+        c.lineWidth = 0.02;
+        c.strokeRect(-0.12, 0.64, 0.11, 0.2);
+        c.strokeRect(0.01, 0.64, 0.11, 0.2);
+      }
+      whiskers(c, 0.5, 0.5, 0.7, "#c9bdb2");
+    },
+  },
+  ours: {
+    emoji: "🐻", label: "Ours", sw: ["#c99a6b", "#6b4423"],
+    pal: { fur: "#a8744a", light: "#c4905f", dark: "#6b4423", inner: "#d9a77a", nose: "#2a1810", iris: "#2a1810" },
+    draw(c, F, P) {
+      earPair(c, () => {
+        ell(c, 0.95, -1.05, 0.42, 0.42, P.fur);
+        ell(c, 0.95, -1.05, 0.24, 0.24, P.inner);
+      });
+      head(c, P);
+      ell(c, 0, 0.55, 0.62, 0.5, "#e6c39d");
+      eye(c, F, 0, 0.17, P, { sclera: "#f6eadb" });
+      eye(c, F, 1, 0.17, P, { sclera: "#f6eadb" });
+      ell(c, 0, 0.33, 0.22, 0.15, P.nose);
+      mouth(c, F, 0, 0.68, 0.5, P);
+    },
+  },
+  panda: {
+    emoji: "🐼", label: "Panda", sw: ["#f2f2f2", "#222"],
+    pal: { fur: "#f6f6f6", light: "#ffffff", dark: "#1c1c1c", nose: "#1c1c1c", iris: "#1c1c1c" },
+    draw(c, F, P) {
+      earPair(c, () => ell(c, 0.98, -1.1, 0.45, 0.45, P.dark));
+      head(c, P);
+      [0, 1].forEach((i) => {
+        const e = F.eyes[i];
+        c.save();
+        c.translate(e.x, e.y + 0.05);
+        c.rotate(-Math.sign(e.x) * 0.5);
+        ell(c, 0, 0, 0.28, 0.4, P.dark);
+        c.restore();
+      });
+      eye(c, F, 0, 0.14, P, { sclera: "#fff" });
+      eye(c, F, 1, 0.14, P, { sclera: "#fff" });
+      ell(c, 0, 0.42, 0.2, 0.14, P.nose);
+      mouth(c, F, 0, 0.72, 0.5, P);
+    },
+  },
+  renard: {
+    emoji: "🦊", label: "Renard", sw: ["#ff9a4d", "#c2410c"],
+    pal: { fur: "#ee7b2a", light: "#f59a4a", dark: "#2a1a14", inner: "#fff2e0", nose: "#1c1c1c", iris: "#5a2d0c" },
+    draw(c, F, P) {
+      earPair(c, () => {
+        poly(c, [[0.3, -1.0], [1.05, -2.05], [1.4, -0.4]], P.fur);
+        poly(c, [[0.62, -1.4], [1.05, -2.05], [1.2, -1.2]], P.dark);
+        poly(c, [[0.62, -0.95], [1.0, -1.45], [1.15, -0.65]], P.inner);
+      });
+      head(c, P);
+      earPair(c, () => poly(c, [[0.1, 0.3], [1.35, -0.05], [1.0, 0.95]], P.inner));
+      poly(c, [[-0.4, 0.2], [0.4, 0.2], [0, 1.15]], P.inner);
+      eye(c, F, 0, 0.2, P, { sclera: "#fff6df" });
+      eye(c, F, 1, 0.2, P, { sclera: "#fff6df" });
+      ell(c, 0, 0.62, 0.15, 0.11, P.nose);
+      mouth(c, F, 0, 0.92, 0.4, P);
+    },
+  },
+  lion: {
+    emoji: "🦁", label: "Lion", sw: ["#ffcf6b", "#b45309"],
+    pal: { fur: "#e9b04f", light: "#f7cf7a", dark: "#8a4a12", mane: "#a0561a", nose: "#4a2a1a", iris: "#4a2a0a" },
+    draw(c, F, P) {
+      for (let i = 0; i < 18; i += 1) {
+        const a = (i / 18) * TAU;
+        ell(c, Math.cos(a) * 1.35, Math.sin(a) * 1.45 - 0.05, 0.6, 0.6, i % 2 ? P.mane : P.dark);
+      }
+      ell(c, 0, -0.05, 1.5, 1.6, P.mane);
+      earPair(c, () => ell(c, 0.95, -1.15, 0.3, 0.3, P.fur));
+      head(c, P, 1.12, 1.22);
+      ell(c, 0, 0.5, 0.58, 0.48, "#fbe6bd");
+      eye(c, F, 0, 0.2, P, { sclera: "#fff6df" });
+      eye(c, F, 1, 0.2, P, { sclera: "#fff6df" });
+      poly(c, [[-0.16, 0.25], [0.16, 0.25], [0, 0.42]], P.nose);
+      mouth(c, F, 0, 0.66, 0.5, P);
+    },
