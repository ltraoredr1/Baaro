{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self), payment=(self)"
        },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin-allow-popups" },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://challenges.cloudflare.com https://js.stripe.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://api.anthropic.com https://api.openai.com https://api.x.ai https://api.daily.co https://*.daily.co https://api-checkout.cinetpay.com https://challenges.cloudflare.com https://api.stripe.com; frame-src 'self' https://challenges.cloudflare.com https://js.stripe.com https://hooks.stripe.com https://*.daily.co; media-src 'self' blob: https:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/gifts", "destination": "/api/wallet?route=gifts" },
    { "source": "/api/payout", "destination": "/api/wallet?route=payout" },
    { "source": "/api/create-payment", "destination": "/api/payments?route=create" },
    { "source": "/api/stripe-redeem", "destination": "/api/payments?route=stripe-redeem" },
    { "source": "/api/payment-webhook", "destination": "/api/webhooks?route=payment" },
    { "source": "/api/stripe-webhook", "destination": "/api/webhooks?route=stripe" },
    { "source": "/api/chat-call", "destination": "/api/chat?route=call" },
    { "source": "/api/create-room", "destination": "/api/live?route=room" },
    { "source": "/api/live-roles", "destination": "/api/live?route=roles" },
    { "source": "/api/ai-routing", "destination": "/api/ai?route=routing" },
    { "source": "/api/debate-ai", "destination": "/api/ai?route=debate" },
    { "source": "/api/translate-media", "destination": "/api/translate?route=media" },
    { "source": "/api/invite/:code", "destination": "/api/referral?route=invite&code=:code" }
  ]
}
