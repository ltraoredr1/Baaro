# Copiez ce fichier en .env.local et remplissez avec vos vraies valeurs
# (trouvables dans Supabase : Project Settings > API)

VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=votre-clé-anonyme-publique

# Uniquement côté serveur (fonction /api/chat), jamais préfixée par VITE_
ANTHROPIC_API_KEY=votre-clé-api-anthropic

# Uniquement côté serveur (fonctions /api/wallet et /api/register-device).
# Trouvable dans Supabase : Project Settings > API > service_role (secret !).
# Jamais préfixée VITE_, jamais exposée au navigateur, jamais commit.
SUPABASE_SERVICE_ROLE_KEY=votre-clé-service-role-supabase

# Clé PUBLIQUE du site Cloudflare Turnstile (voir README, section CAPTCHA).
# Contrairement aux clés ci-dessus, celle-ci est faite pour être publique.
VITE_TURNSTILE_SITE_KEY=votre-clé-site-turnstile

# Uniquement nécessaire pour les builds natifs (Capacitor). Laissez vide
# pour le site web classique.
VITE_API_BASE_URL=https://baaro-xxxx.vercel.app

# Optionnel — serveur TURN pour fiabiliser les appels vidéo/audio de groupe
# des "Débats" derrière certains réseaux restrictifs (voir src/lib/webrtc.js).
# Sans ces variables, seuls des serveurs STUN publics gratuits sont utilisés :
# les appels fonctionnent sur la plupart des réseaux, mais pas tous.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
