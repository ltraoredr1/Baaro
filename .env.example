# ============================================================
# BAARO — ENVIRONMENT TEMPLATE
# ============================================================
# Copy this file to .env.local for local development.
# NEVER commit real secrets. Production secrets belong in Vercel/
# your secret manager, not in this repository.
#
# PUBLIC (Vite) variables are safe to expose to the browser.
# SERVER variables MUST NEVER use the VITE_ prefix.
# ============================================================

# ------------------------------------------------------------
# FRONTEND / PUBLIC
# ------------------------------------------------------------
VITE_APP_ENV=development
VITE_API_BASE_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_DAILY_DOMAIN=
VITE_VAPID_PUBLIC_KEY=

# "Lire le vocal" (Whisper sur l'appareil) — optionnel
# Français : modèle Whisper multilingue ONNX (défaut : Xenova/whisper-base)
VITE_WHISPER_FR_MODEL=Xenova/whisper-base
# Bambara : Whisper d'origine ne gère PAS le bambara. Renseigne ici un modèle Whisper
# ajusté au bambara ET converti en ONNX (id Hugging Face). Vide = option bambara masquée.
VITE_WHISPER_BAMBARA_MODEL=
# Jeton de langue à forcer pour le modèle bambara (vide = aucun ; dépend de l'entraînement)
VITE_WHISPER_BAMBARA_LANG=

# Worker public URL used by the Videos tab for unlimited-size multipart uploads (R2 ceiling applies).
VITE_BAARO_MEDIA_WORKER_URL=

# ------------------------------------------------------------
# SUPABASE — SERVER ONLY
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# APPLICATION / SECURITY
# ------------------------------------------------------------
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PUBLIC_APP_URL=http://localhost:5173
SEND_SMS_HOOK_SECRET=

# Web Push (VAPID) — la clé privée reste côté serveur uniquement
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@baaro.app

# ------------------------------------------------------------
# CLOUDFLARE R2 — MEDIA STORAGE / SERVER ONLY
# ------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=baaro-media
R2_PUBLIC_BASE_URL=

# ------------------------------------------------------------
# RATE LIMITING — REQUIRED on Vercel production
# ------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------
# AI PROVIDERS — OPTIONAL / SERVER ONLY
# ------------------------------------------------------------
BAARO_AI_MODEL=
BAARO_AI_PROVIDER_ORDER=

OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

GEMINI_API_KEY=
GEMINI_API_BASE=
GEMINI_MODEL=

MOONSHOT_API_KEY=
MOONSHOT_API_BASE=
MOONSHOT_MODEL=

XAI_API_KEY=
XAI_API_BASE=
XAI_MODEL=

N8N_BAARO_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# ------------------------------------------------------------
# LIVE VIDEO — OPTIONAL
# ------------------------------------------------------------
DAILY_API_KEY=
DAILY_DOMAIN=

# ------------------------------------------------------------
# PAYMENTS — OPTIONAL / SERVER ONLY
# Leave empty until the provider is configured. Use sandbox/test
# credentials outside production.
# ------------------------------------------------------------
CINETPAY_API_KEY=
CINETPAY_SITE_ID=
# Token dedicated to CinetPay Mass Payout / Transfer API
CINETPAY_TRANSFER_TOKEN=
BAARO_AD_REVENUE_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SHOP_EUR=
STRIPE_PRICE_SHOP_USD=
FLUTTERWAVE_SECRET_KEY=
PAWAPAY_API_KEY=
# sandbox for development/staging, live only in production
PAWAPAY_ENV=sandbox

# ------------------------------------------------------------
# VERCEL — PROVIDED AUTOMATICALLY BY VERCEL
# ------------------------------------------------------------
VERCEL_ENV=
VERCEL_URL=
VERCEL_PROJECT_PRODUCTION_URL=

# DEV is provided automatically by Vite (do not set manually).
# DEV=

# ------------------------------------------------------------
# NEXTGEN VIDEO ENGINES / EXTERNAL MEDIA WORKER
# Heavy processing; API stays unchanged.
# BAARO_MEDIA_PROCESSOR_URL must be the public Cloud Run /process URL.
# BAARO_WORKER_SECRET must match the Cloud Run secret.
# ------------------------------------------------------------
BAARO_MEDIA_PROCESSOR_URL=
BAARO_WORKER_SECRET=
BAARO_WORKER_ID=
BAARO_WORKER_PORT=8787
BAARO_WORKER_TMP_DIR=/tmp/baaro-worker
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
WHISPER_BIN=whisper
WHISPER_MODEL=small
BAARO_TTS_URL=
BAARO_TTS_SECRET=
