{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baaro",
  "compatibility_date": "2026-09-26",

  "kv_namespaces": [
    {
      "binding": "KV_BINDING",
      "id": "f79b8443e5774232a5edb09ff7434329"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BAARO_MEDIA",
      "bucket_name": "baaro-media"
    }
  ],

  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
