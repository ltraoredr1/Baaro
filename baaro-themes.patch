+/* Palettes : --b-bg (fond), --b-surface / --b-surface2 / --b-hover (cartes), --b-ivory (texte),
+   --b-muted* (texte secondaire), --b-border, --b-glow (halo décoratif du fond). */
+:root,
+html[data-baaro-theme="midnight"] {
+  --b-bg: #182848; --b-surface: #223560; --b-surface2: #2d4278; --b-hover: #38508f;
+  --b-ivory: #f7f2e7; --b-muted: #aeb8d0; --b-muted-light: #c7d0e4;
+  --b-border: rgba(255, 255, 255, 0.12);
+  --b-glow: radial-gradient(900px 520px at 12% -8%, rgba(45, 191, 166, 0.22), transparent 60%),
+            radial-gradient(800px 520px at 100% 0%, rgba(217, 174, 82, 0.18), transparent 60%);
+}
+html[data-baaro-theme="oled"] {
+  --b-bg: #000000; --b-surface: #0e0f12; --b-surface2: #17181d; --b-hover: #1f2127;
+  --b-ivory: #f7f2e7; --b-muted: #9aa3b5; --b-muted-light: #b4bccb;
+  --b-border: rgba(255, 255, 255, 0.1); --b-glow: none;
+}
+html[data-baaro-theme="emerald"] {
+  --b-bg: #0f3b2e; --b-surface: #17503f; --b-surface2: #1f6350; --b-hover: #2a7761;
+  --b-ivory: #f4f7ee; --b-muted: #a9c7b8; --b-muted-light: #c4dccf;
+  --b-border: rgba(255, 255, 255, 0.13);
+  --b-glow: radial-gradient(900px 520px at 90% -10%, rgba(217, 174, 82, 0.2), transparent 60%);
+}
+html[data-baaro-theme="sunset"] {
+  --b-bg: #4a1f2b; --b-surface: #5e2b38; --b-surface2: #733846; --b-hover: #874555;
+  --b-ivory: #fff4ea; --b-muted: #dbb4b8; --b-muted-light: #ecccce;
+  --b-border: rgba(255, 255, 255, 0.14);
+  --b-glow: radial-gradient(900px 520px at 100% -10%, rgba(245, 158, 11, 0.3), transparent 60%),
+            radial-gradient(700px 480px at 0% 0%, rgba(236, 72, 153, 0.18), transparent 60%);
+}
+html[data-baaro-theme="ocean"] {
+  --b-bg: #0f3a5f; --b-surface: #174d7a; --b-surface2: #20609a; --b-hover: #2b73b3;
+  --b-ivory: #f2f8fc; --b-muted: #a9c6df; --b-muted-light: #c4d9ec;
+  --b-border: rgba(255, 255, 255, 0.14);
+  --b-glow: radial-gradient(900px 520px at 10% -10%, rgba(78, 225, 200, 0.22), transparent 60%);
+}
+html[data-baaro-theme="forest"] {
+  --b-bg: #1e4d2b; --b-surface: #28613a; --b-surface2: #327448; --b-hover: #3e8a57;
+  --b-ivory: #f4f8ee; --b-muted: #b0cdb7; --b-muted-light: #c9e0cf;
+  --b-border: rgba(255, 255, 255, 0.14);
+  --b-glow: radial-gradient(900px 520px at 100% -10%, rgba(217, 174, 82, 0.2), transparent 60%);
+}
+html[data-baaro-theme="desert"] {
+  --b-bg: #4a3a28; --b-surface: #5e4a33; --b-surface2: #735c41; --b-hover: #886f4f;
+  --b-ivory: #fbf3e4; --b-muted: #d3c0a2; --b-muted-light: #e5d5bb;
+  --b-border: rgba(255, 255, 255, 0.14);
+  --b-glow: radial-gradient(900px 520px at 80% -10%, rgba(245, 200, 107, 0.26), transparent 60%);
+}
+html[data-baaro-theme="indigo"] {
+  --b-bg: #2a2f6e; --b-surface: #363c86; --b-surface2: #444b9c; --b-hover: #535bb3;
+  --b-ivory: #f6f5ff; --b-muted: #b9bde6; --b-muted-light: #d0d3f0;
+  --b-border: rgba(255, 255, 255, 0.15);
+  --b-glow: radial-gradient(900px 520px at 90% -10%, rgba(139, 92, 246, 0.3), transparent 60%),
+            radial-gradient(700px 480px at 0% 0%, rgba(45, 191, 166, 0.16), transparent 60%);
+}
+html[data-baaro-theme="light"] {
+  --b-bg: #f6f1e7; --b-surface: #ffffff; --b-surface2: #efe7d6; --b-hover: #e6dcc6;
+  --b-ivory: #1b2438; --b-muted: #5b6780; --b-muted-light: #44506a;
+  --b-border: rgba(27, 36, 56, 0.14);
+  --b-glow: radial-gradient(900px 520px at 12% -8%, rgba(45, 191, 166, 0.14), transparent 60%),
+            radial-gradient(800px 520px at 100% 0%, rgba(217, 174, 82, 0.18), transparent 60%);
+}
+
+html[data-baaro-theme] {
+  background-color: var(--b-bg);
+  background-image: var(--b-glow);
+  background-attachment: fixed;
+  color: var(--b-ivory);
+}
+
+/* Thème clair : les composants écrits en Tailwind avec du texte blanc / des bordures blanches
+   sont recolorés (les boutons qui ont une couleur de fond propre gardent leur texte blanc). */
+html[data-baaro-theme="light"] [class*="text-white"]:not([class*="bg-"]) { color: var(--b-ivory); }
+html[data-baaro-theme="light"] [class*="border-white"] { border-color: var(--b-border); }
+html[data-baaro-theme="light"] [class*="bg-black/9"] { background-color: var(--b-surface); }
+html[data-baaro-theme="light"] input,
+html[data-baaro-theme="light"] textarea { color: var(--b-ivory); }
 
 html[data-baaro-theme="custom"] {
-  background-color: var(--baaro-custom-bg, #0b1220);
-  background-image: var(--baaro-custom-image, none);
+  background-color: var(--baaro-custom-bg, #182848);
+  background-image: var(--baaro-custom-image, var(--b-glow));
   background-size: cover;
   background-position: center;
   background-attachment: fixed;
