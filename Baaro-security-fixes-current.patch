[32m+[m[32m  let keyMarker;[m
[32m+[m[32m  let uploadIdMarker;[m
[32m+[m[32m  let scanned = 0;[m
[32m+[m[32m  let aborted = 0;[m
[32m+[m
[32m+[m[32m  do {[m
[32m+[m[32m    const page = await client.send(new ListMultipartUploadsCommand({[m
[32m+[m[32m      Bucket: config.r2.bucket,[m
[32m+[m[32m      KeyMarker: keyMarker,[m
[32m+[m[32m      UploadIdMarker: uploadIdMarker,[m
[32m+[m[32m    }));[m
[32m+[m[32m    for (const upload of page.Uploads || []) {[m
[32m+[m[32m      scanned += 1;[m
[32m+[m[32m      const initiated = upload.Initiated ? new Date(upload.Initiated).getTime() : 0;[m
[32m+[m[32m      if (!upload.Key || !upload.UploadId || !initiated || initiated > cutoff) continue;[m
[32m+[m[32m      await client.send(new AbortMultipartUploadCommand({[m
[32m+[m[32m        Bucket: config.r2.bucket,[m
[32m+[m[32m        Key: upload.Key,[m
[32m+[m[32m        UploadId: upload.UploadId,[m
[32m+[m[32m      }));[m
[32m+[m[32m      aborted += 1;[m
[32m+[m[32m    }[m
[32m+[m[32m    keyMarker = page.IsTruncated ? page.NextKeyMarker : undefined;[m
[32m+[m[32m    uploadIdMarker = page.IsTruncated ? page.NextUploadIdMarker : undefined;[m
