[32m+[m[32m/**[m
[32m+[m[32m * Supprime uniquement les multipart uploads abandonnés depuis le délai donné.[m
[32m+[m[32m * Aucun quota utilisateur n'est appliqué : cette tâche ne fait que nettoyer[m
[32m+[m[32m * les uploads jamais finalisés afin d'éviter les déchets de stockage.[m
[32m+[m[32m */[m
[32m+[m[32mexport async function cleanupAbandonedMultipartUploads({ olderThanHours = 24 } = {}) {[m
[32m+[m[32m  const hours = Number(olderThanHours);[m
[32m+[m[32m  if (!Number.isFinite(hours) || hours <= 0) {[m
[32m+[m[32m    throw httpError('Délai de nettoyage invalide');[m
[32m+[m[32m  }[m
[32m+[m[32m  const cutoff = Date.now() - hours * 60 * 60 * 1000;[m
