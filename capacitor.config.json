{
  "appId": "com.baaro.app",
  "appName": "BAARO",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "backgroundColor": "#ffffff"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    },
    "Keyboard": {
      "resize": "native"
    }
  },
  "android": {
    "allowMixedContent": true
  }
}
