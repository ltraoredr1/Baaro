# --- Build Rust + C/libavformat ---
FROM rust:1-bookworm AS native-build
WORKDIR /build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config libavformat-dev && rm -rf /var/lib/apt/lists/*
COPY rust/baaro-media/ ./
RUN cargo build --release --locked

# --- Runtime Cloud Run ---
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg python3 python3-pip ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=native-build /build/target/release/baaro-media /usr/local/bin/baaro-media
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . .
ENV NODE_ENV=production
ENV BAARO_WORKER_PORT=8080
ENV BAARO_WORKER_TMP_DIR=/tmp/baaro-worker
ENV FFMPEG_BIN=ffmpeg
ENV FFPROBE_BIN=ffprobe
ENV WHISPER_BIN=whisper
ENV BAARO_MEDIA_BIN=/usr/local/bin/baaro-media
EXPOSE 8080
CMD ["node", "server.mjs"]
