index 0000000000000000000000000000000000000000..fb969dfba7bdc7e84d35b586575396e9ef689a5d
--- /dev/null
+++ b/src/features/messaging/native/src/lib.rs
@@ -0,0 +1,324 @@
+use aes_gcm::{
+    aead::{Aead, KeyInit, Payload},
+    Aes256Gcm, Nonce,
+};
+use hkdf::Hkdf;
+use js_sys::{Object, Reflect, Uint8Array};
+use rand_core::{OsRng, RngCore};
+use sha2::{Digest, Sha256};
+use subtle::ConstantTimeEq;
+use wasm_bindgen::prelude::*;
+use x25519_dalek::{PublicKey, StaticSecret};
+use zeroize::Zeroizing;
+
+const ENVELOPE_MAGIC: &[u8; 4] = b"BAR3";
+const PUBLIC_KEY_LEN: usize = 32;
+const PRIVATE_KEY_LEN: usize = 32;
+const SALT_LEN: usize = 32;
+const NONCE_LEN: usize = 12;
+const HEADER_LEN: usize = 4 + PUBLIC_KEY_LEN + SALT_LEN + NONCE_LEN;
+const MAX_PLAINTEXT_BYTES: usize = 10 * 1024 * 1024;
+const HKDF_INFO: &[u8] = b"baaro.messaging.v3.x25519-aes256gcm";
+const AAD: &[u8] = b"baaro.messaging.envelope.v3";
+
+fn fixed_array<const N: usize>(bytes: &[u8], label: &str) -> Result<[u8; N], String> {
+    bytes
+        .try_into()
+        .map_err(|_| format!("{label} doit contenir exactement {N} octets."))
+}
+
+fn derive_aead_key(
+    shared_secret: &[u8; 32],
+    salt: &[u8; SALT_LEN],
+) -> Result<Zeroizing<[u8; 32]>, String> {
+    let hkdf = Hkdf::<Sha256>::new(Some(salt), shared_secret);
+    let mut key = Zeroizing::new([0u8; 32]);
+    hkdf.expand(HKDF_INFO, &mut key[..])
+        .map_err(|_| "Dérivation HKDF impossible.".to_owned())?;
+    Ok(key)
+}
+
+#[wasm_bindgen]
+pub fn generate_identity_keypair() -> Result<JsValue, JsValue> {
+    let secret = StaticSecret::random_from_rng(OsRng);
+    let public = PublicKey::from(&secret);
+    let result = Object::new();
+    Reflect::set(
+        &result,
+        &JsValue::from_str("publicKey"),
+        &Uint8Array::from(public.as_bytes().as_slice()),
+    )?;
+    Reflect::set(
+        &result,
+        &JsValue::from_str("privateKey"),
+        &Uint8Array::from(secret.as_bytes().as_slice()),
+    )?;
+    Ok(result.into())
+}
+
+/// Chiffre un message vers une identité X25519 avec une clé éphémère par message.
+/// L'enveloppe BAR3 contient magic(4)|ephemeral_public(32)|salt(32)|nonce(12)|ciphertext+tag.
+fn encrypt_message_v3_inner(plaintext: &[u8], recipient_public: &[u8]) -> Result<Vec<u8>, String> {
+    if plaintext.is_empty() || plaintext.len() > MAX_PLAINTEXT_BYTES {
+        return Err("Taille de message invalide.".to_owned());
+    }
+    let recipient_bytes = fixed_array::<PUBLIC_KEY_LEN>(recipient_public, "Clé publique")?;
+    let recipient = PublicKey::from(recipient_bytes);
+    let ephemeral_secret = StaticSecret::random_from_rng(OsRng);
+    let ephemeral_public = PublicKey::from(&ephemeral_secret);
+    let shared_secret = Zeroizing::new(ephemeral_secret.diffie_hellman(&recipient).to_bytes());
+    if bool::from(shared_secret.ct_eq(&[0u8; 32])) {
+        return Err("Échange X25519 invalide.".to_owned());
+    }
+
+    let mut salt = [0u8; SALT_LEN];
+    let mut nonce = [0u8; NONCE_LEN];
+    OsRng.fill_bytes(&mut salt);
+    OsRng.fill_bytes(&mut nonce);
+    let key_bytes = derive_aead_key(&shared_secret, &salt)?;
+
+    let cipher = Aes256Gcm::new_from_slice(&key_bytes[..])
+        .map_err(|_| "Initialisation AES-GCM impossible.".to_owned())?;
+    let ciphertext = cipher
+        .encrypt(
+            Nonce::from_slice(&nonce),
+            Payload {
+                msg: plaintext,
+                aad: AAD,
+            },
+        )
+        .map_err(|_| "Chiffrement AES-GCM impossible.".to_owned())?;
+    let mut envelope = Vec::with_capacity(HEADER_LEN + ciphertext.len());
+    envelope.extend_from_slice(ENVELOPE_MAGIC);
+    envelope.extend_from_slice(ephemeral_public.as_bytes());
+    envelope.extend_from_slice(&salt);
+    envelope.extend_from_slice(&nonce);
+    envelope.extend_from_slice(&ciphertext);
+    Ok(envelope)
+}
+
+#[wasm_bindgen]
+pub fn encrypt_message_v3(plaintext: &[u8], recipient_public: &[u8]) -> Result<Vec<u8>, JsValue> {
+    encrypt_message_v3_inner(plaintext, recipient_public)
+        .map_err(|message| JsValue::from_str(&message))
+}
+
+fn decrypt_message_v3_core(envelope: &[u8], recipient_private: &[u8]) -> Result<Vec<u8>, String> {
+    if envelope.len() < HEADER_LEN + 16 || envelope.len() > HEADER_LEN + MAX_PLAINTEXT_BYTES + 16 {
+        return Err("Enveloppe v3 de taille invalide.".to_owned());
+    }
+    if &envelope[..4] != ENVELOPE_MAGIC {
+        return Err("Version d'enveloppe non prise en charge.".to_owned());
+    }
+
+    let private_bytes = Zeroizing::new(fixed_array::<PRIVATE_KEY_LEN>(
+        recipient_private,
+        "Clé privée",
+    )?);
+    let ephemeral_public =
+        fixed_array::<PUBLIC_KEY_LEN>(&envelope[4..4 + PUBLIC_KEY_LEN], "Clé éphémère")?;
+    let salt_start = 4 + PUBLIC_KEY_LEN;
+    let salt = fixed_array::<SALT_LEN>(&envelope[salt_start..salt_start + SALT_LEN], "Sel")?;
+    let nonce_start = salt_start + SALT_LEN;
+    let nonce = fixed_array::<NONCE_LEN>(&envelope[nonce_start..nonce_start + NONCE_LEN], "Nonce")?;
+
+    let recipient_secret = StaticSecret::from(*private_bytes);
+    let shared_secret = Zeroizing::new(
+        recipient_secret
+            .diffie_hellman(&PublicKey::from(ephemeral_public))
+            .to_bytes(),
+    );
+    if bool::from(shared_secret.ct_eq(&[0u8; 32])) {
+        return Err("Échange X25519 invalide.".to_owned());
+    }
+    let key_bytes = derive_aead_key(&shared_secret, &salt)?;
+
+    let cipher = Aes256Gcm::new_from_slice(&key_bytes[..])
+        .map_err(|_| "Initialisation AES-GCM impossible.".to_owned())?;
+    let plaintext = cipher
+        .decrypt(
+            Nonce::from_slice(&nonce),
+            Payload {
+                msg: &envelope[nonce_start + NONCE_LEN..],
+                aad: AAD,
+            },
+        )
+        .map_err(|_| "Authentification ou déchiffrement impossible.".to_owned())?;
+    if plaintext.is_empty() {
+        return Err("Message vide non accepté.".to_owned());
+    }
+    Ok(plaintext)
+}
+
+fn decrypt_message_v3_inner(
+    envelope: &[u8],
+    recipient_private: Vec<u8>,
+) -> Result<Vec<u8>, String> {
+    let recipient_private = Zeroizing::new(recipient_private);
+    decrypt_message_v3_core(envelope, &recipient_private)
+}
+
+#[wasm_bindgen]
+pub fn decrypt_message_v3(envelope: &[u8], recipient_private: Vec<u8>) -> Result<Vec<u8>, JsValue> {
+    decrypt_message_v3_inner(envelope, recipient_private)
+        .map_err(|message| JsValue::from_str(&message))
+}
+
+fn compute_safety_number_inner(public_a: &[u8], public_b: &[u8]) -> Result<String, String> {
+    let a = fixed_array::<PUBLIC_KEY_LEN>(public_a, "Clé publique A")?;
+    let b = fixed_array::<PUBLIC_KEY_LEN>(public_b, "Clé publique B")?;
+    let (first, second) = if a <= b { (&a, &b) } else { (&b, &a) };
+    let mut hasher = Sha256::new();
+    hasher.update(b"baaro.safety-number.v3\0");
+    hasher.update(first);
+    hasher.update(second);
+    let digest = hasher.finalize();
+    let hex = digest[..20]
+        .iter()
+        .map(|byte| format!("{byte:02X}"))
+        .collect::<String>();
+    Ok(hex
+        .as_bytes()
+        .chunks(5)
+        .map(|part| std::str::from_utf8(part).unwrap_or(""))
+        .collect::<Vec<_>>()
+        .join(" "))
+}
+
+/// Empreinte courte, déterministe et indépendante de l'ordre des deux identités.
+#[wasm_bindgen]
+pub fn compute_safety_number(public_a: &[u8], public_b: &[u8]) -> Result<String, JsValue> {
+    compute_safety_number_inner(public_a, public_b).map_err(|message| JsValue::from_str(&message))
+}
+
+/// Comparaison à temps constant sur des buffers de même longueur.
+#[wasm_bindgen]
+pub fn constant_time_equal(a: &[u8], b: &[u8]) -> bool {
+    a.len() == b.len() && bool::from(a.ct_eq(b))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn v3_encrypts_and_decrypts_for_the_recipient() {
+        let secret = StaticSecret::random_from_rng(OsRng);
+        let public = PublicKey::from(&secret);
+        let plaintext = b"BAARO v3 test - UTF-8 handled as bytes";
+        let envelope = encrypt_message_v3_inner(plaintext, public.as_bytes()).expect("encrypt");
+        assert_eq!(&envelope[..4], ENVELOPE_MAGIC);
+        let private_key = secret.as_bytes().to_vec();
+        assert_eq!(
+            decrypt_message_v3_inner(&envelope, private_key.clone()).expect("decrypt"),
+            plaintext
+        );
+    }
+
+    #[test]
+    fn rejects_an_authenticated_empty_plaintext() {
+        let recipient_secret = StaticSecret::random_from_rng(OsRng);
+        let recipient_public = PublicKey::from(&recipient_secret);
+        let ephemeral_secret = StaticSecret::random_from_rng(OsRng);
+        let ephemeral_public = PublicKey::from(&ephemeral_secret);
+        let shared_secret = Zeroizing::new(
+            ephemeral_secret
+                .diffie_hellman(&recipient_public)
+                .to_bytes(),
+        );
+        let salt = [7u8; SALT_LEN];
+        let nonce = [8u8; NONCE_LEN];
+        let key = derive_aead_key(&shared_secret, &salt).expect("derive key");
+        let cipher = Aes256Gcm::new_from_slice(&key[..]).expect("cipher");
+        let ciphertext = cipher
+            .encrypt(Nonce::from_slice(&nonce), Payload { msg: &[], aad: AAD })
+            .expect("encrypt empty plaintext");
+
+        let mut envelope = Vec::new();
+        envelope.extend_from_slice(ENVELOPE_MAGIC);
+        envelope.extend_from_slice(ephemeral_public.as_bytes());
+        envelope.extend_from_slice(&salt);
+        envelope.extend_from_slice(&nonce);
+        envelope.extend_from_slice(&ciphertext);
+        let private_key = recipient_secret.as_bytes().to_vec();
+
+        assert!(decrypt_message_v3_inner(&envelope, private_key).is_err());
+    }
+
+    #[test]
+    fn v3_rejects_tampering_and_wrong_recipient() {
+        let secret = StaticSecret::random_from_rng(OsRng);
+        let public = PublicKey::from(&secret);
+        let wrong_secret = StaticSecret::random_from_rng(OsRng);
+        let mut envelope = encrypt_message_v3_inner(b"secret", public.as_bytes()).expect("encrypt");
+        let wrong_private_key = wrong_secret.as_bytes().to_vec();
+        assert!(decrypt_message_v3_inner(&envelope, wrong_private_key).is_err());
+        let last = envelope.len() - 1;
+        envelope[last] ^= 1;
+        let private_key = secret.as_bytes().to_vec();
+        assert!(decrypt_message_v3_inner(&envelope, private_key).is_err());
+    }
+
+    #[test]
+    fn safety_number_is_stable_and_symmetric() {
+        let a = StaticSecret::random_from_rng(OsRng);
+        let b = StaticSecret::random_from_rng(OsRng);
+        let a_public = PublicKey::from(&a);
+        let b_public = PublicKey::from(&b);
+        assert_eq!(
+            compute_safety_number_inner(a_public.as_bytes(), b_public.as_bytes()).unwrap(),
+            compute_safety_number_inner(b_public.as_bytes(), a_public.as_bytes()).unwrap()
+        );
+    }
+
+    #[test]
+    fn hkdf_sha256_matches_the_versioned_vector() {
+        let shared_secret = std::array::from_fn(|index| index as u8);
+        let salt = std::array::from_fn(|index| index as u8);
+        let expected = [
+            0x79, 0x3f, 0xca, 0x35, 0xbc, 0x9d, 0xe9, 0xde, 0xff, 0xd4, 0xf9, 0xaf, 0x7c, 0x26,
+            0xc9, 0x62, 0x5a, 0xc7, 0x25, 0x1d, 0x93, 0x33, 0xc3, 0xd9, 0xd3, 0x5a, 0x08, 0x7e,
+            0xe8, 0xd4, 0x2f, 0x11,
+        ];
+
+        assert_eq!(
+            &derive_aead_key(&shared_secret, &salt).expect("HKDF vector")[..],
+            &expected
+        );
+    }
+
+    #[test]
+    fn safety_number_matches_the_versioned_vector() {
+        let public_a: Vec<u8> = (1..=32).collect();
+        let public_b: Vec<u8> = (1..=32).rev().collect();
+
+        assert_eq!(
+            compute_safety_number_inner(&public_a, &public_b).unwrap(),
+            "62716 8A8EF C9D7C E7FEE 8A314 7D622 AFDD5 155BA"
+        );
+    }
+
+    #[test]
+    fn constant_time_comparison_checks_equal_lengths() {
+        assert!(constant_time_equal(b"abc", b"abc"));
+        assert!(!constant_time_equal(b"abc", b"abd"));
+        assert!(!constant_time_equal(b"abc", b"ab"));
+    }
+
+    #[test]
+    fn rejects_wrong_key_lengths_and_unknown_envelopes() {
+        assert!(encrypt_message_v3_inner(b"secret", b"short").is_err());
+        let invalid_key = vec![0u8; PRIVATE_KEY_LEN];
+        assert!(decrypt_message_v3_inner(b"not-an-envelope", invalid_key).is_err());
+
+        let mut unknown_version = vec![0u8; HEADER_LEN + 16];
+        assert!(decrypt_message_v3_core(&unknown_version, &[0u8; PRIVATE_KEY_LEN]).is_err());
+        unknown_version[0..4].copy_from_slice(ENVELOPE_MAGIC);
+        let invalid_private_key = vec![0u8; PRIVATE_KEY_LEN - 1];
+        assert!(decrypt_message_v3_inner(&unknown_version, invalid_private_key).is_err());
+
+        let oversized_plaintext = vec![0u8; MAX_PLAINTEXT_BYTES + 1];
+        assert!(encrypt_message_v3_inner(&oversized_plaintext, &[1u8; PUBLIC_KEY_LEN]).is_err());
+        assert!(!constant_time_equal(&[0u8; 32], &[0u8; 31]));
+    }
+}
diff --git a/tests/messaging/crypto-wasm-build.test.mjs b/tests/messaging/crypto-wasm-build.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..185ef6411dfb307f325ac9c7772e6ca06da239f4
--- /dev/null
+++ b/tests/messaging/crypto-wasm-build.test.mjs
@@ -0,0 +1,47 @@
+import assert from "node:assert/strict";
+import { chmodSync, mkdtempSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { spawnSync } from "node:child_process";
+import { fileURLToPath } from "node:url";
+import { after, describe, it } from "node:test";
+
+const repoRoot = resolve(fileURLToPath(new URL("../..", import.meta.url)));
+const buildScript = join(repoRoot, "scripts/build-messaging-crypto.mjs");
+const tempDir = mkdtempSync(join(tmpdir(), "baaro-wasm-build-test-"));
+const fakeWasmPack = join(tempDir, "wasm-pack-failing");
+writeFileSync(
+  fakeWasmPack,
+  "#!/bin/sh\nif [ \"$1\" = \"--version\" ]; then echo 'wasm-pack 0.15.1'; exit 0; fi\nexit 23\n"
+);
+chmodSync(fakeWasmPack, 0o755);
+after(() => rmSync(tempDir, { recursive: true, force: true }));
+
+function runBuilder(args = [], extraEnv = {}) {
+  return spawnSync(process.execPath, [buildScript, ...args], {
+    cwd: repoRoot,
+    encoding: "utf8",
+    env: {
+      ...process.env,
+      WASM_PACK: fakeWasmPack,
+      VERCEL: "",
+      ...extraEnv,
+    },
+  });
+}
+
+describe("messaging WASM build fallback", () => {
+  it("uses committed artifacts when a present wasm-pack cannot build in non-strict mode", () => {
+    const result = runBuilder();
+
+    assert.equal(result.status, 0, result.stderr);
+    assert.match(result.stderr, /artefacts versionnés utilisés/);
+  });
+
+  it("does not let Vercel bypass a strict source-to-artifact build", () => {
+    const result = runBuilder(["--strict"], { VERCEL: "1" });
+
+    assert.notEqual(result.status, 0);
+    assert.match(result.stderr, / build .* --target web/);
+  });
+});
diff --git a/tests/messaging/crypto-wasm-loader.test.mjs b/tests/messaging/crypto-wasm-loader.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a2e04a758f6d9792605de6d8fb058dafd07ef653
--- /dev/null
+++ b/tests/messaging/crypto-wasm-loader.test.mjs
@@ -0,0 +1,91 @@
+import assert from "node:assert/strict";
+import { describe, it } from "node:test";
+import {
+  createCryptoWasmApi,
+  createCryptoWasmLoader,
+  resolveCryptoWasmUrl,
+} from "../../src/features/messaging/lib/crypto-wasm.js";
+
+describe("messaging crypto WASM loader", () => {
+  it("resolves the public artifact from the emitted asset chunk and Vite dev root", () => {
+    assert.equal(
+      resolveCryptoWasmUrl({
+        isDev: false,
+        sourceUrl: "https://app.example/subpath/assets/messaging-abc123.js",
+      }),
+      "https://app.example/subpath/wasm/messaging_crypto.js"
+    );
+    assert.equal(
+      resolveCryptoWasmUrl({
+        isDev: true,
+        origin: "http://localhost:5173",
+      }),
+      "http://localhost:5173/wasm/messaging_crypto.js"
+    );
+  });
+
+  it("shares concurrent initialization and invokes wasm-bindgen init once", async () => {
+    let importCount = 0;
+    let initCount = 0;
+    const module = {
+      default: async () => {
+        initCount += 1;
+      },
+    };
+    const load = createCryptoWasmLoader(async () => {
+      importCount += 1;
+      await new Promise((resolve) => setTimeout(resolve, 5));
+      return module;
+    });
+
+    const first = load();
+    const second = load();
+    assert.strictEqual(first, second);
+    assert.strictEqual(await first, module);
+    assert.equal(importCount, 1);
+    assert.equal(initCount, 1);
+  });
+
+  it("clears a rejected import so a later attempt can recover", async () => {
+    let attempts = 0;
+    const module = { default: async () => {} };
+    const load = createCryptoWasmLoader(async () => {
+      attempts += 1;
+      if (attempts === 1) throw new Error("temporary load failure");
+      return module;
+    });
+
+    await assert.rejects(load(), /temporary load failure/);
+    assert.strictEqual(await load(), module);
+    assert.equal(attempts, 2);
+  });
+
+  it("routes the camelCase API to every versioned wasm-bindgen export", async () => {
+    const calls = [];
+    const module = {
+      generate_identity_keypair: () => (calls.push(["generate"]), "identity"),
+      encrypt_message_v3: (...args) => (calls.push(["encrypt", ...args]), "envelope"),
+      decrypt_message_v3: (...args) => (calls.push(["decrypt", ...args]), "plaintext"),
+      compute_safety_number: (...args) => (calls.push(["safety", ...args]), "fingerprint"),
+      constant_time_equal: (...args) => (calls.push(["equal", ...args]), true),
+    };
+    const api = createCryptoWasmApi(async () => module);
+    const plaintext = new Uint8Array([1, 2]);
+    const publicKey = new Uint8Array([3, 4]);
+    const envelope = new Uint8Array([5, 6]);
+    const privateKey = new Uint8Array([7, 8]);
+
+    assert.equal(await api.generateIdentityKeyPairV3(), "identity");
+    assert.equal(await api.encryptMessageV3(plaintext, publicKey), "envelope");
+    assert.equal(await api.decryptMessageV3(envelope, privateKey), "plaintext");
+    assert.equal(await api.computeSafetyNumberV3(publicKey, envelope), "fingerprint");
+    assert.equal(await api.constantTimeEqualV3(plaintext, plaintext), true);
+    assert.deepEqual(calls, [
+      ["generate"],
+      ["encrypt", plaintext, publicKey],
+      ["decrypt", envelope, privateKey],
+      ["safety", publicKey, envelope],
+      ["equal", plaintext, plaintext],
+    ]);
+  });
+});
diff --git a/tests/messaging/crypto-wasm.test.mjs b/tests/messaging/crypto-wasm.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..6e68810119232091cf31c56f1b55f7260ccb5a4e
--- /dev/null
+++ b/tests/messaging/crypto-wasm.test.mjs
@@ -0,0 +1,65 @@
+import assert from "node:assert/strict";
+import { readFileSync } from "node:fs";
+import { describe, it } from "node:test";
+import {
+  compute_safety_number,
+  constant_time_equal,
+  decrypt_message_v3,
+  encrypt_message_v3,
+  generate_identity_keypair,
+  initSync,
+} from "../../public/wasm/messaging_crypto.js";
+
+const wasmBytes = readFileSync(
+  new URL("../../public/wasm/messaging_crypto_bg.wasm", import.meta.url)
+);
+initSync({ module: wasmBytes });
+
+describe("messaging crypto v3 WASM foundation", () => {
+  it("generates X25519 identities and round-trips integrity-protected binary payloads", () => {
+    const recipient = generate_identity_keypair();
+    const privateKeySnapshot = recipient.privateKey.slice();
+    const plaintext = new TextEncoder().encode("Message v3 — UTF-8 ✓");
+    const envelope = encrypt_message_v3(plaintext, recipient.publicKey);
+
+    assert.equal(
+      new TextDecoder().decode(decrypt_message_v3(envelope, recipient.privateKey)),
+      "Message v3 — UTF-8 ✓"
+    );
+    assert.equal(
+      new TextDecoder().decode(decrypt_message_v3(envelope, recipient.privateKey)),
+      "Message v3 — UTF-8 ✓"
+    );
+    assert.deepEqual(recipient.privateKey, privateKeySnapshot);
+    assert.equal(new TextDecoder().decode(envelope.slice(0, 4)), "BAR3");
+  });
+
+  it("rejects an incorrect recipient and ciphertext tampering", () => {
+    const recipient = generate_identity_keypair();
+    const other = generate_identity_keypair();
+    const envelope = encrypt_message_v3(new TextEncoder().encode("private"), recipient.publicKey);
+
+    assert.throws(() => decrypt_message_v3(envelope, other.privateKey));
+    const tampered = envelope.slice();
+    tampered[tampered.length - 1] ^= 1;
+    assert.throws(() => decrypt_message_v3(tampered, recipient.privateKey));
+    assert.throws(() => encrypt_message_v3(new TextEncoder().encode("x"), new Uint8Array(3)));
+    assert.throws(() => encrypt_message_v3(new Uint8Array(0), recipient.publicKey));
+
+    for (const headerOffset of [4, 36, 68]) {
+      const headerTampered = envelope.slice();
+      headerTampered[headerOffset] ^= 1;
+      assert.throws(() => decrypt_message_v3(headerTampered, recipient.privateKey));
+    }
+  });
+
+  it("creates an order-independent safety number and compares equal-length inputs", () => {
+    const a = generate_identity_keypair();
+    const b = generate_identity_keypair();
+
+    assert.equal(compute_safety_number(a.publicKey, b.publicKey), compute_safety_number(b.publicKey, a.publicKey));
+    assert.equal(constant_time_equal(new Uint8Array([1, 2, 3]), new Uint8Array([1, 2, 3])), true);
+    assert.equal(constant_time_equal(new Uint8Array([1, 2, 3]), new Uint8Array([1, 2, 4])), false);
+    assert.equal(constant_time_equal(new Uint8Array([1, 2, 3]), new Uint8Array([1, 2])), false);
+  });
+});
diff --git a/tests/messaging/crypto.test.mjs b/tests/messaging/crypto.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..e11924c13da473e9862e9507c945a4370114796e
--- /dev/null
+++ b/tests/messaging/crypto.test.mjs
@@ -0,0 +1,131 @@
+import assert from "node:assert/strict";
+import { before, describe, it } from "node:test";
+import { webcrypto } from "node:crypto";
+import {
+  decryptMessage,
+  deserializePayload,
+  encryptMessage,
+  importPublicKey,
+  isEncryptedPayload,
+  serializePayload,
+} from "../../src/features/messaging/lib/crypto.js";
+
+if (!globalThis.crypto?.subtle) {
+  Object.defineProperty(globalThis, "crypto", { value: webcrypto });
+}
+
+const RSA = {
+  name: "RSA-OAEP",
+  modulusLength: 2048,
+  publicExponent: new Uint8Array([1, 0, 1]),
+  hash: "SHA-256",
+};
+
+const toBase64 = (bytes) => Buffer.from(bytes).toString("base64");
+let alice;
+let bob;
+
+before(async () => {
+  [alice, bob] = await Promise.all([
+    webcrypto.subtle.generateKey(RSA, true, ["encrypt", "decrypt"]),
+    webcrypto.subtle.generateKey(RSA, true, ["encrypt", "decrypt"]),
+  ]);
+});
+
+describe("messaging E2E crypto compatibility", () => {
+  it("encrypts v2 for multiple recipients and round-trips each recipient", async () => {
+    const alicePublicJwk = await webcrypto.subtle.exportKey("jwk", alice.publicKey);
+    const bobPublicJwk = await webcrypto.subtle.exportKey("jwk", bob.publicKey);
+    const message = "Compatibilité E2E ✓ — caractères UTF-8";
+
+    const payload = await encryptMessage(message, [
+      { user_id: "alice", publicKeyJwk: alicePublicJwk },
+      { user_id: "bob", publicKeyJwk: bobPublicJwk },
+    ]);
+
+    assert.equal(payload.v, 2);
+    assert.equal(payload.alg, "RSA-OAEP+AES-GCM");
+    assert.deepEqual(Object.keys(payload.keys).sort(), ["alice", "bob"]);
+    assert.equal(await decryptMessage(payload, alice.privateKey, "alice"), message);
+    assert.equal(await decryptMessage(payload, bob.privateKey, "bob"), message);
+    assert.equal(await decryptMessage(payload, alice.privateKey, "bob"), null);
+  });
+
+  it("preserves legacy v1 single-recipient payload decryption", async () => {
+    const iv = webcrypto.getRandomValues(new Uint8Array(12));
+    const aesKey = await webcrypto.subtle.generateKey(
+      { name: "AES-GCM", length: 256 },
+      true,
+      ["encrypt", "decrypt"]
+    );
+    const rawAesKey = await webcrypto.subtle.exportKey("raw", aesKey);
+    const plaintext = new TextEncoder().encode("ancien message v1");
+    const ciphertext = await webcrypto.subtle.encrypt(
+      { name: "AES-GCM", iv, tagLength: 128 },
+      aesKey,
+      plaintext
+    );
+    const wrappedKey = await webcrypto.subtle.encrypt(
+      { name: "RSA-OAEP" },
+      alice.publicKey,
+      rawAesKey
+    );
+    const payload = {
+      v: 1,
+      alg: "RSA-OAEP+AES-GCM",
+      ek: toBase64(new Uint8Array(wrappedKey)),
+      iv: toBase64(iv),
+      ct: toBase64(new Uint8Array(ciphertext)),
+    };
+
+    assert.equal(await decryptMessage(payload, alice.privateKey), "ancien message v1");
+    assert.equal(await decryptMessage(payload, bob.privateKey), null);
+  });
+
+  it("serializes and deserializes v1/v2 without changing their envelope", async () => {
+    const alicePublicJwk = await webcrypto.subtle.exportKey("jwk", alice.publicKey);
+    const payload = await encryptMessage("round-trip", [
+      { user_id: "alice", publicKeyJwk: alicePublicJwk },
+    ]);
+    const serialized = serializePayload(payload);
+    const restored = deserializePayload(serialized);
+
+    assert.equal(JSON.stringify(restored), serialized);
+    assert.equal(isEncryptedPayload(serialized), true);
+    assert.equal(isEncryptedPayload("not-json"), false);
+    assert.equal(deserializePayload("{}"), null);
+  });
+
+  it("rejects malformed and unsupported payloads safely", async () => {
+    const malformed = [
+      null,
+      {},
+      { v: 3, alg: "RSA-OAEP+AES-GCM", iv: "AA==", ct: "AA==" },
+      { v: 1, alg: "RSA-OAEP+AES-GCM", iv: "AA==", ct: "AA==" },
+      { v: 2, alg: "RSA-OAEP+AES-GCM", keys: [], iv: "AA==", ct: "AA==" },
+    ];
+
+    for (const payload of malformed) {
+      assert.equal(await decryptMessage(payload, alice.privateKey, "alice"), null);
+    }
+
+    assert.throws(() => serializePayload({ v: 3, alg: "future" }));
+    assert.equal(deserializePayload('{"v":2,"alg":"RSA-OAEP+AES-GCM","keys":{},"iv":4,"ct":4}'), null);
+  });
+
+  it("fails closed when there is no valid recipient", async () => {
+    await assert.rejects(() => encryptMessage("secret", []), /destinataire/i);
+    await assert.rejects(
+      () => encryptMessage("secret", [{ user_id: "missing", publicKeyJwk: null }]),
+      /clé publique valide/i
+    );
+  });
+
+  it("still validates and imports RSA public JWKs used by existing profiles", async () => {
+    const jwk = await webcrypto.subtle.exportKey("jwk", alice.publicKey);
+    const imported = await importPublicKey(jwk);
+    assert.equal(imported.type, "public");
+    assert.equal(imported.algorithm.name, "RSA-OAEP");
+    await assert.rejects(() => importPublicKey({ kty: "OKP", crv: "X25519" }));
+  });
+});
