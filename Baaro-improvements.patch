diff --git a/scripts/build-messaging-crypto.mjs b/scripts/build-messaging-crypto.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..a38ac10a8731006773778d14f76f8bcdc1713a34
--- /dev/null
+++ b/scripts/build-messaging-crypto.mjs
@@ -0,0 +1,64 @@
+import { existsSync } from 'node:fs';
+import { mkdir, copyFile } from 'node:fs/promises';
+import { spawnSync } from 'node:child_process';
+import { dirname, join, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+
+const root = resolve(fileURLToPath(new URL('..', import.meta.url)));
+const crate = join(root, 'src/features/messaging/native');
+const pkg = join(crate, 'pkg');
+const out = join(root, 'public/wasm');
+const generatedJs = join(pkg, 'messaging_crypto.js');
+const generatedWasm = join(pkg, 'messaging_crypto_bg.wasm');
+const artifacts = [join(out, 'messaging_crypto.js'), join(out, 'messaging_crypto_bg.wasm')];
+const strict = process.argv.includes('--strict');
+const wasmPack = process.env.WASM_PACK || 'wasm-pack';
+
+function run(bin, args) {
+  const result = spawnSync(bin, args, { cwd: root, stdio: 'inherit' });
+  if (result.error || result.status !== 0) {
+    throw new Error(`${bin} ${args.join(' ')} a échoué (status ${result.status ?? 'indisponible'}).`);
+  }
+}
+
+const onVercel = Boolean(process.env.VERCEL);
+if (onVercel && !strict && artifacts.every(existsSync)) {
+  console.log('Vercel : artefacts messaging WASM versionnés, compilation ignorée.');
+  process.exit(0);
+}
+
+const available = spawnSync(wasmPack, ['--version'], { cwd: root, stdio: 'ignore' });
+if (available.error || available.status !== 0) {
+  if (!strict && artifacts.every(existsSync)) {
+    console.warn('wasm-pack absent : utilisation des artefacts messaging WASM versionnés.');
+    process.exit(0);
+  }
+  throw new Error('wasm-pack est requis. Installe-le ou utilise --strict pour rendre ce prérequis explicite.');
+}
+
+await mkdir(dirname(generatedJs), { recursive: true });
+await mkdir(out, { recursive: true });
+try {
+  run(wasmPack, [
+    'build', crate,
+    '--target', 'web',
+    '--release',
+    '--out-dir', pkg,
+    '--out-name', 'messaging_crypto',
+  ]);
+} catch (error) {
+  if (!strict && artifacts.every(existsSync)) {
+    console.warn(`Build WASM impossible (${error.message}); artefacts versionnés utilisés.`);
+    process.exit(0);
+  }
+  throw error;
+}
+
+if (!existsSync(generatedJs) || !existsSync(generatedWasm)) {
+  throw new Error('wasm-pack n’a pas produit les deux artefacts messaging attendus.');
+}
+await Promise.all([
+  copyFile(generatedJs, artifacts[0]),
+  copyFile(generatedWasm, artifacts[1]),
+]);
+console.log('Messaging WASM prêt : public/wasm/messaging_crypto.js + messaging_crypto_bg.wasm');
diff --git a/src/features/messaging/lib/crypto-wasm.js b/src/features/messaging/lib/crypto-wasm.js
new file mode 100644
index 0000000000000000000000000000000000000000..fe36e36526922add5eaa6d16294272f90a84d7a1
--- /dev/null
+++ b/src/features/messaging/lib/crypto-wasm.js
@@ -0,0 +1,87 @@
+export function resolveCryptoWasmUrl({
+  isDev = Boolean(import.meta.env?.DEV),
+  sourceUrl = import.meta.url,
+  origin = globalThis.location?.origin,
+} = {}) {
+  if (isDev) {
+    if (!origin) throw new Error("Origine de l'application indisponible pour le chargement WASM.");
+    return new URL("/wasm/messaging_crypto.js", `${new URL(origin).origin}/`).href;
+  }
+
+  // En production, crypto-wasm.js est empaqueté dans dist/assets/ tandis que
+  // public/wasm est copié dans dist/wasm. Le lien depuis import.meta.url
+  // reste valable avec base='./', Capacitor et les routes SPA profondes.
+  return new URL("../wasm/messaging_crypto.js", sourceUrl).href;
+}
+
+export function createCryptoWasmLoader(importer) {
+  let wasmPromise;
+
+  function load() {
+    if (wasmPromise) return wasmPromise;
+
+    const currentPromise = Promise.resolve()
+      .then(importer)
+      .then(async (wasm) => {
+        await wasm.default();
+        return wasm;
+      })
+      .catch((error) => {
+        if (wasmPromise === currentPromise) wasmPromise = undefined;
+        throw new Error(`Module BAARO messaging WASM indisponible : ${error?.message || error}`);
+      });
+
+    wasmPromise = currentPromise;
+    return currentPromise;
+  }
+
+  load.reset = () => {
+    wasmPromise = undefined;
+  };
+
+  return load;
+}
+
+const loadWasmModule = createCryptoWasmLoader(() =>
+  import(/* @vite-ignore */ resolveCryptoWasmUrl())
+);
+
+/**
+ * Charge le module v3 généré par wasm-pack.
+ * Ce module n'est pas utilisé par crypto.js : les clés de compte et les
+ * payloads RSA v1/v2 restent gérés par Web Crypto jusqu'à une migration conçue.
+ */
+export function initCryptoWasm() {
+  return loadWasmModule();
+}
+
+export function createCryptoWasmApi(init = initCryptoWasm) {
+  return {
+    async generateIdentityKeyPairV3() {
+      return (await init()).generate_identity_keypair();
+    },
+    async encryptMessageV3(plaintextBytes, recipientPublicKey) {
+      return (await init()).encrypt_message_v3(plaintextBytes, recipientPublicKey);
+    },
+    async decryptMessageV3(envelope, recipientPrivateKey) {
+      return (await init()).decrypt_message_v3(envelope, recipientPrivateKey);
+    },
+    async computeSafetyNumberV3(publicKeyA, publicKeyB) {
+      return (await init()).compute_safety_number(publicKeyA, publicKeyB);
+    },
+    async constantTimeEqualV3(a, b) {
+      return (await init()).constant_time_equal(a, b);
+    },
+  };
+}
+
+const api = createCryptoWasmApi();
+export const generateIdentityKeyPairV3 = (...args) => api.generateIdentityKeyPairV3(...args);
+export const encryptMessageV3 = (...args) => api.encryptMessageV3(...args);
+export const decryptMessageV3 = (...args) => api.decryptMessageV3(...args);
+export const computeSafetyNumberV3 = (...args) => api.computeSafetyNumberV3(...args);
+export const constantTimeEqualV3 = (...args) => api.constantTimeEqualV3(...args);
+
+export function resetCryptoWasmForTests() {
+  loadWasmModule.reset();
+}
