diff --git a/worker/lib/jobValidation.mjs b/worker/lib/jobValidation.mjs
new file mode 100644
index 0000000..ebe27b8
--- /dev/null
+++ b/worker/lib/jobValidation.mjs
@@ -0,0 +1,191 @@
+const JOB_TYPES = new Set([
+  "transcode",
+  "thumbnail",
+  "captions",
+  "translate",
+  "dub",
+  "moderate",
+  "features",
+  "highlights",
+  "edit_plan",
+]);
+
+const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
+const MAX_JOB_BYTES = 128 * 1024;
+const MAX_TEXT_LENGTH = 30_000;
+
+function isRecord(value) {
+  return value !== null && typeof value === "object" && !Array.isArray(value);
+}
+
+function invalid(message) {
+  const error = new Error(message);
+  error.status = 400;
+  throw error;
+}
+
+function validateOptionalUuid(value, field) {
+  if (value === undefined || value === null || value === "") return undefined;
+  if (typeof value !== "string" || !UUID_RE.test(value)) {
+    invalid(`${field} doit être un UUID valide`);
+  }
+  return value;
+}
+
+function validateText(payload, field, maxLength, { required = false } = {}) {
+  const value = payload[field];
+  if (value === undefined || value === null) {
+    if (required) invalid(`payload.${field} est requis`);
+    return undefined;
+  }
+  if (typeof value !== "string" || value.length > maxLength) {
+    invalid(`payload.${field} doit être un texte de ${maxLength} caractères maximum`);
+  }
+  if (required && !value.trim()) invalid(`payload.${field} ne peut pas être vide`);
+  return value;
+}
+
+function safeR2Key(value, field) {
+  if (typeof value !== "string" || !value.trim() || value.length > 1024) {
+    invalid(`${field} doit être une clé R2 valide`);
+  }
+  if (
+    value.startsWith("/") ||
+    value.includes("\\") ||
+    /[\u0000-\u001f\u007f]/.test(value) ||
+    value.split("/").some((part) => part === "." || part === "..") ||
+    /^[a-z][a-z0-9+.-]*:\/\//i.test(value)
+  ) {
+    invalid(`${field} contient un chemin interdit`);
+  }
+  return value;
+}
+
+function safeOutputPrefix(value, ownerId) {
+  if (typeof value !== "string" || value.length > 512) {
+    invalid("payload.outputPrefix doit être un préfixe valide");
+  }
+  const ownerPrefix = `processed/${ownerId}/`;
+  if (!value.startsWith(ownerPrefix)) {
+    invalid("payload.outputPrefix doit rester dans le dossier processed de son propriétaire");
+  }
+  const parts = value.slice(ownerPrefix.length).split("/");
+  if (
+    !parts.length ||
+    parts.some((part) => !part || part === "." || part === "..") ||
+    value.includes("\\") ||
+    /[\u0000-\u001f\u007f]/.test(value)
+  ) {
+    invalid("payload.outputPrefix contient un chemin interdit");
+  }
+  return value;
+}
+
+function validateLanguage(payload, field) {
+  const value = validateText(payload, field, 80);
+  if (value !== undefined && (!value.trim() || /[\u0000-\u001f\u007f]/.test(value))) {
+    invalid(`payload.${field} n’est pas valide`);
+  }
+  return value;
+}
+
+/** Retourne une copie réduite au schéma consommé par le processeur. */
+export function validateWorkerJob(input) {
+  if (!isRecord(input)) invalid("Job invalide : objet attendu");
+  if (Buffer.byteLength(JSON.stringify(input), "utf8") > MAX_JOB_BYTES) {
+    invalid("Job trop volumineux");
+  }
+
+  if (typeof input.id !== "string" || !UUID_RE.test(input.id)) {
+    invalid("job.id doit être un UUID valide");
+  }
+  if (typeof input.owner_id !== "string" || !UUID_RE.test(input.owner_id)) {
+    invalid("job.owner_id doit être un UUID valide");
+  }
+  if (typeof input.job_type !== "string" || !JOB_TYPES.has(input.job_type)) {
+    invalid("Type de job non supporté");
+  }
+
+  const videoId = validateOptionalUuid(input.video_id, "job.video_id");
+  const assetId = validateOptionalUuid(input.asset_id, "job.asset_id");
+  const payload = input.payload === undefined || input.payload === null ? {} : input.payload;
+  if (!isRecord(payload)) invalid("job.payload doit être un objet JSON");
+
+  const sourceFields = ["sourceKey", "key", "r2Key"].filter(
+    (field) => payload[field] !== undefined && payload[field] !== null && payload[field] !== "",
+  );
+  if (sourceFields.length > 1) {
+    invalid("Fournir une seule clé source parmi sourceKey, key ou r2Key");
+  }
+  const sourceKey = sourceFields.length
+    ? safeR2Key(payload[sourceFields[0]], `payload.${sourceFields[0]}`)
+    : undefined;
+
+  const normalizedPayload = {};
+  if (sourceKey) normalizedPayload.sourceKey = sourceKey;
+
+  if (payload.outputPrefix !== undefined && payload.outputPrefix !== null) {
+    normalizedPayload.outputPrefix = safeOutputPrefix(payload.outputPrefix, input.owner_id);
+  }
+
+  const profile = validateText(payload, "profile", 16);
+  if (profile !== undefined) {
+    if (!new Set(["mobile", "hd", "source"]).has(profile)) {
+      invalid("payload.profile doit être mobile, hd ou source");
+    }
+    normalizedPayload.profile = profile;
+  }
+
+  if (payload.at !== undefined && payload.at !== null) {
+    if (typeof payload.at !== "number" || !Number.isFinite(payload.at) || payload.at < 0 || payload.at > 86_400) {
+      invalid("payload.at doit être un nombre entre 0 et 86400");
+    }
+    normalizedPayload.at = payload.at;
+  }
+
+  const stringFields = [
+    ["language", 80],
+    ["sourceLanguage", 80],
+    ["targetLanguage", 80],
+    ["whisperModel", 64],
+    ["moderationProvider", 120],
+    ["voice", 120],
+    ["text", MAX_TEXT_LENGTH],
+    ["prompt", MAX_TEXT_LENGTH],
+    ["transcript", MAX_TEXT_LENGTH],
+  ];
+  for (const [field, maxLength] of stringFields) {
+    const value = validateText(payload, field, maxLength);
+    if (value !== undefined) normalizedPayload[field] = value;
+  }
+  for (const field of ["language", "sourceLanguage", "targetLanguage"]) {
+    validateLanguage(normalizedPayload, field);
+  }
+  if (normalizedPayload.whisperModel !== undefined && !/^[a-zA-Z0-9._-]+$/.test(normalizedPayload.whisperModel)) {
+    invalid("payload.whisperModel contient des caractères interdits");
+  }
+  for (const field of ["moderationProvider", "voice"]) {
+    const value = normalizedPayload[field];
+    if (value !== undefined && (!value.trim() || /[\u0000-\u001f\u007f]/.test(value))) {
+      invalid(`payload.${field} n’est pas valide`);
+    }
+  }
+
+  const needsSource = !["edit_plan", "translate"].includes(input.job_type) || Boolean(sourceKey);
+  if (needsSource && !sourceKey) invalid("payload.sourceKey est requis pour ce type de job");
+  if (input.job_type === "translate" && !sourceKey && !normalizedPayload.text?.trim()) {
+    invalid("Le job translate doit fournir payload.sourceKey ou payload.text");
+  }
+  if (input.job_type === "dub" && !normalizedPayload.text?.trim()) {
+    invalid("payload.text est requis pour le job dub");
+  }
+
+  return {
+    id: input.id,
+    owner_id: input.owner_id,
+    job_type: input.job_type,
+    ...(videoId ? { video_id: videoId } : {}),
+    ...(assetId ? { asset_id: assetId } : {}),
+    payload: normalizedPayload,
+  };
+}
