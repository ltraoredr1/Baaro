diff --git a/worker/test/security.test.mjs b/worker/test/security.test.mjs
new file mode 100644
index 0000000..4e76031
--- /dev/null
+++ b/worker/test/security.test.mjs
@@ -0,0 +1,135 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+import {
+  createWorkerServer,
+  startWorker,
+  workerSecretMatches,
+} from "../server.mjs";
+import { validateWorkerJob } from "../lib/jobValidation.mjs";
+
+const JOB_ID = "11111111-1111-4111-8111-111111111111";
+const OWNER_ID = "22222222-2222-4222-8222-222222222222";
+const VIDEO_ID = "33333333-3333-4333-8333-333333333333";
+const SECRET = "test-worker-secret-value";
+
+async function withServer(server, callback) {
+  await new Promise((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(0, "127.0.0.1", resolve);
+  });
+  const { port } = server.address();
+  try {
+    await callback(`http://127.0.0.1:${port}`);
+  } finally {
+    await new Promise((resolve, reject) => server.close((error) => error ? reject(error) : resolve()));
+  }
+}
+
+async function sendJob(baseUrl, { secret, job = {} } = {}) {
+  return fetch(`${baseUrl}/process`, {
+    method: "POST",
+    headers: {
+      "content-type": "application/json",
+      ...(secret ? { "x-baaro-worker-secret": secret } : {}),
+    },
+    body: JSON.stringify({ job }),
+  });
+}
+
+test("production refuse de démarrer sans BAARO_WORKER_SECRET", () => {
+  assert.throws(
+    () => startWorker({ secret: "  ", port: 0, production: true }),
+    /BAARO_WORKER_SECRET est obligatoire en production/,
+  );
+});
+
+test("le secret est comparé exactement et les valeurs absentes échouent", () => {
+  assert.equal(workerSecretMatches(SECRET, SECRET), true);
+  assert.equal(workerSecretMatches(`${SECRET}x`, SECRET), false);
+  assert.equal(workerSecretMatches(undefined, SECRET), false);
+  assert.equal(workerSecretMatches(SECRET, ""), false);
+});
+
+test("un /process sans secret configuré répond 503 et n’appelle jamais le processeur", async () => {
+  let calls = 0;
+  const server = createWorkerServer({ secret: "", jobProcessor: async () => { calls += 1; } });
+  await withServer(server, async (baseUrl) => {
+    const response = await sendJob(baseUrl, { job: { id: JOB_ID } });
+    assert.equal(response.status, 503);
+    assert.equal(calls, 0);
+  });
+});
+
+test("chaque requête /process requiert le secret configuré", async () => {
+  let calls = 0;
+  const server = createWorkerServer({ secret: SECRET, jobProcessor: async () => { calls += 1; } });
+  await withServer(server, async (baseUrl) => {
+    for (const suppliedSecret of [undefined, "wrong-secret"]) {
+      const response = await sendJob(baseUrl, { secret: suppliedSecret, job: { id: JOB_ID } });
+      assert.equal(response.status, 401);
+    }
+    assert.equal(calls, 0);
+  });
+});
+
+test("un job valide est normalisé avant son passage au processeur", async () => {
+  let receivedJob;
+  const server = createWorkerServer({
+    secret: SECRET,
+    jobProcessor: async (job) => {
+      receivedJob = job;
+      return { accepted: true };
+    },
+  });
+  await withServer(server, async (baseUrl) => {
+    const response = await sendJob(baseUrl, {
+      secret: SECRET,
+      job: {
+        id: JOB_ID,
+        owner_id: OWNER_ID,
+        video_id: VIDEO_ID,
+        job_type: "translate",
+        payload: { text: "Bonjour", targetLanguage: "en" },
+        untrusted_extra: "must not reach processor",
+      },
+    });
+    assert.equal(response.status, 200);
+    assert.deepEqual(receivedJob, {
+      id: JOB_ID,
+      owner_id: OWNER_ID,
+      job_type: "translate",
+      video_id: VIDEO_ID,
+      payload: { text: "Bonjour", targetLanguage: "en" },
+    });
+  });
+});
+
+test("un type de job, UUID ou chemin source invalide est rejeté avant traitement", () => {
+  const base = {
+    id: JOB_ID,
+    owner_id: OWNER_ID,
+    job_type: "transcode",
+    payload: { sourceKey: "uploads/video.mp4" },
+  };
+  assert.throws(() => validateWorkerJob({ ...base, job_type: "shell" }), /Type de job non supporté/);
+  assert.throws(() => validateWorkerJob({ ...base, id: "../other" }), /job.id doit être un UUID valide/);
+  assert.throws(() => validateWorkerJob({ ...base, payload: { sourceKey: "uploads/../secret.mp4" } }), /chemin interdit/);
+  assert.throws(() => validateWorkerJob({ ...base, payload: { sourceKey: "uploads/video.mp4", profile: "ultra" } }), /profile/);
+});
+
+test("les préfixes de sortie sont limités à l’espace processed du propriétaire", () => {
+  const base = {
+    id: JOB_ID,
+    owner_id: OWNER_ID,
+    job_type: "transcode",
+    payload: { sourceKey: "uploads/video.mp4" },
+  };
+  assert.throws(
+    () => validateWorkerJob({ ...base, payload: { ...base.payload, outputPrefix: "processed/other-user/video" } }),
+    /dossier processed de son propriétaire/,
+  );
+  assert.throws(
+    () => validateWorkerJob({ ...base, payload: { ...base.payload, outputPrefix: `processed/${OWNER_ID}/../other` } }),
+    /chemin interdit/,
+  );
+});
