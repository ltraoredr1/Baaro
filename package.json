{
  "name": "baaro",
  "private": true,
  "version": "0.2.3",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "predev": "node scripts/build-stories-wasm.mjs && node scripts/build-offline-wasm.mjs && node scripts/build-messaging-crypto.mjs && node scripts/copy-ort-wasm.mjs && node scripts/copy-mediapipe-wasm.mjs",
    "dev": "vite",
    "prebuild": "(rustup target add wasm32-unknown-unknown 2>/dev/null || true) && node scripts/build-stories-wasm.mjs && node scripts/build-offline-wasm.mjs && node scripts/build-messaging-crypto.mjs && node scripts/copy-ort-wasm.mjs && node scripts/copy-mediapipe-wasm.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check:production": "node scripts/check-production.mjs",
    "audit:security": "node scripts/security-audit-scan.mjs",
    "check:lock": "node scripts/check-lock.mjs",
    "check:e2e": "node scripts/check-e2e-readiness.mjs",
    "check:e2e:smoke": "node scripts/check-e2e-smoke.mjs",
    "check:payout": "node scripts/check-payout.mjs",
    "check:ai": "node scripts/check-ai-config.mjs",
    "check:notifications": "node scripts/check-notifications.mjs",
    "check:performance": "node scripts/check-performance.mjs",
    "check:android": "node scripts/check-android.mjs",
    "check:economy": "node scripts/check-economy.mjs",
    "check:future-core": "node scripts/check-future-core.mjs",
    "check:monetization": "node scripts/check-monetization.mjs",
    "check:payment-wiring": "node scripts/check-payment-wiring.mjs",
    "check:real-money": "node scripts/check-real-money.mjs",
    "check:real-money-flow": "node scripts/check-real-money-flow.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:upstash": "node scripts/check-upstash-production.mjs",
    "cleanup:identity": "node scripts/cleanup-identity-dead-code.mjs",
    "validate:upgrade": "node scripts/validate_upgrade.mjs",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "ci": "npm run check:lock && npm run check:production && npm run audit:security && npm run check:secrets && npm run check:upstash && npm run check:e2e && npm run check:e2e:smoke && npm run test:messaging-crypto && npm run check:messaging-rust && npm run test:stories && npm run check:payout && npm run check:performance && npm run check:android && npm run test:offline && npm run build",
    "test:chat-translate": "node scripts/test-chat-autotranslate.mjs",
    "test:messaging-crypto": "node --test tests/messaging/*.test.mjs",
    "test:messaging-rust": "cargo test --locked --manifest-path src/features/messaging/native/Cargo.toml",
    "check:messaging-rust": "cargo fmt --manifest-path src/features/messaging/native/Cargo.toml -- --check && cargo test --locked --manifest-path src/features/messaging/native/Cargo.toml && cargo clippy --locked --manifest-path src/features/messaging/native/Cargo.toml -- -D warnings && cargo check --locked --manifest-path src/features/messaging/native/Cargo.toml --target wasm32-unknown-unknown",
    "build:messaging-crypto": "node scripts/build-messaging-crypto.mjs",
    "pretest:offline": "node scripts/build-offline-wasm.mjs --strict",
    "test:offline": "node scripts/test-offline-core-rust.mjs && node scripts/test-offline-wasm.mjs && npm run test:offline-cache",
    "test:offline-cache": "node --test tests/offline/*.test.mjs",
    "pretest:stories": "node scripts/build-stories-wasm.mjs --strict",
    "test:stories": "node --test tests/stories/*.test.mjs && node scripts/test-story-policy-rust.mjs && node scripts/test-stories-wasm.mjs"
  },
  "dependencies": {
    "@aparajita/capacitor-biometric-auth": "^7.0.1",
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0",
    "@capacitor-community/contacts": "^7.0.1",
    "@capacitor-community/privacy-screen": "^6.1.0",
    "@capacitor-community/speech-recognition": "^7.0.0",
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor-trancee/nearby-connections": "^0.2.6",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/push-notifications": "^8.1.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "@daily-co/daily-js": "^0.70.0",
    "@google/genai": "^2.30.0",
    "@huggingface/transformers": "^4.3.2",
    "@mediapipe/tasks-vision": "^0.10.14",
    "@reduxjs/toolkit": "^2.2.7",
    "@supabase/supabase-js": "^2.45.0",
    "i18next": "^23.15.1",
    "i18next-browser-languagedetector": "^8.0.2",
    "jszip": "^3.10.2",
    "libphonenumber-js": "^1.11.14",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-phone-number-input": "^3.4.8",
    "react-redux": "^9.1.2",
    "react-router-dom": "^7.18.5",
    "stripe": "^17.5.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "^4.1.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "globals": "^15.15.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^0.21.1"
  },
  "overrides": {
    "deepmerge": "^4.3.1",
    "glob": "^14.0.3",
    "minimatch": "^11.0.3"
  },
  "allowScripts": {
    "onnxruntime-node@1.30.0": true,
    "protobufjs@7.6.6": true,
    "@google/genai@2.32.0": true
  }
}
