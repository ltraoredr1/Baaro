+package com.baaro.app;
+
+import android.content.Context;
+
+import com.google.android.gms.cast.CastMediaControlIntent;
+import com.google.android.gms.cast.framework.CastOptions;
+import com.google.android.gms.cast.framework.OptionsProvider;
+import com.google.android.gms.cast.framework.SessionProvider;
+
+import java.util.List;
+
+/** Google Cast options for BAARO's standard video playback receiver. */
+public final class BaaroCastOptionsProvider implements OptionsProvider {
+    @Override
+    public CastOptions getCastOptions(Context context) {
+        return new CastOptions.Builder()
+            .setReceiverApplicationId(CastMediaControlIntent.DEFAULT_MEDIA_RECEIVER_APPLICATION_ID)
+            .build();
+    }
+
+    @Override
+    public List<SessionProvider> getAdditionalSessionProviders(Context context) {
+        return null;
+    }
+}
diff --git a/android/app/src/main/java/com/baaro/app/BaaroCastPlugin.java b/android/app/src/main/java/com/baaro/app/BaaroCastPlugin.java
new file mode 100644
index 0000000..080e8ea
--- /dev/null
+++ b/android/app/src/main/java/com/baaro/app/BaaroCastPlugin.java
@@ -0,0 +1,314 @@
+package com.baaro.app;
+
+import android.app.Activity;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+
+import androidx.fragment.app.FragmentActivity;
+import androidx.fragment.app.FragmentManager;
+import androidx.mediarouter.app.MediaRouteChooserDialogFragment;
+
+import com.getcapacitor.JSObject;
+import com.getcapacitor.Plugin;
+import com.getcapacitor.PluginCall;
+import com.getcapacitor.PluginMethod;
+import com.getcapacitor.annotation.CapacitorPlugin;
+import com.google.android.gms.cast.CastDevice;
+import com.google.android.gms.cast.MediaInfo;
+import com.google.android.gms.cast.MediaLoadRequestData;
+import com.google.android.gms.cast.MediaMetadata;
+import com.google.android.gms.cast.framework.CastContext;
+import com.google.android.gms.cast.framework.CastSession;
+import com.google.android.gms.cast.framework.SessionManagerListener;
+import com.google.android.gms.cast.framework.media.RemoteMediaClient;
+import com.google.android.gms.common.api.ResultCallback;
+import com.google.android.gms.common.api.Status;
+
+/** Native Google Cast sender bridge for the BAARO video feed. */
+@CapacitorPlugin(name = "BaaroCast")
+public final class BaaroCastPlugin extends Plugin {
+    private static final String DIALOG_TAG = "baaro-cast-chooser";
+    private static final long PENDING_MEDIA_TTL_MS = 90_000;
+
+    private CastContext castContext;
+    private boolean listenerRegistered = false;
+    private JSObject pendingMedia;
+    private String currentMediaId;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final Runnable expirePendingMedia = () -> pendingMedia = null;
+
+    private final SessionManagerListener<CastSession> sessionListener =
+        new SessionManagerListener<CastSession>() {
+            @Override public void onSessionStarting(CastSession session) {}
+
+            @Override
+            public void onSessionStarted(CastSession session, String sessionId) {
+                loadPendingMedia(session);
+                emitState();
+            }
+
+            @Override
+            public void onSessionStartFailed(CastSession session, int error) {
+                pendingMedia = null;
+                handler.removeCallbacks(expirePendingMedia);
+                emitError("Impossible de démarrer la diffusion Chromecast.");
+                emitState();
+            }
+
+            @Override public void onSessionEnding(CastSession session) {}
+
+            @Override
+            public void onSessionEnded(CastSession session, int error) {
+                currentMediaId = null;
+                emitState();
+            }
+
+            @Override public void onSessionResuming(CastSession session, String sessionId) {}
+
+            @Override
+            public void onSessionResumed(CastSession session, boolean wasSuspended) {
+                loadPendingMedia(session);
+                emitState();
+            }
+
+            @Override
+            public void onSessionResumeFailed(CastSession session, int error) {
+                emitError("La connexion Chromecast n’a pas pu être reprise.");
+                emitState();
+            }
+
+            @Override public void onSessionSuspended(CastSession session, int reason) {
+                emitState();
+            }
+        };
+
+    @Override
+    public void load() {
+        super.load();
+        try {
+            ensureCastContext();
+        } catch (Exception error) {
+            // Certains appareils Android n’ont pas Google Play services.
+            android.util.Log.w("BAARO-Cast", "Google Cast indisponible", error);
+        }
+    }
+
+    @Override
+    protected void handleOnDestroy() {
+        clearPendingMedia();
+        if (castContext != null && listenerRegistered) {
+            castContext.getSessionManager().removeSessionManagerListener(
+                sessionListener,
+                CastSession.class
+            );
+            listenerRegistered = false;
+        }
+        super.handleOnDestroy();
+    }
+
+    @PluginMethod
+    public void getStatus(PluginCall call) {
+        try {
+            ensureCastContext();
+            call.resolve(buildState());
+        } catch (Exception error) {
+            JSObject state = new JSObject();
+            state.put("available", false);
+            state.put("connected", false);
+            call.resolve(state);
+        }
+    }
+
+    @PluginMethod
+    public void startCasting(PluginCall call) {
+        String url = call.getString("url");
+        if (!isPublicHttpsUrl(url)) {
+            call.reject("Le cast nécessite une URL vidéo HTTPS accessible depuis le réseau.");
+            return;
+        }
+
+        JSObject media = new JSObject();
+        media.put("url", url);
+        media.put("mediaId", safeString(call.getString("mediaId"), ""));
+        media.put("title", safeString(call.getString("title"), "Vidéo BAARO"));
+        media.put("subtitle", safeString(call.getString("subtitle"), "BAARO"));
+        media.put("contentType", safeString(call.getString("contentType"), "video/mp4"));
+        media.put("imageUrl", safeString(call.getString("imageUrl"), ""));
+        media.put("durationSeconds", Math.max(0, call.getDouble("durationSeconds", 0.0)));
+        media.put("positionSeconds", Math.max(0, call.getDouble("positionSeconds", 0.0)));
+        handler.removeCallbacks(expirePendingMedia);
+        pendingMedia = media;
+        handler.postDelayed(expirePendingMedia, PENDING_MEDIA_TTL_MS);
+
+        try {
+            ensureCastContext();
+            CastSession activeSession = castContext.getSessionManager().getCurrentCastSession();
+            if (activeSession != null && activeSession.isConnected()) {
+                pendingMedia = null;
+                handler.removeCallbacks(expirePendingMedia);
+                loadMedia(activeSession, media);
+                call.resolve(buildState());
+                return;
+            }
+            showChooser(call);
+        } catch (Exception error) {
+            clearPendingMedia();
+            call.reject("Google Cast n’est pas disponible sur cet appareil.", error);
+        }
+    }
+
+    @PluginMethod
+    public void stopCasting(PluginCall call) {
+        try {
+            ensureCastContext();
+            clearPendingMedia();
+            castContext.getSessionManager().endCurrentSession(true);
+            call.resolve(buildState());
+        } catch (Exception error) {
+            call.reject("Impossible d’arrêter la diffusion.", error);
+        }
+    }
+
+    private void ensureCastContext() {
+        if (castContext == null) {
+            castContext = CastContext.getSharedInstance(getContext());
+        }
+        if (!listenerRegistered) {
+            castContext.getSessionManager().addSessionManagerListener(
+                sessionListener,
+                CastSession.class
+            );
+            listenerRegistered = true;
+        }
+    }
+
+    private void showChooser(PluginCall call) {
+        Activity activity = getActivity();
+        if (!(activity instanceof FragmentActivity)) {
+            clearPendingMedia();
+            call.reject("Le sélecteur Chromecast n’est pas disponible dans cette activité.");
+            return;
+        }
+
+        FragmentManager fragments = ((FragmentActivity) activity).getSupportFragmentManager();
+        if (fragments.isStateSaved()) {
+            clearPendingMedia();
+            call.reject("Réessaie d’ouvrir le sélecteur Chromecast dans un instant.");
+            return;
+        }
+        if (fragments.findFragmentByTag(DIALOG_TAG) == null) {
+            MediaRouteChooserDialogFragment chooser = new MediaRouteChooserDialogFragment();
+            chooser.setRouteSelector(castContext.getMergedSelector());
+            chooser.show(fragments, DIALOG_TAG);
+        }
+
+        JSObject result = buildState();
+        result.put("waitingForDevice", true);
+        call.resolve(result);
+    }
+
+    private void loadPendingMedia(CastSession session) {
+        if (pendingMedia == null || session == null || !session.isConnected()) return;
+        JSObject media = pendingMedia;
+        pendingMedia = null;
+        handler.removeCallbacks(expirePendingMedia);
+        loadMedia(session, media);
+    }
+
+    private void clearPendingMedia() {
+        pendingMedia = null;
+        handler.removeCallbacks(expirePendingMedia);
+    }
+
+    private void loadMedia(CastSession session, JSObject media) {
+        RemoteMediaClient remote = session.getRemoteMediaClient();
+        if (remote == null) {
+            emitError("Le lecteur distant Chromecast n’est pas prêt.");
+            return;
+        }
+
+        String url = media.optString("url", "");
+        if (!isPublicHttpsUrl(url)) {
+            emitError("La télévision ne peut lire que les vidéos accessibles en HTTPS.");
+            return;
+        }
+
+        MediaMetadata metadata = new MediaMetadata(MediaMetadata.MEDIA_TYPE_MOVIE);
+        metadata.putString(MediaMetadata.KEY_TITLE, media.optString("title", "Vidéo BAARO"));
+        metadata.putString(MediaMetadata.KEY_SUBTITLE, media.optString("subtitle", "BAARO"));
+        String imageUrl = media.optString("imageUrl", "");
+        if (isPublicHttpsUrl(imageUrl)) {
+            metadata.addImage(new com.google.android.gms.common.images.WebImage(Uri.parse(imageUrl)));
+        }
+
+        String contentType = media.optString("contentType", "video/mp4");
+        long durationMs = Math.max(0, Math.round(media.optDouble("durationSeconds", 0.0) * 1000));
+        long positionMs = Math.max(0, Math.round(media.optDouble("positionSeconds", 0.0) * 1000));
+        MediaInfo.Builder mediaBuilder = new MediaInfo.Builder(url)
+            .setStreamType(MediaInfo.STREAM_TYPE_BUFFERED)
+            .setContentType(contentType)
+            .setMetadata(metadata);
+        if (durationMs > 0) mediaBuilder.setStreamDuration(durationMs);
+
+        MediaLoadRequestData request = new MediaLoadRequestData.Builder()
+            .setMediaInfo(mediaBuilder.build())
+            .setAutoplay(true)
+            .setCurrentTime(positionMs)
+            .build();
+
+        String mediaId = media.optString("mediaId", "");
+        remote.load(request).setResultCallback((ResultCallback<RemoteMediaClient.MediaChannelResult>) result -> {
+            Status status = result.getStatus();
+            if (status != null && status.isSuccess()) {
+                currentMediaId = mediaId;
+                remote.setStreamMute(media.optBoolean("muted", false));
+                emitState();
+            } else {
+                emitError("Le téléviseur a refusé cette vidéo. Vérifie son format et son accès réseau.");
+            }
+        });
+    }
+
+    private JSObject buildState() {
+        JSObject state = new JSObject();
+        state.put("available", castContext != null);
+        CastSession session = castContext == null
+            ? null
+            : castContext.getSessionManager().getCurrentCastSession();
+        boolean connected = session != null && session.isConnected();
+        state.put("connected", connected);
+        if (connected) {
+            CastDevice device = session.getCastDevice();
+            if (device != null) state.put("deviceName", device.getFriendlyName());
+            if (currentMediaId != null) state.put("mediaId", currentMediaId);
+        }
+        return state;
+    }
+
+    private void emitState() {
+        notifyListeners("castStateChanged", buildState());
+    }
+
+    private void emitError(String message) {
+        JSObject event = new JSObject();
+        event.put("message", message);
+        notifyListeners("castError", event);
+    }
+
+    private boolean isPublicHttpsUrl(String value) {
+        if (value == null || value.trim().isEmpty()) return false;
+        try {
+            Uri uri = Uri.parse(value.trim());
+            return "https".equalsIgnoreCase(uri.getScheme())
+                && uri.getHost() != null
+                && uri.getUserInfo() == null;
+        } catch (Exception ignored) {
+            return false;
+        }
+    }
+
+    private String safeString(String value, String fallback) {
+        return value == null ? fallback : value.trim();
+    }
+}
