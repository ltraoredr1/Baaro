--- /dev/null
+++ b/native-plugins/cast/src/index.ts
@@ -0,0 +1,39 @@
+import { registerPlugin } from "@capacitor/core";
+
+export interface BaaroCastStatus {
+  available: boolean;
+  connected: boolean;
+  deviceName?: string;
+  mediaId?: string;
+  waitingForDevice?: boolean;
+}
+
+export interface BaaroCastMedia {
+  mediaId: string;
+  url: string;
+  title: string;
+  subtitle?: string;
+  contentType: string;
+  imageUrl?: string;
+  muted?: boolean;
+  durationSeconds?: number;
+  positionSeconds?: number;
+}
+
+export interface BaaroCastPlugin {
+  getStatus(): Promise<BaaroCastStatus>;
+  startCasting(media: BaaroCastMedia): Promise<BaaroCastStatus>;
+  stopCasting(): Promise<BaaroCastStatus>;
+  addListener(
+    eventName: "castStateChanged",
+    listenerFunc: (state: BaaroCastStatus) => void
+  ): Promise<{ remove: () => void }>;
+  addListener(
+    eventName: "castError",
+    listenerFunc: (event: { message: string }) => void
+  ): Promise<{ remove: () => void }>;
+}
+
+export const BaaroCast = registerPlugin<BaaroCastPlugin>("BaaroCast", {
+  web: () => Promise.resolve({} as BaaroCastPlugin),
+});
