diff --git a/src/features/videos/components/CastButton.jsx b/src/features/videos/components/CastButton.jsx
new file mode 100644
index 0000000..a0915d5
--- /dev/null
+++ b/src/features/videos/components/CastButton.jsx
@@ -0,0 +1,176 @@
+import { useEffect, useState } from "react";
+import { Capacitor } from "@capacitor/core";
+import { Cast, CircleStop } from "lucide-react";
+import { BaaroCast } from "../../../../native-plugins/cast/src/index.ts";
+import { COLORS } from "../../../theme.js";
+import { useToast } from "../../../components/ToastContext.jsx";
+
+const EMPTY_STATUS = { connected: false, available: false };
+
+function isNativeAndroid() {
+  return Capacitor.isNativePlatform() && Capacitor.getPlatform() === "android";
+}
+
+function getContentType(url) {
+  try {
+    const pathname = new URL(url).pathname.toLowerCase();
+    if (pathname.endsWith(".m3u8")) return "application/x-mpegURL";
+    if (pathname.endsWith(".webm")) return "video/webm";
+    if (pathname.endsWith(".ogv") || pathname.endsWith(".ogg")) return "video/ogg";
+    if (pathname.endsWith(".mov")) return "video/quicktime";
+  } catch {
+    // L’URL sera validée par le bridge ou par le navigateur.
+  }
+  return "video/mp4";
+}
+
+export default function CastButton({
+  video,
+  videoRefs,
+  audioRefs,
+  videoId,
+  isActive,
+  muted = false,
+  hasSeparateSound = false,
+}) {
+  const { showToast } = useToast();
+  const [status, setStatus] = useState(EMPTY_STATUS);
+  const [supported, setSupported] = useState(false);
+  const nativeAndroid = isNativeAndroid();
+  const mediaId = String(videoId ?? video?.id ?? "");
+  const isThisVideoCasting = !!status.connected && status.mediaId === mediaId;
+
+  useEffect(() => {
+    if (!isActive) return undefined;
+    let alive = true;
+    const handles = [];
+
+    if (nativeAndroid) {
+      setSupported(false);
+      BaaroCast.getStatus()
+        .then((next) => {
+          if (alive) {
+            setStatus(next || EMPTY_STATUS);
+            setSupported(!!next?.available);
+          }
+        })
+        .catch(() => {
+          if (alive) {
+            setStatus(EMPTY_STATUS);
+            setSupported(false);
+          }
+        });
+
+      const add = async (eventName, callback) => {
+        try {
+          const handle = await BaaroCast.addListener(eventName, callback);
+          if (alive) handles.push(handle);
+          else await handle.remove();
+        } catch {
+          // Google Play services peut ne pas être disponible sur l’appareil.
+        }
+      };
+
+      void add("castStateChanged", (next) => {
+        if (!alive) return;
+        setStatus(next || EMPTY_STATUS);
+        setSupported(!!next?.available);
+        if (next?.connected && next.mediaId === mediaId) {
+          videoRefs?.current?.[videoId]?.pause?.();
+          audioRefs?.current?.[videoId]?.pause?.();
+        }
+      });
+      void add("castError", ({ message }) => {
+        if (alive) showToast(message || "La diffusion a échoué.", "error");
+      });
+
+      return () => {
+        alive = false;
+        handles.forEach((handle) => void handle.remove());
+      };
+    }
+
+    const element = videoRefs?.current?.[videoId];
+    const remote = element?.remote;
+    const hasRemotePlayback = !!remote && typeof remote.prompt === "function";
+    const hasAirPlay = typeof element?.webkitShowPlaybackTargetPicker === "function";
+    setSupported(hasRemotePlayback || hasAirPlay);
+
+    const onConnecting = () => setStatus((previous) => ({ ...previous, connected: false }));
+    const onConnect = () => setStatus({ available: true, connected: true, mediaId });
+    const onDisconnect = () => setStatus(EMPTY_STATUS);
+    remote?.addEventListener?.("connecting", onConnecting);
+    remote?.addEventListener?.("connect", onConnect);
+    remote?.addEventListener?.("disconnect", onDisconnect);
+    if (remote?.state === "connected") onConnect();
+
+    return () => {
+      alive = false;
+      remote?.removeEventListener?.("connecting", onConnecting);
+      remote?.removeEventListener?.("connect", onConnect);
+      remote?.removeEventListener?.("disconnect", onDisconnect);
+    };
+  }, [audioRefs, isActive, mediaId, nativeAndroid, showToast, videoId, videoRefs]);
+
+  if (!isActive || !supported) return null;
+
+  const handleCast = async (event) => {
+    event.stopPropagation();
+    try {
+      if (nativeAndroid) {
+        if (isThisVideoCasting) {
+          await BaaroCast.stopCasting();
+          showToast("Diffusion arrêtée.", "info");
+          return;
+        }
+
+        const element = videoRefs?.current?.[videoId];
+        const url = video?.video_url || video?.media_url;
+        const result = await BaaroCast.startCasting({
+          mediaId,
+          url,
+          title: video?.title || video?.description || "Vidéo BAARO",
+          subtitle: video?.profiles?.display_name || video?.profiles?.handle || "BAARO",
+          contentType: getContentType(url || ""),
+          imageUrl: video?.thumbnail_url || "",
+          muted,
+          durationSeconds: Number.isFinite(element?.duration) ? element.duration : 0,
+          positionSeconds: Number.isFinite(element?.currentTime) ? element.currentTime : 0,
+        });
+        if (result?.waitingForDevice) {
+          showToast("Sélectionne ton Chromecast ou téléviseur compatible.", "info");
+        }
+      } else {
+        const element = videoRefs?.current?.[videoId];
+        if (typeof element?.remote?.prompt === "function") {
+          await element.remote.prompt();
+        } else if (typeof element?.webkitShowPlaybackTargetPicker === "function") {
+          element.webkitShowPlaybackTargetPicker();
+        }
+      }
+
+      if (hasSeparateSound) {
+        showToast("La piste musicale ajoutée séparément par BAARO n’est pas envoyée au téléviseur.", "info");
+      }
+    } catch (error) {
+      showToast(error?.message || "Aucun appareil de diffusion disponible.", "error");
+    }
+  };
+
+  return (
+    <button
+      type="button"
+      onClick={handleCast}
+      className="h-11 w-11 rounded-full backdrop-blur-md flex items-center justify-center"
+      style={{
+        background: status.connected ? "rgba(45,191,166,0.28)" : "rgba(255,255,255,0.10)",
+        color: status.connected ? COLORS.teal : "white",
+        boxShadow: status.connected ? `0 0 0 1px ${COLORS.teal}` : undefined,
+      }}
+      aria-label={isThisVideoCasting ? "Arrêter la diffusion" : "Diffuser sur un écran"}
+      title={status.connected && status.deviceName ? `Diffusion sur ${status.deviceName}` : "Diffuser sur un écran"}
+    >
+      {isThisVideoCasting ? <CircleStop size={20} /> : <Cast size={20} />}
+    </button>
+  );
+}
