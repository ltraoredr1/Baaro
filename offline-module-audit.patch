diff --git a/src/features/offline/native/offline_core.rs b/src/features/offline/native/offline_core.rs
new file mode 100644
index 0000000..ca45901
--- /dev/null
+++ b/src/features/offline/native/offline_core.rs
@@ -0,0 +1,52 @@
+#![no_std]
+
+#[cfg(not(test))]
+use core::panic::PanicInfo;
+
+#[cfg(not(test))]
+#[panic_handler]
+fn panic(_info: &PanicInfo) -> ! {
+    loop {}
+}
+
+const MAX_ATTEMPTS: u32 = 5;
+const MAX_PAYLOAD_BYTES: u32 = 4096;
+
+/// Codes stables partagés avec offlineCore.js : like=1, unlike=2, follow=3, unfollow=4.
+#[no_mangle]
+pub extern "C" fn offline_validate_action(
+    action: u32,
+    attempts: u32,
+    payload_bytes: u32,
+) -> u32 {
+    let known_action = (1..=4).contains(&action);
+    (known_action && attempts < MAX_ATTEMPTS && payload_bytes <= MAX_PAYLOAD_BYTES) as u32
+}
+
+/// Délai exponentiel, plafonné à cinq minutes.
+#[no_mangle]
+pub extern "C" fn offline_retry_delay_ms(attempts: u32) -> u32 {
+    let exponent = attempts.min(8);
+    let delay = 1_000u32.saturating_mul(1u32 << exponent);
+    delay.min(300_000)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn validates_known_actions_and_limits() {
+        assert_eq!(offline_validate_action(1, 0, 32), 1);
+        assert_eq!(offline_validate_action(9, 0, 32), 0);
+        assert_eq!(offline_validate_action(1, 5, 32), 0);
+        assert_eq!(offline_validate_action(1, 0, 4097), 0);
+    }
+
+    #[test]
+    fn retry_is_bounded() {
+        assert_eq!(offline_retry_delay_ms(0), 1_000);
+        assert_eq!(offline_retry_delay_ms(3), 8_000);
+        assert_eq!(offline_retry_delay_ms(20), 256_000);
+    }
+}
diff --git a/src/features/offline/native/offline_payload.c b/src/features/offline/native/offline_payload.c
new file mode 100644
index 0000000..7f3c171
--- /dev/null
+++ b/src/features/offline/native/offline_payload.c
@@ -0,0 +1,44 @@
+#include <stdint.h>
+
+#define MAX_PAYLOAD_BYTES 4096u
+
+static uint8_t payload_buffer[MAX_PAYLOAD_BYTES + 1u];
+
+__attribute__((visibility("default")))
+uint32_t offline_payload_buffer(void) {
+  return (uint32_t)(uintptr_t)payload_buffer;
+}
+
+/* Rejette UTF-8 mal formé, séquences surlongues, surrogate halves et > U+10FFFF. */
+__attribute__((visibility("default")))
+uint32_t offline_validate_payload(uint32_t length) {
+  if (length > MAX_PAYLOAD_BYTES) return 0u;
+  uint32_t i = 0u;
+  while (i < length) {
+    uint8_t a = payload_buffer[i++];
+    if (a <= 0x7fu) continue;
+    if (a >= 0xc2u && a <= 0xdfu) {
+      if (i >= length || (payload_buffer[i++] & 0xc0u) != 0x80u) return 0u;
+      continue;
+    }
+    if (a >= 0xe0u && a <= 0xefu) {
+      if (i + 1u >= length) return 0u;
+      uint8_t b = payload_buffer[i++];
+      uint8_t c = payload_buffer[i++];
+      if ((b & 0xc0u) != 0x80u || (c & 0xc0u) != 0x80u) return 0u;
+      if ((a == 0xe0u && b < 0xa0u) || (a == 0xedu && b >= 0xa0u)) return 0u;
+      continue;
+    }
+    if (a >= 0xf0u && a <= 0xf4u) {
+      if (i + 2u >= length) return 0u;
+      uint8_t b = payload_buffer[i++];
+      uint8_t c = payload_buffer[i++];
+      uint8_t d = payload_buffer[i++];
+      if ((b & 0xc0u) != 0x80u || (c & 0xc0u) != 0x80u || (d & 0xc0u) != 0x80u) return 0u;
+      if ((a == 0xf0u && b < 0x90u) || (a == 0xf4u && b >= 0x90u)) return 0u;
+      continue;
+    }
+    return 0u;
+  }
+  return 1u;
+}
diff --git a/src/features/offline/offlineCore.js b/src/features/offline/offlineCore.js
new file mode 100644
index 0000000..c0d2d3a
--- /dev/null
+++ b/src/features/offline/offlineCore.js
@@ -0,0 +1,81 @@
+const ACTION_CODES = Object.freeze({ like_post: 1, unlike_post: 2, follow_user: 3, unfollow_user: 4 });
+const MAX_ATTEMPTS = 5;
+const MAX_PAYLOAD_BYTES = 4096;
+let wasmPromise;
+
+async function loadWasmPair() {
+  if (typeof WebAssembly === "undefined" || typeof fetch !== "function") return null;
+  try {
+    const [rustResponse, cResponse] = await Promise.all([
+      fetch("/wasm/offline_core.wasm"),
+      fetch("/wasm/offline_payload.wasm"),
+    ]);
+    if (!rustResponse.ok || !cResponse.ok) return null;
+    const [rustBytes, cBytes] = await Promise.all([
+      rustResponse.arrayBuffer(),
+      cResponse.arrayBuffer(),
+    ]);
+    const [rust, c] = await Promise.all([
+      WebAssembly.instantiate(rustBytes, {}),
+      WebAssembly.instantiate(cBytes, {}),
+    ]);
+    const rustExports = rust.instance.exports;
+    const cExports = c.instance.exports;
+    if (
+      typeof rustExports.offline_validate_action !== "function" ||
+      typeof rustExports.offline_retry_delay_ms !== "function" ||
+      !cExports.memory ||
+      typeof cExports.offline_payload_buffer !== "function" ||
+      typeof cExports.offline_validate_payload !== "function"
+    ) return null;
+    return { rust: rustExports, c: cExports };
+  } catch {
+    return null;
+  }
+}
+
+function wasm() {
+  if (!wasmPromise) wasmPromise = loadWasmPair();
+  return wasmPromise;
+}
+
+export async function validateOfflineRecord(type, attempts, payload) {
+  const code = ACTION_CODES[type];
+  if (!code || !Number.isInteger(attempts) || attempts < 0 || attempts >= MAX_ATTEMPTS) return false;
+  let serialized;
+  try {
+    serialized = JSON.stringify(payload ?? {});
+  } catch {
+    return false;
+  }
+  const bytes = new TextEncoder().encode(serialized);
+  if (bytes.byteLength > MAX_PAYLOAD_BYTES) return false;
+
+  const core = await wasm();
+  if (!core) return true;
+  try {
+    const address = core.c.offline_payload_buffer() >>> 0;
+    const memory = new Uint8Array(core.c.memory.buffer);
+    if (address + bytes.byteLength > memory.byteLength) return false;
+    memory.set(bytes, address);
+    return core.rust.offline_validate_action(code, attempts, bytes.byteLength) === 1 &&
+      core.c.offline_validate_payload(bytes.byteLength) === 1;
+  } catch {
+    return false;
+  }
+}
+
+export async function retryDelayMs(attempts) {
+  const safeAttempts = Math.max(0, Math.min(8, Number(attempts) || 0));
+  const core = await wasm();
+  if (core) {
+    try {
+      return core.rust.offline_retry_delay_ms(safeAttempts);
+    } catch {
+      // Repli JS déterministe ci-dessous.
+    }
+  }
+  return Math.min(300_000, 1_000 * (2 ** safeAttempts));
+}
+
+export const OFFLINE_MAX_ATTEMPTS = MAX_ATTEMPTS;
