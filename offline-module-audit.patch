diff --git a/src/lib/offlineErrorPolicy.js b/src/lib/offlineErrorPolicy.js
new file mode 100644
index 0000000..d56b8ac
--- /dev/null
+++ b/src/lib/offlineErrorPolicy.js
@@ -0,0 +1,10 @@
+export function isTransientOfflineError(error) {
+  const hasStatus = error?.status != null || error?.statusCode != null;
+  const status = Number(error?.status ?? error?.statusCode ?? -1);
+  if ([408, 425, 429].includes(status)) return true;
+  if (status >= 400 && status < 500) return false;
+  if (status >= 500) return true;
+  const message = `${error?.message || ""} ${error?.code || ""}`.toLowerCase();
+  return /network|fetch|timeout|timed out|connection|offline|temporar|abort|too many requests|retry after/.test(message) ||
+    (!hasStatus && error?.name === "TypeError");
+}
diff --git a/src/lib/offlineQueueLock.js b/src/lib/offlineQueueLock.js
new file mode 100644
index 0000000..a331533
--- /dev/null
+++ b/src/lib/offlineQueueLock.js
@@ -0,0 +1,22 @@
+const localTails = new Map();
+
+/** Sérialise les mutations de file sur le compte actif entre onglets compatibles. */
+export async function withOfflineQueueLock(name, operation) {
+  const lockName = `baaro:${String(name)}`;
+  if (typeof navigator !== "undefined" && navigator.locks?.request) {
+    return navigator.locks.request(lockName, { mode: "exclusive" }, operation);
+  }
+
+  // Repli pour moteurs sans Web Locks : protège au moins les appels du même runtime.
+  const previous = localTails.get(lockName) || Promise.resolve();
+  let release;
+  const current = new Promise((resolve) => { release = resolve; });
+  localTails.set(lockName, current);
+  await previous;
+  try {
+    return await operation();
+  } finally {
+    release();
+    if (localTails.get(lockName) === current) localTails.delete(lockName);
+  }
+}
