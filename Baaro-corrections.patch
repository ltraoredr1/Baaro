[32m+[m[32mcreate or replace function public.submit_baaro_sound([m
[32m+[m[32m  p_title text,[m
[32m+[m[32m  p_artist text,[m
[32m+[m[32m  p_audio_url text,[m
[32m+[m[32m  p_language text,[m
[32m+[m[32m  p_region text,[m
[32m+[m[32m  p_rights_holder text,[m
[32m+[m[32m  p_license_code text,[m
[32m+[m[32m  p_license_name text,[m
[32m+[m[32m  p_attribution_required boolean,[m
[32m+[m[32m  p_commercial_use_allowed boolean,[m
[32m+[m[32m  p_remix_allowed boolean,[m
[32m+[m[32m  p_source_url text,[m
[32m+[m[32m  p_rights_declaration text[m
[32m+[m[32m)[m
[32m+[m[32mreturns uuid[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity invoker[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare v_id uuid;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.uid() is null then raise exception 'AUTH_REQUIRED'; end if;[m
[32m+[m[32m  if p_license_code not in ('creator_license','traditional_cultural','public_domain','cc0','cc_by','custom') then[m
[32m+[m[32m    raise exception 'INVALID_LICENSE';[m
[32m+[m[32m  end if;[m
[32m+[m[32m  insert into public.sound_submissions ([m
[32m+[m[32m    submitted_by,title,artist,audio_url,language,region,rights_holder,[m
[32m+[m[32m    license_code,license_name,attribution_required,commercial_use_allowed,[m
[32m+[m[32m    remix_allowed,source_url,rights_declaration[m
[32m+[m[32m  ) values ([m
[32m+[m[32m    auth.uid(),trim(p_title),nullif(trim(p_artist),''),p_audio_url,[m
[32m+[m[32m    nullif(trim(p_language),''),nullif(trim(p_region),''),nullif(trim(p_rights_holder),''),[m
[32m+[m[32m    p_license_code,coalesce(nullif(trim(p_license_name),''),'Licence créateur BAARO'),[m
[32m+[m[32m    coalesce(p_attribution_required,true),coalesce(p_commercial_use_allowed,false),[m
[32m+[m[32m    coalesce(p_remix_allowed,false),nullif(trim(p_source_url),''),trim(p_rights_declaration)[m
[32m+[m[32m  ) returning id into v_id;[m
[32m+[m[32m  return v_id;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
