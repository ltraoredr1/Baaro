[32m+[m[32mend $$;[m
[32m+[m
[32m+[m[32malter table public.follows enable row level security;[m
[32m+[m
[32m+[m[32mdrop policy if exists follows_select on public.follows;[m
[32m+[m[32mdrop policy if exists "follows_read" on public.follows;[m
[32m+[m[32mcreate policy follows_select on public.follows[m
