[32m+[m[32mcreate or replace function public.get_economy_dashboard()[m
[32m+[m[32mreturns jsonb[m
[32m+[m[32mlanguage plpgsql security invoker set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare uid uuid:=auth.uid(); a public.economy_accounts; m public.creator_monetization; c text; result jsonb;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if uid is null then raise exception 'AUTH_REQUIRED'; end if;[m
[32m+[m[32m  select * into a from public.economy_accounts where user_id=uid;[m
[32m+[m[32m  select * into m from public.creator_monetization where creator_id=uid;[m
[32m+[m[32m  c:=coalesce(a.currency,coalesce(m.currency,'XOF'));[m
[32m+[m[32m  select jsonb_build_object([m
[32m+[m[32m    'currency',c,[m
[32m+[m[32m    'pending_minor',coalesce(a.pending_minor,0),[m
[32m+[m[32m    'available_minor',coalesce(a.available_minor,0),[m
[32m+[m[32m    'payout_hold_minor',coalesce(a.payout_hold_minor,0),[m
[32m+[m[32m    'paid_out_minor',coalesce(a.paid_out_minor,0),[m
[32m+[m[32m    'min_cashout_minor',round(coalesce(m.min_cashout,1000)*100)::bigint,[m
[32m+[m[32m    'monetization',jsonb_build_object('enabled',coalesce(m.enabled,false)),[m
[32m+[m[32m    'by_source',coalesce((select jsonb_agg(x order by x.net_minor desc) from (select source,sum(amount_minor) net_minor from public.economy_ledger where user_id=uid and entry_type='earning' and direction='credit' group by source) x),'[]'::jsonb),[m
[32m+[m[32m    'recent',coalesce((select jsonb_agg(x order by x.created_at desc) from (select id,source,amount_minor net_minor,currency,created_at from public.economy_ledger where user_id=uid and entry_type='earning' and direction='credit' order by created_at desc limit 20) x),'[]'::jsonb)[m
[32m+[m[32m  ) into result;[m
[32m+[m[32m  return result;[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.get_economy_dashboard() from public, anon;[m
[32m+[m[32mgrant execute on function public.get_economy_dashboard() to authenticated;[m
