[32m+[m[32m-- SOURCE: 0037_clean.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO 039: fonctions wallet alignées sur wallets.id (plus de wallets.user_id)[m
[32m+[m[32m-- transactions.user_id reste une FK relationnelle (correct).[m
[32m+[m[32m-- À exécuter APRÈS 038_identity_id_only_and_profile_persistence.sql[m
[32m+[m
[32m+[m[32m-- Colonnes attendues[m
[32m+[m[32mALTER TABLE public.wallets[m
[32m+[m[32m  ADD COLUMN IF NOT EXISTS balance numeric NOT NULL DEFAULT 0,[m
[32m+[m[32m  ADD COLUMN IF NOT EXISTS updated_at timestamptz DEFAULT now();[m
[32m+[m
[32m+[m[32m-- DROP obligatoire : CREATE OR REPLACE ne peut pas changer les défauts de paramètres[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.wallet_ensure(uuid, numeric);[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.wallet_earn(uuid, numeric, text, text, numeric, boolean);[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.wallet_earn(uuid, numeric, text, text, numeric, boolean, uuid);[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.wallet_redeem(uuid, numeric, text, text);[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.wallet_convert(uuid, numeric);[m
[32m+[m
[32m+[m[32m-- wallet_ensure[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.wallet_ensure(p_user_id uuid, p_welcome_bonus numeric DEFAULT 50)[m
[32m+[m[32mRETURNS jsonb[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  w public.wallets%rowtype;[m
[32m+[m[32m  bonus numeric := greatest(coalesce(p_welcome_bonus, 0), 0);[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  INSERT INTO public.wallets(id, balance, updated_at)[m
[32m+[m[32m  VALUES (p_user_id, 0, now())[m
[32m+[m[32m  ON CONFLICT (id) DO NOTHING;[m
[32m+[m
[32m+[m[32m  SELECT * INTO w FROM public.wallets WHERE id = p_user_id FOR UPDATE;[m
[32m+[m
[32m+[m[32m  IF bonus > 0 AND NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM public.transactions[m
[32m+[m[32m    WHERE user_id = p_user_id AND action_key = 'welcome_bonus'[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    UPDATE public.wallets[m
[32m+[m[32m      SET balance = balance + bonus, updated_at = now()[m
[32m+[m[32m    WHERE id = p_user_id[m
[32m+[m[32m    RETURNING * INTO w;[m
[32m+[m
[32m+[m[32m    INSERT INTO public.transactions(user_id, label, pts, action_key, day_key)[m
[32m+[m[32m    VALUES (p_user_id, 'Bonus de bienvenue', bonus, 'welcome_bonus', current_date);[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  RETURN jsonb_build_object('id', w.id, 'user_id', w.id, 'balance', w.balance, 'updated_at', w.updated_at);[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32m-- wallet_earn (anti-farming + reference_id)[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.wallet_earn([m
[32m+[m[32m  p_user_id uuid,[m
[32m+[m[32m  p_pts numeric,[m
[32m+[m[32m  p_label text,[m
[32m+[m[32m  p_action_key text,[m
[32m+[m[32m  p_daily_cap numeric DEFAULT 100,[m
[32m+[m[32m  p_daily_bonus boolean DEFAULT false,[m
[32m+[m[32m  p_reference_id uuid DEFAULT NULL[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS jsonb[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  w public.wallets%rowtype;[m
[32m+[m[32m  earned numeric := 0;[m
[32m+[m[32m  actual_pts numeric;[m
[32m+[m[32m  tx public.transactions%rowtype;[m
[32m+[m[32m  event_exists boolean := false;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF p_pts IS NULL OR p_pts <= 0 THEN RAISE EXCEPTION 'INVALID_POINTS'; END IF;[m
[32m+[m[32m  IF length(coalesce(p_label,'')) = 0 THEN RAISE EXCEPTION 'INVALID_LABEL'; END IF;[m
[32m+[m
[32m+[m[32m  IF NOT p_daily_bonus THEN[m
[32m+[m[32m    IF p_reference_id IS NULL THEN RAISE EXCEPTION 'REWARD_REFERENCE_REQUIRED'; END IF;[m
[32m+[m
[32m+[m[32m    CASE p_action_key[m
[32m+[m[32m      WHEN 'publish_post' THEN[m
[32m+[m[32m        SELECT EXISTS(SELECT 1 FROM public.posts WHERE id = p_reference_id AND author_id = p_user_id) INTO event_exists;[m
[32m+[m[32m      WHEN 'publish_post_media' THEN[m
[32m+[m[32m        SELECT EXISTS(SELECT 1 FROM public.posts WHERE id = p_reference_id AND author_id = p_user_id AND media_url IS NOT NULL) INTO event_exists;[m
[32m+[m[32m      WHEN 'like_post' THEN[m
[32m+[m[32m        SELECT EXISTS(SELECT 1 FROM public.post_likes WHERE post_id = p_reference_id AND user_id = p_user_id) INTO event_exists;[m
[32m+[m[32m      WHEN 'comment' THEN[m
[32m+[m[32m        SELECT EXISTS(SELECT 1 FROM public.comments WHERE id = p_reference_id AND author_id = p_user_id) INTO event_exists;[m
[32m+[m[32m      WHEN 'subscribe' THEN[m
[32m+[m[32m        SELECT EXISTS(SELECT 1 FROM public.follows WHERE follower_id = p_user_id AND followed_id = p_reference_id) INTO event_exists;[m
[32m+[m[32m      WHEN 'like_video' THEN[m
[32m+[m[32m        SELECT EXISTS(SELECT 1 FROM public.video_likes WHERE video_id = p_reference_id AND user_id = p_user_id) INTO event_exists;[m
[32m+[m[32m      WHEN 'comment_video' THEN[m
[32m+[m[32m        SELECT EXISTS(SELECT 1 FROM public.video_comments WHERE id = p_reference_id AND author_id = p_user_id) INTO event_exists;[m
[32m+[m[32m      WHEN 'publish_video' THEN[m
[32m+[m[32m        SELECT EXISTS(SELECT 1 FROM public.videos WHERE id = p_reference_id AND author_id = p_user_id) INTO event_exists;[m
[32m+[m[32m      WHEN 'repost_video' THEN[m
[32m+[m[32m        SELECT EXISTS(SELECT 1 FROM public.videos WHERE id = p_reference_id AND author_id = p_user_id) INTO event_exists;[m
[32m+[m[32m      WHEN 'publish_story' THEN[m
[32m+[m[32m      ELSE[m
[32m+[m[32m        RAISE EXCEPTION 'UNVERIFIABLE_REWARD_ACTION';[m
[32m+[m[32m    END CASE;[m
[32m+[m
[32m+[m[32m    IF NOT event_exists THEN RAISE EXCEPTION 'REWARD_EVENT_NOT_FOUND'; END IF;[m
[32m+[m
[32m+[m[32m    IF EXISTS ([m
[32m+[m[32m      SELECT 1 FROM public.transactions[m
[32m+[m[32m      WHERE user_id = p_user_id AND action_key = p_action_key AND reference_id = p_reference_id AND pts > 0[m
[32m+[m[32m    ) THEN[m
[32m+[m[32m      RAISE EXCEPTION 'REWARD_ALREADY_CLAIMED';[m
[32m+[m[32m    END IF;[m
[32m+[m[32m  ELSE[m
[32m+[m[32m    IF p_action_key <> 'daily_bonus' THEN RAISE EXCEPTION 'INVALID_DAILY_BONUS'; END IF;[m
[32m+[m[32m    IF EXISTS ([m
[32m+[m[32m      SELECT 1 FROM public.transactions[m
[32m+[m[32m      WHERE user_id = p_user_id AND action_key = 'daily_bonus' AND day_key = current_date[m
[32m+[m[32m    ) THEN[m
[32m+[m[32m      RAISE EXCEPTION 'DAILY_BONUS_ALREADY_CLAIMED';[m
[32m+[m[32m    END IF;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  PERFORM public.wallet_ensure(p_user_id, 0);[m
[32m+[m[32m  SELECT * INTO w FROM public.wallets WHERE id = p_user_id FOR UPDATE;[m
[32m+[m
[32m+[m[32m  SELECT coalesce(sum(pts), 0) INTO earned[m
[32m+[m[32m  FROM public.transactions[m
[32m+[m[32m  WHERE user_id = p_user_id AND pts > 0 AND created_at >= date_trunc('day', now());[m
[32m+[m
[32m+[m[32m  IF earned >= p_daily_cap THEN RAISE EXCEPTION 'DAILY_CAP_REACHED'; END IF;[m
[32m+[m[32m  actual_pts := least(p_pts, p_daily_cap - earned);[m
[32m+[m
[32m+[m[32m  UPDATE public.wallets[m
[32m+[m[32m    SET balance = balance + actual_pts, updated_at = now()[m
[32m+[m[32m  WHERE id = p_user_id[m
[32m+[m[32m  RETURNING * INTO w;[m
[32m+[m
[32m+[m[32m  INSERT INTO public.transactions(user_id, label, pts, action_key, day_key, reference_id)[m
[32m+[m[32m  VALUES (p_user_id, left(p_label, 120), actual_pts, p_action_key, current_date, p_reference_id)[m
[32m+[m[32m  RETURNING * INTO tx;[m
[32m+[m
[32m+[m[32m  RETURN jsonb_build_object([m
[32m+[m[32m    'balance', w.balance,[m
[32m+[m[32m    'earned_today', earned + actual_pts,[m
[32m+[m[32m    'remaining_today', greatest(0, p_daily_cap - earned - actual_pts),[m
[32m+[m[32m    'transaction', to_jsonb(tx)[m
[32m+[m[32m  );[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32m-- wallet_redeem[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.wallet_redeem([m
[32m+[m[32m  p_user_id uuid,[m
[32m+[m[32m  p_cost numeric,[m
[32m+[m[32m  p_label text,[m
[32m+[m[32m  p_action_key text[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS jsonb[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  w public.wallets%rowtype;[m
[32m+[m[32m  tx public.transactions%rowtype;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF p_cost IS NULL OR p_cost <= 0 THEN RAISE EXCEPTION 'INVALID_COST'; END IF;[m
[32m+[m[32m  PERFORM public.wallet_ensure(p_user_id, 0);[m
[32m+[m[32m  SELECT * INTO w FROM public.wallets WHERE id = p_user_id FOR UPDATE;[m
[32m+[m[32m  IF w.balance < p_cost THEN RAISE EXCEPTION 'INSUFFICIENT_BALANCE'; END IF;[m
[32m+[m
[32m+[m[32m  UPDATE public.wallets SET balance = balance - p_cost, updated_at = now()[m
[32m+[m[32m  WHERE id = p_user_id RETURNING * INTO w;[m
[32m+[m
[32m+[m[32m  INSERT INTO public.transactions(user_id, label, pts, action_key, day_key)[m
[32m+[m[32m  VALUES (p_user_id, left(p_label, 120), -p_cost, p_action_key, current_date)[m
[32m+[m[32m  RETURNING * INTO tx;[m
[32m+[m
[32m+[m[32m  RETURN jsonb_build_object('balance', w.balance, 'transaction', to_jsonb(tx));[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32m-- Grants[m
[32m+[m[32mREVOKE ALL ON FUNCTION public.wallet_ensure(uuid, numeric) FROM public, anon, authenticated;[m
[32m+[m[32mREVOKE ALL ON FUNCTION public.wallet_earn(uuid, numeric, text, text, numeric, boolean, uuid) FROM public, anon, authenticated;[m
[32m+[m[32mREVOKE ALL ON FUNCTION public.wallet_redeem(uuid, numeric, text, text) FROM public, anon, authenticated;[m
[32m+[m
[32m+[m[32mGRANT EXECUTE ON FUNCTION public.wallet_ensure(uuid, numeric) TO service_role;[m
[32m+[m[32mGRANT EXECUTE ON FUNCTION public.wallet_earn(uuid, numeric, text, text, numeric, boolean, uuid) TO service_role;[m
[32m+[m[32mGRANT EXECUTE ON FUNCTION public.wallet_redeem(uuid, numeric, text, text) TO service_role;[m
[32m+[m
