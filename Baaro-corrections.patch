[32m+[m[32m  alter table public.stories add constraint stories_caption_size check (caption is null or char_length(caption) <= 5000);[m
[32m+[m[32mexception when duplicate_object then null; end $$;[m
[32m+[m[32mdo $$ begin[m
[32m+[m[32m  alter table public.stories add constraint stories_media_url_size check (media_url is null or char_length(media_url) <= 4096);[m
[32m+[m[32mexception when duplicate_object then null; end $$;[m
[32m+[m[32mdo $$ begin[m
[32m+[m[32m  alter table public.search_history add constraint search_history_query_size check (char_length(query) <= 200);[m
[32m+[m[32mexception when duplicate_object then null; end $$;[m
[32m+[m
