[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0047_fix_phone_auth_id_only.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO 049[m
[32m+[m[32m-- Correction définitive de l'authentification téléphone[m
[32m+[m[32m--[m
[32m+[m[32m-- Architecture BAARO :[m
[32m+[m[32m--[m
[32m+[m[32m--   auth.users.id[m
[32m+[m[32m--          =[m
[32m+[m[32m--      profiles.id[m
[32m+[m[32m--[m
[32m+[m[32m-- Aucun autre identifiant technique de compte n'est créé ici.[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 1. Colonnes nécessaires dans profiles[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mALTER TABLE public.profiles[m
[32m+[m[32m  ADD COLUMN IF NOT EXISTS phone text;[m
[32m+[m
[32m+[m[32mALTER TABLE public.profiles[m
[32m+[m[32m  ADD COLUMN IF NOT EXISTS bio text;[m
[32m+[m
[32m+[m[32mALTER TABLE public.profiles[m
[32m+[m[32m  ADD COLUMN IF NOT EXISTS flag text;[m
[32m+[m
[32m+[m[32mALTER TABLE public.profiles[m
[32m+[m[32m  ADD COLUMN IF NOT EXISTS created_at timestamptz[m
[32m+[m[32m  DEFAULT now();[m
[32m+[m
[32m+[m[32mALTER TABLE public.profiles[m
[32m+[m[32m  ADD COLUMN IF NOT EXISTS updated_at timestamptz[m
[32m+[m[32m  DEFAULT now();[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 2. Identifiant canonique[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mALTER TABLE public.profiles[m
[32m+[m[32m  ALTER COLUMN id SET NOT NULL;[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 3. Relation profiles -> auth.users[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mALTER TABLE public.profiles[m
[32m+[m[32m  DROP CONSTRAINT IF EXISTS profiles_id_fkey;[m
[32m+[m
[32m+[m[32mALTER TABLE public.profiles[m
[32m+[m[32m  ADD CONSTRAINT profiles_id_fkey[m
[32m+[m[32m  FOREIGN KEY (id)[m
[32m+[m[32m  REFERENCES auth.users(id)[m
[32m+[m[32m  ON DELETE CASCADE;[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 4. Réparer les anciens profils sans handle[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mUPDATE public.profiles[m
[32m+[m[32mSET[m
[32m+[m[32m  handle =[m
[32m+[m[32m    '@user_' ||[m
[32m+[m[32m    substr([m
[32m+[m[32m      replace(id::text, '-', ''),[m
[32m+[m[32m      1,[m
[32m+[m[32m      12[m
[32m+[m[32m    )[m
[32m+[m[32mWHERE handle IS NULL[m
[32m+[m[32m   OR length(trim(handle)) = 0;[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 5. Normaliser les handles[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mUPDATE public.profiles[m
[32m+[m[32mSET handle = lower(trim(handle))[m
[32m+[m[32mWHERE handle IS NOT NULL[m
[32m+[m[32m  AND handle <> lower(trim(handle));[m
[32m+[m
[32m+[m
[32m+[m[32mUPDATE public.profiles[m
[32m+[m[32mSET handle = '@' || handle[m
[32m+[m[32mWHERE handle IS NOT NULL[m
[32m+[m[32m  AND left(handle, 1) <> '@';[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 6. Index unique des handles[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mDROP INDEX IF EXISTS public.profiles_handle_unique;[m
[32m+[m
[32m+[m[32mCREATE UNIQUE INDEX IF NOT EXISTS[m
[32m+[m[32m  profiles_handle_unique[m
[32m+[m[32mON public.profiles (lower(handle));[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 7. handle obligatoire[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mALTER TABLE public.profiles[m
[32m+[m[32m  ALTER COLUMN handle SET NOT NULL;[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 8. Fonction automatique de création du profil[m
[32m+[m[32m--[m
[32m+[m[32m-- IMPORTANT :[m
[32m+[m[32m-- l'identifiant utilisé est NEW.id.[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.handle_new_user()[m
[32m+[m[32mRETURNS trigger[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  v_name text;[m
[32m+[m[32m  v_handle text;[m
[32m+[m[32m  v_fallback_handle text;[m
[32m+[m[32m  v_flag text;[m
[32m+[m[32m  v_bio text;[m
[32m+[m[32m  v_phone text;[m
[32m+[m[32mBEGIN[m
[32m+[m
[32m+[m[32m  -- ----------------------------------------------------------[m
[32m+[m[32m  -- Nom affiché[m
[32m+[m[32m  -- ----------------------------------------------------------[m
[32m+[m
[32m+[m[32m  v_name := left([m
[32m+[m[32m    coalesce([m
[32m+[m[32m      nullif([m
[32m+[m[32m        new.raw_user_meta_data ->> 'display_name',[m
[32m+[m[32m        ''[m
[32m+[m[32m      ),[m
[32m+[m
[32m+[m[32m      nullif([m
[32m+[m[32m        new.raw_user_meta_data ->> 'full_name',[m
[32m+[m[32m        ''[m
[32m+[m[32m      ),[m
[32m+[m
[32m+[m[32m      nullif([m
[32m+[m[32m        new.raw_user_meta_data ->> 'name',[m
[32m+[m[32m        ''[m
[32m+[m[32m      ),[m
[32m+[m
[32m+[m[32m      nullif([m
[32m+[m[32m        split_part([m
[32m+[m[32m          coalesce(new.email, ''),[m
[32m+[m[32m          '@',[m
[32m+[m[32m          1[m
[32m+[m[32m        ),[m
[32m+[m[32m        ''[m
[32m+[m[32m      ),[m
[32m+[m
[32m+[m[32m      nullif(new.phone, ''),[m
[32m+[m
[32m+[m[32m      'Membre BAARO'[m
[32m+[m[32m    ),[m
[32m+[m[32m    80[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m
[32m+[m[32m  -- ----------------------------------------------------------[m
[32m+[m[32m  -- Téléphone[m
[32m+[m[32m  -- ----------------------------------------------------------[m
[32m+[m
[32m+[m[32m  v_phone := nullif([m
[32m+[m[32m    trim(coalesce(new.phone, '')),[m
[32m+[m[32m    ''[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m
[32m+[m[32m  -- ----------------------------------------------------------[m
[32m+[m[32m  -- Drapeau[m
[32m+[m[32m  -- ----------------------------------------------------------[m
[32m+[m
[32m+[m[32m  v_flag := coalesce([m
[32m+[m[32m    nullif([m
[32m+[m[32m      new.raw_user_meta_data ->> 'flag',[m
[32m+[m[32m      ''[m
[32m+[m[32m    ),[m
[32m+[m[32m    '🌍'[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m
[32m+[m[32m  -- ----------------------------------------------------------[m
[32m+[m[32m  -- Biographie[m
[32m+[m[32m  -- ----------------------------------------------------------[m
[32m+[m
[32m+[m[32m  v_bio := coalesce([m
[32m+[m[32m    new.raw_user_meta_data ->> 'bio',[m
[32m+[m[32m    ''[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m
[32m+[m[32m  -- ----------------------------------------------------------[m
[32m+[m[32m  -- Handle demandé par les métadonnées[m
[32m+[m[32m  -- ----------------------------------------------------------[m
[32m+[m
[32m+[m[32m  v_handle := lower([m
[32m+[m[32m    trim([m
[32m+[m[32m      coalesce([m
[32m+[m[32m        nullif([m
[32m+[m[32m          new.raw_user_meta_data ->> 'handle',[m
[32m+[m[32m          ''[m
[32m+[m[32m        ),[m
[32m+[m
[32m+[m[32m        '@user_' ||[m
[32m+[m[32m        substr([m
[32m+[m[32m          replace(new.id::text, '-', ''),[m
[32m+[m[32m          1,[m
[32m+[m[32m          12[m
[32m+[m[32m        )[m
[32m+[m[32m      )[m
[32m+[m[32m    )[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m
[32m+[m[32m  -- Ajouter @ si nécessaire[m
[32m+[m[32m  IF left(v_handle, 1) <> '@' THEN[m
[32m+[m[32m    v_handle := '@' || v_handle;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m
[32m+[m[32m  -- Limiter la longueur[m
[32m+[m[32m  v_handle := left(v_handle, 40);[m
[32m+[m
[32m+[m
[32m+[m[32m  -- ----------------------------------------------------------[m
[32m+[m[32m  -- Handle garanti unique[m
[32m+[m[32m  -- ----------------------------------------------------------[m
[32m+[m
[32m+[m[32m  v_fallback_handle :=[m
[32m+[m[32m    '@user_' ||[m
[32m+[m[32m    substr([m
[32m+[m[32m      replace(new.id::text, '-', ''),[m
[32m+[m[32m      1,[m
[32m+[m[32m      12[m
