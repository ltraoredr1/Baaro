[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0056_add_contacts.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- Onglet "Contact" (Communauté) — v2, performance + fiabilité du matching.[m
[32m+[m[32m-- Remplace l'approche "une colonne phone_hash/email_hash" par une table dédiée[m
[32m+[m[32m-- contact_hashes : chaque personne peut avoir PLUSIEURS hachages (variantes de[m
[32m+[m[32m-- formatage du même numéro : +223 70..., 22370..., 070..., 70...) sans qu'on[m
[32m+[m[32m-- ait besoin de deviner un indicatif pays. Ça augmente nettement le taux de[m
[32m+[m[32m-- correspondance avec un vrai répertoire de téléphone, pour un coût quasi nul[m
[32m+[m[32m-- (quelques lignes de plus par utilisateur, PK sur le hash = recherche O(1)).[m
[32m+[m
[32m+[m[32m-- Nettoyage si vous aviez déjà exécuté l'ancienne version (v1) de ce fichier :[m
[32m+[m[32mdrop index if exists public.profiles_phone_hash_idx;[m
[32m+[m[32mdrop index if exists public.profiles_email_hash_idx;[m
[32m+[m[32malter table public.profiles drop column if exists phone_hash;[m
[32m+[m[32malter table public.profiles drop column if exists email_hash;[m
[32m+[m
[32m+[m[32m-- Le numéro en clair n'est gardé QUE pour l'affichage à son propriétaire dans[m
[32m+[m[32m-- ses propres réglages — jamais exposé aux autres.[m
[32m+[m[32malter table public.profiles add column if not exists phone text;[m
[32m+[m
[32m+[m[32mcreate table if not exists public.contact_hashes ([m
[32m+[m[32m  hash text primary key,[m
[32m+[m[32m  profile_id uuid not null references public.profiles(id) on delete cascade,[m
[32m+[m[32m  kind text not null check (kind in ('phone', 'email')),[m
[32m+[m[32m  created_at timestamptz not null default now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mcreate index if not exists contact_hashes_profile_idx on public.contact_hashes (profile_id);[m
[32m+[m
[32m+[m[32malter table public.contact_hashes enable row level security;[m
[32m+[m
[32m+[m[32mdrop policy if exists "contact_hashes_manage_own" on public.contact_hashes;[m
[32m+[m[32mcreate policy "contact_hashes_manage_own"[m
[32m+[m[32m  on public.contact_hashes for all[m
[32m+[m[32m  using (auth.uid() = profile_id)[m
[32m+[m[32m  with check (auth.uid() = profile_id);[m
[32m+[m
[32m+[m[32mdrop policy if exists "profiles_update_own_contact_fields" on public.profiles;[m
[32m+[m[32mcreate policy "profiles_update_own_contact_fields"[m
[32m+[m[32m  on public.profiles for update[m
[32m+[m[32m  using (auth.uid() = id)[m
[32m+[m[32m  with check (auth.uid() = id);[m
[32m+[m
[32m+[m[32m-- Fonction serveur : reçoit une liste de hachages (déjà calculés côté client,[m
[32m+[m[32m-- variantes comprises) et renvoie les profils publics qui correspondent, avec[m
[32m+[m[32m-- le hachage qui a matché (matched_hash) — ça permet au client de relier le[m
[32m+[m[32m-- résultat au contact précis de son répertoire, pour ensuite proposer[m
[32m+[m[32m-- d'inviter ceux qui n'ont pas matché. Jamais de numéro/e-mail en clair ni de[m
[32m+[m[32m-- hachage de tiers renvoyé au-delà de ce qui matche la requête.[m
[32m+[m[32mcreate or replace function public.find_users_by_contact_hashes(hashes text[])[m
[32m+[m[32mreturns table ([m
[32m+[m[32m  id uuid,[m
[32m+[m[32m  display_name text,[m
[32m+[m[32m  handle text,[m
[32m+[m[32m  avatar_url text,[m
[32m+[m[32m  flag text,[m
[32m+[m[32m  matched_via text,[m
[32m+[m[32m  matched_hash text[m
[32m+[m[32m)[m
[32m+[m[32mlanguage sql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32m  select p.id, p.display_name, p.handle, p.avatar_url, p.flag,[m
[32m+[m[32m         ch.kind as matched_via, ch.hash as matched_hash[m
[32m+[m[32m  from public.contact_hashes ch[m
[32m+[m[32m  join public.profiles p on p.id = ch.profile_id[m
[32m+[m[32m  where ch.hash = any(hashes)[m
[32m+[m[32m    and p.id <> auth.uid();[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mgrant execute on function public.find_users_by_contact_hashes(text[]) to authenticated, anon;[m
