[32m+[m[32m-- 5) Trigger : créer le profil automatiquement à l'inscription (persistance)[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.handle_new_user()[m
[32m+[m[32mRETURNS trigger[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  INSERT INTO public.profiles (id, display_name, handle, flag, bio, created_at, updated_at)[m
[32m+[m[32m  VALUES ([m
[32m+[m[32m    NEW.id,[m
[32m+[m[32m    COALESCE(NEW.raw_user_meta_data->>'display_name', 'Membre BAARO'),[m
[32m+[m[32m    COALESCE([m
[32m+[m[32m      NULLIF(NEW.raw_user_meta_data->>'handle', ''),[m
[32m+[m[32m      '@user_' || left(NEW.id::text, 8)[m
[32m+[m[32m    ),[m
[32m+[m[32m    COALESCE(NEW.raw_user_meta_data->>'flag', '🌍'),[m
[32m+[m[32m    '',[m
[32m+[m[32m    now(),[m
[32m+[m[32m    now()[m
[32m+[m[32m  )[m
[32m+[m[32m  ON CONFLICT (id) DO NOTHING;[m
[32m+[m
[32m+[m[32m  -- Wallet de base[m
[32m+[m[32m  BEGIN[m
[32m+[m[32m    INSERT INTO public.wallets (id, balance, updated_at)[m
[32m+[m[32m    VALUES (NEW.id, 0, now())[m
[32m+[m[32m    ON CONFLICT (id) DO NOTHING;[m
[32m+[m[32m  EXCEPTION WHEN undefined_table OR undefined_column THEN[m
[32m+[m[32m    BEGIN[m
[32m+[m[32m      INSERT INTO public.wallets (id, updated_at)[m
[32m+[m[32m      VALUES (NEW.id, now())[m
[32m+[m[32m      ON CONFLICT (id) DO NOTHING;[m
[32m+[m[32m    EXCEPTION WHEN OTHERS THEN[m
[32m+[m[32m      NULL;[m
[32m+[m[32m    END;[m
[32m+[m[32m  END;[m
[32m+[m
[32m+[m[32m  RETURN NEW;[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mDROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;[m
