[32m+[m[32m-- ===== SOURCE 0011_engagement_names_and_post_views.sql =====[m
[32m+[m[32m-- BAARO: engagement visibility for content owners[m
[32m+[m[32m-- Shows names of viewers/likers to the owner only.[m
[32m+[m[32m-- Adds post views and hardens video view RPC access.[m
[32m+[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32m-- 1) Post views: one counted view per authenticated viewer per UTC day.[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32malter table public.posts add column if not exists views_count bigint not null default 0;[m
[32m+[m
[32m+[m[32mcreate table if not exists public.post_views ([m
[32m+[m[32m  post_id uuid not null references public.posts(id) on delete cascade,[m
[32m+[m[32m  viewer_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  view_date date not null default current_date,[m
[32m+[m[32m  viewed_at timestamptz not null default now(),[m
[32m+[m[32m  primary key (post_id, viewer_id, view_date)[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mcreate index if not exists idx_post_views_post_date[m
[32m+[m[32m  on public.post_views(post_id, viewed_at desc);[m
[32m+[m[32mcreate index if not exists idx_post_views_viewer_date[m
[32m+[m[32m  on public.post_views(viewer_id, viewed_at desc);[m
[32m+[m
[32m+[m[32malter table public.post_views enable row level security;[m
[32m+[m[32mdrop policy if exists post_views_owner_read on public.post_views;[m
[32m+[m[32mcreate policy post_views_owner_read on public.post_views[m
[32m+[m[32m  for select to authenticated[m
[32m+[m[32m  using (exists ([m
[32m+[m[32m    select 1 from public.posts p[m
[32m+[m[32m    where p.id = post_id and p.author_id = auth.uid()[m
[32m+[m[32m  ));[m
[32m+[m
[32m+[m[32mdrop policy if exists post_views_client_insert on public.post_views;[m
[32m+[m
[32m+[m[32mcreate or replace function public.register_post_view(p_post_id uuid)[m
[32m+[m[32mreturns jsonb[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  uid uuid := auth.uid();[m
[32m+[m[32m  owner_id uuid;[m
[32m+[m[32m  inserted boolean := false;[m
[32m+[m[32m  new_views bigint := 0;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if uid is null then raise exception 'AUTH_REQUIRED'; end if;[m
[32m+[m
[32m+[m[32m  select author_id into owner_id from public.posts where id = p_post_id;[m
[32m+[m[32m  if owner_id is null then raise exception 'POST_NOT_FOUND'; end if;[m
[32m+[m
[32m+[m[32m  -- A creator opening their own post does not create an artificial view.[m
[32m+[m[32m  if owner_id = uid then[m
[32m+[m[32m    select coalesce(views_count, 0) into new_views from public.posts where id = p_post_id;[m
[32m+[m[32m    return jsonb_build_object('counted', false, 'views', new_views);[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  insert into public.post_views(post_id, viewer_id, view_date)[m
[32m+[m[32m  values (p_post_id, uid, current_date)[m
[32m+[m[32m  on conflict (post_id, viewer_id, view_date) do nothing;[m
[32m+[m
[32m+[m[32m  inserted := found;[m
[32m+[m[32m  if inserted then[m
[32m+[m[32m    update public.posts[m
[32m+[m[32m       set views_count = coalesce(views_count, 0) + 1,[m
[32m+[m[32m           updated_at = now()[m
[32m+[m[32m     where id = p_post_id[m
[32m+[m[32m     returning views_count into new_views;[m
[32m+[m[32m  else[m
[32m+[m[32m    select coalesce(views_count, 0) into new_views from public.posts where id = p_post_id;[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  return jsonb_build_object('counted', inserted, 'views', new_views);[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mrevoke all on function public.register_post_view(uuid) from public, anon;[m
[32m+[m[32mgrant execute on function public.register_post_view(uuid) to authenticated;[m
[32m+[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32m-- 2) Engagement-list RPCs. They expose identity data only to the content owner.[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32mcreate or replace function public.get_story_viewers(p_story_id uuid)[m
[32m+[m[32mreturns table(viewer_id uuid, display_name text, handle text, avatar_url text, flag text, viewed_at timestamptz)[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.uid() is null then raise exception 'AUTH_REQUIRED'; end if;[m
[32m+[m[32m  if not exists (select 1 from public.stories where id = p_story_id and author_id = auth.uid()) then raise exception 'ACCESS_DENIED'; end if;[m
[32m+[m[32m  return query[m
[32m+[m[32m    select v.viewer_id, p.display_name, p.handle, p.avatar_url, p.flag, v.viewed_at[m
[32m+[m[32m    from public.story_views v[m
[32m+[m[32m    left join public.profiles p on p.id = v.viewer_id[m
[32m+[m[32m    where v.story_id = p_story_id[m
