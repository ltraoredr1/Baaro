[32m+[m[32m-- Versioned legal consent. Store acceptance metadata, never the full document text.[m
[32m+[m[32mcreate table if not exists public.legal_consents ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  user_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  document_type text not null check(document_type in ('terms','privacy','community','creator','merchant','refund','cookies')),[m
[32m+[m[32m  version text not null,[m
[32m+[m[32m  accepted_at timestamptz not null default now(),[m
[32m+[m[32m  ip_hash text,[m
[32m+[m[32m  user_agent_hash text,[m
[32m+[m[32m  unique(user_id, document_type, version)[m
[32m+[m[32m);[m
[32m+[m[32malter table public.legal_consents enable row level security;[m
[32m+[m[32mdrop policy if exists legal_consents_read_own on public.legal_consents;[m
[32m+[m[32mcreate policy legal_consents_read_own on public.legal_consents for select to authenticated using(user_id=auth.uid());[m
[32m+[m[32mrevoke insert,update,delete on public.legal_consents from anon,authenticated;[m
[32m+[m[32mcreate or replace function public.record_legal_consent(p_document_type text,p_version text,p_ip_hash text default null,p_user_agent_hash text default null)[m
[32m+[m[32mreturns uuid language plpgsql security definer set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare v_id uuid; v_uid uuid := auth.uid();[m
[32m+[m[32mbegin[m
[32m+[m[32m  if v_uid is null then raise exception 'AUTH_REQUIRED'; end if;[m
[32m+[m[32m  if p_document_type not in ('terms','privacy','community','creator','merchant','refund','cookies') then raise exception 'INVALID_DOCUMENT'; end if;[m
[32m+[m[32m  if p_version is null or length(trim(p_version))=0 then raise exception 'INVALID_VERSION'; end if;[m
[32m+[m[32m  insert into public.legal_consents(user_id,document_type,version,ip_hash,user_agent_hash)[m
[32m+[m[32m  values(v_uid,lower(trim(p_document_type)),trim(p_version),p_ip_hash,p_user_agent_hash)[m
