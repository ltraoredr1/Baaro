[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0009_fix_debates_security.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- Correctifs de sécurité pour les Débats/Lives — à exécuter APRÈS[m
[32m+[m[32m-- supabase-add-debates.sql, dans une nouvelle requête du SQL Editor[m
[32m+[m[32m-- Supabase.[m
[32m+[m[32m--[m
[32m+[m[32m-- 1) Le code d'invitation n'était pas vraiment secret. L'ancienne policy[m
[32m+[m[32m--    de lecture ("auth.uid() is not null") laissait n'importe quel[m
[32m+[m[32m--    compte connecté — même anonyme — faire un simple[m
[32m+[m[32m--    `select * from debate_rooms` et lire ainsi l'invite_code de TOUS[m
[32m+[m[32m--    les salons, pas seulement les siens. On restreint désormais la[m
[32m+[m[32m--    lecture aux salons dont on est l'hôte ou déjà participant·e, et on[m
[32m+[m[32m--    fait passer la vérification du code par une fonction serveur (RPC)[m
[32m+[m[32m--    qui, elle, est autorisée à lire la table sans être limitée par[m
[32m+[m[32m--    cette policy — c'est elle qui décide si le code est valide.[m
[32m+[m[32m--[m
[32m+[m[32m-- 2) On empêche un·e participant·e de faire passer un message pour un[m
[32m+[m[32m--    message de l'IA ou du système : avant, seul le type (sender_type)[m
[32m+[m[32m--    était vérifié, n'importe qui pouvait insérer sender_type='ai' avec[m
[32m+[m[32m--    n'importe quel sender_id. On impose désormais sender_id = null[m
[32m+[m[32m--    pour ces deux types.[m
[32m+[m[32m--[m
[32m+[m[32m-- 3) Le nouveau mode "Live" (un·e seul·e hôte diffuse, façon TikTok Live)[m
[32m+[m[32m--    supporte davantage de monde qu'un débat à plusieurs caméras : on[m
[32m+[m[32m--    relève le plafond de spectateur·ices.[m
[32m+[m
[32m+[m[32m-- --- 1) Lecture restreinte + fonction de jointure par code -----------[m
[32m+[m
[32m+[m[32mdrop policy if exists "debate_rooms_read" on debate_rooms;[m
[32m+[m[32mcreate policy "debate_rooms_read" on debate_rooms for select using ([m
[32m+[m[32m  auth.uid() = host_id[m
[32m+[m[32m  or exists ([m
[32m+[m[32m    select 1 from debate_participants dp[m
[32m+[m[32m    where dp.room_id = debate_rooms.id and dp.user_id = auth.uid()[m
[32m+[m[32m  )[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- Rejoindre un live par code : fonction "security definer", donc elle[m
[32m+[m[32m-- peut lire debate_rooms (y compris invite_code) même si l'appelant·e[m
[32m+[m[32m-- n'a pas encore le droit de lire cette ligne. Elle vérifie le code et[m
[32m+[m[32m-- la capacité, puis ajoute l'appelant·e comme participant·e — c'est[m
[32m+[m[32m-- l'unique porte d'entrée pour rejoindre par code désormais.[m
[32m+[m[32mcreate or replace function join_debate_by_code(p_code text)[m
[32m+[m[32mreturns debate_rooms[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_room debate_rooms;[m
[32m+[m[32m  v_count int;[m
[32m+[m[32mbegin[m
[32m+[m[32m  select * into v_room from debate_rooms[m
[32m+[m[32m    where invite_code = lower(trim(p_code)) and status = 'active';[m
[32m+[m
[32m+[m[32m  if not found then[m
[32m+[m[32m    raise exception 'Aucun live actif avec ce code.';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  select count(*) into v_count from debate_participants[m
[32m+[m[32m    where room_id = v_room.id and left_at is null;[m
[32m+[m
[32m+[m[32m  if v_count >= v_room.max_participants then[m
[32m+[m[32m    raise exception 'Ce live est complet.';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  insert into debate_participants (room_id, user_id, joined_at, left_at)[m
[32m+[m[32m  values (v_room.id, auth.uid(), now(), null)[m
[32m+[m[32m  on conflict (room_id, user_id) do update set left_at = null, joined_at = now();[m
[32m+[m
[32m+[m[32m  return v_room;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mgrant execute on function join_debate_by_code(text) to authenticated, anon;[m
[32m+[m
[32m+[m[32m-- --- 2) Empêcher l'usurpation des messages IA/système -----------------[m
[32m+[m
[32m+[m[32mdrop policy if exists "debate_messages_insert" on debate_messages;[m
[32m+[m[32mcreate policy "debate_messages_insert" on debate_messages for insert with check ([m
[32m+[m[32m  exists (select 1 from debate_participants dp where dp.room_id = debate_messages.room_id and dp.user_id = auth.uid())[m
[32m+[m[32m  and ([m
[32m+[m[32m    (sender_type = 'user' and sender_id = auth.uid())[m
[32m+[m[32m    or (sender_type in ('ai', 'system') and sender_id is null)[m
[32m+[m[32m  )[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- --- 3) Plafond de spectateur·ices relevé ------------------------------[m
[32m+[m
[32m+[m[32malter table debate_rooms drop constraint if exists debate_rooms_max_participants_check;[m
[32m+[m[32malter table debate_rooms add constraint debate_rooms_max_participants_check[m
[32m+[m[32m  check (max_participants between 2 and 50);[m
[32m+[m
[32m+[m[32m-- Note : la fonction join_debate_by_code() ne se substitue pas à un vrai[m
[32m+[m[32m-- rate limiting contre le brute-force d'un code à 8 caractères — pour un[m
[32m+[m[32m-- lancement à fort trafic, envisager d'ajouter une limite de tentatives[m
[32m+[m[32m-- (par IP ou par compte) côté edge function si besoin.[m
[32m+[m
