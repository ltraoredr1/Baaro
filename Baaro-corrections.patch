[32m+[m[32m      returning views into new_views;[m
[32m+[m[32m  else[m
[32m+[m[32m    select coalesce(views, 0) into new_views[m
[32m+[m[32m    from public.videos where id = p_video_id;[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  return jsonb_build_object('counted', inserted, 'views', new_views);[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mrevoke all on function public.register_video_view(uuid) from public, anon;[m
