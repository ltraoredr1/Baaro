[32m+[m[32m  after insert or delete on public.comments[m
[32m+[m[32m  for each row execute function public.baaro_sync_post_comment_count();[m
[32m+[m
[32m+[m[32m-- 5. Trigger compteur likes[m
[32m+[m[32mcreate or replace function public.baaro_sync_post_like_count()[m
[32m+[m[32mreturns trigger[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  target_post_id uuid;[m
[32m+[m[32mbegin[m
[32m+[m[32m  target_post_id := case when tg_op = 'DELETE' then old.post_id else new.post_id end;[m
[32m+[m
[32m+[m[32m  update public.posts[m
[32m+[m[32m  set likes_count = ([m
[32m+[m[32m    select count(*)::int from public.post_likes where post_id = target_post_id[m
[32m+[m[32m  )[m
[32m+[m[32m  where id = target_post_id;[m
[32m+[m
[32m+[m[32m  return case when tg_op = 'DELETE' then old else new end;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mdrop trigger if exists trg_baaro_post_like_count on public.post_likes;[m
[32m+[m[32mcreate trigger trg_baaro_post_like_count[m
[32m+[m[32m  after insert or delete on public.post_likes[m
[32m+[m[32m  for each row execute function public.baaro_sync_post_like_count();[m
[32m+[m
[32m+[m[32m-- 6. Recalcul global des compteurs[m
[32m+[m[32mupdate public.posts p[m
[32m+[m[32mset comments_count = coalesce(([m
[32m+[m[32m  select count(*)::int from public.comments c where c.post_id = p.id[m
[32m+[m[32m), 0);[m
[32m+[m
[32m+[m[32mupdate public.posts p[m
[32m+[m[32mset likes_count = coalesce(([m
[32m+[m[32m  select count(*)::int from public.post_likes l where l.post_id = p.id[m
[32m+[m[32m), 0);[m
[32m+[m
[32m+[m[32mupdate public.posts set comments_count = 0 where comments_count < 0;[m
[32m+[m[32mupdate public.posts set likes_count = 0 where likes_count < 0;[m
[32m+[m
[32m+[m[32m-- 7. Realtime (ignore si deja present)[m
[32m+[m[32mdo $$[m
