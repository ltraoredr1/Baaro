[32m+[m[32m-- Calls: participants may update status, but identity/room fields cannot be rewritten.[m
[32m+[m[32mcreate or replace function public.prevent_call_identity_change()[m
[32m+[m[32mreturns trigger[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if new.caller_id <> old.caller_id[m
[32m+[m[32m     or new.callee_id <> old.callee_id[m
[32m+[m[32m     or coalesce(new.conversation_id::text, '') <> coalesce(old.conversation_id::text, '')[m
[32m+[m[32m     or coalesce(new.daily_room_name, '') <> coalesce(old.daily_room_name, '')[m
[32m+[m[32m     or new.type <> old.type[m
[32m+[m[32m     or new.created_at <> old.created_at then[m
[32m+[m[32m    raise exception 'CALL_IDENTITY_FIELDS_IMMUTABLE';[m
[32m+[m[32m  end if;[m
[32m+[m[32m  if new.status not in ('ringing','accepted','rejected','missed','ended','cancelled') then[m
[32m+[m[32m    raise exception 'INVALID_CALL_STATUS';[m
[32m+[m[32m  end if;[m
[32m+[m[32m  return new;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mdrop trigger if exists trg_calls_immutable_identity on public.calls;[m
[32m+[m[32mcreate trigger trg_calls_immutable_identity[m
[32m+[m[32mbefore update on public.calls[m
[32m+[m[32mfor each row execute function public.prevent_call_identity_change();[m
[32m+[m
[32m+[m[32mdrop policy if exists calls_participant_update on public.calls;[m
[32m+[m[32mcreate policy calls_participant_update on public.calls[m
[32m+[m[32m  for update[m
