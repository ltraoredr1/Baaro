[32m+[m[32m-- Only a participant may send a gift in an active room.[m
[32m+[m[32mcreate or replace function public.wallet_send_gift([m
[32m+[m[32m  p_sender_id uuid,[m
[32m+[m[32m  p_room_id uuid,[m
[32m+[m[32m  p_gift_type_id text[m
[32m+[m[32m)[m
[32m+[m[32mreturns jsonb[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  room public.debate_rooms%rowtype;[m
[32m+[m[32m  gift public.gift_types%rowtype;[m
[32m+[m[32m  sender public.wallets%rowtype;[m
[32m+[m[32m  host public.wallets%rowtype;[m
[32m+[m[32m  gift_row public.gifts_sent%rowtype;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if p_sender_id is null or p_room_id is null or p_gift_type_id is null then raise exception 'INVALID_GIFT_REQUEST'; end if;[m
[32m+[m[32m  select * into room from public.debate_rooms where id = p_room_id for share;[m
[32m+[m[32m  if not found or room.status <> 'active' then raise exception 'LIVE_NOT_FOUND'; end if;[m
[32m+[m[32m  if room.host_id = p_sender_id then raise exception 'SELF_GIFT_FORBIDDEN'; end if;[m
[32m+[m[32m  if not exists (select 1 from public.debate_participants where room_id = p_room_id and user_id = p_sender_id) then[m
[32m+[m[32m    raise exception 'NOT_LIVE_PARTICIPANT';[m
[32m+[m[32m  end if;[m
[32m+[m[32m  select * into gift from public.gift_types where id = p_gift_type_id for share;[m
[32m+[m[32m  if not found or gift.cost_points <= 0 then raise exception 'GIFT_NOT_FOUND'; end if;[m
[32m+[m
[32m+[m[32m  if p_sender_id::text < room.host_id::text then[m
[32m+[m[32m    perform public.wallet_ensure(p_sender_id, 0); perform public.wallet_ensure(room.host_id, 0);[m
[32m+[m[32m    select * into sender from public.wallets where id = p_sender_id for update;[m
[32m+[m[32m    select * into host from public.wallets where id = room.host_id for update;[m
[32m+[m[32m  else[m
[32m+[m[32m    perform public.wallet_ensure(room.host_id, 0); perform public.wallet_ensure(p_sender_id, 0);[m
[32m+[m[32m    select * into host from public.wallets where id = room.host_id for update;[m
[32m+[m[32m    select * into sender from public.wallets where id = p_sender_id for update;[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  if sender.balance < gift.cost_points then raise exception 'INSUFFICIENT_BALANCE'; end if;[m
[32m+[m[32m  update public.wallets set balance = balance - gift.cost_points, updated_at = now() where user_id = p_sender_id;[m
[32m+[m[32m  update public.wallets set balance = balance + gift.cost_points, updated_at = now() where user_id = room.host_id;[m
[32m+[m[32m  insert into public.transactions(user_id, label, pts, action_key, day_key)[m
[32m+[m[32m  values[m
[32m+[m[32m    (p_sender_id, 'Cadeau envoyé : ' || gift.id, -gift.cost_points, 'gift_sent', current_date),[m
[32m+[m[32m    (room.host_id, 'Cadeau reçu : ' || gift.id, gift.cost_points, 'gift_received', current_date);[m
[32m+[m[32m  insert into public.gifts_sent(room_id, from_user_id, to_user_id, gift_type_id, points_spent)[m
[32m+[m[32m  values (p_room_id, p_sender_id, room.host_id, gift.id, gift.cost_points)[m
[32m+[m[32m  returning * into gift_row;[m
[32m+[m[32m  select * into sender from public.wallets where id = p_sender_id;[m
[32m+[m[32m  return jsonb_build_object('balance', sender.balance, 'gift', to_jsonb(gift_row));[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m[32mrevoke all on function public.wallet_send_gift(uuid, uuid, text) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.wallet_send_gift(uuid, uuid, text) to service_role;[m
