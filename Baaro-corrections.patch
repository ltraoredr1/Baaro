[32m+[m[32m-- ===== SOURCE 0006_baaro_future_nexus.sql =====[m
[32m+[m[32m-- BAARO Future Nexus: user-controlled intelligence, trust, goals and interoperable spaces.[m
[32m+[m[32m-- No secret material is stored here. Sensitive AI memory is explicit, scoped and deletable by the owner.[m
[32m+[m
[32m+[m[32mcreate table if not exists public.nexus_preferences ([m
[32m+[m[32m  user_id uuid primary key references auth.users(id) on delete cascade,[m
