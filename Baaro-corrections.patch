[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0034_canonical_user_id.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO — Identité canonique unique[m
[32m+[m[32m-- Source de vérité utilisateur: auth.users.id (UUID Supabase Auth).[m
[32m+[m[32m-- Les identifiants locaux, emails, handles et noms ne doivent jamais être utilisés[m
[32m+[m[32m-- comme clés de relation utilisateur.[m
[32m+[m
[32m+[m[32mDO $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  r record;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  -- Tables principales: ajouter la FK vers auth.users si une colonne utilisateur[m
[32m+[m[32m  -- existe et qu'une FK équivalente n'est pas déjà présente.[m
[32m+[m[32m  FOR r IN[m
[32m+[m[32m    SELECT * FROM (VALUES[m
[32m+[m[32m      ('profiles','user_id'),[m
[32m+[m[32m      ('wallets','user_id'),[m
[32m+[m[32m      ('transactions','user_id'),[m
[32m+[m[32m      ('post_likes','user_id'),[m
[32m+[m[32m      ('comments','author_id'),[m
[32m+[m[32m      ('follows','follower_id'),[m
[32m+[m[32m      ('follows','followed_id'),[m
[32m+[m[32m      ('messages','sender_id'),[m
[32m+[m[32m      ('messages','recipient_id'),[m
[32m+[m[32m      ('videos','author_id'),[m
[32m+[m[32m      ('notifications','user_id'),[m
[32m+[m[32m      ('notification_preferences','user_id'),[m
[32m+[m[32m      ('push_tokens','user_id'),[m
[32m+[m[32m      ('post_reactions','user_id'),[m
[32m+[m[32m      ('post_bookmarks','user_id'),[m
[32m+[m[32m      ('post_shares','user_id'),[m
[32m+[m[32m      ('poll_votes','user_id'),[m
[32m+[m[32m      ('group_members','user_id'),[m
[32m+[m[32m      ('channel_messages','sender_id'),[m
[32m+[m[32m      ('voice_participants','user_id'),[m
[32m+[m[32m      ('debate_participants','user_id'),[m
[32m+[m[32m      ('debate_messages','sender_id'),[m
[32m+[m[32m      ('wallet_ledger','user_id')[m
[32m+[m[32m    ) AS x(table_name, column_name)[m
[32m+[m[32m  LOOP[m
[32m+[m[32m    IF to_regclass('public.' || r.table_name) IS NOT NULL[m
[32m+[m[32m       AND EXISTS ([m
[32m+[m[32m         SELECT 1 FROM information_schema.columns c[m
[32m+[m[32m         WHERE c.table_schema='public' AND c.table_name=r.table_name[m
[32m+[m[32m           AND c.column_name=r.column_name AND c.udt_name='uuid'[m
[32m+[m[32m       )[m
[32m+[m[32m       AND NOT EXISTS ([m
[32m+[m[32m         SELECT 1 FROM pg_constraint c[m
[32m+[m[32m         WHERE c.conrelid=('public.'||r.table_name)::regclass[m
[32m+[m[32m           AND c.contype='f'[m
[32m+[m[32m           AND c.confrelid='auth.users'::regclass[m
[32m+[m[32m           AND pg_get_constraintdef(c.oid) ILIKE '%'||r.column_name||'%'[m
[32m+[m[32m       ) THEN[m
[32m+[m[32m      BEGIN[m
[32m+[m[32m        EXECUTE format([m
[32m+[m[32m          'ALTER TABLE public.%I ADD CONSTRAINT %I FOREIGN KEY (%I) REFERENCES auth.users(id) ON DELETE CASCADE',[m
[32m+[m[32m          r.table_name, left(r.table_name||'_'||r.column_name||'_auth_fk', 63), r.column_name[m
[32m+[m[32m        );[m
[32m+[m[32m      EXCEPTION WHEN duplicate_object THEN NULL;[m
[32m+[m[32m      END;[m
[32m+[m[32m    END IF;[m
[32m+[m[32m  END LOOP;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- Empêcher les relations self-follow et les profils sans utilisateur.[m
[32m+[m[32mDO $$ BEGIN[m
[32m+[m[32m  IF to_regclass('public.follows') IS NOT NULL THEN[m
[32m+[m[32m    BEGIN[m
[32m+[m[32m      ALTER TABLE public.follows ADD CONSTRAINT follows_no_self CHECK (follower_id <> followed_id);[m
[32m+[m[32m    EXCEPTION WHEN duplicate_object THEN NULL;[m
[32m+[m[32m    END;[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- RLS: une ligne appartenant à un utilisateur ne peut être créée/modifiée[m
[32m+[m[32m-- qu'avec son auth.uid(). Les policies existantes plus spécifiques restent intactes.[m
[32m+[m[32mALTER TABLE IF EXISTS public.profiles ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE IF EXISTS public.wallets ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE IF EXISTS public.post_likes ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE IF EXISTS public.post_reactions ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE IF EXISTS public.post_bookmarks ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE IF EXISTS public.post_shares ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE IF EXISTS public.poll_votes ENABLE ROW LEVEL SECURITY;[m
[32m+[m
[32m+[m[32mCOMMENT ON SCHEMA public IS 'BAARO: auth.users.id is the single canonical user identity for all user relations.';[m
[32m+[m
