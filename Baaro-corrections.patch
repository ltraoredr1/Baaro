[32m+[m[32m    'Membre BAARO'[m
[32m+[m[32m  ), 80);[m
[32m+[m
[32m+[m[32m  v_handle := lower(trim(coalesce([m
[32m+[m[32m    nullif(new.raw_user_meta_data ->> 'handle', ''),[m
