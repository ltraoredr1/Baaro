[32m+[m[32mrevoke all on function public.wallet_earn(uuid, numeric, text, text, numeric, boolean, uuid) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.wallet_earn(uuid, numeric, text, text, numeric, boolean, uuid) to service_role;[m
