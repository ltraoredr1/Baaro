[32m+[m[32mcreate or replace function public.fulfill_monetization_checkout(p_intent_id uuid,p_provider text,p_provider_reference text)[m
[32m+[m[32mreturns boolean[m
[32m+[m[32mlanguage plpgsql security definer set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare i public.monetization_checkout_intents; now_end timestamptz;[m
[32m+[m[32mbegin[m
[32m+[m[32m if auth.role() <> 'service_role' then raise exception 'SERVICE_ROLE_REQUIRED'; end if;[m
[32m+[m[32m select * into i from public.monetization_checkout_intents where id=p_intent_id for update;[m
[32m+[m[32m if not found then raise exception 'CHECKOUT_NOT_FOUND'; end if;[m
[32m+[m[32m if i.status='paid' then return true; end if;[m
[32m+[m[32m if i.status not in ('pending','processing') then raise exception 'CHECKOUT_NOT_PAYABLE'; end if;[m
[32m+[m[32m update public.monetization_checkout_intents set status='paid',provider=p_provider,provider_reference=p_provider_reference,updated_at=now() where id=i.id;[m
[32m+[m[32m if i.product_code='premium_monthly' then[m
[32m+[m[32m   now_end:=now()+interval '30 days';[m
[32m+[m[32m   insert into public.premium_subscriptions(user_id,status,provider,provider_reference,current_period_end) values(i.user_id,'active',p_provider,p_provider_reference,now_end)[m
[32m+[m[32m   on conflict(user_id) do update set status='active',provider=excluded.provider,provider_reference=excluded.provider_reference,current_period_start=now(),current_period_end=excluded.current_period_end,updated_at=now();[m
[32m+[m[32m elsif i.product_code='pro_merchant_monthly' then[m
[32m+[m[32m   insert into public.merchant_pro_subscriptions(merchant_id,status,current_period_end) values(i.user_id,'active',now()+interval '30 days')[m
[32m+[m[32m   on conflict(merchant_id) do update set status='active',current_period_end=excluded.current_period_end,updated_at=now();[m
[32m+[m[32m elsif i.product_code='cosmetics_pack_6' then[m
[32m+[m[32m   insert into public.user_cosmetics(user_id,cosmetic_code,quantity) values(i.user_id,'animated_pack',6)[m
[32m+[m[32m   on conflict(user_id,cosmetic_code) do update set quantity=public.user_cosmetics.quantity+6;[m
[32m+[m[32m elsif i.product_code='ai_pack_10' then[m
[32m+[m[32m   insert into public.ai_usage_daily(user_id,usage_date,paid_generations,units_used) values(i.user_id,current_date,10,10)[m
[32m+[m[32m   on conflict(user_id,usage_date) do update set paid_generations=public.ai_usage_daily.paid_generations+10,units_used=public.ai_usage_daily.units_used+10;[m
[32m+[m[32m elsif i.product_code='job_boost_7d' then[m
[32m+[m[32m   insert into public.job_profile_boosts(user_id,ends_at,status) values(i.user_id,now()+interval '7 days','active');[m
[32m+[m[32m elsif i.product_code='api_starter_monthly' then[m
[32m+[m[32m   insert into public.api_subscriptions(owner_id,plan_code,status,current_period_end) values(i.user_id,'starter','active',now()+interval '30 days');[m
[32m+[m[32m end if;[m
[32m+[m[32m return true;[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.fulfill_monetization_checkout(uuid,text,text) from public,anon,authenticated;[m
[32m+[m[32mgrant execute on function public.fulfill_monetization_checkout(uuid,text,text) to service_role;[m
