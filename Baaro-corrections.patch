[32m+[m[32m-- SOURCE: 0038_profile_social_fix.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 1. Adaptation dynamique de la table 'follows' existante[m
[32m+[m[32mDO $$[m[41m [m
[32m+[m[32mBEGIN[m
[32m+[m[32m    -- Si la table n'existe pas, on la crée[m
[32m+[m[32m    IF NOT EXISTS (SELECT FROM pg_tables WHERE schemaname = 'public' AND tablename = 'follows') THEN[m
[32m+[m[32m        CREATE TABLE public.follows ([m
[32m+[m[32m            follower_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,[m
[32m+[m[32m            following_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE,[m
[32m+[m[32m            created_at TIMESTAMP WITH TIME ZONE DEFAULT timezone('utc'::text, now()) NOT NULL,[m
[32m+[m[32m            PRIMARY KEY (follower_id, following_id)[m
[32m+[m[32m        );[m
[32m+[m[32m    ELSE[m
[32m+[m[32m        -- Renommer 'followed_id' en 'following_id' si la colonne s'appelait ainsi[m
[32m+[m[32m        IF EXISTS (SELECT FROM information_schema.columns WHERE table_name = 'follows' AND column_name = 'followed_id') THEN[m
[32m+[m[32m            ALTER TABLE public.follows RENAME COLUMN followed_id TO following_id;[m
[32m+[m[32m        -- Renommer 'target_id' en 'following_id' si la colonne s'appelait ainsi[m
[32m+[m[32m        ELSIF EXISTS (SELECT FROM information_schema.columns WHERE table_name = 'follows' AND column_name = 'target_id') THEN[m
[32m+[m[32m            ALTER TABLE public.follows RENAME COLUMN target_id TO following_id;[m
[32m+[m[32m        -- Si 'following_id' n'existe toujours pas, on l'ajoute[m
[32m+[m[32m        ELSIF NOT EXISTS (SELECT FROM information_schema.columns WHERE table_name = 'follows' AND column_name = 'following_id') THEN[m
[32m+[m[32m            ALTER TABLE public.follows ADD COLUMN following_id UUID NOT NULL REFERENCES public.profiles(id) ON DELETE CASCADE;[m
[32m+[m[32m        END IF;[m
[32m+[m[32m    END IF;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- 2. Indexation pour optimiser les performances[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_follows_follower ON public.follows(follower_id);[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_follows_following ON public.follows(following_id);[m
[32m+[m
[32m+[m[32m-- 3. Activation et réinitialisation des politiques RLS[m
[32m+[m[32mALTER TABLE public.follows ENABLE ROW LEVEL SECURITY;[m
[32m+[m
