[32m+[m[32mdeclare[m
[32m+[m[32m  total integer;[m
[32m+[m[32mbegin[m
[32m+[m[32m  select count(*) into total[m
[32m+[m[32m  from public.profile_contacts[m
[32m+[m[32m  where user_id = new.user_id[m
[32m+[m[32m    and contact_type = new.contact_type[m
[32m+[m[32m    and id <> coalesce(new.id, '00000000-0000-0000-0000-000000000000'::uuid);[m
[32m+[m
[32m+[m[32m  if total >= 3 then[m
[32m+[m[32m    raise exception 'Maximum de 3 contacts de ce type par profil';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  return new;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
