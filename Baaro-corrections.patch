[32m+[m[32mcreate or replace function public.join_community_group([m
[32m+[m[32m  p_group uuid default null,[m
[32m+[m[32m  p_code text default null[m
[32m+[m[32m)[m
[32m+[m[32mreturns jsonb[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_uid uuid := auth.uid();[m
[32m+[m[32m  v_group_id uuid;[m
[32m+[m[32m  v_public boolean;[m
[32m+[m[32m  v_inv public.group_invites;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if v_uid is null then[m
[32m+[m[32m    raise exception 'Non authentifié';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  -- Mode 1: code d'invitation[m
[32m+[m[32m  if p_code is not null and length(trim(p_code)) > 0 then[m
[32m+[m[32m    select * into v_inv[m
[32m+[m[32m    from public.group_invites[m
[32m+[m[32m    where upper(code) = upper(trim(p_code))[m
[32m+[m[32m      and (expires_at is null or expires_at > now())[m
[32m+[m[32m      and (coalesce(max_uses, 0) = 0 or coalesce(uses, 0) < max_uses)[m
[32m+[m[32m    for update;[m
[32m+[m
[32m+[m[32m    if not found then[m
[32m+[m[32m      raise exception 'Invitation invalide ou expirée';[m
[32m+[m[32m    end if;[m
[32m+[m
[32m+[m[32m    v_group_id := v_inv.group_id;[m
[32m+[m
[32m+[m[32m    if public.is_banned(v_group_id, v_uid) then[m
[32m+[m[32m      raise exception 'Accès refusé';[m
[32m+[m[32m    end if;[m
[32m+[m
[32m+[m[32m    if public.group_role(v_group_id) is not null then[m
[32m+[m[32m      return jsonb_build_object([m
[32m+[m[32m        'ok', true,[m
[32m+[m[32m        'group_id', v_group_id,[m
[32m+[m[32m        'already_member', true[m
[32m+[m[32m      );[m
[32m+[m[32m    end if;[m
[32m+[m
[32m+[m[32m    update public.group_invites[m
[32m+[m[32m    set uses = coalesce(uses, 0) + 1[m
[32m+[m[32m    where id = v_inv.id;[m
[32m+[m
[32m+[m[32m    insert into public.group_members (group_id, user_id, role)[m
[32m+[m[32m    values (v_group_id, v_uid, 'member')[m
[32m+[m[32m    on conflict do nothing;[m
[32m+[m
[32m+[m[32m    return jsonb_build_object([m
[32m+[m[32m      'ok', true,[m
[32m+[m[32m      'group_id', v_group_id,[m
[32m+[m[32m      'via', 'invite'[m
[32m+[m[32m    );[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  -- Mode 2: groupe public[m
[32m+[m[32m  if p_group is null then[m
[32m+[m[32m    raise exception 'Groupe ou code requis';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  v_group_id := p_group;[m
[32m+[m
[32m+[m[32m  if public.is_banned(v_group_id, v_uid) then[m
[32m+[m[32m    raise exception 'Accès refusé';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  if public.group_role(v_group_id) is not null then[m
[32m+[m[32m    return jsonb_build_object([m
[32m+[m[32m      'ok', true,[m
[32m+[m[32m      'group_id', v_group_id,[m
[32m+[m[32m      'already_member', true[m
[32m+[m[32m    );[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  select coalesce(is_public, true) into v_public[m
[32m+[m[32m  from public.groups[m
[32m+[m[32m  where id = v_group_id;[m
[32m+[m
[32m+[m[32m  if not found then[m
[32m+[m[32m    raise exception 'Groupe introuvable';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  if not v_public then[m
[32m+[m[32m    raise exception 'Groupe privé : code d''invitation requis';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  insert into public.group_members (group_id, user_id, role)[m
[32m+[m[32m  values (v_group_id, v_uid, 'member')[m
[32m+[m[32m  on conflict do nothing;[m
[32m+[m
[32m+[m[32m  return jsonb_build_object([m
[32m+[m[32m    'ok', true,[m
[32m+[m[32m    'group_id', v_group_id,[m
[32m+[m[32m    'via', 'public'[m
[32m+[m[32m  );[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mgrant execute on function public.join_community_group(uuid, text) to authenticated;[m
[32m+[m
[32m+[m[32mcreate or replace function public.ban_community_member([m
[32m+[m[32m  p_group uuid,[m
[32m+[m[32m  p_user uuid,[m
[32m+[m[32m  p_reason text default null[m
[32m+[m[32m)[m
[32m+[m[32mreturns void[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_actor text := public.group_role(p_group);[m
[32m+[m[32m  v_target text;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.uid() is null then raise exception 'Non authentifié'; end if;[m
[32m+[m[32m  if p_user = auth.uid() then raise exception 'Action impossible sur soi-même'; end if;[m
[32m+[m
[32m+[m[32m  select case when g.owner_id = p_user then 'owner' else gm.role end[m
[32m+[m[32m  into v_target[m
[32m+[m[32m  from public.groups g[m
[32m+[m[32m  left join public.group_members gm[m
[32m+[m[32m    on gm.group_id = g.id and gm.user_id = p_user[m
[32m+[m[32m  where g.id = p_group;[m
[32m+[m
[32m+[m[32m  if public.role_rank(v_actor) < 1[m
[32m+[m[32m     or public.role_rank(v_actor) <= public.role_rank(v_target) then[m
[32m+[m[32m    raise exception 'Droits insuffisants';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  insert into public.group_bans (group_id, user_id, banned_by, reason)[m
[32m+[m[32m  values (p_group, p_user, auth.uid(), left(p_reason, 300))[m
[32m+[m[32m  on conflict do nothing;[m
[32m+[m
[32m+[m[32m  delete from public.group_members[m
[32m+[m[32m  where group_id = p_group and user_id = p_user;[m
[32m+[m[32mend $$;[m
[32m+[m
[32m+[m[32mcreate or replace function public.unban_community_member([m
[32m+[m[32m  p_group uuid,[m
[32m+[m[32m  p_user uuid[m
[32m+[m[32m)[m
[32m+[m[32mreturns void[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if public.role_rank(public.group_role(p_group)) < 1 then[m
[32m+[m[32m    raise exception 'Droits insuffisants';[m
[32m+[m[32m  end if;[m
[32m+[m[32m  delete from public.group_bans where group_id = p_group and user_id = p_user;[m
[32m+[m[32mend $$;[m
[32m+[m
[32m+[m[32mcreate or replace function public.set_member_role([m
[32m+[m[32m  p_group uuid,[m
[32m+[m[32m  p_user uuid,[m
[32m+[m[32m  p_role text[m
[32m+[m[32m)[m
[32m+[m[32mreturns void[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_actor text := public.group_role(p_group);[m
[32m+[m[32m  v_target text;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if coalesce(p_role, '') not in ('admin','moderator','member') then[m
[32m+[m[32m    raise exception 'Rôle invalide';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  select role into v_target from public.group_members[m
[32m+[m[32m  where group_id = p_group and user_id = p_user;[m
[32m+[m[32m  if v_target is null then raise exception 'Membre introuvable'; end if;[m
[32m+[m[32m  if v_target = 'owner' then raise exception 'Le propriétaire ne peut pas changer'; end if;[m
[32m+[m
[32m+[m[32m  if v_actor = 'owner' then[m
[32m+[m[32m    null;[m
[32m+[m[32m  elsif v_actor = 'admin' and p_role <> 'admin' and v_target <> 'admin' then[m
[32m+[m[32m    null;[m
[32m+[m[32m  else[m
[32m+[m[32m    raise exception 'Droits insuffisants';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  update public.group_members set role = p_role[m
[32m+[m[32m  where group_id = p_group and user_id = p_user;[m
[32m+[m[32mend $$;[m
