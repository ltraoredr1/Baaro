[32m+[m[32m-- SOURCE: 0054_fix_social_interactions.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO — Correction des interactions sociales (Feed & Sondages)[m
[32m+[m[32m-- Fichier : 053_fix_social_interactions.sql[m
[32m+[m[32m-- Date : 26 septembre 2026[m
[32m+[m[32m--[m[41m [m
[32m+[m[32m-- Objectif : Aligner les fonctions SQL avec le schéma réel[m[41m [m
[32m+[m[32m-- (user_id au lieu de id, display_name au lieu de full_name,[m[41m [m
[32m+[m[32m-- et éviter les UPDATE sur les vues).[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32m-- 1. Corriger vote_poll (ne pas UPDATE la vue poll_results, le COUNT est automatique)[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.vote_poll(p_poll_id uuid, p_option_id uuid)[m
[32m+[m[32mRETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $function$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  v_post_id uuid;[m
[32m+[m[32m  v_user_id uuid;[m
[32m+[m[32m  v_option_index integer;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  v_user_id := auth.uid();[m
[32m+[m[32m  IF v_user_id IS NULL THEN RAISE EXCEPTION 'User not authenticated'; END IF;[m
[32m+[m[41m  [m
[32m+[m[32m  SELECT p.post_id, po.position INTO v_post_id, v_option_index[m
[32m+[m[32m  FROM polls p[m
[32m+[m[32m  JOIN poll_options po ON po.poll_id = p.id AND po.id = p_option_id[m
[32m+[m[32m  WHERE p.id = p_poll_id;[m
[32m+[m[41m  [m
[32m+[m[32m  IF v_post_id IS NULL THEN RAISE EXCEPTION 'Poll or option not found'; END IF;[m
[32m+[m[41m  [m
[32m+[m[32m  DELETE FROM public.poll_votes WHERE poll_id = p_poll_id AND user_id = v_user_id;[m
[32m+[m[41m  [m
[32m+[m[32m  INSERT INTO public.poll_votes (poll_id, option_id, user_id, post_id, option_index)[m
[32m+[m[32m  VALUES (p_poll_id, p_option_id, v_user_id, v_post_id, v_option_index);[m
[32m+[m[32mEND;[m
[32m+[m[32m$function$;[m
[32m+[m
[32m+[m[32m-- 2. Corriger notify_on_poll_vote (utiliser user_id et display_name)[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.notify_on_poll_vote()[m
[32m+[m[32mRETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $function$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  v_post_id UUID;[m
[32m+[m[32m  v_post_author UUID;[m
[32m+[m[32m  v_actor_name TEXT;[m
[32m+[m[32m  v_question TEXT;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  SELECT post_id INTO v_post_id FROM public.polls WHERE id = NEW.poll_id;[m
[32m+[m[32m  SELECT author_id INTO v_post_author FROM public.posts WHERE id = v_post_id;[m
[32m+[m[32m  SELECT question INTO v_question FROM public.polls WHERE id = NEW.poll_id;[m
[32m+[m[41m  [m
[32m+[m[32m  SELECT COALESCE(display_name, handle, 'Quelqu''un') INTO v_actor_name[m
[32m+[m[32m    FROM public.profiles WHERE id = NEW.user_id;[m
[32m+[m
[32m+[m[32m  PERFORM public.create_notification([m
[32m+[m[32m    v_post_author, NEW.user_id, 'poll_vote',[m
[32m+[m[32m    v_actor_name || ' a voté à votre sondage : ' || LEFT(v_question, 50),[m
[32m+[m[32m    v_post_id[m
[32m+[m[32m  );[m
[32m+[m[32m  RETURN NEW;[m
[32m+[m[32mEND;[m
[32m+[m[32m$function$;[m
[32m+[m
[32m+[m[32m-- 3. Corriger create_notification (utiliser notification_id et user_id)[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.create_notification([m
[32m+[m[32m  p_target_id uuid, p_actor_id uuid, p_type text, p_message text, p_source_id uuid DEFAULT NULL::uuid[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS void LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $function$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF p_target_id = p_actor_id THEN RETURN; END IF;[m
[32m+[m[41m  [m
[32m+[m[32m  IF p_source_id IS NOT NULL AND EXISTS ([m
[32m+[m[32m    SELECT 1 FROM public.notifications[m
[32m+[m[32m    WHERE user_id = p_target_id AND type = p_type AND source_id = p_source_id[m
[32m+[m[32m    AND created_at > NOW() - INTERVAL '5 minutes'[m
[32m+[m[32m  ) THEN RETURN; END IF;[m
[32m+[m
[32m+[m[32m  INSERT INTO public.notifications (notification_id, user_id, actor_id, type, message, source_id, read, created_at)[m
[32m+[m[32m  VALUES (gen_random_uuid(), p_target_id, p_actor_id, p_type, p_message, p_source_id, false, NOW());[m
[32m+[m[32mEND;[m
[32m+[m[32m$function$;[m
[32m+[m
[32m+[m[32m-- 4. Corriger notify_on_comment (utiliser display_name)[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.notify_on_comment()[m
[32m+[m[32mRETURNS trigger LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $function$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  v_post_author UUID;[m
[32m+[m[32m  v_actor_name TEXT;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  SELECT author_id INTO v_post_author FROM public.posts WHERE id = NEW.post_id;[m
[32m+[m[41m  [m
[32m+[m[32m  SELECT COALESCE(display_name, handle, 'Quelqu''un') INTO v_actor_name[m
[32m+[m[32m    FROM public.profiles WHERE id = NEW.author_id;[m
[32m+[m
[32m+[m[32m  PERFORM public.create_notification([m
[32m+[m[32m    v_post_author, NEW.author_id, 'comment',[m
[32m+[m[32m    v_actor_name || ' a commenté votre publication', NEW.post_id[m
[32m+[m[32m  );[m
[32m+[m[32m  RETURN NEW;[m
[32m+[m[32mEND;[m
[32m+[m[32m$function$;[m
[32m+[m
[32m+[m[32m-- 5. Corriger get_poll_voters (joindre sur user_id, pas id)[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.get_poll_voters(p_poll_id uuid)[m
[32m+[m[32mRETURNS TABLE(option_id uuid, option_text text, voters jsonb)[m
[32m+[m[32mLANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $function$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM public.poll_votes WHERE poll_id = p_poll_id AND user_id = auth.uid()[m
[32m+[m[32m  ) AND NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM public.polls p[m
[32m+[m[32m    JOIN public.posts po ON po.id = p.post_id[m
[32m+[m[32m    WHERE p.id = p_poll_id AND po.author_id = auth.uid()[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    RAISE EXCEPTION 'ACCESS_DENIED';[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  RETURN QUERY[m
[32m+[m[32m  SELECT[m[41m [m
[32m+[m[32m    po.id AS option_id,[m
[32m+[m[32m    po.option_text,[m
[32m+[m[32m    COALESCE([m
[32m+[m[32m      jsonb_agg([m
[32m+[m[32m        jsonb_build_object([m
[32m+[m[32m          'id', pv.user_id,[m
[32m+[m[32m          'display_name', COALESCE(pr.display_name, pr.handle, 'Membre'),[m
[32m+[m[32m          'avatar_url', pr.avatar_url,[m
[32m+[m[32m          'handle', pr.handle[m
[32m+[m[32m        )[m
[32m+[m[32m        ORDER BY pv.created_at DESC[m
[32m+[m[32m      ) FILTER (WHERE pv.id IS NOT NULL),[m
[32m+[m[32m      '[]'::jsonb[m
[32m+[m[32m    ) AS voters[m
[32m+[m[32m  FROM public.poll_options po[m
[32m+[m[32m  LEFT JOIN public.poll_votes pv ON po.id = pv.option_id[m
[32m+[m[32m  LEFT JOIN public.profiles pr ON pv.user_id = pr.id[m
[32m+[m[32m  WHERE po.poll_id = p_poll_id[m
[32m+[m[32m  GROUP BY po.id, po.option_text, po.position[m
[32m+[m[32m  ORDER BY po.position;[m
[32m+[m[32mEND;[m
[32m+[m[32m$function$;[m
[32m+[m
