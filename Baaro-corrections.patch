[32m+[m
[32m+[m[32malter table public.story_close_friends enable row level security;[m
[32m+[m
[32m+[m[32mdrop policy if exists story_close_friends_owner on public.story_close_friends;[m
[32m+[m[32mcreate policy story_close_friends_owner[m
