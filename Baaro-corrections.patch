[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- ÉTAPE 6 : RECALCUL DES COMPTEURS EXISTANTS[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32m-- Recalculer les vrais compteurs pour toutes les vidéos depuis les données existantes[m
[32m+[m[32mUPDATE public.videos v[m
[32m+[m[32mSET[m[41m [m
[32m+[m[32m  likes = COALESCE(subquery.likes_count, 0),[m
[32m+[m[32m  comments_count = COALESCE(subquery.comments_count, 0)[m
[32m+[m[32mFROM ([m
[32m+[m[32m  SELECT[m[41m [m
[32m+[m[32m    v.id as video_id,[m
[32m+[m[32m    (SELECT COUNT(*) FROM public.video_likes vl WHERE vl.video_id = v.id) as likes_count,[m
[32m+[m[32m    (SELECT COUNT(*) FROM public.video_comments vc WHERE vc.video_id = v.id) as comments_count[m
[32m+[m[32m  FROM public.videos v[m
[32m+[m[32m) subquery[m
[32m+[m[32mWHERE v.id = subquery.video_id;[m
[32m+[m
