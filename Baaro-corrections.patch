[32m+[m[32m-- Payouts require a verified payout profile; this is the anti-fraud/KYC gate.[m
[32m+[m[32mcreate or replace function public.request_economy_payout(p_amount_minor bigint,p_method text,p_destination_token text default null)[m
[32m+[m[32mreturns uuid language plpgsql security invoker set search_path=public as $$[m
[32m+[m[32mdeclare uid uuid:=auth.uid(); a public.economy_accounts; p uuid; min_cash bigint; k public.creator_payout_profiles;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if uid is null then raise exception 'AUTH_REQUIRED'; end if;[m
[32m+[m[32m  if p_amount_minor<=0 then raise exception 'INVALID_AMOUNT'; end if;[m
[32m+[m[32m  if p_method not in ('mobile_money','bank_transfer') then raise exception 'INVALID_PAYOUT_METHOD'; end if;[m
[32m+[m[32m  select * into k from public.creator_payout_profiles where user_id=uid;[m
[32m+[m[32m  if not found or k.kyc_status<>'verified' or not k.payout_verified then raise exception 'PAYOUT_KYC_REQUIRED'; end if;[m
[32m+[m[32m  if k.risk_level='blocked' then raise exception 'PAYOUT_BLOCKED_FOR_RISK'; end if;[m
[32m+[m[32m  if p_destination_token is null or length(trim(p_destination_token))<8 then raise exception 'PAYOUT_DESTINATION_REQUIRED'; end if;[m
[32m+[m[32m  select * into a from public.economy_accounts where user_id=uid for update;[m
[32m+[m[32m  if not found then raise exception 'NO_EARNINGS_ACCOUNT'; end if;[m
[32m+[m[32m  select round(min_cashout*100)::bigint into min_cash from public.creator_monetization where creator_id=uid;[m
[32m+[m[32m  min_cash:=coalesce(min_cash,100000);[m
[32m+[m[32m  if p_amount_minor<min_cash then raise exception 'MIN_CASHOUT'; end if;[m
[32m+[m[32m  if p_amount_minor>a.available_minor then raise exception 'INSUFFICIENT_AVAILABLE'; end if;[m
[32m+[m[32m  insert into public.economy_payouts(user_id,amount_minor,currency,method,destination_token) values(uid,p_amount_minor,a.currency,p_method,nullif(trim(p_destination_token),'')) returning id into p;[m
[32m+[m[32m  insert into public.economy_ledger(user_id,entry_type,bucket,direction,source,amount_minor,currency,reference_id,metadata) values(uid,'payout_hold','payout_hold','credit','payout',p_amount_minor,a.currency,p,jsonb_build_object('status','reserved'));[m
[32m+[m[32m  update public.economy_accounts set available_minor=available_minor-p_amount_minor,payout_hold_minor=payout_hold_minor+p_amount_minor,updated_at=now() where user_id=uid;[m
[32m+[m[32m  return p;[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.request_economy_payout(bigint,text,text) from public,anon;[m
[32m+[m[32mgrant execute on function public.request_economy_payout(bigint,text,text) to authenticated;[m
[32m+[m
[32m+[m[32m-- Server-side ad revenue entry point. The ad delivery service is the only caller.[m
[32m+[m[32mcreate or replace function public.record_ad_creator_revenue(p_idempotency_key text,p_creator_id uuid,p_gross_minor bigint,p_provider_fee_minor bigint default 0,p_reference_id uuid default null,p_metadata jsonb default '{}'::jsonb)[m
[32m+[m[32mreturns uuid language plpgsql security definer set search_path=public as $$[m
