[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0023_economy_payout_foundation.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO 2.0 v17 — Economy / Payout foundation[m
[32m+[m[32m-- Payouts are intentionally disabled until a verified provider integration is configured.[m
[32m+[m
[32m+[m[32mcreate table if not exists public.payout_accounts ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  user_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  provider text not null check (provider in ('stripe_connect')),[m
[32m+[m[32m  provider_account_id text not null,[m
[32m+[m[32m  country_code text check (country_code is null or country_code ~ '^[A-Z]{2}$'),[m
[32m+[m[32m  currency text check (currency is null or currency ~ '^[A-Z]{3}$'),[m
[32m+[m[32m  status text not null default 'pending'[m
[32m+[m[32m    check (status in ('pending','enabled','disabled','restricted')),[m
[32m+[m[32m  created_at timestamptz not null default now(),[m
[32m+[m[32m  updated_at timestamptz not null default now(),[m
[32m+[m[32m  unique(provider, provider_account_id),[m
[32m+[m[32m  unique(user_id, provider)[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mcreate table if not exists public.payout_requests ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  user_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  payout_account_id uuid references public.payout_accounts(id) on delete restrict,[m
[32m+[m[32m  amount_points bigint not null check (amount_points > 0),[m
[32m+[m[32m  currency text not null check (currency ~ '^[A-Z]{3}$'),[m
[32m+[m[32m  amount_minor bigint not null check (amount_minor > 0),[m
[32m+[m[32m  status text not null default 'pending'[m
[32m+[m[32m    check (status in ('pending','processing','paid','failed','cancelled','requires_review')),[m
[32m+[m[32m  idempotency_key text not null,[m
[32m+[m[32m  provider_payout_id text,[m
[32m+[m[32m  failure_code text,[m
[32m+[m[32m  failure_reason text,[m
[32m+[m[32m  created_at timestamptz not null default now(),[m
[32m+[m[32m  updated_at timestamptz not null default now(),[m
[32m+[m[32m  unique(user_id, idempotency_key)[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mcreate index if not exists payout_requests_user_created_idx[m
[32m+[m[32m  on public.payout_requests(user_id, created_at desc);[m
[32m+[m
[32m+[m[32mcreate index if not exists payout_requests_status_idx[m
[32m+[m[32m  on public.payout_requests(status, created_at);[m
[32m+[m
[32m+[m[32malter table public.payout_accounts enable row level security;[m
[32m+[m[32malter table public.payout_requests enable row level security;[m
[32m+[m
[32m+[m[32mdrop policy if exists payout_accounts_select_own on public.payout_accounts;[m
[32m+[m[32mcreate policy payout_accounts_select_own[m
[32m+[m[32mon public.payout_accounts for select[m
[32m+[m[32musing (auth.uid() = id);[m
[32m+[m
[32m+[m[32mdrop policy if exists payout_requests_select_own on public.payout_requests;[m
[32m+[m[32mcreate policy payout_requests_select_own[m
[32m+[m[32mon public.payout_requests for select[m
[32m+[m[32musing (auth.uid() = id);[m
[32m+[m
[32m+[m[32m-- No client INSERT/UPDATE/DELETE policies are intentionally created.[m
[32m+[m[32m-- Payout mutations must happen through authenticated server-side functions.[m
[32m+[m
[32m+[m[32mcreate or replace function public.create_payout_request([m
[32m+[m[32m  p_idempotency_key text,[m
[32m+[m[32m  p_amount_points bigint,[m
[32m+[m[32m  p_currency text[m
[32m+[m[32m)[m
[32m+[m[32mreturns public.payout_requests[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_uid uuid := auth.uid();[m
[32m+[m[32m  v_wallet public.wallets;[m
[32m+[m[32m  v_account public.payout_accounts;[m
[32m+[m[32m  v_request public.payout_requests;[m
[32m+[m[32m  v_amount_minor bigint;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if v_uid is null then[m
[32m+[m[32m    raise exception 'authentication_required';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  if p_idempotency_key is null or length(trim(p_idempotency_key)) < 16[m
[32m+[m[32m     or length(trim(p_idempotency_key)) > 128 then[m
[32m+[m[32m    raise exception 'invalid_idempotency_key';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  if p_amount_points <= 0 then[m
[32m+[m[32m    raise exception 'invalid_amount';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  select * into v_request[m
[32m+[m[32m  from public.payout_requests[m
[32m+[m[32m  where user_id = v_uid and idempotency_key = trim(p_idempotency_key)[m
[32m+[m[32m  for update;[m
[32m+[m
[32m+[m[32m  if found then[m
[32m+[m[32m    return v_request;[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  select * into v_account[m
[32m+[m[32m  from public.payout_accounts[m
[32m+[m[32m  where user_id = v_uid and provider = 'stripe_connect'[m
[32m+[m[32m  for update;[m
[32m+[m
[32m+[m[32m  if not found or v_account.status <> 'enabled' then[m
[32m+[m[32m    raise exception 'payout_account_not_ready';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  -- Conversion must be replaced by the configured business-rate table/RPC[m
[32m+[m[32m  -- before enabling payouts. This function intentionally refuses a real payout.[m
[32m+[m[32m  raise exception 'payout_disabled_until_provider_configuration';[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mrevoke all on function public.create_payout_request(text,bigint,text) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.create_payout_request(text,bigint,text) to authenticated;[m
[32m+[m
