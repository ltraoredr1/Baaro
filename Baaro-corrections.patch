[32m+[m[32m  status text not null default 'active' check (status in ('active','paused','completed','archived')),[m
[32m+[m[32m  progress numeric(5,2) not null default 0 check (progress >= 0 and progress <= 100),[m
[32m+[m[32m  created_at timestamptz not null default now(),[m
[32m+[m[32m  updated_at timestamptz not null default now()[m
[32m+[m[32m);[m
[32m+[m[32mcreate index if not exists nexus_goals_user_idx on public.nexus_goals(user_id, status, updated_at desc);[m
[32m+[m
[32m+[m[32mcreate table if not exists public.nexus_memory_items ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  user_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  scope text not null default 'personal' check (scope in ('personal','conversation','community','project')),[m
[32m+[m[32m  title text not null check (char_length(title) between 1 and 160),[m
[32m+[m[32m  content text not null check (char_length(content) between 1 and 5000),[m
[32m+[m[32m  source text not null default 'user' check (source in ('user','assistant','imported')),[m
[32m+[m[32m  expires_at timestamptz,[m
[32m+[m[32m  created_at timestamptz not null default now()[m
[32m+[m[32m);[m
[32m+[m[32mcreate index if not exists nexus_memory_user_idx on public.nexus_memory_items(user_id, created_at desc);[m
[32m+[m
[32m+[m[32mcreate table if not exists public.nexus_trust_events ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  subject_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  actor_id uuid references auth.users(id) on delete set null,[m
[32m+[m[32m  kind text not null check (kind in ('verified_identity','successful_trade','community_contribution','reported_abuse','resolved_report','quality_content','spam_penalty')),[m
[32m+[m[32m  weight integer not null default 0 check (weight between -100 and 100),[m
[32m+[m[32m  metadata jsonb not null default '{}'::jsonb,[m
[32m+[m[32m  created_at timestamptz not null default now()[m
[32m+[m[32m);[m
[32m+[m[32mcreate index if not exists nexus_trust_subject_idx on public.nexus_trust_events(subject_id, created_at desc);[m
[32m+[m
[32m+[m[32mcreate table if not exists public.nexus_actions ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  user_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  action_type text not null check (action_type in ('recommend','remind','summarize','translate','learn','create','sell','connect')),[m
[32m+[m[32m  payload jsonb not null default '{}'::jsonb,[m
[32m+[m[32m  status text not null default 'queued' check (status in ('queued','running','completed','failed','cancelled')),[m
[32m+[m[32m  created_at timestamptz not null default now(),[m
[32m+[m[32m  completed_at timestamptz[m
[32m+[m[32m);[m
