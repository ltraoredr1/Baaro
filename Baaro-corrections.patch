[32m+[m[32m-- ============================================[m
[32m+[m[32m-- 6. POLITIQUES DE SÉCURITÉ[m
[32m+[m[32m-- ============================================[m
[32m+[m
[32m+[m[32m-- Polls[m
[32m+[m[32mDROP POLICY IF EXISTS "polls_read_public" ON public.polls;[m
[32m+[m[32mCREATE POLICY "polls_read_public" ON public.polls[m
[32m+[m[32m  FOR SELECT USING (true);[m
[32m+[m
[32m+[m[32mDROP POLICY IF EXISTS "polls_insert_author" ON public.polls;[m
[32m+[m[32mCREATE POLICY "polls_insert_author" ON public.polls[m
[32m+[m[32m  FOR INSERT WITH CHECK ([m
[32m+[m[32m    EXISTS ([m
[32m+[m[32m      SELECT 1 FROM public.posts p[m[41m [m
[32m+[m[32m      WHERE p.id = polls.post_id AND p.author_id = auth.uid()[m
[32m+[m[32m    )[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m-- Poll options[m
[32m+[m[32mDROP POLICY IF EXISTS "poll_options_read_public" ON public.poll_options;[m
[32m+[m[32mCREATE POLICY "poll_options_read_public" ON public.poll_options[m
[32m+[m[32m  FOR SELECT USING (true);[m
[32m+[m
[32m+[m[32mDROP POLICY IF EXISTS "poll_options_insert_author" ON public.poll_options;[m
[32m+[m[32mCREATE POLICY "poll_options_insert_author" ON public.poll_options[m
[32m+[m[32m  FOR INSERT WITH CHECK ([m
[32m+[m[32m    EXISTS ([m
[32m+[m[32m      SELECT 1 FROM public.polls p[m
[32m+[m[32m      JOIN public.posts po ON po.id = p.post_id[m
[32m+[m[32m      WHERE p.id = poll_options.poll_id AND po.author_id = auth.uid()[m
[32m+[m[32m    )[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m-- Poll votes[m
[32m+[m[32mDROP POLICY IF EXISTS "poll_votes_read_public" ON public.poll_votes;[m
[32m+[m[32mCREATE POLICY "poll_votes_read_public" ON public.poll_votes[m
[32m+[m[32m  FOR SELECT USING (true);[m
[32m+[m
[32m+[m[32mDROP POLICY IF EXISTS "poll_votes_own" ON public.poll_votes;[m
[32m+[m[32mCREATE POLICY "poll_votes_own" ON public.poll_votes[m
[32m+[m[32m  FOR ALL[m[41m [m
[32m+[m[32m  USING (auth.uid() = id)[m
[32m+[m[32m  WITH CHECK (auth.uid() = id);[m
[32m+[m
[32m+[m[32m-- Post reactions[m
[32m+[m[32mDROP POLICY IF EXISTS "post_reactions_read_public" ON public.post_reactions;[m
[32m+[m[32mCREATE POLICY "post_reactions_read_public" ON public.post_reactions[m
[32m+[m[32m  FOR SELECT USING (true);[m
[32m+[m
[32m+[m[32mDROP POLICY IF EXISTS "post_reactions_own" ON public.post_reactions;[m
[32m+[m[32mCREATE POLICY "post_reactions_own" ON public.post_reactions[m
[32m+[m[32m  FOR ALL[m[41m [m
[32m+[m[32m  USING (auth.uid() = id)[m
[32m+[m[32m  WITH CHECK (auth.uid() = id);[m
[32m+[m
[32m+[m[32m-- Post bookmarks (PRIVÉ)[m
[32m+[m[32mDROP POLICY IF EXISTS "post_bookmarks_own" ON public.post_bookmarks;[m
[32m+[m[32mCREATE POLICY "post_bookmarks_own" ON public.post_bookmarks[m
[32m+[m[32m  FOR ALL[m[41m [m
[32m+[m[32m  USING (auth.uid() = id)[m
[32m+[m[32m  WITH CHECK (auth.uid() = id);[m
[32m+[m
[32m+[m[32m-- Post shares[m
[32m+[m[32mDROP POLICY IF EXISTS "post_shares_read_public" ON public.post_shares;[m
[32m+[m[32mCREATE POLICY "post_shares_read_public" ON public.post_shares[m
[32m+[m[32m  FOR SELECT USING (true);[m
[32m+[m
[32m+[m[32mDROP POLICY IF EXISTS "post_shares_own" ON public.post_shares;[m
[32m+[m[32mCREATE POLICY "post_shares_own" ON public.post_shares[m
[32m+[m[32m  FOR ALL[m[41m [m
[32m+[m[32m  USING (auth.uid() = id)[m
[32m+[m[32m  WITH CHECK (auth.uid() = id);[m
[32m+[m
[32m+[m[32m-- ============================================[m
[32m+[m[32m-- 7. FONCTION toggle_follow[m
[32m+[m[32m-- ============================================[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.toggle_follow(p_target UUID)[m
[32m+[m[32mRETURNS BOOLEAN[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  v_is_following BOOLEAN;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF p_target = auth.uid() THEN[m
[32m+[m[32m    RAISE EXCEPTION 'CANNOT_FOLLOW_SELF';[m
[32m+[m[32m  END IF;[m
[32m+[m[41m  [m
[32m+[m[32m  IF NOT EXISTS (SELECT 1 FROM public.profiles WHERE id = p_target) THEN[m
[32m+[m[32m    RAISE EXCEPTION 'TARGET_NOT_FOUND';[m
[32m+[m[32m  END IF;[m
[32m+[m[41m  [m
[32m+[m[32m  SELECT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM public.follows[m[41m [m
[32m+[m[32m    WHERE follower_id = auth.uid() AND followed_id = p_target[m
[32m+[m[32m  ) INTO v_is_following;[m
[32m+[m[41m  [m
[32m+[m[32m  IF v_is_following THEN[m
[32m+[m[32m    DELETE FROM public.follows[m[41m [m
[32m+[m[32m    WHERE follower_id = auth.uid() AND followed_id = p_target;[m
[32m+[m[32m    RETURN FALSE;[m
[32m+[m[32m  ELSE[m
[32m+[m[32m    INSERT INTO public.follows (follower_id, followed_id)[m
[32m+[m[32m    VALUES (auth.uid(), p_target);[m
[32m+[m[32m    RETURN TRUE;[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mREVOKE ALL ON FUNCTION public.toggle_follow(UUID) FROM PUBLIC, ANON;[m
[32m+[m[32mGRANT EXECUTE ON FUNCTION public.toggle_follow(UUID) TO AUTHENTICATED;[m
[32m+[m
[32m+[m[32m-- ============================================[m
[32m+[m[32m-- 8. FONCTION vote_poll (sécurisée)[m
[32m+[m[32m-- ============================================[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.vote_poll(p_poll_id UUID, p_option_id UUID)[m
[32m+[m[32mRETURNS VOID[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF EXISTS ([m
[32m+[m[32m    SELECT 1 FROM public.poll_votes[m[41m [m
[32m+[m[32m    WHERE poll_id = p_poll_id AND id = auth.uid()[m[41m [m
[32m+[m[32m    AND created_at > NOW() - INTERVAL '2 seconds'[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    RAISE EXCEPTION 'SOCIAL_RATE_LIMIT';[m
[32m+[m[32m  END IF;[m
[32m+[m[41m  [m
[32m+[m[32m  IF NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM public.poll_options[m[41m [m
[32m+[m[32m    WHERE id = p_option_id AND poll_id = p_poll_id[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    RAISE EXCEPTION 'INVALID_POLL_OPTION';[m
[32m+[m[32m  END IF;[m
[32m+[m[41m  [m
[32m+[m[32m  IF EXISTS (SELECT 1 FROM public.poll_votes WHERE poll_id = p_poll_id AND id = auth.uid()) THEN[m
[32m+[m[32m    UPDATE public.poll_votes[m[41m [m
[32m+[m[32m    SET option_id = p_option_id, created_at = NOW()[m
[32m+[m[32m    WHERE poll_id = p_poll_id AND id = auth.uid();[m
[32m+[m[32m  ELSE[m
[32m+[m[32m    INSERT INTO public.poll_votes (poll_id, id, option_id)[m
[32m+[m[32m    VALUES (p_poll_id, auth.uid(), p_option_id);[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mREVOKE ALL ON FUNCTION public.vote_poll(UUID, UUID) FROM PUBLIC, ANON;[m
[32m+[m[32mGRANT EXECUTE ON FUNCTION public.vote_poll(UUID, UUID) TO AUTHENTICATED;[m
[32m+[m
[32m+[m[32m-- ============================================[m
[32m+[m[32m-- 9. FONCTION get_social_suggestions[m
[32m+[m[32m-- ============================================[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.get_social_suggestions(p_limit INT DEFAULT 6)[m
[32m+[m[32mRETURNS TABLE (id UUID, handle TEXT, full_name TEXT, avatar_url TEXT, mutual_count INT)[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  RETURN QUERY[m
[32m+[m[32m  SELECT[m[41m [m
[32m+[m[32m    p.id, p.handle, p.full_name, p.avatar_url,[m
[32m+[m[32m    (SELECT COUNT(*) FROM public.follows f2[m[41m [m
[32m+[m[32m     WHERE f2.followed_id = p.id[m[41m [m
[32m+[m[32m     AND f2.follower_id IN (SELECT followed_id FROM public.follows WHERE follower_id = auth.uid())[m
[32m+[m[32m    )::INT AS mutual_count[m
[32m+[m[32m  FROM public.profiles p[m
[32m+[m[32m  WHERE p.id != auth.uid()[m
[32m+[m[32m    AND p.id NOT IN (SELECT followed_id FROM public.follows WHERE follower_id = auth.uid())[m
[32m+[m[32m  ORDER BY mutual_count DESC, RANDOM()[m
[32m+[m[32m  LIMIT p_limit;[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mREVOKE ALL ON FUNCTION public.get_social_suggestions(INT) FROM PUBLIC, ANON;[m
[32m+[m[32mGRANT EXECUTE ON FUNCTION public.get_social_suggestions(INT) TO AUTHENTICATED;[m
[32m+[m
[32m+[m[32m-- ============================================[m
[32m+[m[32m-- 10. ACTIVATION REALTIME[m
[32m+[m[32m-- ============================================[m
[32m+[m[32mDO $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  ALTER PUBLICATION supabase_realtime ADD TABLE public.poll_votes;[m
[32m+[m[32m  ALTER PUBLICATION supabase_realtime ADD TABLE public.post_reactions;[m
[32m+[m[32m  ALTER PUBLICATION supabase_realtime ADD TABLE public.post_bookmarks;[m
[32m+[m[32m  ALTER PUBLICATION supabase_realtime ADD TABLE public.post_shares;[m
[32m+[m[32mEXCEPTION WHEN duplicate_object THEN[m[41m [m
[32m+[m[32m  NULL;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32mALTER TABLE public.poll_votes REPLICA IDENTITY FULL;[m
[32m+[m[32mALTER TABLE public.post_reactions REPLICA IDENTITY FULL;[m
[32m+[m[32mALTER TABLE public.post_bookmarks REPLICA IDENTITY FULL;[m
[32m+[m[32mALTER TABLE public.post_shares REPLICA IDENTITY FULL;[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0016_reward_integrity_security.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO 2.0 — Reward integrity / anti-farming[m
[32m+[m[32m-- Every non-daily reward must reference a real, server-verifiable event.[m
[32m+[m
[32m+[m[32malter table public.transactions[m
[32m+[m[32m  add column if not exists reference_id uuid;[m
[32m+[m
[32m+[m[32mcreate index if not exists idx_transactions_reward_reference[m
[32m+[m[32m  on public.transactions(user_id, action_key, reference_id)[m
[32m+[m[32m  where pts > 0 and reference_id is not null;[m
[32m+[m
[32m+[m[32mcreate unique index if not exists ux_transactions_reward_event[m
[32m+[m[32m  on public.transactions(user_id, action_key, reference_id)[m
[32m+[m[32m  where pts > 0 and reference_id is not null;[m
[32m+[m
[32m+[m[32mcreate or replace function public.wallet_earn([m
[32m+[m[32m  p_user_id uuid,[m
[32m+[m[32m  p_pts numeric,[m
[32m+[m[32m  p_label text,[m
[32m+[m[32m  p_action_key text,[m
[32m+[m[32m  p_daily_cap numeric default 100,[m
[32m+[m[32m  p_daily_bonus boolean default false,[m
[32m+[m[32m  p_reference_id uuid default null[m
[32m+[m[32m)[m
[32m+[m[32mreturns jsonb[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  w public.wallets%rowtype;[m
[32m+[m[32m  earned numeric := 0;[m
[32m+[m[32m  actual_pts numeric;[m
[32m+[m[32m  tx public.transactions%rowtype;[m
[32m+[m[32m  event_exists boolean := false;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if p_pts is null or p_pts <= 0 then raise exception 'INVALID_POINTS'; end if;[m
[32m+[m[32m  if length(coalesce(p_label,'')) = 0 then raise exception 'INVALID_LABEL'; end if;[m
[32m+[m
[32m+[m[32m  if not p_daily_bonus then[m
[32m+[m[32m    if p_reference_id is null then raise exception 'REWARD_REFERENCE_REQUIRED'; end if;[m
[32m+[m
[32m+[m[32m    case p_action_key[m
[32m+[m[32m      when 'publish_post' then[m
[32m+[m[32m        select exists(select 1 from public.posts where id = p_reference_id and author_id = p_user_id) into event_exists;[m
[32m+[m[32m      when 'publish_post_media' then[m
[32m+[m[32m        select exists(select 1 from public.posts where id = p_reference_id and author_id = p_user_id and media_url is not null) into event_exists;[m
[32m+[m[32m      when 'like_post' then[m
[32m+[m[32m        select exists(select 1 from public.post_likes where post_id = p_reference_id and user_id = p_user_id) into event_exists;[m
[32m+[m[32m      when 'comment' then[m
[32m+[m[32m        select exists(select 1 from public.comments where id = p_reference_id and author_id = p_user_id) into event_exists;[m
[32m+[m[32m      when 'subscribe' then[m
[32m+[m[32m        select exists(select 1 from public.follows where follower_id = p_user_id and followed_id = p_reference_id) into event_exists;[m
[32m+[m[32m      when 'like_video' then[m
[32m+[m[32m        select exists(select 1 from public.video_likes where video_id = p_reference_id and user_id = p_user_id) into event_exists;[m
[32m+[m[32m      when 'comment_video' then[m
[32m+[m[32m        select exists(select 1 from public.video_comments where id = p_reference_id and author_id = p_user_id) into event_exists;[m
[32m+[m[32m      when 'publish_video' then[m
[32m+[m[32m        select exists(select 1 from public.videos where id = p_reference_id and author_id = p_user_id) into event_exists;[m
[32m+[m[32m      when 'repost_video' then[m
[32m+[m[32m        select exists(select 1 from public.videos where id = p_reference_id and author_id = p_user_id and is_repost = true) into event_exists;[m
[32m+[m[32m      when 'publish_story' then[m
[32m+[m[32m      else[m
[32m+[m[32m        raise exception 'UNVERIFIABLE_REWARD_ACTION';[m
[32m+[m[32m    end case;[m
[32m+[m
[32m+[m[32m    if not event_exists then raise exception 'REWARD_EVENT_NOT_FOUND'; end if;[m
[32m+[m
[32m+[m[32m    if exists ([m
[32m+[m[32m      select 1 from public.transactions[m
[32m+[m[32m      where user_id = p_user_id and action_key = p_action_key and reference_id = p_reference_id and pts > 0[m
[32m+[m[32m    ) then[m
[32m+[m[32m      raise exception 'REWARD_ALREADY_CLAIMED';[m
[32m+[m[32m    end if;[m
[32m+[m[32m  else[m
[32m+[m[32m    if p_action_key <> 'daily_bonus' then raise exception 'INVALID_DAILY_BONUS'; end if;[m
[32m+[m[32m    if exists ([m
[32m+[m[32m      select 1 from public.transactions[m
[32m+[m[32m      where user_id = p_user_id and action_key = 'daily_bonus' and day_key = current_date[m
[32m+[m[32m    ) then[m
[32m+[m[32m      raise exception 'DAILY_BONUS_ALREADY_CLAIMED';[m
[32m+[m[32m    end if;[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  perform public.wallet_ensure(p_user_id, 0);[m
[32m+[m[32m  select * into w from public.wallets where id = p_user_id for update;[m
[32m+[m
[32m+[m[32m  select coalesce(sum(pts), 0) into earned[m
[32m+[m[32m  from public.transactions[m
[32m+[m[32m  where user_id = p_user_id and pts > 0 and created_at >= date_trunc('day', now());[m
[32m+[m
[32m+[m[32m  if earned >= p_daily_cap then raise exception 'DAILY_CAP_REACHED'; end if;[m
[32m+[m[32m  actual_pts := least(p_pts, p_daily_cap - earned);[m
[32m+[m
[32m+[m[32m  update public.wallets[m
[32m+[m[32m    set balance = balance + actual_pts, updated_at = now()[m
[32m+[m[32m  where user_id = p_user_id[m
[32m+[m[32m  returning * into w;[m
[32m+[m
[32m+[m[32m  insert into public.transactions(user_id, label, pts, action_key, day_key, reference_id)[m
[32m+[m[32m  values (p_user_id, left(p_label, 120), actual_pts, p_action_key, current_date, p_reference_id)[m
[32m+[m[32m  returning * into tx;[m
[32m+[m
[32m+[m[32m  return jsonb_build_object([m
[32m+[m[32m    'balance', w.balance,[m
[32m+[m[32m    'earned_today', earned + actual_pts,[m
[32m+[m[32m    'remaining_today', greatest(0, p_daily_cap - earned - actual_pts),[m
[32m+[m[32m    'transaction', to_jsonb(tx)[m
[32m+[m[32m  );[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
