[32m+[m[32m-- The canonical column in public.follows is followed_id.[m
[32m+[m[32m-- Existing installations already use this name; this migration mainly hardens constraints/policies.[m
[32m+[m
[32m+[m[32malter table public.follows enable row level security;[m
[32m+[m[32mdrop policy if exists "follows_read" on public.follows;[m
[32m+[m[32mdrop policy if exists "follows_own" on public.follows;[m
[32m+[m[32mcreate policy "follows_read" on public.follows[m
[32m+[m[32m  for select using (auth.uid() is not null);[m
[32m+[m[32mcreate policy "follows_own" on public.follows[m
[32m+[m[32m  for insert with check (auth.uid() = follower_id and follower_id <> followed_id);[m
[32m+[m[32mcreate policy "follows_update_own" on public.follows[m
[32m+[m[32m  for update[m
[32m+[m[32m  using (auth.uid() = follower_id)[m
[32m+[m[32m  with check (auth.uid() = follower_id and follower_id <> followed_id);[m
