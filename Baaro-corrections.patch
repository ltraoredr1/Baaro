[32m+[m[32mcreate or replace function public.request_economy_payout(p_amount_minor bigint,p_method text,p_destination_token text default null)[m
[32m+[m[32mreturns uuid[m
[32m+[m[32mlanguage plpgsql security invoker set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare uid uuid:=auth.uid(); a public.economy_accounts; p uuid; min_cash bigint;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if uid is null then raise exception 'AUTH_REQUIRED'; end if;[m
[32m+[m[32m  if p_amount_minor <= 0 then raise exception 'INVALID_AMOUNT'; end if;[m
[32m+[m[32m  if p_method not in ('mobile_money','bank_transfer') then raise exception 'INVALID_PAYOUT_METHOD'; end if;[m
[32m+[m[32m  select * into a from public.economy_accounts where user_id=uid for update;[m
[32m+[m[32m  if not found then raise exception 'NO_EARNINGS_ACCOUNT'; end if;[m
[32m+[m[32m  select round(min_cashout*100)::bigint into min_cash from public.creator_monetization where creator_id=uid;[m
[32m+[m[32m  min_cash:=coalesce(min_cash,100000);[m
[32m+[m[32m  if p_amount_minor < min_cash then raise exception 'MIN_CASHOUT'; end if;[m
[32m+[m[32m  if p_amount_minor > a.available_minor then raise exception 'INSUFFICIENT_AVAILABLE'; end if;[m
[32m+[m[32m  insert into public.economy_payouts(user_id,amount_minor,currency,method,destination_token) values(uid,p_amount_minor,a.currency,p_method,nullif(trim(p_destination_token),'')) returning id into p;[m
[32m+[m[32m  insert into public.economy_ledger(user_id,entry_type,bucket,direction,source,amount_minor,currency,reference_id,metadata) values(uid,'payout_hold','payout_hold','credit','payout',p_amount_minor,a.currency,p,jsonb_build_object('status','reserved'));[m
[32m+[m[32m  update public.economy_accounts set available_minor=available_minor-p_amount_minor,payout_hold_minor=payout_hold_minor+p_amount_minor,updated_at=now() where user_id=uid;[m
[32m+[m[32m  return p;[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.request_economy_payout(bigint,text,text) from public, anon;[m
[32m+[m[32mgrant execute on function public.request_economy_payout(bigint,text,text) to authenticated;[m
[32m+[m
[32m+[m[32mcreate or replace function public.complete_economy_payout(p_payout_id uuid,p_provider text,p_provider_reference text)[m
[32m+[m[32mreturns boolean[m
[32m+[m[32mlanguage plpgsql security definer set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare p public.economy_payouts;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.role() <> 'service_role' then raise exception 'SERVICE_ROLE_REQUIRED'; end if;[m
[32m+[m[32m  select * into p from public.economy_payouts where id=p_payout_id for update;[m
[32m+[m[32m  if not found then raise exception 'PAYOUT_NOT_FOUND'; end if;[m
[32m+[m[32m  if p.status='paid' then return true; end if;[m
[32m+[m[32m  if p.status not in ('pending','processing') then raise exception 'PAYOUT_NOT_PAYABLE'; end if;[m
[32m+[m[32m  update public.economy_payouts set status='paid',provider=p_provider,provider_reference=p_provider_reference,processed_at=now() where id=p.id;[m
[32m+[m[32m  insert into public.economy_ledger(user_id,entry_type,bucket,direction,source,amount_minor,currency,reference_id,metadata) values(p.user_id,'payout_paid','paid_out','credit','payout',p.amount_minor,p.currency,p.id,jsonb_build_object('provider',p_provider,'provider_reference',p_provider_reference));[m
[32m+[m[32m  update public.economy_accounts set payout_hold_minor=payout_hold_minor-p.amount_minor,paid_out_minor=paid_out_minor+p.amount_minor,updated_at=now() where user_id=p.user_id;[m
[32m+[m[32m  return true;[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.complete_economy_payout(uuid,text,text) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.complete_economy_payout(uuid,text,text) to service_role;[m
[32m+[m
[32m+[m[32mcreate or replace function public.cancel_economy_payout(p_payout_id uuid,p_reason text default null)[m
[32m+[m[32mreturns boolean[m
[32m+[m[32mlanguage plpgsql security definer set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare p public.economy_payouts;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.role() <> 'service_role' then raise exception 'SERVICE_ROLE_REQUIRED'; end if;[m
[32m+[m[32m  select * into p from public.economy_payouts where id=p_payout_id for update;[m
[32m+[m[32m  if not found then raise exception 'PAYOUT_NOT_FOUND'; end if;[m
[32m+[m[32m  if p.status in ('paid','cancelled') then return true; end if;[m
[32m+[m[32m  update public.economy_payouts set status='cancelled',failure_reason=left(p_reason,500),processed_at=now() where id=p.id;[m
[32m+[m[32m  insert into public.economy_ledger(user_id,entry_type,bucket,direction,source,amount_minor,currency,reference_id,metadata) values(p.user_id,'payout_reversed','available','credit','payout',p.amount_minor,p.currency,p.id,jsonb_build_object('reason',p_reason));[m
[32m+[m[32m  update public.economy_accounts set payout_hold_minor=payout_hold_minor-p.amount_minor,available_minor=available_minor+p.amount_minor,updated_at=now() where user_id=p.user_id;[m
[32m+[m[32m  return true;[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.cancel_economy_payout(uuid,text) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.cancel_economy_payout(uuid,text) to service_role;[m
