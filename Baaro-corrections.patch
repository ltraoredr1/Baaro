[32m+[m[32mlanguage plpgsql security invoker set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  uid uuid := auth.uid();[m
[32m+[m[32m  i public.monetization_checkout_intents;[m
[32m+[m[32m  code text;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if uid is null then raise exception 'AUTH_REQUIRED'; end if;[m
[32m+[m[32m  if p_recipient_id is null or p_recipient_id=uid then raise exception 'INVALID_RECIPIENT'; end if;[m
[32m+[m[32m  if p_amount_minor not in (10000,50000,100000) then raise exception 'INVALID_TIP_AMOUNT'; end if;[m
[32m+[m[32m  if not exists(select 1 from auth.users where id=p_recipient_id) then raise exception 'RECIPIENT_NOT_FOUND'; end if;[m
