[32m+[m[32m  p_user_id uuid default auth.uid()[m
[32m+[m[32m) returns numeric[m
[32m+[m[32mlanguage sql stable security definer set search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32m  select round([m
[32m+[m[32m    (coalesce(v.views,0)::numeric * 0.02)[m
[32m+[m[32m    + (coalesce(v.likes,0)::numeric * 1.0)[m
[32m+[m[32m    + (coalesce(v.comments_count,0)::numeric * 1.8)[m
[32m+[m[32m    + (coalesce(v.completion_rate,0) * 100)[m
[32m+[m[32m    + (coalesce(v.rewatch_rate,0) * 80)[m
[32m+[m[32m    + case when v.author_id = p_user_id then -100 else 0 end[m
[32m+[m[32m  , 4)[m
[32m+[m[32m  from public.videos v[m
[32m+[m[32m  where v.id = p_video_id;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mrevoke all on function public.video_discovery_score(uuid, uuid) from public;[m
