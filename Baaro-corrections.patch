[32m+[m[32m-- Apply approved submissions to the public catalogue. This function is[m
[32m+[m[32m-- intentionally service-role/admin-only; clients cannot approve their own work.[m
[32m+[m[32mcreate or replace function public.publish_approved_sound(p_submission_id uuid)[m
[32m+[m[32mreturns text[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare s public.sound_submissions%rowtype; v_id text;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.role() <> 'service_role' then raise exception 'FORBIDDEN'; end if;[m
[32m+[m[32m  select * into s from public.sound_submissions where id = p_submission_id and status = 'approved';[m
[32m+[m[32m  if not found then raise exception 'SUBMISSION_NOT_APPROVED'; end if;[m
[32m+[m[32m  v_id := 'creator-' || replace(s.id::text,'-','');[m
[32m+[m[32m  insert into public.sounds ([m
[32m+[m[32m    id,title,artist,audio_url,cover_url,category,license_code,license_name,[m
[32m+[m[32m    rights_holder,attribution_required,commercial_use_allowed,remix_allowed,[m
[32m+[m[32m    upload_to_baaro_allowed,territories,status,submitted_by,source_url,rights_verified_at,rights_notes[m
[32m+[m[32m  ) values ([m
[32m+[m[32m    v_id,s.title,s.artist,s.audio_url,s.cover_url,s.category,s.license_code,s.license_name,[m
[32m+[m[32m    s.rights_holder,s.attribution_required,s.commercial_use_allowed,s.remix_allowed,[m
[32m+[m[32m    true,s.territories,'approved',s.submitted_by,s.source_url,now(),s.rights_declaration[m
[32m+[m[32m  ) on conflict (id) do update set[m
[32m+[m[32m    audio_url=excluded.audio_url, license_code=excluded.license_code,[m
[32m+[m[32m    license_name=excluded.license_name, rights_holder=excluded.rights_holder,[m
[32m+[m[32m    status='approved', rights_verified_at=now(), updated_at=now();[m
[32m+[m[32m  return v_id;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m[32mrevoke all on function public.publish_approved_sound(uuid) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.publish_approved_sound(uuid) to service_role;[m
