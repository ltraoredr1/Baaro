[32m+[m
[32m+[m[32m-- 4. Fonction RPC pour récupérer les amis réciproques[span_3](start_span)[span_3](end_span)[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.get_user_friends(uuid) CASCADE;[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.get_user_friends(uuid) CASCADE;[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.get_user_friends(user_id_param UUID)[m
[32m+[m[32mRETURNS TABLE (friend_id UUID) AS $$[m
