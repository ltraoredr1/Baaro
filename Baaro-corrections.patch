[32m+[m[32m-- SOURCE: 0006_add_messages_security.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- Corrige la sécurité de la messagerie privée (table `messages`).[m
[32m+[m[32m-- La table a été créée avec RLS activée mais SANS aucune policy, ce qui[m
[32m+[m[32m-- bloquait tout accès (aucune lecture ni écriture possible).[m
[32m+[m[32m-- À exécuter après supabase-schema.sql, dans une nouvelle requête du SQL Editor.[m
[32m+[m
[32m+[m[32mdrop policy if exists "messages_read_own" on messages;[m
[32m+[m[32mcreate policy "messages_read_own" on messages[m
[32m+[m[32m  for select[m
[32m+[m[32m  using (auth.uid() = sender_id or auth.uid() = recipient_id);[m
[32m+[m
[32m+[m[32mdrop policy if exists "messages_send_own" on messages;[m
[32m+[m[32mcreate policy "messages_send_own" on messages[m
[32m+[m[32m  for insert[m
[32m+[m[32m  with check (auth.uid() = sender_id);[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0007_add_multihost_gifts.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO — Lives multi-hôtes (Daily.co) + Cadeaux[m
[32m+[m[32m-- À exécuter APRÈS supabase-add-debates.sql et supabase-fix-debates-security.sql[m
[32m+[m[32m-- Version corrigée sur le vrai schéma (debate_rooms/debate_participants[m
[32m+[m[32m-- avec PK (room_id,user_id), debate_messages avec sender_id/sender_type).[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32m-- 1. RÔLES DANS LE LIVE[m
[32m+[m[32m-- ------------------------------------------------------------[m
[32m+[m[32malter table debate_participants[m
[32m+[m[32m  add column if not exists role text not null default 'viewer'[m
[32m+[m[32m  check (role in ('host', 'co_host', 'viewer'));[m
[32m+[m
[32m+[m[32m-- Pas besoin de contrainte d'unicité supplémentaire : (room_id, user_id)[m
[32m+[m[32m-- est déjà la clé primaire de debate_participants.[m
[32m+[m
[32m+[m[32mcreate index if not exists idx_debate_participants_broadcasters[m
[32m+[m[32m  on debate_participants (room_id, role)[m
[32m+[m[32m  where role in ('host', 'co_host');[m
[32m+[m
[32m+[m[32m-- ⚠️ CORRECTIF DE SÉCURITÉ IMPORTANT ⚠️[m
[32m+[m[32m-- La policy existante "debate_participants_update_own" (voir[m
[32m+[m[32m-- supabase-add-debates.sql) autorise chaque utilisateur à modifier N'IMPORTE[m
[32m+[m[32m-- QUELLE colonne de sa propre ligne, y compris "role" — un spectateur[m
[32m+[m[32m-- pourrait donc s'auto-promouvoir hôte par un simple UPDATE depuis la[m
[32m+[m[32m-- console du navigateur. Les policies RLS sont permissives (OR entre[m
[32m+[m[32m-- elles) : ajouter une policy plus restrictive ne suffit PAS à bloquer ça.[m
[32m+[m[32m-- La seule protection fiable est un trigger qui rejette tout changement de[m
[32m+[m[32m-- "role" sauf s'il vient de la clé service_role (donc uniquement via[m
[32m+[m[32m-- api/live-roles.js, qui vérifie déjà côté serveur que l'appelant est[m
[32m+[m[32m-- l'hôte du salon).[m
[32m+[m
[32m+[m[32mcreate or replace function prevent_client_role_change()[m
[32m+[m[32mreturns trigger as $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if NEW.role is distinct from OLD.role then[m
[32m+[m[32m    if auth.role() <> 'service_role' then[m
[32m+[m[32m      raise exception 'Le rôle ne peut être modifié que par le serveur';[m
[32m+[m[32m    end if;[m
[32m+[m[32m  end if;[m
[32m+[m[32m  return NEW;[m
[32m+[m[32mend;[m
[32m+[m[32m$$ language plpgsql security definer[m
[32m+[m[32mSET search_path = public;[m
[32m+[m
[32m+[m[32mdrop trigger if exists debate_participants_role_guard on debate_participants;[m
[32m+[m[32mcreate trigger debate_participants_role_guard[m
[32m+[m[32m  before update on debate_participants[m
[32m+[m[32m  for each row execute function prevent_client_role_change();[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 2. CADEAUX (GIFTS)[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mcreate table if not exists gift_types ([m
[32m+[m[32m  id text primary key,[m
[32m+[m[32m  label text not null,[m
[32m+[m[32m  icon text not null,[m
[32m+[m[32m  cost_points integer not null check (cost_points > 0),[m
[32m+[m[32m  created_at timestamptz not null default now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32minsert into gift_types (id, label, icon, cost_points) values[m
[32m+[m[32m  ('heart_gold', 'Cœur doré', '💛', 10),[m
[32m+[m[32m  ('rose', 'Rose', '🌹', 50),[m
[32m+[m[32m  ('star', 'Étoile', '⭐', 100),[m
[32m+[m[32m  ('crown', 'Couronne', '👑', 500)[m
[32m+[m[32mon conflict (id) do nothing;[m
[32m+[m
[32m+[m[32m-- FIX: une 1re version de gifts_sent (sender_id/receiver_id/gift_id) est creee plus haut.[m
[32m+[m[32m-- "create table if not exists" ne la remplacerait pas : on la supprime pour obtenir[m
[32m+[m[32m-- le schema attendu par la suite (from_user_id/to_user_id/gift_type_id/points_spent).[m
[32m+[m[32m-- Sans risque : la fonctionnalite cadeaux est supprimee en fin de migration.[m
[32m+[m[32mdrop table if exists public.gifts_sent cascade;[m
[32m+[m
[32m+[m[32mcreate table if not exists gifts_sent ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  room_id uuid not null references debate_rooms(id) on delete cascade,[m
[32m+[m[32m  from_user_id uuid not null references auth.users(id),[m
[32m+[m[32m  to_user_id uuid not null references auth.users(id),[m
[32m+[m[32m  gift_type_id text not null references gift_types(id),[m
[32m+[m[32m  points_spent integer not null,[m
[32m+[m[32m  created_at timestamptz not null default now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mcreate index if not exists idx_gifts_sent_room on gifts_sent (room_id, created_at desc);[m
[32m+[m
[32m+[m[32malter table gift_types enable row level security;[m
[32m+[m[32malter table gifts_sent enable row level security;[m
[32m+[m
[32m+[m[32mdrop policy if exists "gift_types_public_read" on gift_types;[m
[32m+[m[32mcreate policy "gift_types_public_read" on gift_types for select using (true);[m
[32m+[m
[32m+[m[32mdrop policy if exists "gifts_sent_public_read" on gifts_sent;[m
[32m+[m[32mcreate policy "gifts_sent_public_read" on gifts_sent for select using (true);[m
[32m+[m
[32m+[m[32m-- Aucune policy INSERT côté client : uniquement via api/gifts.js (service_role).[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 3. LIMITE CONNUE — messages IA/système usurpables[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- La policy "debate_messages_insert" existante (supabase-add-debates.sql)[m
[32m+[m[32m-- autorise TOUT membre du salon à insérer un message avec[m
[32m+[m[32m-- sender_type IN ('ai','system') et un texte arbitraire — donc à usurper[m
[32m+[m[32m-- l'IA ou une annonce système. C'est déjà le cas indépendamment de ce[m
[32m+[m[32m-- correctif (pas introduit par le multi-hôte). Pour corriger proprement,[m
[32m+[m[32m-- il faudrait faire écrire les messages IA depuis le serveur[m
[32m+[m[32m-- (service_role, dans api/chat.js) plutôt que depuis le client comme le[m
[32m+[m[32m-- fait useRoomChat.askAI() actuellement — je peux le faire si tu m'envoies[m
[32m+[m[32m-- api/chat.js.[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- Realtime (Database > Replication) si pas déjà fait :[m
[32m+[m[32m-- alter publication supabase_realtime add table gifts_sent;[m
[32m+[m[32m-- alter publication supabase_realtime add table debate_participants; -- déjà fait par add-debates.sql[m
