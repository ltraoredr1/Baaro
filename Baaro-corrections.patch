[32m+[m[32m    if not exists(select 1 from public.groups where id=group_id) then raise exception 'GROUP_NOT_FOUND'; end if;[m
[32m+[m[32m    insert into public.vip_group_subscriptions(group_id,subscriber_id,price_minor,currency,status,period_end)[m
[32m+[m[32m    values(group_id,i.user_id,i.amount_minor,i.currency,'active',now()+interval '30 days')[m
[32m+[m[32m    on conflict(group_id,subscriber_id) do update set price_minor=excluded.price_minor,currency=excluded.currency,status='active',period_end=excluded.period_end;[m
[32m+[m
[32m+[m[32m  elsif i.product_code='pro_merchant_monthly' then[m
[32m+[m[32m    insert into public.merchant_pro_subscriptions(merchant_id,status,price_minor,currency,current_period_end)[m
[32m+[m[32m    values(i.user_id,'active',i.amount_minor,i.currency,now()+interval '30 days')[m
[32m+[m[32m    on conflict(merchant_id) do update set status='active',price_minor=excluded.price_minor,currency=excluded.currency,current_period_end=excluded.current_period_end,updated_at=now();[m
[32m+[m
[32m+[m[32m  elsif i.product_code='cosmetics_pack_6' then[m
[32m+[m[32m    insert into public.user_cosmetics(user_id,cosmetic_code,quantity,source)[m
[32m+[m[32m    values(i.user_id,'animated_pack',6,'purchase')[m
[32m+[m[32m    on conflict(user_id,cosmetic_code) do update set quantity=public.user_cosmetics.quantity+6;[m
[32m+[m
[32m+[m[32m  elsif i.product_code='ai_pack_10' then[m
[32m+[m[32m    insert into public.ai_usage_daily(user_id,usage_date,paid_generations,units_used)[m
[32m+[m[32m    values(i.user_id,current_date,10,10)[m
