[32m+[m[32m-- 4. Trigger compteur commentaires[m
[32m+[m[32mcreate or replace function public.baaro_sync_post_comment_count()[m
[32m+[m[32mreturns trigger[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  target_post_id uuid;[m
[32m+[m[32mbegin[m
[32m+[m[32m  target_post_id := case when tg_op = 'DELETE' then old.post_id else new.post_id end;[m
[32m+[m
[32m+[m[32m  update public.posts p[m
[32m+[m[32m  set comments_count = ([m
[32m+[m[32m    select count(*)::int from public.comments c where c.post_id = target_post_id[m
[32m+[m[32m  )[m
[32m+[m[32m  where p.id = target_post_id;[m
[32m+[m
[32m+[m[32m  return case when tg_op = 'DELETE' then old else new end;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mdrop trigger if exists trg_baaro_post_comment_count on public.comments;[m
