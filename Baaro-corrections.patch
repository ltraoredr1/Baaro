[32m+[m[32mcreate or replace function public.claim_media_jobs(p_limit integer default 5, p_worker text default 'vercel')[m
[32m+[m[32mreturns setof public.media_jobs[m
[32m+[m[32mlanguage plpgsql security definer set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  return query[m
[32m+[m[32m  with picked as ([m
[32m+[m[32m    select id from public.media_jobs[m
[32m+[m[32m    where status='queued' and available_at <= now()[m
[32m+[m[32m    order by priority desc, created_at asc[m
[32m+[m[32m    for update skip locked limit greatest(1, least(p_limit, 20))[m
[32m+[m[32m  )[m
[32m+[m[32m  update public.media_jobs j[m
[32m+[m[32m  set status='processing', attempts=j.attempts+1, locked_at=now(), locked_by=p_worker, updated_at=now()[m
[32m+[m[32m  from picked[m
[32m+[m[32m  where j.id=picked.id[m
[32m+[m[32m  returning j.*;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mrevoke all on function public.claim_media_jobs(integer,text) from public;[m
