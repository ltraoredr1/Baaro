[32m+[m[32m-- SOURCE: 0035_rename_user_id_to_id.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO: supprimer le problème user_id — identité unique = id[m
[32m+[m[32m-- profiles.id / wallets.id = auth.users.id[m
[32m+[m[32m-- Ne renomme PAS les colonnes FK des tables de relation (post_likes.user_id, etc.)[m
[32m+[m
[32m+[m[32mDO $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m
[32m+[m[32m    WHERE table_schema='public' AND table_name='profiles' AND column_name='user_id'[m
[32m+[m[32m  ) AND NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m
[32m+[m[32m    WHERE table_schema='public' AND table_name='profiles' AND column_name='id'[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    ALTER TABLE public.profiles RENAME COLUMN user_id TO id;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  IF EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m
[32m+[m[32m    WHERE table_schema='public' AND table_name='wallets' AND column_name='user_id'[m
[32m+[m[32m  ) AND NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m
[32m+[m[32m    WHERE table_schema='public' AND table_name='wallets' AND column_name='id'[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    ALTER TABLE public.wallets RENAME COLUMN user_id TO id;[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- Policies[m
[32m+[m[32mDO $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  DROP POLICY IF EXISTS "profiles_insert" ON public.profiles;[m
[32m+[m[32m  CREATE POLICY "profiles_insert" ON public.profiles FOR INSERT WITH CHECK (auth.uid() = id);[m
[32m+[m[32m  DROP POLICY IF EXISTS "profiles_update" ON public.profiles;[m
[32m+[m[32m  CREATE POLICY "profiles_update" ON public.profiles FOR UPDATE USING (auth.uid() = id) WITH CHECK (auth.uid() = id);[m
[32m+[m
[32m+[m[32m  DROP POLICY IF EXISTS "wallet_own" ON public.wallets;[m
[32m+[m[32m  CREATE POLICY "wallet_own" ON public.wallets FOR ALL USING (auth.uid() = id) WITH CHECK (auth.uid() = id);[m
[32m+[m[32mEXCEPTION WHEN undefined_table THEN NULL;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32mCOMMENT ON TABLE public.profiles IS 'BAARO: id = auth.users.id (identité unique, plus de user_id)';[m
[32m+[m[32mCOMMENT ON TABLE public.wallets IS 'BAARO: id = auth.users.id';[m
[32m+[m
[32m+[m[32m-- =====================================================================[m
[32m+[m[32m-- IMPORTANT : les fonctions PL/pgSQL ne sont PAS mises à jour automatiquement[m
[32m+[m[32m-- par un RENAME COLUMN. On corrige les références wallets.user_id /[m[41m [m
[32m+[m[32m-- profiles.user_id dans les corps de fonctions.[m
[32m+[m[32m-- =====================================================================[m
[32m+[m[32mDO $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  r RECORD;[m
[32m+[m[32m  def text;[m
[32m+[m[32m  new_def text;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  FOR r IN[m
[32m+[m[32m    SELECT p.oid, p.proname, n.nspname[m
[32m+[m[32m    FROM pg_proc p[m
[32m+[m[32m    JOIN pg_namespace n ON n.oid = p.pronamespace[m
[32m+[m[32m    WHERE n.nspname = 'public'[m
[32m+[m[32m      AND p.prokind = 'f'[m
[32m+[m[32m      AND pg_get_functiondef(p.oid) ~* '(wallets|profiles).*user_id|from public\.(wallets|profiles) where user_id'[m
[32m+[m[32m  LOOP[m
[32m+[m[32m    def := pg_get_functiondef(r.oid);[m
[32m+[m[32m    new_def := def;[m
[32m+[m[32m    -- Remplacements ciblés pour les tables d'identité uniquement[m
[32m+[m[32m    new_def := regexp_replace(new_def, 'from public\.wallets where user_id', 'from public.wallets where id', 'gi');[m
[32m+[m[32m    new_def := regexp_replace(new_def, 'from public\.profiles where user_id', 'from public.profiles where id', 'gi');[m
[32m+[m[32m    new_def := regexp_replace(new_def, 'update public\.wallets set ([^;]+) where user_id', 'update public.wallets set \1 where id', 'gi');[m
[32m+[m[32m    new_def := regexp_replace(new_def, 'update public\.profiles set ([^;]+) where user_id', 'update public.profiles set \1 where id', 'gi');[m
[32m+[m[32m    new_def := regexp_replace(new_def, 'join public\.profiles p on p\.user_id', 'join public.profiles p on p.id', 'gi');[m
[32m+[m[32m    new_def := regexp_replace(new_def, 'left join public\.profiles p on p\.user_id', 'left join public.profiles p on p.id', 'gi');[m
[32m+[m[32m    new_def := regexp_replace(new_def, 'profiles\.user_id', 'profiles.id', 'gi');[m
[32m+[m[32m    new_def := regexp_replace(new_def, 'wallets\.user_id', 'wallets.id', 'gi');[m
[32m+[m
[32m+[m[32m    IF new_def IS DISTINCT FROM def THEN[m
[32m+[m[32m      BEGIN[m
[32m+[m[32m        EXECUTE new_def;[m
[32m+[m[32m        RAISE NOTICE 'Fonction corrigée: %.%', r.nspname, r.proname;[m
[32m+[m[32m      EXCEPTION WHEN OTHERS THEN[m
