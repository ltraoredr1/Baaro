[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 033_profile_identity_location_country.sql[m
[32m+[m[32m-- BAARO — identité de profil, âge, localisation et pays d'inscription.[m
[32m+[m[32m-- Aucun nouvel endpoint API. Les règles sensibles sont imposées par PostgreSQL/RLS.[m
[32m+[m
[32m+[m[32malter table public.profiles[m
[32m+[m[32m  add column if not exists first_name text not null default '',[m
[32m+[m[32m  add column if not exists last_name text not null default '',[m
[32m+[m[32m  add column if not exists birth_date date,[m
[32m+[m[32m  add column if not exists location text,[m
[32m+[m[32m  add column if not exists registered_country text,[m
[32m+[m[32m  add column if not exists country_changed_at timestamptz,[m
[32m+[m[32m  add column if not exists country_change_available_at timestamptz,[m
[32m+[m[32m  add column if not exists country text;[m
[32m+[m
[32m+[m[32m-- Normalisation + règles métier côté serveur.[m
[32m+[m[32mcreate or replace function public.guard_profile_identity_and_country()[m
[32m+[m[32mreturns trigger[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_registered text;[m
[32m+[m[32m  v_previous text;[m
[32m+[m[32m  v_next text;[m
[32m+[m[32m  v_flag text;[m
[32m+[m[32mbegin[m
[32m+[m[32m  -- Nettoyage et limites de taille.[m
[32m+[m[32m  new.first_name := left(trim(coalesce(new.first_name, '')), 60);[m
[32m+[m[32m  new.last_name := left(trim(coalesce(new.last_name, '')), 60);[m
[32m+[m[32m  new.location := left(trim(coalesce(new.location, '')), 120);[m
[32m+[m[32m  new.display_name := left(trim(coalesce(new.display_name, '')), 120);[m
[32m+[m[32m  new.bio := left(trim(coalesce(new.bio, '')), 500);[m
[32m+[m
[32m+[m[32m  v_previous := upper(nullif(trim(coalesce(old.country, '')), ''));[m
[32m+[m[32m  v_next := upper(nullif(trim(coalesce(new.country, '')), ''));[m
[32m+[m[32m  v_registered := upper(nullif(trim(coalesce(old.registered_country, '')), ''));[m
[32m+[m
[32m+[m[32m  if new.birth_date is not null then[m
[32m+[m[32m    if new.birth_date < date '1900-01-01' or new.birth_date > (current_date - interval '13 years')::date then[m
[32m+[m[32m      raise exception 'Date de naissance invalide: âge minimum de 13 ans';[m
[32m+[m[32m    end if;[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  -- Le pays d'inscription est immuable après sa première définition.[m
[32m+[m[32m  if tg_op = 'INSERT' then[m
[32m+[m[32m    if v_next is not null then[m
[32m+[m[32m      new.country := v_next;[m
[32m+[m[32m      new.registered_country := v_next;[m
[32m+[m[32m      new.country_changed_at := null;[m
[32m+[m[32m      new.country_change_available_at := null;[m
[32m+[m[32m    else[m
[32m+[m[32m      new.country := null;[m
[32m+[m[32m      new.registered_country := null;[m
[32m+[m[32m    end if;[m
[32m+[m[32m  else[m
[32m+[m[32m    if v_registered is not null then[m
[32m+[m[32m      new.registered_country := v_registered;[m
[32m+[m[32m    elsif v_next is not null then[m
[32m+[m[32m      new.registered_country := v_next;[m
[32m+[m[32m    else[m
[32m+[m[32m      new.registered_country := null;[m
[32m+[m[32m    end if;[m
[32m+[m
[32m+[m[32m    if v_previous is distinct from v_next then[m
[32m+[m[32m      -- Première définition du pays : pas de délai.[m
[32m+[m[32m      if v_previous is null then[m
[32m+[m[32m        new.country_changed_at := null;[m
[32m+[m[32m        new.country_change_available_at := null;[m
[32m+[m[32m      else[m
[32m+[m[32m        -- Tout changement ultérieur est bloqué pendant 4 mois.[m
[32m+[m[32m        if old.country_change_available_at is not null[m
[32m+[m[32m           and old.country_change_available_at > now() then[m
[32m+[m[32m          raise exception 'Changement de pays disponible le %', old.country_change_available_at;[m
[32m+[m[32m        end if;[m
[32m+[m[32m        new.country_changed_at := now();[m
[32m+[m[32m        new.country_change_available_at := now() + interval '4 months';[m
[32m+[m[32m      end if;[m
[32m+[m[32m    else[m
[32m+[m[32m      new.country_changed_at := old.country_changed_at;[m
[32m+[m[32m      new.country_change_available_at := old.country_change_available_at;[m
[32m+[m[32m    end if;[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  -- Le drapeau est dérivé du pays et ne peut pas être arbitrairement modifié.[m
[32m+[m[32m  v_next := upper(nullif(trim(coalesce(new.country, '')), ''));[m
[32m+[m[32m  v_flag := case v_next[m
[32m+[m[32m    when 'ML' then '🇲🇱'[m
[32m+[m[32m    when 'SN' then '🇸🇳'[m
[32m+[m[32m    when 'CI' then '🇨🇮'[m
[32m+[m[32m    when 'BF' then '🇧🇫'[m
[32m+[m[32m    when 'GN' then '🇬🇳'[m
[32m+[m[32m    when 'NE' then '🇳🇪'[m
[32m+[m[32m    when 'TG' then '🇹🇬'[m
[32m+[m[32m    when 'BJ' then '🇧🇯'[m
[32m+[m[32m    when 'CM' then '🇨🇲'[m
[32m+[m[32m    when 'NG' then '🇳🇬'[m
[32m+[m[32m    when 'GH' then '🇬🇭'[m
[32m+[m[32m    when 'MA' then '🇲🇦'[m
[32m+[m[32m    else '🌍'[m
[32m+[m[32m  end;[m
[32m+[m[32m  new.flag := v_flag;[m
[32m+[m
[32m+[m[32m  return new;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mdrop trigger if exists profiles_identity_country_guard on public.profiles;[m
[32m+[m[32mcreate trigger profiles_identity_country_guard[m
[32m+[m[32mbefore insert or update of first_name, last_name, birth_date, location, country, registered_country, flag, display_name, bio[m
[32m+[m[32mon public.profiles[m
[32m+[m[32mfor each row execute function public.guard_profile_identity_and_country();[m
[32m+[m
[32m+[m[32m-- Remet les anciennes lignes en état cohérent sans modifier le pays d'inscription[m
[32m+[m[32m-- lorsqu'il existe déjà.[m
[32m+[m[32mupdate public.profiles[m
[32m+[m[32mset[m
[32m+[m[32m  first_name = left(trim(coalesce(first_name, '')), 60),[m
[32m+[m[32m  last_name = left(trim(coalesce(last_name, '')), 60),[m
[32m+[m[32m  location = left(trim(coalesce(location, '')), 120),[m
