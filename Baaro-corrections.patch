[32m+[m[32m    'security_setting_changed','key_rotated'[m
[32m+[m[32m  )),[m
[32m+[m[32m  device_id text,[m
[32m+[m[32m  request_id text,[m
[32m+[m[32m  ip_hash text,[m
[32m+[m[32m  user_agent_hash text,[m
