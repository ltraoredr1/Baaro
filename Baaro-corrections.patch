[32m+[m[32m-- SOURCE: 0055_follows_status.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO — Colonnes amis + RLS follows (obligatoire pour FriendRequestButton)[m
[32m+[m[32malter table public.follows[m
[32m+[m[32m  add column if not exists status text not null default 'accepted';[m
[32m+[m[32malter table public.follows[m
