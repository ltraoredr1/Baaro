[32m+[m[32m-- SOURCE: 0018_messaging_calls_integrity.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO 2.0 — Messaging + Calls integrity hardening[m
[32m+[m[32m-- Apply after migrations 001-016.[m
[32m+[m
[32m+[m[32m-- 1) Messages: sender/recipient/conversation must describe the same private chat.[m
[32m+[m[32mcreate or replace function public.validate_message_participants()[m
[32m+[m[32mreturns trigger[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  c public.conversations;[m
[32m+[m[32mbegin[m
[32m+[m[32m  select * into c from public.conversations where id = new.conversation_id for share;[m
[32m+[m[32m  if not found then raise exception 'CONVERSATION_NOT_FOUND'; end if;[m
[32m+[m
[32m+[m[32m  if new.sender_id is null or new.sender_id <> auth.uid() then[m
[32m+[m[32m    raise exception 'MESSAGE_SENDER_FORBIDDEN';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  if not ((c.user1_id = new.sender_id and c.user2_id = new.recipient_id)[m
[32m+[m[32m       or (c.user2_id = new.sender_id and c.user1_id = new.recipient_id)) then[m
[32m+[m[32m    raise exception 'MESSAGE_PARTICIPANTS_MISMATCH';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  return new;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mdrop trigger if exists trg_messages_validate_participants on public.messages;[m
[32m+[m[32mcreate trigger trg_messages_validate_participants[m
[32m+[m[32mbefore insert on public.messages[m
[32m+[m[32mfor each row execute function public.validate_message_participants();[m
[32m+[m
[32m+[m[32mcreate or replace function public.prevent_message_identity_change()[m
[32m+[m[32mreturns trigger[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if new.sender_id <> old.sender_id[m
[32m+[m[32m     or coalesce(new.recipient_id::text,'') <> coalesce(old.recipient_id::text,'')[m
[32m+[m[32m     or new.conversation_id <> old.conversation_id then[m
[32m+[m[32m    raise exception 'MESSAGE_IDENTITY_FIELDS_IMMUTABLE';[m
[32m+[m[32m  end if;[m
[32m+[m[32m  return new;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mdrop trigger if exists trg_messages_identity_guard on public.messages;[m
[32m+[m[32mcreate trigger trg_messages_identity_guard[m
[32m+[m[32mbefore update on public.messages[m
[32m+[m[32mfor each row execute function public.prevent_message_identity_change();[m
[32m+[m
[32m+[m[32m-- 2) Conversations: prevent self-conversations and make pair ordering canonical.[m
[32m+[m[32mcreate or replace function public.normalize_conversation_pair()[m
[32m+[m[32mreturns trigger[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare tmp uuid;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if new.user1_id = new.user2_id then raise exception 'SELF_CONVERSATION_FORBIDDEN'; end if;[m
[32m+[m[32m  if new.user1_id > new.user2_id then[m
[32m+[m[32m    tmp := new.user1_id; new.user1_id := new.user2_id; new.user2_id := tmp;[m
[32m+[m[32m  end if;[m
[32m+[m[32m  if auth.uid() is not null and auth.uid() <> new.user1_id and auth.uid() <> new.user2_id then[m
[32m+[m[32m    raise exception 'CONVERSATION_PARTICIPANT_FORBIDDEN';[m
[32m+[m[32m  end if;[m
[32m+[m[32m  return new;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mdrop trigger if exists trg_conversations_normalize on public.conversations;[m
[32m+[m[32mcreate trigger trg_conversations_normalize[m
[32m+[m[32mbefore insert on public.conversations[m
[32m+[m[32mfor each row execute function public.normalize_conversation_pair();[m
[32m+[m
[32m+[m[32m-- 3) Calls: caller/callee must belong to the same conversation.[m
[32m+[m[32mcreate or replace function public.validate_call_participants()[m
[32m+[m[32mreturns trigger[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare c public.conversations;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if new.caller_id = new.callee_id then raise exception 'SELF_CALL_FORBIDDEN'; end if;[m
[32m+[m[32m  select * into c from public.conversations where id = new.conversation_id;[m
[32m+[m[32m  if not found then raise exception 'CONVERSATION_NOT_FOUND'; end if;[m
[32m+[m[32m  if not ((c.user1_id = new.caller_id and c.user2_id = new.callee_id)[m
[32m+[m[32m       or (c.user2_id = new.caller_id and c.user1_id = new.callee_id)) then[m
[32m+[m[32m    raise exception 'CALL_PARTICIPANTS_MISMATCH';[m
[32m+[m[32m  end if;[m
[32m+[m[32m  if new.caller_id <> auth.uid() then raise exception 'CALLER_FORBIDDEN'; end if;[m
[32m+[m[32m  return new;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mdrop trigger if exists trg_calls_validate_participants on public.calls;[m
[32m+[m[32mcreate trigger trg_calls_validate_participants[m
[32m+[m[32mbefore insert on public.calls[m
[32m+[m[32mfor each row execute function public.validate_call_participants();[m
[32m+[m
[32m+[m[32m-- Restrict call status transitions to sensible forward states.[m
[32m+[m[32mcreate or replace function public.validate_call_status_transition()[m
[32m+[m[32mreturns trigger[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if old.status = 'ringing' and new.status not in ('ringing','accepted','rejected','missed','cancelled','ended') then[m
[32m+[m[32m    raise exception 'INVALID_CALL_STATUS_TRANSITION';[m
[32m+[m[32m  elsif old.status = 'accepted' and new.status not in ('accepted','ended','cancelled') then[m
[32m+[m[32m    raise exception 'INVALID_CALL_STATUS_TRANSITION';[m
[32m+[m[32m  elsif old.status in ('rejected','missed','ended','cancelled') and new.status <> old.status then[m
[32m+[m[32m    raise exception 'CALL_ALREADY_TERMINAL';[m
[32m+[m[32m  end if;[m
[32m+[m[32m  return new;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mdrop trigger if exists trg_calls_status_transition on public.calls;[m
[32m+[m[32mcreate trigger trg_calls_status_transition[m
[32m+[m[32mbefore update on public.calls[m
[32m+[m[32mfor each row execute function public.validate_call_status_transition();[m
[32m+[m
[32m+[m[32m-- Realtime remains useful for incoming calls and messages.[m
[32m+[m[32mdo $$ begin[m
[32m+[m[32m  alter publication supabase_realtime add table public.calls;[m
[32m+[m[32mexception when duplicate_object then null; end $$;[m
