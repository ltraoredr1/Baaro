[32m+[m[32mlanguage sql[m
[32m+[m[32mstable[m
[32m+[m[32msecurity invoker[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32m  select[m
[32m+[m[32m    s.id, s.title, s.artist, s.audio_url, s.cover_url,[m
[32m+[m[32m    null::integer as duration_seconds,[m
[32m+[m[32m    s.usage_count, s.category, s.license_code, s.license_name,[m
[32m+[m[32m    s.rights_holder, s.attribution_required, s.commercial_use_allowed,[m
[32m+[m[32m    s.remix_allowed, s.language, s.region, s.source_url[m
[32m+[m[32m  from public.sounds s[m
[32m+[m[32m  where s.status = 'approved'[m
[32m+[m[32m    and s.upload_to_baaro_allowed = true[m
[32m+[m[32m    and (p_genre is null or s.category = p_genre or s.category = 'original')[m
