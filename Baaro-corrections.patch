[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0036_identity_id_only_and_profile_persistence.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO 038: identité unique = id uniquement + persistance des profils[m
[32m+[m[32m-- - profiles / wallets : clé primaire = id (UUID auth.users.id)[m
[32m+[m[32m-- - Plus de colonne user_id sur ces tables d'identité[m
[32m+[m[32m-- - FKs qui référençaient profiles(user_id) pointent vers profiles(id)[m
[32m+[m[32m-- - RLS et trigger de création automatique de profil à l'inscription[m
[32m+[m
[32m+[m[32m-- 1) Renommer user_id → id sur les tables d'identité si nécessaire[m
[32m+[m[32mDO $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m
[32m+[m[32m    WHERE table_schema = 'public' AND table_name = 'profiles' AND column_name = 'user_id'[m
[32m+[m[32m  ) AND NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m
[32m+[m[32m    WHERE table_schema = 'public' AND table_name = 'profiles' AND column_name = 'id'[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    ALTER TABLE public.profiles RENAME COLUMN user_id TO id;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  IF EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m
[32m+[m[32m    WHERE table_schema = 'public' AND table_name = 'wallets' AND column_name = 'user_id'[m
[32m+[m[32m  ) AND NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m
[32m+[m[32m    WHERE table_schema = 'public' AND table_name = 'wallets' AND column_name = 'id'[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    ALTER TABLE public.wallets RENAME COLUMN user_id TO id;[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- 2) S'assurer que id est PK et référence auth.users[m
[32m+[m[32mDO $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  -- profiles[m
[32m+[m[32m  IF to_regclass('public.profiles') IS NOT NULL THEN[m
[32m+[m[32m    BEGIN[m
[32m+[m[32m      ALTER TABLE public.profiles[m
[32m+[m[32m        ALTER COLUMN id SET NOT NULL;[m
[32m+[m[32m    EXCEPTION WHEN OTHERS THEN NULL;[m
[32m+[m[32m    END;[m
[32m+[m[32m    BEGIN[m
[32m+[m[32m      ALTER TABLE public.profiles DROP CONSTRAINT IF EXISTS profiles_pkey;[m
[32m+[m[32m      ALTER TABLE public.profiles ADD PRIMARY KEY (id);[m
[32m+[m[32m    EXCEPTION WHEN OTHERS THEN NULL;[m
[32m+[m[32m    END;[m
[32m+[m[32m    BEGIN[m
[32m+[m[32m      ALTER TABLE public.profiles[m
[32m+[m[32m        DROP CONSTRAINT IF EXISTS profiles_id_fkey;[m
[32m+[m[32m      ALTER TABLE public.profiles[m
[32m+[m[32m        ADD CONSTRAINT profiles_id_fkey[m
[32m+[m[32m        FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE;[m
[32m+[m[32m    EXCEPTION WHEN OTHERS THEN NULL;[m
[32m+[m[32m    END;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  -- wallets[m
[32m+[m[32m  IF to_regclass('public.wallets') IS NOT NULL THEN[m
[32m+[m[32m    BEGIN[m
[32m+[m[32m      ALTER TABLE public.wallets DROP CONSTRAINT IF EXISTS wallets_pkey;[m
[32m+[m[32m      ALTER TABLE public.wallets ADD PRIMARY KEY (id);[m
[32m+[m[32m    EXCEPTION WHEN OTHERS THEN NULL;[m
[32m+[m[32m    END;[m
[32m+[m[32m    BEGIN[m
[32m+[m[32m      ALTER TABLE public.wallets[m
[32m+[m[32m        DROP CONSTRAINT IF EXISTS wallets_id_fkey;[m
[32m+[m[32m      ALTER TABLE public.wallets[m
[32m+[m[32m        ADD CONSTRAINT wallets_id_fkey[m
[32m+[m[32m        FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE;[m
[32m+[m[32m    EXCEPTION WHEN OTHERS THEN NULL;[m
[32m+[m[32m    END;[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- 3) Corriger les FKs qui pointaient encore vers profiles(user_id)[m
[32m+[m[32mDO $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  r RECORD;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  FOR r IN[m
[32m+[m[32m    SELECT con.conname, rel.relname AS table_name[m
[32m+[m[32m    FROM pg_constraint con[m
[32m+[m[32m    JOIN pg_class rel ON rel.oid = con.conrelid[m
[32m+[m[32m    JOIN pg_namespace nsp ON nsp.oid = rel.relnamespace[m
[32m+[m[32m    WHERE nsp.nspname = 'public'[m
[32m+[m[32m      AND con.contype = 'f'[m
[32m+[m[32m      AND pg_get_constraintdef(con.oid) ILIKE '%profiles%user_id%'[m
[32m+[m[32m  LOOP[m
[32m+[m[32m    EXECUTE format('ALTER TABLE public.%I DROP CONSTRAINT IF EXISTS %I', r.table_name, r.conname);[m
[32m+[m[32m  END LOOP;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- Recréer les FKs principales vers profiles(id)[m
[32m+[m[32mDO $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF to_regclass('public.shops') IS NOT NULL THEN[m
