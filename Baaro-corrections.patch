[32m+[m[32m-- ============================================[m
[32m+[m[32m-- 3. VUE POUR RÉSULTATS DE SONDAGES[m
[32m+[m[32m-- ============================================[m
[32m+[m[32mCREATE OR REPLACE VIEW public.poll_results AS[m
[32m+[m[32mSELECT[m[41m [m
[32m+[m[32m  po.poll_id,[m
[32m+[m[32m  po.id AS option_id,[m
[32m+[m[32m  po.option_text,[m
[32m+[m[32m  po.position,[m
