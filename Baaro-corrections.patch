[32m+[m[32m-- Messages: a sender may only send to the other participant of the conversation.[m
[32m+[m[32m-- This prevents arbitrary message injection into a valid conversation row.[m
[32m+[m[32mdrop policy if exists "messages_send_own" on public.messages;[m
[32m+[m[32mcreate policy "messages_send_own" on public.messages[m
[32m+[m[32m  for insert[m
[32m+[m[32m  with check ([m
[32m+[m[32m    auth.uid() = sender_id[m
[32m+[m[32m    and ([m
[32m+[m[32m      recipient_id is null[m
[32m+[m[32m      or recipient_id <> sender_id[m
[32m+[m[32m    )[m
[32m+[m[32m    and exists ([m
[32m+[m[32m      select 1[m
[32m+[m[32m      from public.conversations c[m
[32m+[m[32m      where c.id = messages.conversation_id[m
[32m+[m[32m        and ([m
[32m+[m[32m          (c.user1_id = auth.uid() and c.user2_id = messages.recipient_id)[m
[32m+[m[32m          or[m
[32m+[m[32m          (c.user2_id = auth.uid() and c.user1_id = messages.recipient_id)[m
[32m+[m[32m        )[m
[32m+[m[32m    )[m
[32m+[m[32m  );[m
