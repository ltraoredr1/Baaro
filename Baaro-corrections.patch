[32m+[m[32mCREATE POLICY "videos_update_own" ON public.videos[m
[32m+[m[32mFOR UPDATE TO authenticated[m
[32m+[m[32mUSING (auth.uid() = author_id)[m
[32m+[m[32mWITH CHECK (auth.uid() = author_id);[m
