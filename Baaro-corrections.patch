[32m+[m[32m-- Trigger guard pour groups[m
[32m+[m[32mcreate or replace function public.groups_guard()[m
[32m+[m[32mreturns trigger language plpgsql as $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if tg_op = 'INSERT' then[m
[32m+[m[32m    new.is_public := coalesce(new.is_public, true) and not coalesce(new.is_private, false);[m
[32m+[m[32m  else[m
[32m+[m[32m    if new.owner_id is distinct from old.owner_id and auth.uid() is not null then[m
[32m+[m[32m      raise exception 'Changement de propriétaire interdit';[m
[32m+[m[32m    end if;[m
[32m+[m[32m    if new.is_public is not distinct from old.is_public[m
[32m+[m[32m       and new.is_private is distinct from old.is_private then[m
[32m+[m[32m      new.is_public := not new.is_private;[m
[32m+[m[32m    end if;[m
[32m+[m[32m  end if;[m
[32m+[m[32m  new.is_private := not coalesce(new.is_public, true);[m
[32m+[m[32m  return new;[m
[32m+[m[32mend $$;[m
[32m+[m
[32m+[m[32mdrop trigger if exists trg_groups_guard on public.groups;[m
