[32m+[m[32m    EXCEPTION WHEN OTHERS THEN NULL;[m
[32m+[m[32m    END;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  IF to_regclass('public.companies') IS NOT NULL THEN[m
[32m+[m[32m    BEGIN[m
[32m+[m[32m      ALTER TABLE public.companies[m
[32m+[m[32m        DROP CONSTRAINT IF EXISTS companies_owner_id_fkey;[m
[32m+[m[32m      ALTER TABLE public.companies[m
[32m+[m[32m        ADD CONSTRAINT companies_owner_id_fkey[m
[32m+[m[32m        FOREIGN KEY (owner_id) REFERENCES public.profiles(id) ON DELETE CASCADE;[m
[32m+[m[32m    EXCEPTION WHEN OTHERS THEN NULL;[m
[32m+[m[32m    END;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  IF to_regclass('public.company_reviews') IS NOT NULL THEN[m
[32m+[m[32m    BEGIN[m
[32m+[m[32m      ALTER TABLE public.company_reviews[m
[32m+[m[32m        DROP CONSTRAINT IF EXISTS company_reviews_user_id_fkey;[m
[32m+[m[32m      ALTER TABLE public.company_reviews[m
[32m+[m[32m        ADD CONSTRAINT company_reviews_user_id_fkey[m
[32m+[m[32m        FOREIGN KEY (user_id) REFERENCES public.profiles(id) ON DELETE CASCADE;[m
[32m+[m[32m    EXCEPTION WHEN OTHERS THEN NULL;[m
[32m+[m[32m    END;[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- 4) RLS : identité = id[m
[32m+[m[32mALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;[m
[32m+[m
[32m+[m[32mDROP POLICY IF EXISTS "profiles_read" ON public.profiles;[m
[32m+[m[32mCREATE POLICY "profiles_read" ON public.profiles FOR SELECT USING (true);[m
[32m+[m
