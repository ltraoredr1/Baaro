[32m+[m[32m-- 5. ACTIVATION RLS[m
[32m+[m[32m-- ============================================[m
[32m+[m[32mALTER TABLE public.polls ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE public.poll_options ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE public.poll_votes ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE public.post_reactions ENABLE ROW LEVEL SECURITY;[m
[32m+[m[32mALTER TABLE public.post_bookmarks ENABLE ROW LEVEL SECURITY;[m
