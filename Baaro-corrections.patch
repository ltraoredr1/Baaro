[32m+[m[32mcreate or replace function public.create_community_group([m
[32m+[m[32m  p_name text,[m
[32m+[m[32m  p_description text default null,[m
[32m+[m[32m  p_is_public boolean default true,[m
[32m+[m[32m  p_category text default 'community'[m
[32m+[m[32m)[m
[32m+[m[32mreturns public.groups[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_uid uuid := auth.uid();[m
[32m+[m[32m  v_group public.groups;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if v_uid is null then raise exception 'Non authentifié'; end if;[m
[32m+[m[32m  if p_name is null or length(trim(p_name)) < 2 then[m
[32m+[m[32m    raise exception 'Nom du groupe trop court';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  insert into public.groups (name, description, owner_id, is_public, category)[m
[32m+[m[32m  values ([m
[32m+[m[32m    left(trim(p_name), 80),[m
[32m+[m[32m    nullif(left(trim(coalesce(p_description, '')), 500), ''),[m
[32m+[m[32m    v_uid,[m
[32m+[m[32m    coalesce(p_is_public, true),[m
[32m+[m[32m    coalesce(nullif(trim(p_category), ''), 'community')[m
[32m+[m[32m  )[m
[32m+[m[32m  returning * into v_group;[m
[32m+[m
[32m+[m[32m  insert into public.group_members (group_id, user_id, role)[m
[32m+[m[32m  values (v_group.id, v_uid, 'owner')[m
[32m+[m[32m  on conflict (group_id, user_id) do update set role = 'owner';[m
[32m+[m
[32m+[m[32m  insert into public.channels (group_id, name, type, description)[m
[32m+[m[32m  values (v_group.id, 'general', 'text', 'Canal principal');[m
[32m+[m
[32m+[m[32m  return v_group;[m
[32m+[m[32mend $$;[m
