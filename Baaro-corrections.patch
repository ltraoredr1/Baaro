[32m+[m[32m  audio_url text,[m
[32m+[m[32m  cover_url text,[m
[32m+[m[32m  duration_seconds integer,[m
[32m+[m[32m  usage_count integer,[m
[32m+[m[32m  category text,[m
[32m+[m[32m  license_code text,[m
[32m+[m[32m  license_name text,[m
[32m+[m[32m  rights_holder text,[m
