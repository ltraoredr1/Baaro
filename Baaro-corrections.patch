[32m+[m[32mcreate or replace function public.revoke_group_invite(p_invite_id uuid)[m
[32m+[m[32mreturns void[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_group uuid;[m
[32m+[m[32mbegin[m
[32m+[m[32m  select group_id into v_group[m
[32m+[m[32m  from public.group_invites[m
[32m+[m[32m  where id = p_invite_id;[m
[32m+[m
[32m+[m[32m  if v_group is null then[m
[32m+[m[32m    raise exception 'Invitation introuvable';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  if public.group_role(v_group) not in ('owner', 'admin') then[m
[32m+[m[32m    raise exception 'Droits insuffisants';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  delete from public.group_invites where id = p_invite_id;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mcreate or replace function public.peek_group_invite(p_code text)[m
[32m+[m[32mreturns jsonb[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_inv public.group_invites;[m
[32m+[m[32m  v_g public.groups;[m
[32m+[m[32m  v_count int;[m
[32m+[m[32mbegin[m
[32m+[m[32m  select * into v_inv[m
[32m+[m[32m  from public.group_invites[m
[32m+[m[32m  where upper(code) = upper(trim(p_code))[m
[32m+[m[32m    and (expires_at is null or expires_at > now())[m
[32m+[m[32m    and (coalesce(max_uses, 0) = 0 or coalesce(uses, 0) < max_uses);[m
[32m+[m
[32m+[m[32m  if not found then[m
[32m+[m[32m    return jsonb_build_object('ok', false, 'error', 'invalid');[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  select * into v_g from public.groups where id = v_inv.group_id;[m
[32m+[m
[32m+[m[32m  if not found then[m
[32m+[m[32m    return jsonb_build_object('ok', false, 'error', 'group_gone');[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  select count(*)::int into v_count[m
[32m+[m[32m  from public.group_members[m
[32m+[m[32m  where group_id = v_g.id;[m
[32m+[m
[32m+[m[32m  return jsonb_build_object([m
[32m+[m[32m    'ok', true,[m
[32m+[m[32m    'group_id', v_g.id,[m
[32m+[m[32m    'name', v_g.name,[m
[32m+[m[32m    'description', v_g.description,[m
[32m+[m[32m    'is_public', coalesce(v_g.is_public, true),[m
[32m+[m[32m    'member_count', v_count,[m
[32m+[m[32m    'code', v_inv.code[m
[32m+[m[32m  );[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SECTION 2 : NOTIFICATIONS[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32m-- 2.1 Table notifications[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS public.notifications ([m
[32m+[m[32m  notification_id UUID PRIMARY KEY DEFAULT gen_random_uuid(),[m
[32m+[m[32m  user_id UUID NOT NULL,[m
[32m+[m[32m  actor_id UUID NULL,[m
[32m+[m[32m  type TEXT NULL DEFAULT 'general',[m
[32m+[m[32m  message TEXT NOT NULL DEFAULT '',[m
[32m+[m[32m  source_id UUID NULL,[m
[32m+[m[32m  read BOOLEAN NOT NULL DEFAULT false,[m
[32m+[m[32m  read_at TIMESTAMPTZ NULL,[m
[32m+[m[32m  created_at TIMESTAMPTZ NOT NULL DEFAULT now(),[m
[32m+[m[32m  updated_at TIMESTAMPTZ NOT NULL DEFAULT now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- Normalisation des anciennes colonnes[m
[32m+[m[32mDO $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m
[32m+[m[32m    WHERE table_schema = 'public' AND table_name = 'notifications' AND column_name = 'id'[m
[32m+[m[32m  )[m
[32m+[m[32m  AND NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m
[32m+[m[32m    WHERE table_schema = 'public' AND table_name = 'notifications' AND column_name = 'notification_id'[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    ALTER TABLE public.notifications RENAME COLUMN id TO notification_id;[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32mALTER TABLE public.notifications ADD COLUMN IF NOT EXISTS notification_id UUID;[m
[32m+[m[32mALTER TABLE public.notifications ADD COLUMN IF NOT EXISTS user_id UUID;[m
[32m+[m[32mALTER TABLE public.notifications ADD COLUMN IF NOT EXISTS actor_id UUID;[m
[32m+[m[32mALTER TABLE public.notifications ADD COLUMN IF NOT EXISTS type TEXT;[m
[32m+[m[32mALTER TABLE public.notifications ADD COLUMN IF NOT EXISTS message TEXT;[m
[32m+[m[32mALTER TABLE public.notifications ADD COLUMN IF NOT EXISTS source_id UUID;[m
[32m+[m[32mALTER TABLE public.notifications ADD COLUMN IF NOT EXISTS read BOOLEAN;[m
[32m+[m[32mALTER TABLE public.notifications ADD COLUMN IF NOT EXISTS read_at TIMESTAMPTZ;[m
[32m+[m[32mALTER TABLE public.notifications ADD COLUMN IF NOT EXISTS created_at TIMESTAMPTZ;[m
[32m+[m[32mALTER TABLE public.notifications ADD COLUMN IF NOT EXISTS updated_at TIMESTAMPTZ;[m
[32m+[m
[32m+[m[32m-- Valeurs par défaut[m
[32m+[m[32mALTER TABLE public.notifications ALTER COLUMN notification_id SET DEFAULT gen_random_uuid();[m
[32m+[m[32mALTER TABLE public.notifications ALTER COLUMN type SET DEFAULT 'general';[m
[32m+[m[32mALTER TABLE public.notifications ALTER COLUMN message SET DEFAULT '';[m
[32m+[m[32mALTER TABLE public.notifications ALTER COLUMN read SET DEFAULT false;[m
[32m+[m[32mALTER TABLE public.notifications ALTER COLUMN created_at SET DEFAULT now();[m
[32m+[m[32mALTER TABLE public.notifications ALTER COLUMN updated_at SET DEFAULT now();[m
[32m+[m
[32m+[m[32m-- Nettoyage des NULL[m
[32m+[m[32mUPDATE public.notifications SET notification_id = gen_random_uuid() WHERE notification_id IS NULL;[m
[32m+[m[32mUPDATE public.notifications SET type = 'general' WHERE type IS NULL;[m
[32m+[m[32mUPDATE public.notifications SET message = '' WHERE message IS NULL;[m
[32m+[m[32mUPDATE public.notifications SET read = false WHERE read IS NULL;[m
[32m+[m[32mUPDATE public.notifications SET created_at = now() WHERE created_at IS NULL;[m
[32m+[m[32mUPDATE public.notifications SET updated_at = now() WHERE updated_at IS NULL;[m
[32m+[m
[32m+[m[32m-- Contraintes NOT NULL[m
[32m+[m[32mALTER TABLE public.notifications ALTER COLUMN notification_id SET NOT NULL;[m
[32m+[m[32mALTER TABLE public.notifications ALTER COLUMN user_id SET NOT NULL;[m
[32m+[m[32mALTER TABLE public.notifications ALTER COLUMN message SET NOT NULL;[m
[32m+[m[32mALTER TABLE public.notifications ALTER COLUMN read SET NOT NULL;[m
[32m+[m[32mALTER TABLE public.notifications ALTER COLUMN created_at SET NOT NULL;[m
[32m+[m[32mALTER TABLE public.notifications ALTER COLUMN updated_at SET NOT NULL;[m
[32m+[m
[32m+[m[32m-- FK vers auth.users[m
[32m+[m[32mALTER TABLE public.notifications DROP CONSTRAINT IF EXISTS notifications_user_id_fkey;[m
[32m+[m[32mALTER TABLE public.notifications DROP CONSTRAINT IF EXISTS notifications_actor_id_fkey;[m
[32m+[m
[32m+[m[32mALTER TABLE public.notifications[m
[32m+[m[32m  ADD CONSTRAINT notifications_user_id_fkey[m
[32m+[m[32m  FOREIGN KEY (user_id) REFERENCES auth.users(id) ON DELETE CASCADE;[m
[32m+[m
[32m+[m[32mALTER TABLE public.notifications[m
[32m+[m[32m  ADD CONSTRAINT notifications_actor_id_fkey[m
[32m+[m[32m  FOREIGN KEY (actor_id) REFERENCES auth.users(id) ON DELETE SET NULL;[m
[32m+[m
[32m+[m[32m-- Clé primaire[m
[32m+[m[32mDO $$[m
[32m+[m[32mDECLARE pk_name TEXT;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  SELECT conname INTO pk_name[m
[32m+[m[32m  FROM pg_constraint[m
[32m+[m[32m  WHERE conrelid = 'public.notifications'::regclass AND contype = 'p'[m
[32m+[m[32m  LIMIT 1;[m
[32m+[m
[32m+[m[32m  IF pk_name IS NOT NULL AND pk_name <> 'notifications_pkey' THEN[m
[32m+[m[32m    EXECUTE format('ALTER TABLE public.notifications DROP CONSTRAINT %I', pk_name);[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  IF NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM pg_constraint[m
[32m+[m[32m    WHERE conrelid = 'public.notifications'::regclass AND contype = 'p'[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    ALTER TABLE public.notifications ADD CONSTRAINT notifications_pkey PRIMARY KEY (notification_id);[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- Index[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_notifications_user_created ON public.notifications(user_id, created_at DESC);[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_notifications_user_read ON public.notifications(user_id, read);[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_notifications_actor ON public.notifications(actor_id);[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_notifications_user_unread ON public.notifications(user_id) WHERE read = false;[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_notifications_type ON public.notifications(type) WHERE type IS NOT NULL;[m
[32m+[m
[32m+[m[32m-- RLS[m
[32m+[m[32mALTER TABLE public.notifications ENABLE ROW LEVEL SECURITY;[m
[32m+[m
[32m+[m[32mDROP POLICY IF EXISTS "notifications_read" ON public.notifications;[m
[32m+[m[32mDROP POLICY IF EXISTS "notifications_insert" ON public.notifications;[m
[32m+[m[32mDROP POLICY IF EXISTS "notifications_select_own" ON public.notifications;[m
[32m+[m[32mDROP POLICY IF EXISTS "notifications_update_own" ON public.notifications;[m
[32m+[m[32mDROP POLICY IF EXISTS "notifications_delete_own" ON public.notifications;[m
[32m+[m[32mDROP POLICY IF EXISTS "notif_own" ON public.notifications;[m
[32m+[m[32mDROP POLICY IF EXISTS "notifications_insert_system" ON public.notifications;[m
[32m+[m[32mDROP POLICY IF EXISTS "notifications_insert_authenticated" ON public.notifications;[m
[32m+[m
[32m+[m[32mCREATE POLICY "notifications_select_own" ON public.notifications FOR SELECT USING (auth.uid() = user_id);[m
[32m+[m[32mCREATE POLICY "notifications_update_own" ON public.notifications FOR UPDATE USING (auth.uid() = user_id) WITH CHECK (auth.uid() = user_id);[m
[32m+[m[32mCREATE POLICY "notifications_delete_own" ON public.notifications FOR DELETE USING (auth.uid() = user_id);[m
[32m+[m[32mCREATE POLICY "notifications_insert_system" ON public.notifications FOR INSERT TO service_role WITH CHECK (true);[m
[32m+[m[32mCREATE POLICY "notifications_insert_authenticated" ON public.notifications FOR INSERT TO authenticated WITH CHECK (auth.uid() = actor_id);[m
[32m+[m
[32m+[m[32m-- Trigger updated_at[m
[32m+[m[32mcreate or replace function public.update_notifications_updated_at()[m
[32m+[m[32mreturns trigger language plpgsql as $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  new.updated_at = now();[m
[32m+[m[32m  return new;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mdrop trigger if exists update_notifications_updated_at_trigger on public.notifications;[m
[32m+[m[32mcreate trigger update_notifications_updated_at_trigger[m
[32m+[m[32mbefore update on public.notifications[m
[32m+[m[32mfor each row execute function public.update_notifications_updated_at();[m
[32m+[m
[32m+[m[32m-- Vue compteur non-lus[m
[32m+[m[32mDROP VIEW IF EXISTS public.notification_unread_counts;[m
[32m+[m[32mCREATE VIEW public.notification_unread_counts AS[m
[32m+[m[32mSELECT user_id, COUNT(*)::BIGINT AS unread_count[m
[32m+[m[32mFROM public.notifications[m
[32m+[m[32mWHERE read = false[m
[32m+[m[32mGROUP BY user_id;[m
[32m+[m
[32m+[m[32m-- Trigger follow notification[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.create_follow_notification()[m
[32m+[m[32mRETURNS TRIGGER LANGUAGE plpgsql SECURITY DEFINER SET search_path = public AS $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF TG_OP = 'INSERT' THEN[m
[32m+[m[32m    INSERT INTO public.notifications (user_id, actor_id, type, message, source_id)[m
[32m+[m[32m    VALUES (NEW.followed_id, NEW.follower_id, 'follow', 'a commencé à vous suivre', NEW.follower_id);[m
[32m+[m[32m  END IF;[m
[32m+[m[32m  RETURN NEW;[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mDROP TRIGGER IF EXISTS on_follow_created ON public.follows;[m
[32m+[m[32mCREATE TRIGGER on_follow_created[m
[32m+[m[32mAFTER INSERT ON public.follows[m
[32m+[m[32mFOR EACH ROW EXECUTE FUNCTION public.create_follow_notification();[m
[32m+[m
[32m+[m[32m-- Realtime[m
[32m+[m[32mALTER TABLE public.notifications REPLICA IDENTITY FULL;[m
[32m+[m[32mDO $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM pg_publication_tables[m
[32m+[m[32m    WHERE pubname = 'supabase_realtime' AND schemaname = 'public' AND tablename = 'notifications'[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    ALTER PUBLICATION supabase_realtime ADD TABLE public.notifications;[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- 2.2 Préférences de notification[m
[32m+[m[32mcreate table if not exists public.notification_preferences ([m
[32m+[m[32m  user_id uuid primary key references auth.users(id) on delete cascade,[m
[32m+[m[32m  push_enabled boolean not null default true,[m
[32m+[m[32m  messages boolean not null default true,[m
[32m+[m[32m  social boolean not null default true,[m
[32m+[m[32m  live boolean not null default true,[m
[32m+[m[32m  wallet boolean not null default true,[m
[32m+[m[32m  marketing boolean not null default false,[m
[32m+[m[32m  updated_at timestamptz not null default now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32malter table public.notification_preferences enable row level security;[m
[32m+[m[32mdrop policy if exists notification_preferences_own on public.notification_preferences;[m
[32m+[m[32mcreate policy notification_preferences_own on public.notification_preferences[m
[32m+[m[32m  for all using (auth.uid() = user_id) with check (auth.uid() = user_id);[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SECTION 3 : PUSH TOKENS[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mcreate table if not exists public.push_tokens ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  user_id uuid references auth.users(id) on delete cascade not null,[m
[32m+[m[32m  token text not null,[m
[32m+[m[32m  platform text not null check (platform in ('web', 'ios', 'android')),[m
[32m+[m[32m  user_agent text,[m
[32m+[m[32m  created_at timestamptz not null default now(),[m
[32m+[m[32m  updated_at timestamptz not null default now(),[m
[32m+[m[32m  unique (user_id, token)[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32malter table public.push_tokens enable row level security;[m
[32m+[m
[32m+[m[32mdrop policy if exists push_tokens_insert on public.push_tokens;[m
[32m+[m[32mdrop policy if exists push_tokens_delete on public.push_tokens;[m
[32m+[m[32mdrop policy if exists push_tokens_select on public.push_tokens;[m
[32m+[m
[32m+[m[32mcreate policy push_tokens_insert on public.push_tokens[m
[32m+[m[32m  for insert to authenticated with check (user_id = auth.uid());[m
[32m+[m[32mcreate policy push_tokens_delete on public.push_tokens[m
[32m+[m[32m  for delete to authenticated using (user_id = auth.uid());[m
[32m+[m[32mcreate policy push_tokens_select on public.push_tokens[m
[32m+[m[32m  for select to authenticated using (user_id = auth.uid());[m
[32m+[m
[32m+[m[32mcreate index if not exists idx_push_tokens_platform on public.push_tokens(platform);[m
[32m+[m[32mcreate index if not exists idx_push_tokens_updated on public.push_tokens(updated_at desc);[m
[32m+[m[32mcreate index if not exists idx_push_tokens_user on public.push_tokens(user_id);[m
[32m+[m
[32m+[m[32m-- Fonction upsert_push_token[m
[32m+[m[32mcreate or replace function public.upsert_push_token([m
[32m+[m[32m  p_user_id uuid,[m
[32m+[m[32m  p_token text,[m
[32m+[m[32m  p_platform text,[m
[32m+[m[32m  p_user_agent text default null[m
[32m+[m[32m)[m
[32m+[m[32mreturns void[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.uid() is null or auth.uid() <> p_user_id then[m
[32m+[m[32m    raise exception 'Non autorisé';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  delete from public.push_tokens[m
[32m+[m[32m  where user_id = p_user_id and platform = p_platform and token <> p_token;[m
[32m+[m
[32m+[m[32m  insert into public.push_tokens (user_id, token, platform, user_agent, updated_at)[m
[32m+[m[32m  values (p_user_id, p_token, p_platform, p_user_agent, now())[m
[32m+[m[32m  on conflict (user_id, token)[m
[32m+[m[32m  do update set user_agent = excluded.user_agent, updated_at = now();[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mrevoke all on function public.upsert_push_token(uuid, text, text, text) from public, anon;[m
[32m+[m[32mgrant execute on function public.upsert_push_token(uuid, text, text, text) to authenticated;[m
[32m+[m
[32m+[m[32m-- Fonction prune_stale_push_tokens[m
[32m+[m[32mcreate or replace function public.prune_stale_push_tokens(max_age interval default interval '180 days')[m
[32m+[m[32mreturns integer[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mdeclare deleted_count integer;[m
[32m+[m[32mbegin[m
[32m+[m[32m  delete from public.push_tokens where updated_at < now() - max_age;[m
[32m+[m[32m  get diagnostics deleted_count = row_count;[m
[32m+[m[32m  return deleted_count;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mrevoke all on function public.prune_stale_push_tokens(interval) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.prune_stale_push_tokens(interval) to service_role;[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SECTION 4 : FOLLOWS ET PROFILES (RLS)[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32malter table public.follows enable row level security;[m
[32m+[m[32malter table public.profiles enable row level security;[m
[32m+[m
[32m+[m[32m-- Policies follows[m
[32m+[m[32mdrop policy if exists follows_select_own on public.follows;[m
[32m+[m[32mcreate policy follows_select_own on public.follows[m
[32m+[m[32m  for select to authenticated[m
[32m+[m[32m  using (follower_id = auth.uid() or followed_id = auth.uid());[m
[32m+[m
[32m+[m[32mdrop policy if exists follows_insert_own on public.follows;[m
[32m+[m[32mcreate policy follows_insert_own on public.follows[m
[32m+[m[32m  for insert to authenticated[m
[32m+[m[32m  with check (follower_id = auth.uid());[m
[32m+[m
[32m+[m[32mdrop policy if exists follows_update_own on public.follows;[m
[32m+[m[32mcreate policy follows_update_own on public.follows[m
[32m+[m[32m  for update to authenticated[m
[32m+[m[32m  using (follower_id = auth.uid() or followed_id = auth.uid())[m
[32m+[m[32m  with check (follower_id = auth.uid() or followed_id = auth.uid());[m
[32m+[m
[32m+[m[32mdrop policy if exists follows_delete_own on public.follows;[m
[32m+[m[32mcreate policy follows_delete_own on public.follows[m
[32m+[m[32m  for delete to authenticated[m
[32m+[m[32m  using (follower_id = auth.uid() or followed_id = auth.uid());[m
