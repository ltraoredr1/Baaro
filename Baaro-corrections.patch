[32m+[m[32mdrop policy if exists "profiles_update_own" on public.profiles;[m
[32m+[m[32mcreate policy "profiles_update_own" on public.profiles for update using (auth.uid() = id);[m
[32m+[m
[32m+[m[32m-- Follows : owner peut tout gérer[m
[32m+[m[32mdrop policy if exists "follows_all_own" on public.follows;[m
[32m+[m[32mcreate policy "follows_all_own" on public.follows for all using (auth.uid() = follower_id or auth.uid() = followed_id);[m
[32m+[m
[32m+[m[32m-- Notification : owner only[m
[32m+[m[32mdrop policy if exists "notif_own" on public.notification_preferences;[m
[32m+[m[32mcreate policy "notif_own" on public.notification_preferences for all using (auth.uid() = user_id);[m
[32m+[m
[32m+[m[32m-- Gifts sent : lecture salon, écriture authentifiée[m
[32m+[m[32mdrop policy if exists "gifts_read_room" on public.gifts_sent;[m
[32m+[m[32mcreate policy "gifts_read_room" on public.gifts_sent for select using (true);[m
[32m+[m
[32m+[m[32mdrop policy if exists "gifts_insert_auth" on public.gifts_sent;[m
[32m+[m[32mcreate policy "gifts_insert_auth" on public.gifts_sent for insert with check (auth.uid() = sender_id);[m
