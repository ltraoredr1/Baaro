[32m+[m
[32m+[m[32m  -- post_shares[m
[32m+[m[32m  IF EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m[41m [m
[32m+[m[32m    WHERE table_schema='public' AND table_name='post_shares' AND column_name='user_id'[m
[32m+[m[32m  ) AND NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m[41m [m
[32m+[m[32m    WHERE table_schema='public' AND table_name='post_shares' AND column_name='id'[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    ALTER TABLE public.post_shares RENAME COLUMN user_id TO id;[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- ============================================[m
[32m+[m[32m-- 2. CRÉATION DES TABLES (si elles n'existent pas)[m
[32m+[m[32m-- ============================================[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS public.polls ([m
[32m+[m[32m  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),[m
[32m+[m[32m  post_id UUID REFERENCES public.posts(id) ON DELETE CASCADE,[m
[32m+[m[32m  question TEXT NOT NULL,[m
[32m+[m[32m  created_at TIMESTAMPTZ DEFAULT NOW()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS public.poll_options ([m
