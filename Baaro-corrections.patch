[32m+[m[32m-- BAARO 026: paiement des commandes + média boutique[m
[32m+[m[32malter table public.orders add column if not exists paid_at timestamptz;[m
[32m+[m
[32m+[m[32mcreate or replace function public.mark_order_paid(p_order_id uuid, p_payment_ref text, p_provider text default null)[m
[32m+[m[32mreturns void[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  update public.orders[m
[32m+[m[32m     set payment_status = 'paid',[m
[32m+[m[32m         paid_at = coalesce(paid_at, now()),[m
[32m+[m[32m         status = case when status = 'pending' then 'confirmed' else status end,[m
[32m+[m[32m         updated_at = now()[m
[32m+[m[32m   where id = p_order_id[m
[32m+[m[32m     and payment_status <> 'paid';[m
[32m+[m
[32m+[m[32m  if not found then[m
[32m+[m[32m    raise exception 'Commande inexistante ou déjà payée';[m
[32m+[m[32m  end if;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mrevoke all on function public.mark_order_paid(uuid, text, text) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.mark_order_paid(uuid, text, text) to service_role;[m
