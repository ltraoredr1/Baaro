[32m+[m[32m  returning * into i;[m
[32m+[m[32m  return jsonb_build_object('id',i.id,'product_code',i.product_code,'amount_minor',i.amount_minor,'currency',i.currency,'status',i.status,'expires_at',i.expires_at);[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.send_tip(uuid,bigint,uuid,uuid) from public,anon;[m
[32m+[m[32mgrant execute on function public.send_tip(uuid,bigint,uuid,uuid) to authenticated;[m
