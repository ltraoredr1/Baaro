[32m+[m[32m-- SECTION 5 : DROITS D'EXÉCUTION[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mdo $$[m
[32m+[m[32mdeclare f record;[m
[32m+[m[32mbegin[m
[32m+[m[32m  for f in[m
[32m+[m[32m    select p.oid::regprocedure as sig[m
[32m+[m[32m    from pg_proc p[m
[32m+[m[32m    join pg_namespace n on n.oid = p.pronamespace[m
[32m+[m[32m    where n.nspname = 'public'[m
[32m+[m[32m      and p.proname in ([m
[32m+[m[32m        'group_role','can_see_group','channel_group','is_banned','can_post_in_channel',[m
[32m+[m[32m        'create_community_group','create_community_channel','join_community_group',[m
[32m+[m[32m        'ban_community_member','unban_community_member','set_member_role','report_community_message',[m
[32m+[m[32m        'create_group_invite','list_group_invites','revoke_group_invite','peek_group_invite',[m
[32m+[m[32m        'upsert_push_token'[m
[32m+[m[32m      )[m
[32m+[m[32m  loop[m
[32m+[m[32m    execute format('revoke all on function %s from public, anon', f.sig);[m
[32m+[m[32m    execute format('grant execute on function %s to authenticated', f.sig);[m
[32m+[m[32m  end loop;[m
[32m+[m[32mend $$;[m
