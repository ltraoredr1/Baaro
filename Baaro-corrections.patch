[32m+[m[32mAS $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF TG_OP = 'INSERT' THEN[m
[32m+[m[32m    UPDATE public.videos[m[41m [m
[32m+[m[32m    SET comments_count = COALESCE(comments_count, 0) + 1[m
