[32m+[m[32m    and (p_region is null or s.region is null or s.region = p_region)[m
[32m+[m[32m    and ([m
[32m+[m[32m      nullif(trim(p_query), '') is null[m
[32m+[m[32m      or s.title ilike '%' || trim(p_query) || '%'[m
