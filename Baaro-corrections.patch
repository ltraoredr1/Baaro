[32m+[m[32m-- Safe, bounded global discovery over the core public entities already present in BAARO.[m
[32m+[m[32mcreate or replace function public.global_discovery_search(p_query text, p_limit int default 8)[m
[32m+[m[32mreturns jsonb language plpgsql stable security definer set search_path = public as $$[m
[32m+[m[32mdeclare q text := trim(coalesce(p_query,'')); lim int := least(greatest(coalesce(p_limit,8),1),20);[m
[32m+[m[32mbegin[m
[32m+[m[32m  if char_length(q) < 2 then return jsonb_build_object('users','[]'::jsonb,'groups','[]'::jsonb,'debates','[]'::jsonb,'posts','[]'::jsonb); end if;[m
[32m+[m[32m  return jsonb_build_object([m
[32m+[m[32m    'users', coalesce((select jsonb_agg(to_jsonb(x)) from (select id, display_name, handle, avatar_url, flag from profiles where display_name ilike '%'||q||'%' or handle ilike '%'||q||'%' order by display_name limit lim) x),'[]'::jsonb),[m
[32m+[m[32m    'groups', coalesce((select jsonb_agg(to_jsonb(x)) from (select id, name, description, avatar_url, category from groups where is_public = true and (name ilike '%'||q||'%' or description ilike '%'||q||'%') order by created_at desc limit lim) x),'[]'::jsonb),[m
[32m+[m[32m    'debates', coalesce((select jsonb_agg(to_jsonb(x)) from (select id, title, topic, status from debate_rooms where status = 'active' and (title ilike '%'||q||'%' or topic ilike '%'||q||'%') order by created_at desc limit lim) x),'[]'::jsonb),[m
[32m+[m[32m    'posts', coalesce((select jsonb_agg(to_jsonb(x)) from (select id, author_id, content, media_url, created_at from posts where content ilike '%'||q||'%' order by created_at desc limit lim) x),'[]'::jsonb)[m
[32m+[m[32m  );[m
[32m+[m[32mend; $$;[m
[32m+[m[32mgrant execute on function public.global_discovery_search(text,int) to authenticated;[m
