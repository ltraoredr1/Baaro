[32m+[m[32m-- BAARO: profils persistants pour tous les modes d'inscription.[m
[32m+[m[32m-- Couvre email, téléphone OTP et OAuth (Facebook/X/Google/etc.).[m
[32m+[m
[32m+[m[32mcreate or replace function public.handle_new_user()[m
[32m+[m[32mreturns trigger[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer set search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
