[32m+[m[32m    ALTER TABLE public.follows RENAME COLUMN following_id TO followed_id;[m
[32m+[m[32m  END IF;[m
[32m+[m[41m  [m
[32m+[m[32m  ALTER TABLE public.follows[m[41m [m
[32m+[m[32m  ADD COLUMN IF NOT EXISTS status TEXT DEFAULT 'accepted',[m
[32m+[m[32m  ADD COLUMN IF NOT EXISTS is_friend BOOLEAN DEFAULT false;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- 2. Supprimer les anciennes fonctions[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.get_user_friends(UUID);[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.get_user_friends(user_id_param UUID);[m
[32m+[m
[32m+[m[32m-- 3. Créer la fonction avec le bon paramètre (id, pas user_id)[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.get_user_friends(uuid) CASCADE;[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.get_user_friends(uuid) CASCADE;[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.get_user_friends(user_id UUID)[m
[32m+[m[32mRETURNS TABLE (friend_id UUID) AS $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  RETURN QUERY[m
[32m+[m[32m  SELECT DISTINCT f1.followed_id[m
[32m+[m[32m  FROM public.follows f1[m
[32m+[m[32m  INNER JOIN public.follows f2[m[41m [m
[32m+[m[32m    ON f1.followed_id = f2.follower_id[m[41m [m
[32m+[m[32m    AND f1.follower_id = f2.followed_id[m
[32m+[m[32m  WHERE f1.follower_id = user_id[m
[32m+[m[32m    AND (f1.status = 'accepted' OR f1.status IS NULL)[m
[32m+[m[32m    AND (f1.is_friend = true OR f1.is_friend IS NULL);[m
[32m+[m[32mEND;[m
[32m+[m[32m$$ LANGUAGE plpgsql SECURITY DEFINER[m
[32m+[m[32mSET search_path = public;[m
[32m+[m
[32m+[m[32m-- 4. Index de performance[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_follows_reciprocal[m[41m [m
[32m+[m[32mON public.follows(follower_id, followed_id)[m[41m [m
[32m+[m[32mWHERE status = 'accepted' OR status IS NULL;[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0043_systeme_abonnement_et_amis.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO — 046 Friend System[m
[32m+[m[32m-- Abonnements + demandes d'amis[m
[32m+[m[32m--[m
[32m+[m[32m-- IMPORTANT :[m
[32m+[m[32m-- - Ne supprime aucune donnée existante.[m
[32m+[m[32m-- - Conserve follower_id / followed_id.[m
[32m+[m[32m-- - Compatible avec le système actuel de follows.[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mBEGIN;[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 1. Vérification de la table follows[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mDROP TABLE IF EXISTS public.follows CASCADE;[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS public.follows ([m
[32m+[m[32m    id uuid PRIMARY KEY DEFAULT gen_random_uuid(),[m
[32m+[m[32m    follower_id uuid NOT NULL,[m
[32m+[m[32m    created_at timestamptz DEFAULT now(),[m
[32m+[m[32m    followed_id uuid NOT NULL,[m
[32m+[m[32m    status text NOT NULL DEFAULT 'accepted',[m
[32m+[m[32m    is_friend boolean NOT NULL DEFAULT false[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 2. Colonnes manquantes[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows[m
[32m+[m[32m    ADD COLUMN IF NOT EXISTS status text;[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows[m
[32m+[m[32m    ADD COLUMN IF NOT EXISTS is_friend boolean;[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows[m
[32m+[m[32m    ADD COLUMN IF NOT EXISTS created_at timestamptz;[m
[32m+[m
[32m+[m[32m-- Valeurs par défaut pour les anciennes lignes[m
[32m+[m[32mUPDATE public.follows[m
[32m+[m[32mSET status = 'accepted'[m
[32m+[m[32mWHERE status IS NULL;[m
[32m+[m
[32m+[m[32mUPDATE public.follows[m
[32m+[m[32mSET is_friend = false[m
[32m+[m[32mWHERE is_friend IS NULL;[m
[32m+[m
[32m+[m[32mUPDATE public.follows[m
[32m+[m[32mSET created_at = now()[m
[32m+[m[32mWHERE created_at IS NULL;[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows[m
[32m+[m[32m    ALTER COLUMN status SET DEFAULT 'accepted';[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows[m
[32m+[m[32m    ALTER COLUMN status SET NOT NULL;[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows[m
[32m+[m[32m    ALTER COLUMN is_friend SET DEFAULT false;[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows[m
[32m+[m[32m    ALTER COLUMN is_friend SET NOT NULL;[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows[m
[32m+[m[32m    ALTER COLUMN created_at SET DEFAULT now();[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 3. Contraintes sur status[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows[m
[32m+[m[32mDROP CONSTRAINT IF EXISTS follows_status_check;[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows[m
[32m+[m[32mADD CONSTRAINT follows_status_check[m
[32m+[m[32mCHECK ([m
[32m+[m[32m    status IN ('pending', 'accepted', 'rejected')[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 4. Empêcher de se suivre soi-même[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows[m
[32m+[m[32mDROP CONSTRAINT IF EXISTS follows_no_self;[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows[m
[32m+[m[32mADD CONSTRAINT follows_no_self[m
[32m+[m[32mCHECK (follower_id <> followed_id);[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 5. Un seul lien A → B[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mCREATE UNIQUE INDEX IF NOT EXISTS uq_follows_user_pair[m
[32m+[m[32mON public.follows (follower_id, followed_id);[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 6. Index pour les abonnements[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_follows_follower[m
[32m+[m[32mON public.follows (follower_id);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_follows_followed[m
[32m+[m[32mON public.follows (followed_id);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_follows_follower_status[m
[32m+[m[32mON public.follows (follower_id, status);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_follows_followed_status[m
[32m+[m[32mON public.follows (followed_id, status);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_follows_friends[m
[32m+[m[32mON public.follows (follower_id, followed_id)[m
[32m+[m[32mWHERE is_friend = true[m
[32m+[m[32m  AND status = 'accepted';[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 7. RLS[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mALTER TABLE public.follows ENABLE ROW LEVEL SECURITY;[m
[32m+[m
[32m+[m[32m-- Lecture publique des relations[m
[32m+[m[32mDROP POLICY IF EXISTS follows_select_public ON public.follows;[m
[32m+[m
[32m+[m[32mCREATE POLICY follows_select_public[m
[32m+[m[32mON public.follows[m
[32m+[m[32mFOR SELECT[m
[32m+[m[32mUSING (true);[m
[32m+[m
[32m+[m[32m-- Création d'un abonnement / demande par l'utilisateur[m
[32m+[m[32mDROP POLICY IF EXISTS follows_insert_own ON public.follows;[m
[32m+[m
[32m+[m[32mCREATE POLICY follows_insert_own[m
[32m+[m[32mON public.follows[m
[32m+[m[32mFOR INSERT[m
[32m+[m[32mWITH CHECK ([m
[32m+[m[32m    auth.uid() = follower_id[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- Suppression de son propre abonnement[m
[32m+[m[32mDROP POLICY IF EXISTS follows_delete_own ON public.follows;[m
[32m+[m
[32m+[m[32mCREATE POLICY follows_delete_own[m
[32m+[m[32mON public.follows[m
[32m+[m[32mFOR DELETE[m
[32m+[m[32mUSING ([m
[32m+[m[32m    auth.uid() = follower_id[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- Modification de sa propre relation[m
[32m+[m[32mDROP POLICY IF EXISTS follows_update_own ON public.follows;[m
[32m+[m
[32m+[m[32mCREATE POLICY follows_update_own[m
[32m+[m[32mON public.follows[m
[32m+[m[32mFOR UPDATE[m
[32m+[m[32mUSING ([m
[32m+[m[32m    auth.uid() = follower_id[m
[32m+[m[32m)[m
[32m+[m[32mWITH CHECK ([m
[32m+[m[32m    auth.uid() = follower_id[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- Le destinataire peut accepter/refuser une demande d'ami[m
[32m+[m[32mDROP POLICY IF EXISTS follows_request_receiver ON public.follows;[m
[32m+[m
[32m+[m[32mCREATE POLICY follows_request_receiver[m
[32m+[m[32mON public.follows[m
[32m+[m[32mFOR UPDATE[m
[32m+[m[32mUSING ([m
[32m+[m[32m    auth.uid() = followed_id[m
[32m+[m[32m    AND status = 'pending'[m
[32m+[m[32m    AND is_friend = true[m
[32m+[m[32m)[m
[32m+[m[32mWITH CHECK ([m
[32m+[m[32m    auth.uid() = followed_id[m
[32m+[m[32m    AND follower_id <> followed_id[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 8. Fonction : envoyer une demande d'ami[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.send_friend_request([m
[32m+[m[32m    p_target uuid[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS boolean[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $function$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m    v_user uuid := auth.uid();[m
[32m+[m[32mBEGIN[m
[32m+[m[32m    IF v_user IS NULL THEN[m
[32m+[m[32m        RAISE EXCEPTION 'NOT_AUTHENTICATED';[m
[32m+[m[32m    END IF;[m
[32m+[m
[32m+[m[32m    IF p_target IS NULL THEN[m
[32m+[m[32m        RAISE EXCEPTION 'INVALID_TARGET';[m
[32m+[m[32m    END IF;[m
[32m+[m
[32m+[m[32m    IF v_user = p_target THEN[m
[32m+[m[32m        RAISE EXCEPTION 'CANNOT_FRIEND_SELF';[m
[32m+[m[32m    END IF;[m
[32m+[m
[32m+[m[32m    INSERT INTO public.follows ([m
[32m+[m[32m        follower_id,[m
[32m+[m[32m        followed_id,[m
[32m+[m[32m        status,[m
[32m+[m[32m        is_friend[m
[32m+[m[32m    )[m
[32m+[m[32m    VALUES ([m
[32m+[m[32m        v_user,[m
[32m+[m[32m        p_target,[m
[32m+[m[32m        'pending',[m
[32m+[m[32m        true[m
[32m+[m[32m    )[m
[32m+[m[32m    ON CONFLICT (follower_id, followed_id)[m
[32m+[m[32m    DO UPDATE SET[m
[32m+[m[32m        status = 'pending',[m
[32m+[m[32m        is_friend = true;[m
[32m+[m
[32m+[m[32m    RETURN true;[m
[32m+[m[32mEND;[m
[32m+[m[32m$function$;[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 9. Fonction : accepter une demande d'ami[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.accept_friend_request([m
[32m+[m[32m    p_follow_id uuid[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS boolean[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $function$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m    v_user uuid := auth.uid();[m
[32m+[m[32m    v_follower uuid;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m    SELECT follower_id[m
[32m+[m[32m    INTO v_follower[m
[32m+[m[32m    FROM public.follows[m
[32m+[m[32m    WHERE id = p_follow_id[m
[32m+[m[32m      AND followed_id = v_user[m
[32m+[m[32m      AND status = 'pending'[m
[32m+[m[32m      AND is_friend = true[m
[32m+[m[32m    FOR UPDATE;[m
[32m+[m
[32m+[m[32m    IF v_follower IS NULL THEN[m
[32m+[m[32m        RAISE EXCEPTION 'FRIEND_REQUEST_NOT_FOUND';[m
[32m+[m[32m    END IF;[m
[32m+[m
[32m+[m[32m    UPDATE public.follows[m
[32m+[m[32m    SET[m
[32m+[m[32m        status = 'accepted',[m
[32m+[m[32m        is_friend = true[m
[32m+[m[32m    WHERE id = p_follow_id;[m
[32m+[m
[32m+[m[32m    -- Crée également la relation inverse.[m
[32m+[m[32m    INSERT INTO public.follows ([m
[32m+[m[32m        follower_id,[m
[32m+[m[32m        followed_id,[m
[32m+[m[32m        status,[m
[32m+[m[32m        is_friend[m
[32m+[m[32m    )[m
[32m+[m[32m    VALUES ([m
[32m+[m[32m        v_user,[m
[32m+[m[32m        v_follower,[m
[32m+[m[32m        'accepted',[m
[32m+[m[32m        true[m
[32m+[m[32m    )[m
[32m+[m[32m    ON CONFLICT (follower_id, followed_id)[m
[32m+[m[32m    DO UPDATE SET[m
[32m+[m[32m        status = 'accepted',[m
[32m+[m[32m        is_friend = true;[m
[32m+[m
[32m+[m[32m    RETURN true;[m
[32m+[m[32mEND;[m
[32m+[m[32m$function$;[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 10. Fonction : refuser une demande[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.reject_friend_request([m
[32m+[m[32m    p_follow_id uuid[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS boolean[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $function$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m    UPDATE public.follows[m
[32m+[m[32m    SET[m
[32m+[m[32m        status = 'rejected',[m
[32m+[m[32m        is_friend = false[m
[32m+[m[32m    WHERE id = p_follow_id[m
[32m+[m[32m      AND followed_id = auth.uid()[m
[32m+[m[32m      AND status = 'pending'[m
[32m+[m[32m      AND is_friend = true;[m
[32m+[m
[32m+[m[32m    IF NOT FOUND THEN[m
[32m+[m[32m        RAISE EXCEPTION 'FRIEND_REQUEST_NOT_FOUND';[m
[32m+[m[32m    END IF;[m
[32m+[m
[32m+[m[32m    RETURN true;[m
[32m+[m[32mEND;[m
[32m+[m[32m$function$;[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 11. Fonction : supprimer un ami[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.remove_friend([m
[32m+[m[32m    p_user uuid[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS boolean[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $function$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m    v_user uuid := auth.uid();[m
[32m+[m[32mBEGIN[m
[32m+[m[32m    IF v_user IS NULL THEN[m
[32m+[m[32m        RAISE EXCEPTION 'NOT_AUTHENTICATED';[m
[32m+[m[32m    END IF;[m
[32m+[m
[32m+[m[32m    DELETE FROM public.follows[m
[32m+[m[32m    WHERE ([m
[32m+[m[32m        follower_id = v_user[m
[32m+[m[32m        AND followed_id = p_user[m
[32m+[m[32m    )[m
[32m+[m[32m    OR ([m
[32m+[m[32m        follower_id = p_user[m
[32m+[m[32m        AND followed_id = v_user[m
[32m+[m[32m    )[m
[32m+[m[32m    AND is_friend = true;[m
[32m+[m
[32m+[m[32m    RETURN true;[m
[32m+[m[32mEND;[m
[32m+[m[32m$function$;[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 12. Fonction : obtenir les amis[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.get_user_friends(uuid) CASCADE;[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.get_user_friends(uuid) CASCADE;[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.get_user_friends([m
[32m+[m[32m    p_user_id uuid[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS TABLE ([m
[32m+[m[32m    friend_id uuid[m
[32m+[m[32m)[m
[32m+[m[32mLANGUAGE sql[m
[32m+[m[32mSTABLE[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $function$[m
[32m+[m[32m    SELECT DISTINCT[m
[32m+[m[32m        f1.followed_id AS friend_id[m
[32m+[m[32m    FROM public.follows f1[m
[32m+[m[32m    INNER JOIN public.follows f2[m
[32m+[m[32m        ON f1.follower_id = f2.followed_id[m
[32m+[m[32m       AND f1.followed_id = f2.follower_id[m
[32m+[m[32m    WHERE f1.follower_id = p_user_id[m
[32m+[m[32m      AND f1.status = 'accepted'[m
[32m+[m[32m      AND f1.is_friend = true[m
[32m+[m[32m      AND f2.status = 'accepted'[m
[32m+[m[32m      AND f2.is_friend = true;[m
[32m+[m[32m$function$;[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- 13. Permissions RPC[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32mGRANT EXECUTE ON FUNCTION public.send_friend_request(uuid)[m
[32m+[m[32mTO authenticated;[m
[32m+[m
[32m+[m[32mGRANT EXECUTE ON FUNCTION public.accept_friend_request(uuid)[m
[32m+[m[32mTO authenticated;[m
[32m+[m
[32m+[m[32mGRANT EXECUTE ON FUNCTION public.reject_friend_request(uuid)[m
