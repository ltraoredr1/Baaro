[32m+[m[32mcreate or replace function public.baaro_sync_video_like_count()[m
[32m+[m[32mreturns trigger language plpgsql security definer set search_path = public as $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if tg_op = 'INSERT' then[m
[32m+[m[32m    update public.videos set likes = likes + 1 where id = new.video_id;[m
[32m+[m[32m    return new;[m
[32m+[m[32m  elsif tg_op = 'DELETE' then[m
[32m+[m[32m    update public.videos set likes = greatest(0, likes - 1) where id = old.video_id;[m
[32m+[m[32m    return old;[m
[32m+[m[32m  end if;[m
[32m+[m[32m  return null;[m
[32m+[m[32mend $$;[m
