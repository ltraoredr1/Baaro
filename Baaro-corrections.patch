[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32m-- 1) Story audience: explicit close-friends membership and real follower checks[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32mcreate table if not exists public.story_close_friends ([m
[32m+[m[32m  owner_id uuid not null references auth.users(id) on delete cascade,[m
