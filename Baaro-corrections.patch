[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO — Correction globale du module vidéo[m
[32m+[m[32m-- Fichier : 052_video_module_global_fix.sql[m
[32m+[m[32m-- Date : 26 septembre 2026[m
[32m+[m[32m--[m[41m [m
[32m+[m[32m-- Objectif :[m
[32m+[m[32m--   1. Supprimer le trigger bloquant qui empêchait les compteurs de se mettre à jour[m
[32m+[m[32m--   2. Corriger la fonction de comptage des vues (support des invités/anonymes)[m
[32m+[m[32m--   3. Créer des triggers propres pour likes et commentaires[m
[32m+[m[32m--   4. Recalculer les compteurs existants[m
[32m+[m[32m--   5. S'assurer que les politiques RLS sont correctes[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- ÉTAPE 1 : NETTOYAGE DES TRIGGERS BLOQUANTS[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32m-- Suppression du trigger qui bloquait toutes les mises à jour de la table videos[m
[32m+[m[32mDROP TRIGGER IF EXISTS trg_protect_video_counters ON public.videos;[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.protect_video_counters();[m
[32m+[m
[32m+[m[32m-- Suppression des anciens triggers en doublon (nettoyage)[m
[32m+[m[32mDROP TRIGGER IF EXISTS trg_video_comments_count ON public.video_comments;[m
[32m+[m[32mDROP TRIGGER IF EXISTS trg_video_likes_count ON public.video_likes;[m
[32m+[m[32mDROP TRIGGER IF EXISTS trg_baaro_video_comment_count ON public.video_comments;[m
[32m+[m[32mDROP TRIGGER IF EXISTS trg_baaro_video_like_count ON public.video_likes;[m
[32m+[m
[32m+[m[32m-- Suppression des anciennes fonctions obsolètes[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.update_video_comments_count_trigger();[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.update_video_likes_count_trigger();[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.baaro_video_comment_count();[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.baaro_video_like_count();[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- ÉTAPE 2 : CORRECTION DE LA FONCTION DE VUES (SUPPORT INVITÉS)[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32m-- Suppression forcée de l'ancienne fonction pour éviter l'erreur 42P13[m
[32m+[m[32mDROP FUNCTION IF EXISTS public.register_video_view(uuid);[m
[32m+[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.register_video_view(p_video_id uuid)[m
[32m+[m[32mRETURNS jsonb[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER SET search_path = public[m
[32m+[m[32mAS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  -- Si l'utilisateur est anonyme (guest), on utilise un UUID générique pour éviter le crash[m
[32m+[m[32m  uid uuid := coalesce(auth.uid(), '00000000-0000-0000-0000-000000000000'::uuid);[m
[32m+[m[32m  inserted boolean := false;[m
[32m+[m[32m  new_views integer := 0;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF NOT EXISTS (SELECT 1 FROM public.videos WHERE id = p_video_id) THEN[m
[32m+[m[32m    RAISE EXCEPTION 'VIDEO_NOT_FOUND';[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  -- Insertion idempotente : une seule vue comptée par jour par utilisateur (ou UUID générique)[m
[32m+[m[32m  INSERT INTO public.video_views(video_id, viewer_id, view_date)[m
[32m+[m[32m  VALUES (p_video_id, uid, current_date)[m
[32m+[m[32m  ON CONFLICT DO NOTHING;[m
[32m+[m
[32m+[m[32m  inserted := FOUND;[m
[32m+[m[41m  [m
[32m+[m[32m  IF inserted THEN[m
[32m+[m[32m    UPDATE public.videos[m
[32m+[m[32m      SET views = coalesce(views, 0) + 1[m
[32m+[m[32m      WHERE id = p_video_id[m
[32m+[m[32m      RETURNING views INTO new_views;[m
[32m+[m[32m  ELSE[m
[32m+[m[32m    SELECT coalesce(views, 0) INTO new_views FROM public.videos WHERE id = p_video_id;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  RETURN jsonb_build_object('counted', inserted, 'views', new_views);[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
