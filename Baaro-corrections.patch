[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0002_security_fix.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO — correctif de sécurité du portefeuille + fonctionnalités[m
[32m+[m[32m-- anti faux-comptes. À coller dans le SQL Editor de Supabase et exécuter[m
[32m+[m[32m-- APRÈS supabase-schema.sql (et les autres migrations déjà appliquées).[m
[32m+[m
[32m+[m[32m-- 1) Le portefeuille et l'historique ne doivent plus[m
[32m+[m[32m--    jamais être modifiables directement depuis le navigateur : jusqu'ici,[m
[32m+[m[32m--    la policy vérifiait seulement "auth.uid() = user_id", pas que la[m
[32m+[m[32m--    valeur écrite était légitime — n'importe qui pouvait donc se créer[m
[32m+[m[32m--    un solde arbitraire via la console. Désormais, seule la lecture de[m
[32m+[m[32m--    ses propres lignes reste autorisée ; toutes les écritures passent par[m
[32m+[m[32m--    /api/wallet, avec la clé de service (qui ignore RLS).[m
[32m+[m[32mdrop policy if exists "wallet_own" on wallets;[m
[32m+[m[32mdrop policy if exists "tx_own" on transactions;[m
[32m+[m
[32m+[m[32mcreate policy "wallet_read_own" on wallets for select using (auth.uid() = id);[m
[32m+[m[32mcreate policy "tx_read_own" on transactions for select using (auth.uid() = id);[m
[32m+[m[32m-- Volontairement aucune policy insert/update/delete pour anon/authenticated[m
[32m+[m[32m-- sur ces trois tables : seul service_role (bypass RLS) peut désormais y[m
[32m+[m[32m-- écrire, depuis les fonctions serveur.[m
[32m+[m
[32m+[m[32m-- 2) Marqueur de compte restreint. Posé à true par /api/register-device[m
[32m+[m[32m--    quand un même appareil dépasse le nombre de comptes autorisés. Un[m
[32m+[m[32m--    compte restreint peut toujours naviguer et gagner des points, mais[m
[32m+[m[32m--    pas racheter de récompenses à valeur réelle (carte cadeau, virement,[m
[32m+[m[32m--    conversion en BARO).[m
[32m+[m[32malter table profiles add column if not exists restricted boolean not null default false;[m
[32m+[m
[32m+[m[32m-- 3) Table de liaison appareil <-> comptes. Aucune policy définie : RLS[m
[32m+[m[32m--    activé + zéro policy = accès refusé à anon/authenticated, seul[m
[32m+[m[32m--    service_role peut y lire/écrire depuis les fonctions serveur.[m
[32m+[m[32mcreate table if not exists device_accounts ([m
[32m+[m[32m  device_id text not null,[m
[32m+[m[32m  user_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  created_at timestamptz not null default now(),[m
[32m+[m[32m  primary key (device_id, user_id)[m
[32m+[m[32m);[m
[32m+[m[32malter table device_accounts enable row level security;[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
