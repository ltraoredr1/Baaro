[32m+[m
[32m+[m[32m-- Views are registered through the RPC only; clients cannot insert arbitrary[m
[32m+[m[32m-- viewer identities.[m
[32m+[m[32mdrop policy if exists video_views_own_insert on public.video_views;[m
[32m+[m
[32m+[m[32mcreate or replace function public.register_video_view(p_video_id uuid)[m
[32m+[m[32mreturns jsonb[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  uid uuid := auth.uid();[m
[32m+[m[32m  inserted boolean := false;[m
[32m+[m[32m  new_views integer := 0;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if uid is null then raise exception 'AUTH_REQUIRED'; end if;[m
[32m+[m[32m  if not exists (select 1 from public.videos where id = p_video_id) then[m
[32m+[m[32m    raise exception 'VIDEO_NOT_FOUND';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  insert into public.video_views(video_id, viewer_id, view_date)[m
[32m+[m[32m  values (p_video_id, uid, current_date)[m
[32m+[m[32m  on conflict do nothing;[m
[32m+[m
[32m+[m[32m  inserted := found;[m
[32m+[m[32m  if inserted then[m
