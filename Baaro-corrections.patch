[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0046_join_debate_code_case.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- Codes d'invitation : comparaison insensible à la casse[m
[32m+[m[32mcreate or replace function public.join_debate_by_code(p_code text)[m
[32m+[m[32mreturns public.debate_rooms[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_room public.debate_rooms;[m
[32m+[m[32m  v_count int;[m
[32m+[m[32mbegin[m
[32m+[m[32m  select * into v_room from public.debate_rooms[m
[32m+[m[32m    where lower(trim(invite_code)) = lower(trim(p_code))[m
[32m+[m[32m      and status in ('active', 'paused');[m
[32m+[m
[32m+[m[32m  if not found then[m
[32m+[m[32m    raise exception 'Aucun live actif avec ce code.';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  select count(*) into v_count from public.debate_participants[m
[32m+[m[32m    where room_id = v_room.id and (left_at is null);[m
[32m+[m
[32m+[m[32m  if v_count >= coalesce(v_room.max_participants, 12) then[m
[32m+[m[32m    raise exception 'Ce live est complet.';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  insert into public.debate_participants (room_id, user_id, joined_at, left_at)[m
[32m+[m[32m  values (v_room.id, auth.uid(), now(), null)[m
[32m+[m[32m  on conflict (room_id, user_id) do update set left_at = null, joined_at = now();[m
[32m+[m
[32m+[m[32m  return v_room;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mgrant execute on function public.join_debate_by_code(text) to authenticated, anon;[m
[32m+[m
