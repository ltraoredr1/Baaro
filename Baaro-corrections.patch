[32m+[m[32m-- 031_cleanup_legacy_handles.sql[m
[32m+[m[32m-- Nettoie les handles hérités : @user_xxx, @membre, uuid-like[m
[32m+[m[32m-- Après 029 + 030[m
[32m+[m
[32m+[m[32m-- 1) Repérer (lecture seule — à exécuter d'abord pour voir le volume)[m
[32m+[m[32m-- select user_id, display_name, handle[m
[32m+[m[32m-- from public.profiles[m
[32m+[m[32m-- where handle ~* '^@?user_[0-9a-f]'[m
[32m+[m[32m--    or lower(handle) in ('@membre', '@member', '@user', 'membre', 'member', 'user')[m
[32m+[m[32m--    or handle ~* '^[0-9a-f]{8}-[0-9a-f]{4}-';[m
[32m+[m
[32m+[m[32m-- 2) Libérer les handles legacy (force une vraie saisie au prochain enregistrement)[m
[32m+[m[32mupdate public.profiles[m
[32m+[m[32mset[m
[32m+[m[32m  handle = null,[m
[32m+[m[32m  updated_at = now()[m
[32m+[m[32mwhere[m
[32m+[m[32m  handle is not null[m
[32m+[m[32m  and ([m
[32m+[m[32m    handle ~* '^@?user_[0-9a-f]'[m
[32m+[m[32m    or lower(coalesce(handle, '')) in ([m
[32m+[m[32m      '@membre', '@member', '@user',[m
[32m+[m[32m      'membre', 'member', 'user'[m
[32m+[m[32m    )[m
[32m+[m[32m    or handle ~* '^[0-9a-f]{8}-[0-9a-f]{4}-'[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m-- 3) Optionnel : si display_name est encore le défaut, le laisser ;[m
[32m+[m[32m--    l'utilisateur choisira nom + @ dans Réglages.[m
[32m+[m
[32m+[m[32mcomment on table public.profiles is[m
[32m+[m[32m  'BAARO profiles — handles legacy @user_xxx nettoyés (031)';[m
