[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO 2.0 — Migration 020 : wallet_ledger append-only[m
[32m+[m[32m-- Exécuter APRÈS les migrations précédentes (jusqu'à 019 inclus).[m
[32m+[m
[32m+[m[32m-- Table ledger immuable (append-only)[m
[32m+[m[32mCREATE TABLE IF NOT EXISTS public.wallet_ledger ([m
[32m+[m[32m  id            uuid PRIMARY KEY DEFAULT gen_random_uuid(),[m
[32m+[m[32m  user_id       uuid NOT NULL REFERENCES auth.users(id) ON DELETE CASCADE,[m
[32m+[m[32m  action_key    text NOT NULL,[m
[32m+[m[32m  pts           integer NOT NULL,          -- positif = crédit, négatif = débit[m
[32m+[m[32m  balance_after integer NOT NULL,[m
[32m+[m[32m  reference_id  uuid,[m
[32m+[m[32m  metadata      jsonb NOT NULL DEFAULT '{}'::jsonb,[m
[32m+[m[32m  created_at    timestamptz NOT NULL DEFAULT now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mCREATE INDEX IF NOT EXISTS idx_wallet_ledger_user_created[m
[32m+[m[32m  ON public.wallet_ledger (user_id, created_at DESC);[m
[32m+[m
[32m+[m[32m-- Idempotence : une seule ligne par (user, action, reference)[m
[32m+[m[32mCREATE UNIQUE INDEX IF NOT EXISTS idx_wallet_ledger_idempotency[m
[32m+[m[32m  ON public.wallet_ledger (user_id, action_key, reference_id)[m
[32m+[m[32m  WHERE reference_id IS NOT NULL;[m
[32m+[m
[32m+[m[32m-- RLS[m
[32m+[m[32mALTER TABLE public.wallet_ledger ENABLE ROW LEVEL SECURITY;[m
[32m+[m
[32m+[m[32mDROP POLICY IF EXISTS "Users can read own ledger" ON public.wallet_ledger;[m
[32m+[m[32mCREATE POLICY "Users can read own ledger"[m
[32m+[m[32m  ON public.wallet_ledger[m
[32m+[m[32m  FOR SELECT[m
[32m+[m[32m  USING (auth.uid() = id);[m
[32m+[m
[32m+[m[32m-- Aucune policy INSERT/UPDATE/DELETE pour le rôle authentifié.[m
[32m+[m[32m-- Seul service_role (côté serveur) peut écrire.[m
[32m+[m
[32m+[m[32m-- Fonction helper pour insérer dans le ledger (appelée depuis les RPC wallet_*)[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.wallet_ledger_append([m
[32m+[m[32m  p_user_id       uuid,[m
[32m+[m[32m  p_action_key    text,[m
[32m+[m[32m  p_pts           integer,[m
[32m+[m[32m  p_balance_after integer,[m
[32m+[m[32m  p_reference_id  uuid DEFAULT NULL,[m
[32m+[m[32m  p_metadata      jsonb DEFAULT '{}'::jsonb[m
[32m+[m[32m)[m
[32m+[m[32mRETURNS uuid[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  v_id uuid;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  INSERT INTO public.wallet_ledger ([m
[32m+[m[32m    user_id, action_key, pts, balance_after, reference_id, metadata[m
[32m+[m[32m  )[m
[32m+[m[32m  VALUES ([m
[32m+[m[32m    p_user_id, p_action_key, p_pts, p_balance_after, p_reference_id, COALESCE(p_metadata, '{}'::jsonb)[m
[32m+[m[32m  )[m
[32m+[m[32m  ON CONFLICT DO NOTHING[m
[32m+[m[32m  RETURNING id INTO v_id;[m
[32m+[m
[32m+[m[32m  RETURN v_id;[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
[32m+[m
