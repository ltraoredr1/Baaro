[32m+[m[32m-- 1.3 Fonctions d'aide[m
[32m+[m[32mcreate or replace function public.group_role(p_group uuid)[m
[32m+[m[32mreturns text language sql stable security definer set search_path = public as $$[m
[32m+[m[32m  select case when g.owner_id = auth.uid() then 'owner' else gm.role end[m
[32m+[m[32m  from public.groups g[m
[32m+[m[32m  left join public.group_members gm[m
[32m+[m[32m    on gm.group_id = g.id and gm.user_id = auth.uid()[m
[32m+[m[32m  where g.id = p_group;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mcreate or replace function public.role_rank(p_role text)[m
[32m+[m[32mreturns int language sql immutable as $$[m
[32m+[m[32m  select case p_role[m
[32m+[m[32m    when 'owner' then 3 when 'admin' then 2[m
[32m+[m[32m    when 'moderator' then 1 when 'member' then 0 else -1 end;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mcreate or replace function public.can_see_group(p_group uuid)[m
[32m+[m[32mreturns boolean language sql stable security definer set search_path = public as $$[m
[32m+[m[32m  select exists ([m
[32m+[m[32m    select 1 from public.groups g[m
[32m+[m[32m    where g.id = p_group and coalesce(g.is_public, true)[m
[32m+[m[32m  ) or public.group_role(p_group) is not null;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mcreate or replace function public.channel_group(p_channel uuid)[m
[32m+[m[32mreturns uuid language sql stable security definer set search_path = public as $$[m
[32m+[m[32m  select group_id from public.channels where id = p_channel;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mcreate or replace function public.is_banned(p_group uuid, p_user uuid)[m
[32m+[m[32mreturns boolean language sql stable security definer set search_path = public as $$[m
[32m+[m[32m  select exists ([m
[32m+[m[32m    select 1 from public.group_bans[m
[32m+[m[32m    where group_id = p_group and user_id = p_user[m
[32m+[m[32m  );[m
[32m+[m[32m$$;[m
