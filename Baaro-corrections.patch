[32m+[m[32m-- Trust is readable only for the subject; aggregation can later be exposed through a controlled RPC.[m
[32m+[m[32mdrop policy if exists nexus_trust_subject on public.nexus_trust_events;[m
[32m+[m[32mcreate policy nexus_trust_subject on public.nexus_trust_events for select to authenticated using (subject_id = auth.uid());[m
[32m+[m
[32m+[m[32mcreate or replace function public.nexus_trust_score(p_user_id uuid)[m
[32m+[m[32mreturns integer language sql stable security definer set search_path = public as $$[m
[32m+[m[32m  select greatest(0, least(100, 50 + coalesce(sum(weight),0)::integer)) from public.nexus_trust_events where subject_id = p_user_id;[m
[32m+[m[32m$$;[m
[32m+[m[32mgrant execute on function public.nexus_trust_score(uuid) to authenticated;[m
[32m+[m
[32m+[m[32mcreate or replace function public.nexus_bootstrap()[m
[32m+[m[32mreturns jsonb language plpgsql security definer set search_path = public as $$[m
[32m+[m[32mdeclare uid uuid := auth.uid();[m
[32m+[m[32mbegin[m
[32m+[m[32m  if uid is null then raise exception 'not_authenticated'; end if;[m
[32m+[m[32m  insert into public.nexus_preferences(user_id) values(uid) on conflict (user_id) do nothing;[m
[32m+[m[32m  return jsonb_build_object([m
[32m+[m[32m    'trust_score', public.nexus_trust_score(uid),[m
[32m+[m[32m    'goals', (select count(*) from public.nexus_goals where user_id = uid and status = 'active'),[m
[32m+[m[32m    'memory_enabled', (select memory_enabled from public.nexus_preferences where user_id = uid)[m
[32m+[m[32m  );[m
[32m+[m[32mend; $$;[m
[32m+[m[32mgrant execute on function public.nexus_bootstrap() to authenticated;[m
