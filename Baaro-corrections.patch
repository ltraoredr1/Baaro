[32m+[m[32m-- Prevent clients from changing sender/conversation identity on an existing message.[m
[32m+[m[32mcreate or replace function public.prevent_message_identity_change()[m
[32m+[m[32mreturns trigger[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if new.sender_id <> old.sender_id[m
[32m+[m[32m     or new.conversation_id <> old.conversation_id[m
[32m+[m[32m     or coalesce(new.recipient_id::text, '') <> coalesce(old.recipient_id::text, '') then[m
[32m+[m[32m    raise exception 'MESSAGE_IDENTITY_FIELDS_IMMUTABLE';[m
[32m+[m[32m  end if;[m
[32m+[m[32m  return new;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
