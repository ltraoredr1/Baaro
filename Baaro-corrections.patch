[32m+[m[32m-- 1.9 Invitations[m
[32m+[m[32malter table public.channels drop constraint if exists channels_type_check;[m
[32m+[m[32malter table public.channels[m
[32m+[m[32m  add constraint channels_type_check[m
[32m+[m[32m  check (type in ('text', 'voice', 'announce'));[m
[32m+[m
[32m+[m[32mcreate table if not exists public.group_invites ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  group_id uuid not null references public.groups(id) on delete cascade,[m
[32m+[m[32m  code text not null,[m
[32m+[m[32m  created_by uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  max_uses int default 0,[m
[32m+[m[32m  uses int not null default 0,[m
[32m+[m[32m  expires_at timestamptz,[m
[32m+[m[32m  created_at timestamptz not null default now(),[m
[32m+[m[32m  unique (group_id, code)[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mcreate index if not exists idx_group_invites_code[m
[32m+[m[32m  on public.group_invites (upper(code));[m
[32m+[m
[32m+[m[32mcreate or replace function public.create_group_invite([m
[32m+[m[32m  p_group uuid,[m
[32m+[m[32m  p_max_uses int default 0,[m
[32m+[m[32m  p_expires_hours int default null[m
[32m+[m[32m)[m
[32m+[m[32mreturns public.group_invites[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_uid uuid := auth.uid();[m
[32m+[m[32m  v_code text;[m
[32m+[m[32m  v_row public.group_invites;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if v_uid is null then[m
[32m+[m[32m    raise exception 'Non authentifié';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  if public.group_role(p_group) not in ('owner', 'admin') then[m
[32m+[m[32m    raise exception 'Seuls les admins peuvent créer une invitation';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  v_code := upper(substr(replace(gen_random_uuid()::text, '-', ''), 1, 8));[m
[32m+[m
[32m+[m[32m  insert into public.group_invites ([m
[32m+[m[32m    group_id, code, created_by, max_uses, expires_at[m
[32m+[m[32m  )[m
[32m+[m[32m  values ([m
[32m+[m[32m    p_group,[m
[32m+[m[32m    v_code,[m
[32m+[m[32m    v_uid,[m
[32m+[m[32m    greatest(coalesce(p_max_uses, 0), 0),[m
[32m+[m[32m    case[m
[32m+[m[32m      when p_expires_hours is null or p_expires_hours <= 0 then null[m
[32m+[m[32m      else now() + (p_expires_hours || ' hours')::interval[m
[32m+[m[32m    end[m
[32m+[m[32m  )[m
[32m+[m[32m  returning * into v_row;[m
[32m+[m
[32m+[m[32m  return v_row;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mcreate or replace function public.list_group_invites(p_group uuid)[m
[32m+[m[32mreturns setof public.group_invites[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if public.group_role(p_group) not in ('owner', 'admin') then[m
[32m+[m[32m    raise exception 'Droits insuffisants';[m
