[32m+[m[32m-- SOURCE: 0004_add_debates.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- Ajoute les "Débats" : salons de groupe combinant texte, vocal, vidéo et[m
[32m+[m[32m-- un participant IA. À exécuter après les migrations précédentes, dans une[m
[32m+[m[32m-- nouvelle requête du SQL Editor Supabase.[m
[32m+[m[32m--[m
[32m+[m[32m-- Important : contrairement à la messagerie privée (chiffrée de bout en[m
[32m+[m[32m-- bout, voir supabase-add-e2e-encryption.sql), les messages texte des[m
[32m+[m[32m-- débats de groupe sont stockés en clair côté serveur — comme pour les[m
[32m+[m[32m-- publications. Le chiffrement de bout en bout pour un groupe (où chaque[m
[32m+[m[32m-- membre doit pouvoir déchiffrer) demanderait un système de clés partagées[m
[32m+[m[32m-- nettement plus complexe ; à envisager dans une itération future si[m
[32m+[m[32m-- nécessaire.[m
[32m+[m[32m--[m
[32m+[m[32m-- L'audio et la vidéo, eux, ne transitent jamais par le serveur : ils[m
[32m+[m[32m-- passent en direct entre les appareils via WebRTC (voir src/lib/webrtc.js).[m
[32m+[m[32m-- Seuls les messages de signalisation (offres/réponses de connexion)[m
[32m+[m[32m-- passent par Supabase Realtime, sans être stockés en base.[m
[32m+[m
[32m+[m[32mcreate table if not exists debate_rooms ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  host_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  title text not null,[m
[32m+[m[32m  topic text,[m
[32m+[m[32m  mode text not null default 'video' check (mode in ('text', 'audio', 'video')),[m
[32m+[m[32m  max_participants int not null default 6 check (max_participants between 2 and 12),[m
[32m+[m[32m  ai_enabled boolean not null default true,[m
[32m+[m[32m  invite_code text not null unique default substr(replace(gen_random_uuid()::text, '-', ''), 1, 8),[m
[32m+[m[32m  status text not null default 'active' check (status in ('active', 'ended')),[m
[32m+[m[32m  created_at timestamptz not null default now(),[m
[32m+[m[32m  ended_at timestamptz[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mcreate table if not exists debate_participants ([m
[32m+[m[32m  room_id uuid not null references debate_rooms(id) on delete cascade,[m
[32m+[m[32m  user_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  joined_at timestamptz not null default now(),[m
[32m+[m[32m  left_at timestamptz,[m
[32m+[m[32m  primary key (room_id, user_id)[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mcreate table if not exists debate_messages ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  room_id uuid not null references debate_rooms(id) on delete cascade,[m
[32m+[m[32m  sender_id uuid references auth.users(id) on delete set null,[m
[32m+[m[32m  sender_type text not null default 'user' check (sender_type in ('user', 'ai', 'system')),[m
[32m+[m[32m  text text not null,[m
[32m+[m[32m  created_at timestamptz not null default now()[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32malter table debate_rooms enable row level security;[m
[32m+[m[32malter table debate_participants enable row level security;[m
[32m+[m[32malter table debate_messages enable row level security;[m
[32m+[m
[32m+[m[32m-- Salons : visibles par toute personne connectée (pour rejoindre via code[m
[32m+[m[32m-- ou invitation) ; seul l'hôte peut modifier/terminer son salon.[m
[32m+[m[32mcreate policy "debate_rooms_read" on debate_rooms for select using (auth.uid() is not null);[m
[32m+[m[32mcreate policy "debate_rooms_insert" on debate_rooms for insert with check (auth.uid() = host_id);[m
[32m+[m[32mcreate policy "debate_rooms_update_host" on debate_rooms for update using (auth.uid() = host_id);[m
[32m+[m
[32m+[m[32m-- Participation : chacun voit qui participe aux salons ; chacun ne peut[m
[32m+[m[32m-- s'ajouter/se retirer que lui-même.[m
[32m+[m[32mcreate policy "debate_participants_read" on debate_participants for select using (auth.uid() is not null);[m
[32m+[m[32mcreate policy "debate_participants_insert" on debate_participants for insert with check (auth.uid() = user_id);[m
[32m+[m[32mcreate policy "debate_participants_update_own" on debate_participants for update using (auth.uid() = user_id);[m
[32m+[m
[32m+[m[32m-- Messages : lisibles et écrits uniquement par les membres du salon.[m
[32m+[m[32m-- Un message peut aussi être envoyé "au nom de l'IA" (sender_id = null,[m
[32m+[m[32m-- sender_type = 'ai') tant que l'auteur de la requête est bien membre du[m
[32m+[m[32m-- salon — c'est le client qui appelle Claude et republie la réponse.[m
[32m+[m[32mcreate policy "debate_messages_read" on debate_messages for select using ([m
[32m+[m[32m  exists (select 1 from debate_participants dp where dp.room_id = debate_messages.room_id and dp.user_id = auth.uid())[m
[32m+[m[32m);[m
[32m+[m[32mcreate policy "debate_messages_insert" on debate_messages for insert with check ([m
[32m+[m[32m  exists (select 1 from debate_participants dp where dp.room_id = debate_messages.room_id and dp.user_id = auth.uid())[m
[32m+[m[32m  and (sender_type = 'user' and sender_id = auth.uid() or sender_type in ('ai', 'system'))[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mcreate index if not exists debate_messages_room_idx on debate_messages (room_id, created_at);[m
[32m+[m[32mcreate index if not exists debate_participants_room_idx on debate_participants (room_id);[m
[32m+[m
[32m+[m[32m-- Active Supabase Realtime sur ces deux tables (Database > Replication[m
[32m+[m[32m-- dans le tableau de bord Supabase, ou via cette commande) pour que les[m
[32m+[m[32m-- messages et l'arrivée/le départ de participants s'affichent en direct.[m
[32m+[m[32malter publication supabase_realtime add table debate_messages;[m
[32m+[m[32malter publication supabase_realtime add table debate_participants;[m
[32m+[m
