[32m+[m[32m  on public.video_views(video_id, view_date desc);[m
[32m+[m[32mcreate index if not exists idx_video_views_viewer_date[m
[32m+[m[32m  on public.video_views(viewer_id, viewed_at desc);[m
[32m+[m
[32m+[m[32malter table public.video_views enable row level security;[m
[32m+[m[32mdrop policy if exists video_views_own_read on public.video_views;[m
