[32m+[m[32m-- BAARO 2.0 - Wallet atomique / ledger sécurisé[m
[32m+[m[32m-- À exécuter après 011_baaro_core_media_security.sql.[m
[32m+[m
[32m+[m[32malter table public.transactions[m
[32m+[m[32m  add column if not exists action_key text,[m
[32m+[m[32m  add column if not exists day_key date;[m
[32m+[m
[32m+[m[32mcreate index if not exists idx_transactions_user_created[m
[32m+[m[32m  on public.transactions(user_id, created_at desc);[m
[32m+[m
[32m+[m[32mcreate index if not exists idx_transactions_user_day_positive[m
[32m+[m[32m  on public.transactions(user_id, day_key, pts)[m
[32m+[m[32m  where pts > 0;[m
[32m+[m
[32m+[m[32mcreate unique index if not exists ux_transactions_daily_bonus[m
[32m+[m[32m  on public.transactions(user_id, day_key)[m
[32m+[m[32m  where action_key = 'daily_bonus';[m
[32m+[m
[32m+[m[32mcreate or replace function public.wallet_ensure(p_user_id uuid, p_welcome_bonus numeric default 50)[m
[32m+[m[32mreturns jsonb[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  w public.wallets%rowtype;[m
[32m+[m[32m  bonus numeric := greatest(coalesce(p_welcome_bonus, 0), 0);[m
[32m+[m[32mbegin[m
[32m+[m[32m  insert into public.wallets(id, balance)[m
[32m+[m[32m  values (p_user_id, 0)[m
[32m+[m[32m  on conflict (user_id) do nothing;[m
[32m+[m
[32m+[m[32m  select * into w from public.wallets where id = p_user_id for update;[m
[32m+[m
[32m+[m[32m  if bonus > 0 and not exists ([m
[32m+[m[32m    select 1 from public.transactions[m
[32m+[m[32m    where user_id = p_user_id and action_key = 'welcome_bonus'[m
[32m+[m[32m  ) then[m
[32m+[m[32m    update public.wallets[m
[32m+[m[32m      set balance = balance + bonus, updated_at = now()[m
[32m+[m[32m    where user_id = p_user_id[m
[32m+[m[32m    returning * into w;[m
[32m+[m
[32m+[m[32m    insert into public.transactions(user_id, label, pts, action_key, day_key)[m
[32m+[m[32m    values (p_user_id, 'Bonus de bienvenue', bonus, 'welcome_bonus', current_date);[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  return jsonb_build_object('user_id', w.id, 'balance', w.balance, 'updated_at', w.updated_at);[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mcreate or replace function public.wallet_earn([m
[32m+[m[32m  p_user_id uuid,[m
[32m+[m[32m  p_pts numeric,[m
[32m+[m[32m  p_label text,[m
[32m+[m[32m  p_action_key text,[m
[32m+[m[32m  p_daily_cap numeric default 100,[m
[32m+[m[32m  p_daily_bonus boolean default false[m
[32m+[m[32m)[m
[32m+[m[32mreturns jsonb[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  w public.wallets%rowtype;[m
[32m+[m[32m  earned numeric := 0;[m
[32m+[m[32m  actual_pts numeric;[m
[32m+[m[32m  tx public.transactions%rowtype;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if p_pts is null or p_pts <= 0 then raise exception 'INVALID_POINTS'; end if;[m
[32m+[m[32m  if length(coalesce(p_label,'')) = 0 then raise exception 'INVALID_LABEL'; end if;[m
[32m+[m
[32m+[m[32m  perform public.wallet_ensure(p_user_id, 0);[m
[32m+[m[32m  select * into w from public.wallets where id = p_user_id for update;[m
[32m+[m
[32m+[m[32m  select coalesce(sum(pts), 0) into earned[m
[32m+[m[32m  from public.transactions[m
[32m+[m[32m  where user_id = p_user_id and pts > 0 and created_at >= date_trunc('day', now());[m
[32m+[m
[32m+[m[32m  if p_daily_bonus and exists ([m
[32m+[m[32m    select 1 from public.transactions[m
[32m+[m[32m    where user_id = p_user_id and action_key = 'daily_bonus' and day_key = current_date[m
[32m+[m[32m  ) then[m
[32m+[m[32m    raise exception 'DAILY_BONUS_ALREADY_CLAIMED';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  if earned >= p_daily_cap then raise exception 'DAILY_CAP_REACHED'; end if;[m
[32m+[m[32m  actual_pts := least(p_pts, p_daily_cap - earned);[m
[32m+[m
[32m+[m[32m  update public.wallets[m
[32m+[m[32m    set balance = balance + actual_pts, updated_at = now()[m
[32m+[m[32m  where user_id = p_user_id[m
[32m+[m[32m  returning * into w;[m
[32m+[m
[32m+[m[32m  insert into public.transactions(user_id, label, pts, action_key, day_key)[m
[32m+[m[32m  values (p_user_id, left(p_label, 120), actual_pts, p_action_key, current_date)[m
[32m+[m[32m  returning * into tx;[m
[32m+[m
[32m+[m[32m  return jsonb_build_object([m
[32m+[m[32m    'balance', w.balance,[m
[32m+[m[32m    'earned_today', earned + actual_pts,[m
[32m+[m[32m    'remaining_today', greatest(0, p_daily_cap - earned - actual_pts),[m
[32m+[m[32m    'transaction', to_jsonb(tx)[m
[32m+[m[32m  );[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mcreate or replace function public.wallet_redeem([m
[32m+[m[32m  p_user_id uuid,[m
[32m+[m[32m  p_cost numeric,[m
