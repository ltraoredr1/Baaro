[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0008_fix_chat_friends.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO — Chat + Amis (conversations, messages, follows)[m
[32m+[m[32m-- Idempotent[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32m-- 1) Table conversations[m
[32m+[m[32mcreate table if not exists conversations ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  user1_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  user2_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  created_at timestamptz not null default now(),[m
[32m+[m[32m  unique (user1_id, user2_id)[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mcreate index if not exists idx_conversations_user1 on conversations (user1_id);[m
