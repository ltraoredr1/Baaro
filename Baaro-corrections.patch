[32m+[m[32m  and ([m
[32m+[m[32m    author_id = auth.uid()[m
[32m+[m[32m    or visibility = 'public'[m
[32m+[m[32m    or ([m
[32m+[m[32m      visibility = 'followers'[m
[32m+[m[32m      and exists ([m
[32m+[m[32m        select 1[m
[32m+[m[32m        from public.follows f[m
[32m+[m[32m        where f.follower_id = auth.uid()[m
[32m+[m[32m          and f.followed_id = stories.author_id[m
[32m+[m[32m          and f.status = 'accepted'[m
[32m+[m[32m      )[m
[32m+[m[32m    )[m
[32m+[m[32m    or ([m
[32m+[m[32m      visibility = 'close_friends'[m
[32m+[m[32m      and exists ([m
[32m+[m[32m        select 1[m
[32m+[m[32m        from public.story_close_friends cf[m
[32m+[m[32m        where cf.owner_id = stories.author_id[m
[32m+[m[32m          and cf.member_id = auth.uid()[m
[32m+[m[32m      )[m
[32m+[m[32m    )[m
[32m+[m[32m  )[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- Views/reactions/replies are additionally constrained by Story visibility.[m
[32m+[m[32mdrop policy if exists story_views_owner on public.story_views;[m
[32m+[m[32mcreate policy story_views_owner[m
[32m+[m[32mon public.story_views[m
[32m+[m[32mfor all to authenticated[m
[32m+[m[32musing ([m
[32m+[m[32m  viewer_id = auth.uid()[m
[32m+[m[32m  and exists (select 1 from public.stories s where s.id = story_id and ([m
[32m+[m[32m    s.author_id = auth.uid() or s.visibility = 'public'[m
[32m+[m[32m    or (s.visibility = 'followers' and exists ([m
[32m+[m[32m      select 1 from public.follows f where f.follower_id = auth.uid() and f.followed_id = s.author_id and f.status = 'accepted'))[m
[32m+[m[32m    or (s.visibility = 'close_friends' and exists ([m
[32m+[m[32m      select 1 from public.story_close_friends cf where cf.owner_id = s.author_id and cf.member_id = auth.uid()))[m
[32m+[m[32m  ))[m
[32m+[m[32m)[m
[32m+[m[32mwith check ([m
[32m+[m[32m  viewer_id = auth.uid()[m
[32m+[m[32m  and exists (select 1 from public.stories s where s.id = story_id and s.deleted_at is null and s.expires_at > now() and ([m
[32m+[m[32m    s.author_id = auth.uid() or s.visibility = 'public'[m
[32m+[m[32m    or (s.visibility = 'followers' and exists ([m
[32m+[m[32m      select 1 from public.follows f where f.follower_id = auth.uid() and f.followed_id = s.author_id and f.status = 'accepted'))[m
[32m+[m[32m    or (s.visibility = 'close_friends' and exists ([m
[32m+[m[32m      select 1 from public.story_close_friends cf where cf.owner_id = s.author_id and cf.member_id = auth.uid()))[m
[32m+[m[32m  ))[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mdrop policy if exists story_reactions_owner on public.story_reactions;[m
[32m+[m[32mcreate policy story_reactions_owner[m
[32m+[m[32mon public.story_reactions[m
[32m+[m[32mfor all to authenticated[m
[32m+[m[32musing ([m
[32m+[m[32m  user_id = auth.uid()[m
[32m+[m[32m  and exists (select 1 from public.stories s where s.id = story_id and ([m
[32m+[m[32m    s.author_id = auth.uid() or s.visibility = 'public'[m
[32m+[m[32m    or (s.visibility = 'followers' and exists ([m
[32m+[m[32m      select 1 from public.follows f where f.follower_id = auth.uid() and f.followed_id = s.author_id and f.status = 'accepted'))[m
[32m+[m[32m    or (s.visibility = 'close_friends' and exists ([m
[32m+[m[32m      select 1 from public.story_close_friends cf where cf.owner_id = s.author_id and cf.member_id = auth.uid()))[m
[32m+[m[32m  ))[m
[32m+[m[32m)[m
[32m+[m[32mwith check ([m
[32m+[m[32m  user_id = auth.uid()[m
[32m+[m[32m  and exists (select 1 from public.stories s where s.id = story_id and s.deleted_at is null and s.expires_at > now() and ([m
[32m+[m[32m    s.author_id = auth.uid() or s.visibility = 'public'[m
[32m+[m[32m    or (s.visibility = 'followers' and exists ([m
[32m+[m[32m      select 1 from public.follows f where f.follower_id = auth.uid() and f.followed_id = s.author_id and f.status = 'accepted'))[m
[32m+[m[32m    or (s.visibility = 'close_friends' and exists ([m
[32m+[m[32m      select 1 from public.story_close_friends cf where cf.owner_id = s.author_id and cf.member_id = auth.uid()))[m
[32m+[m[32m  ))[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32mdrop policy if exists story_replies_participant on public.story_replies;[m
[32m+[m[32mcreate policy story_replies_participant[m
[32m+[m[32mon public.story_replies[m
[32m+[m[32mfor all to authenticated[m
[32m+[m[32musing ([m
[32m+[m[32m  sender_id = auth.uid()[m
[32m+[m[32m  or exists (select 1 from public.stories s where s.id = story_id and s.author_id = auth.uid())[m
[32m+[m[32m)[m
[32m+[m[32mwith check ([m
[32m+[m[32m  sender_id = auth.uid()[m
[32m+[m[32m  and exists (select 1 from public.stories s where s.id = story_id and s.deleted_at is null and s.expires_at > now() and ([m
[32m+[m[32m    s.author_id = auth.uid() or s.visibility = 'public'[m
[32m+[m[32m    or (s.visibility = 'followers' and exists ([m
[32m+[m[32m      select 1 from public.follows f where f.follower_id = auth.uid() and f.followed_id = s.author_id and f.status = 'accepted'))[m
[32m+[m[32m    or (s.visibility = 'close_friends' and exists ([m
[32m+[m[32m      select 1 from public.story_close_friends cf where cf.owner_id = s.author_id and cf.member_id = auth.uid()))[m
[32m+[m[32m  ))[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32m-- 2) Creator monetization: client cannot set revenue share/cashout rules[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32mdrop policy if exists creator_monetization_own on public.creator_monetization;[m
[32m+[m[32mcreate policy creator_monetization_read[m
[32m+[m[32mon public.creator_monetization[m
[32m+[m[32mfor select to authenticated[m
[32m+[m[32musing (creator_id = auth.uid());[m
[32m+[m
[32m+[m[32m-- Only a controlled toggle is exposed to the client. Financial terms remain server-owned.[m
[32m+[m[32mcreate or replace function public.set_creator_monetization_enabled(p_enabled boolean)[m
[32m+[m[32mreturns public.creator_monetization[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity invoker[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare r public.creator_monetization;[m
[32m+[m[32mbegin[m
[32m+[m[32m  update public.creator_monetization[m
[32m+[m[32m     set enabled = p_enabled, updated_at = now()[m
[32m+[m[32m   where creator_id = auth.uid()[m
[32m+[m[32m   returning * into r;[m
[32m+[m[32m  if not found then[m
[32m+[m[32m    insert into public.creator_monetization(creator_id, enabled)[m
[32m+[m[32m    values (auth.uid(), p_enabled)[m
[32m+[m[32m    returning * into r;[m
[32m+[m[32m  end if;[m
[32m+[m[32m  return r;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mrevoke all on function public.set_creator_monetization_enabled(boolean) from public, anon;[m
[32m+[m[32mgrant execute on function public.set_creator_monetization_enabled(boolean) to authenticated;[m
[32m+[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32m-- 3) Media job claiming: worker-only, never callable by normal clients[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32mrevoke all on function public.claim_media_jobs(integer,text) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.claim_media_jobs(integer,text) to service_role;[m
[32m+[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32m-- 4) Video watch/feed RPCs: validate caller identity and bound inputs[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32mcreate or replace function public.record_video_watch([m
[32m+[m[32m  p_video_id uuid, p_watch_ms integer, p_duration_ms integer,[m
[32m+[m[32m  p_completed boolean default false, p_rewatched boolean default false,[m
[32m+[m[32m  p_liked boolean default false, p_shared boolean default false,[m
[32m+[m[32m  p_negative_signal text default null[m
[32m+[m[32m) returns void[m
[32m+[m[32mlanguage plpgsql security definer set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare uid uuid := auth.uid();[m
[32m+[m[32mbegin[m
[32m+[m[32m  if uid is null then raise exception 'not_authenticated'; end if;[m
[32m+[m[32m  if p_video_id is null or not exists (select 1 from public.videos where id = p_video_id) then raise exception 'video_not_found'; end if;[m
[32m+[m[32m  if p_watch_ms is null or p_watch_ms < 0 or p_watch_ms > 86400000 then raise exception 'invalid_watch_ms'; end if;[m
[32m+[m[32m  if p_duration_ms is null or p_duration_ms < 0 or p_duration_ms > 86400000 then raise exception 'invalid_duration_ms'; end if;[m
[32m+[m[32m  if p_negative_signal is not null and p_negative_signal not in ('not_interested','hide_creator','report') then raise exception 'invalid_negative_signal'; end if;[m
[32m+[m
[32m+[m[32m  insert into public.video_watch_events(video_id,user_id,watch_ms,duration_ms,completed,rewatched,liked,shared,negative_signal)[m
[32m+[m[32m  values (p_video_id,uid,p_watch_ms,p_duration_ms,p_completed,p_rewatched,p_liked,p_shared,p_negative_signal);[m
[32m+[m
[32m+[m[32m  update public.videos v set[m
[32m+[m[32m    completion_rate = coalesce((select avg(case when completed then 1.0 else least(watch_ms::numeric/nullif(duration_ms,0),1) end) from public.video_watch_events e where e.video_id=v.id),0),[m
[32m+[m[32m    rewatch_rate = coalesce((select avg(case when rewatched then 1.0 else 0 end) from public.video_watch_events e where e.video_id=v.id),0),[m
[32m+[m[32m    recommendation_score = ([m
[32m+[m[32m      coalesce(v.likes,0)*1.0 + coalesce(v.comments_count,0)*1.8 +[m
[32m+[m[32m      coalesce(v.completion_rate,0)*100 + coalesce(v.rewatch_rate,0)*80 +[m
[32m+[m[32m      greatest(0, extract(epoch from (now()-v.created_at))/3600 * -0.15)[m
[32m+[m[32m    )[m
[32m+[m[32m  where v.id=p_video_id;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m[32mrevoke all on function public.record_video_watch(uuid,integer,integer,boolean,boolean,boolean,boolean,text) from public, anon;[m
[32m+[m[32mgrant execute on function public.record_video_watch(uuid,integer,integer,boolean,boolean,boolean,boolean,text) to authenticated;[m
[32m+[m
[32m+[m[32m-- Feed candidates can only be requested for the current user.[m
[32m+[m[32mcreate or replace function public.video_feed_candidates(p_user_id uuid, p_limit integer default 20)[m
[32m+[m[32mreturns table(id uuid, author_id uuid, video_url text, thumbnail_url text, title text, description text,[m
[32m+[m[32m  duration text, views bigint, likes integer, comments_count integer, created_at timestamptz, score numeric)[m
[32m+[m[32mlanguage sql stable security definer set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32m  select v.id,v.author_id,v.video_url,v.thumbnail_url,v.title,v.description,v.duration,[m
[32m+[m[32m         v.views,v.likes,v.comments_count,v.created_at,[m
[32m+[m[32m         round(coalesce(v.recommendation_score,0)[m
[32m+[m[32m           + case when v.author_id=auth.uid() then -20 else 0 end[m
[32m+[m[32m           + greatest(0, 30 - extract(epoch from (now()-v.created_at))/3600 * 0.25)[m
[32m+[m[32m           + coalesce(v.completion_rate,0)*120 + coalesce(v.rewatch_rate,0)*100[m
[32m+[m[32m           - coalesce((select count(*)*8 from public.video_watch_events e where e.video_id=v.id and e.user_id=auth.uid() and e.created_at > now()-interval '7 days'),0),4) as score[m
[32m+[m[32m  from public.videos v[m
[32m+[m[32m  where auth.uid() = p_user_id[m
[32m+[m[32m    and coalesce(v.visibility,'public')='public'[m
[32m+[m[32m    and not exists(select 1 from public.blocks b where b.blocker_id=auth.uid() and b.blocked_id=v.author_id)[m
[32m+[m[32m    and not exists(select 1 from public.blocks b where b.blocker_id=v.author_id and b.blocked_id=auth.uid())[m
[32m+[m[32m  order by score desc, v.created_at desc[m
[32m+[m[32m  limit greatest(1,least(coalesce(p_limit,20),100));[m
[32m+[m[32m$$;[m
[32m+[m[32mrevoke all on function public.video_feed_candidates(uuid,integer) from public, anon;[m
[32m+[m[32mgrant execute on function public.video_feed_candidates(uuid,integer) to authenticated;[m
[32m+[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32m-- 5) Global search: explicit public visibility + block filtering[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32mcreate or replace function public.global_discovery_search(p_query text, p_limit int default 8)[m
[32m+[m[32mreturns jsonb language plpgsql stable security definer set search_path=public as $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  q text := left(trim(coalesce(p_query,'')),200);[m
[32m+[m[32m  lim int := least(greatest(coalesce(p_limit,8),1),20);[m
[32m+[m[32m  uid uuid := auth.uid();[m
[32m+[m[32mbegin[m
[32m+[m[32m  if uid is null then raise exception 'not_authenticated'; end if;[m
[32m+[m[32m  if char_length(q) < 2 then return jsonb_build_object('users','[]'::jsonb,'groups','[]'::jsonb,'debates','[]'::jsonb,'posts','[]'::jsonb); end if;[m
[32m+[m[32m  return jsonb_build_object([m
[32m+[m[32m    'users', coalesce((select jsonb_agg(to_jsonb(x)) from ([m
[32m+[m[32m      select p.id,p.display_name,p.handle,p.avatar_url,p.flag from public.profiles p[m
[32m+[m[32m      where (p.display_name ilike '%'||q||'%' or p.handle ilike '%'||q||'%')[m
[32m+[m[32m        and p.id <> uid[m
[32m+[m[32m        and not exists(select 1 from public.blocks b where b.blocker_id=uid and b.blocked_id=p.id)[m
[32m+[m[32m        and not exists(select 1 from public.blocks b where b.blocker_id=p.id and b.blocked_id=uid)[m
[32m+[m[32m      order by p.display_name limit lim) x),'[]'::jsonb),[m
[32m+[m[32m    'groups', coalesce((select jsonb_agg(to_jsonb(x)) from ([m
[32m+[m[32m      select g.id,g.name,g.description,g.avatar_url,g.category from public.groups g[m
[32m+[m[32m      where g.is_public = true and (g.name ilike '%'||q||'%' or g.description ilike '%'||q||'%')[m
[32m+[m[32m      order by g.created_at desc limit lim) x),'[]'::jsonb),[m
[32m+[m[32m    'debates', coalesce((select jsonb_agg(to_jsonb(x)) from ([m
[32m+[m[32m      select d.id,d.title,d.topic,d.status from public.debate_rooms d[m
[32m+[m[32m      where d.status = 'active' and (d.title ilike '%'||q||'%' or d.topic ilike '%'||q||'%')[m
[32m+[m[32m      order by d.created_at desc limit lim) x),'[]'::jsonb),[m
[32m+[m[32m    'posts', coalesce((select jsonb_agg(to_jsonb(x)) from ([m
[32m+[m[32m      select p.id,p.author_id,p.text as content,p.media_url,p.created_at from public.posts p[m
[32m+[m[32m      where p.text ilike '%'||q||'%'[m
[32m+[m[32m        and not exists(select 1 from public.blocks b where b.blocker_id=uid and b.blocked_id=p.author_id)[m
[32m+[m[32m        and not exists(select 1 from public.blocks b where b.blocker_id=p.author_id and b.blocked_id=uid)[m
[32m+[m[32m      order by p.created_at desc limit lim) x),'[]'::jsonb)[m
[32m+[m[32m  );[m
[32m+[m[32mend; $$;[m
[32m+[m[32mrevoke all on function public.global_discovery_search(text,int) from public, anon;[m
[32m+[m[32mgrant execute on function public.global_discovery_search(text,int) to authenticated;[m
[32m+[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32m-- 6) Trust score: never expose another user's detailed score through RPC[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32mcreate or replace function public.nexus_trust_score(p_user_id uuid)[m
[32m+[m[32mreturns integer language plpgsql stable security definer set search_path=public as $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.uid() is null then raise exception 'not_authenticated'; end if;[m
[32m+[m[32m  if p_user_id <> auth.uid() then raise exception 'forbidden'; end if;[m
[32m+[m[32m  return greatest(0, least(100, 50 + coalesce((select sum(weight) from public.nexus_trust_events where subject_id = auth.uid()),0)::integer));[m
[32m+[m[32mend; $$;[m
[32m+[m[32mrevoke all on function public.nexus_trust_score(uuid) from public, anon;[m
[32m+[m[32mgrant execute on function public.nexus_trust_score(uuid) to authenticated;[m
[32m+[m
[32m+[m
[32m+[m[32m-- Harden Story view recording: it must be an actually visible, live story.[m
[32m+[m[32mcreate or replace function public.record_story_view(p_story_id uuid)[m
[32m+[m[32mreturns void language plpgsql security definer set search_path = public as $$[m
[32m+[m[32mdeclare uid uuid := auth.uid();[m
[32m+[m[32mbegin[m
[32m+[m[32m  if uid is null then raise exception 'not_authenticated'; end if;[m
[32m+[m[32m  if not exists ([m
[32m+[m[32m    select 1 from public.stories s[m
[32m+[m[32m    where s.id = p_story_id and s.deleted_at is null and s.expires_at > now()[m
[32m+[m[32m      and ([m
[32m+[m[32m        s.author_id = uid or s.visibility = 'public'[m
[32m+[m[32m        or (s.visibility = 'followers' and exists ([m
[32m+[m[32m          select 1 from public.follows f where f.follower_id = uid and f.followed_id = s.author_id and f.status = 'accepted'))[m
[32m+[m[32m        or (s.visibility = 'close_friends' and exists ([m
[32m+[m[32m          select 1 from public.story_close_friends cf where cf.owner_id = s.author_id and cf.member_id = uid))[m
[32m+[m[32m      )[m
[32m+[m[32m  ) then raise exception 'forbidden'; end if;[m
[32m+[m[32m  insert into public.story_views(story_id, viewer_id) values (p_story_id, uid)[m
[32m+[m[32m  on conflict (story_id, viewer_id) do update set viewed_at = now();[m
[32m+[m[32mend; $$;[m
[32m+[m[32mrevoke all on function public.record_story_view(uuid) from public, anon;[m
[32m+[m[32mgrant execute on function public.record_story_view(uuid) to authenticated;[m
[32m+[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32m-- 7) Message pins: must be a participant and the actor must own the pin[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32mdrop policy if exists message_pins_write on public.message_pins;[m
[32m+[m[32mcreate policy message_pins_write[m
[32m+[m[32mon public.message_pins[m
[32m+[m[32mfor all to authenticated[m
[32m+[m[32musing ([m
[32m+[m[32m  pinned_by = auth.uid()[m
[32m+[m[32m  and exists ([m
[32m+[m[32m    select 1 from public.messages m[m
[32m+[m[32m    join public.conversations c on c.id = m.conversation_id[m
[32m+[m[32m    where m.id = message_id and (c.user1_id = auth.uid() or c.user2_id = auth.uid())[m
[32m+[m[32m  )[m
[32m+[m[32m)[m
[32m+[m[32mwith check ([m
[32m+[m[32m  pinned_by = auth.uid()[m
[32m+[m[32m  and exists ([m
[32m+[m[32m    select 1 from public.messages m[m
[32m+[m[32m    join public.conversations c on c.id = m.conversation_id[m
[32m+[m[32m    where m.id = message_id and (c.user1_id = auth.uid() or c.user2_id = auth.uid())[m
[32m+[m[32m  )[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32m-- 8) Server-owned financial/audit tables: clients may read only their own[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32mrevoke insert, update, delete on public.creator_earnings from anon, authenticated;[m
[32m+[m[32mrevoke insert, update, delete on public.creator_revenue_events from anon, authenticated;[m
[32m+[m[32mrevoke insert, update, delete on public.observability_events from anon, authenticated;[m
[32m+[m[32mrevoke insert, update, delete on public.security_events from anon, authenticated;[m
[32m+[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
[32m+[m[32m-- 9) Bounds on user-controlled fields that can be abused for storage/DoS[m
[32m+[m[32m-- ---------------------------------------------------------------------------[m
