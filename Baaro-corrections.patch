[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0039_canonical_identity_unique.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO 041: identité canonique unique + identifiant public unique[m
[32m+[m[32m--[m
[32m+[m[32m-- Règle définitive :[m
[32m+[m[32m--   auth.users.id = profiles.id = wallets.id[m
[32m+[m[32m--   => un seul UUID canonique pour l'identité d'un compte.[m
[32m+[m[32m--[m
[32m+[m[32m-- Les colonnes user_id des tables relationnelles restent des FK vers profiles.id.[m
[32m+[m[32m-- Elles ne sont PAS des identifiants concurrents : elles désignent l'utilisateur[m
[32m+[m[32m-- associé à une ligne de relation (like, vote, membre, notification, etc.).[m
[32m+[m
[32m+[m[32mDO $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF to_regclass('public.profiles') IS NOT NULL THEN[m
[32m+[m[32m    -- L'identité technique BAARO est exactement auth.users.id.[m
[32m+[m[32m    ALTER TABLE public.profiles[m
[32m+[m[32m      ALTER COLUMN id SET NOT NULL;[m
[32m+[m
[32m+[m[32m    ALTER TABLE public.profiles[m
[32m+[m[32m      DROP CONSTRAINT IF EXISTS profiles_id_fkey;[m
[32m+[m[32m    ALTER TABLE public.profiles[m
[32m+[m[32m      ADD CONSTRAINT profiles_id_fkey[m
[32m+[m[32m      FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE;[m
[32m+[m
[32m+[m[32m    -- Chaque compte doit avoir un identifiant public unique.[m
[32m+[m[32m    -- Les anciens profils sans handle reçoivent un identifiant déterministe.[m
[32m+[m[32m    UPDATE public.profiles[m
[32m+[m[32m       SET handle = '@user_' || replace(left(id::text, 12), '-', '')[m
[32m+[m[32m     WHERE handle IS NULL OR length(trim(handle)) = 0;[m
[32m+[m
[32m+[m[32m    -- Normalisation minimale des handles existants.[m
[32m+[m[32m    UPDATE public.profiles[m
[32m+[m[32m       SET handle = lower(trim(handle))[m
[32m+[m[32m     WHERE handle IS NOT NULL[m
[32m+[m[32m       AND handle <> lower(trim(handle));[m
[32m+[m
[32m+[m[32m    -- Un seul handle, insensible à la casse.[m
[32m+[m[32m    DROP INDEX IF EXISTS public.profiles_handle_unique;[m
[32m+[m[32m    CREATE UNIQUE INDEX profiles_handle_unique[m
[32m+[m[32m      ON public.profiles (lower(handle));[m
[32m+[m
[32m+[m[32m    ALTER TABLE public.profiles[m
[32m+[m[32m      ALTER COLUMN handle SET NOT NULL;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  IF to_regclass('public.wallets') IS NOT NULL THEN[m
[32m+[m[32m    ALTER TABLE public.wallets ALTER COLUMN id SET NOT NULL;[m
[32m+[m[32m    ALTER TABLE public.wallets DROP CONSTRAINT IF EXISTS wallets_id_fkey;[m
[32m+[m[32m    ALTER TABLE public.wallets[m
[32m+[m[32m      ADD CONSTRAINT wallets_id_fkey[m
[32m+[m[32m      FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE;[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- Vérification finale : aucune table d'identité ne doit avoir user_id.[m
[32m+[m[32mDO $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  t text;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  FOREACH t IN ARRAY ARRAY['profiles','wallets'] LOOP[m
[32m+[m[32m    IF EXISTS ([m
[32m+[m[32m      SELECT 1[m
[32m+[m[32m      FROM information_schema.columns[m
[32m+[m[32m      WHERE table_schema = 'public'[m
[32m+[m[32m        AND table_name = t[m
[32m+[m[32m        AND column_name = 'user_id'[m
[32m+[m[32m    ) THEN[m
[32m+[m[32m      RAISE EXCEPTION 'BAARO: %.user_id interdit — utiliser %.id', t, t;[m
[32m+[m[32m    END IF;[m
[32m+[m[32m  END LOOP;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32mCOMMENT ON COLUMN public.profiles.id IS[m
[32m+[m[32m  'Identifiant technique canonique unique BAARO = auth.users.id';[m
[32m+[m[32mCOMMENT ON COLUMN public.profiles.handle IS[m
[32m+[m[32m  'Identifiant public unique BAARO, insensible à la casse';[m
[32m+[m
[32m+[m[32m-- Recréer le trigger d'inscription avec profiles.id (et non profiles.user_id).[m
[32m+[m
[32m+[m[32m-- Recréer le trigger d'inscription avec profiles.id et un fallback handle garanti unique.[m
[32m+[m[32mCREATE OR REPLACE FUNCTION public.handle_new_user()[m
[32m+[m[32mRETURNS trigger[m
[32m+[m[32mLANGUAGE plpgsql[m
[32m+[m[32mSECURITY DEFINER[m
[32m+[m[32mSET search_path = public[m
[32m+[m[32mAS $$[m
[32m+[m[32mDECLARE[m
[32m+[m[32m  base_name text;[m
[32m+[m[32m  base_handle text;[m
[32m+[m[32m  fallback_handle text;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  base_name := coalesce([m
[32m+[m[32m    nullif(new.raw_user_meta_data ->> 'display_name', ''),[m
[32m+[m[32m    nullif(new.raw_user_meta_data ->> 'full_name', ''),[m
[32m+[m[32m    nullif(new.raw_user_meta_data ->> 'name', ''),[m
[32m+[m[32m    nullif(split_part(coalesce(new.email, ''), '@', 1), ''),[m
[32m+[m[32m    nullif(new.phone, ''),[m
[32m+[m[32m    'Membre BAARO'[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m  base_handle := lower(trim(coalesce([m
[32m+[m[32m    nullif(new.raw_user_meta_data ->> 'handle', ''),[m
[32m+[m[32m    '@user_' || substr(replace(new.id::text, '-', ''), 1, 8)[m
[32m+[m[32m  )));[m
[32m+[m[32m  IF left(base_handle, 1) <> '@' THEN[m
[32m+[m[32m    base_handle := '@' || base_handle;[m
[32m+[m[32m  END IF;[m
[32m+[m[32m  base_handle := left(base_handle, 40);[m
[32m+[m[32m  fallback_handle := '@user_' || substr(replace(new.id::text, '-', ''), 1, 12);[m
[32m+[m
[32m+[m[32m  BEGIN[m
[32m+[m[32m    INSERT INTO public.profiles (id, display_name, handle, flag)[m
[32m+[m[32m    VALUES (new.id, left(base_name, 80), base_handle, '🌍')[m
[32m+[m[32m    ON CONFLICT (id) DO NOTHING;[m
[32m+[m[32m  EXCEPTION WHEN unique_violation THEN[m
[32m+[m[32m    INSERT INTO public.profiles (id, display_name, handle, flag)[m
[32m+[m[32m    VALUES (new.id, left(base_name, 80), fallback_handle, '🌍')[m
[32m+[m[32m    ON CONFLICT (id) DO NOTHING;[m
[32m+[m[32m  END;[m
[32m+[m
[32m+[m[32m  RETURN new;[m
[32m+[m[32mEND;[m
[32m+[m[32m$$;[m
[32m+[m
[32m+[m[32mDROP TRIGGER IF EXISTS on_auth_user_created ON auth.users;[m
[32m+[m[32mCREATE TRIGGER on_auth_user_created[m
[32m+[m[32mAFTER INSERT ON auth.users[m
[32m+[m[32mFOR EACH ROW EXECUTE PROCEDURE public.handle_new_user();[m
[32m+[m
[32m+[m[32m-- Réparer les comptes créés avant l'activation du trigger canonique.[m
[32m+[m[32mINSERT INTO public.profiles (id, display_name, handle, flag)[m
[32m+[m[32mSELECT[m
[32m+[m[32m  u.id,[m
[32m+[m[32m  left(coalesce([m
[32m+[m[32m    nullif(u.raw_user_meta_data ->> 'display_name', ''),[m
[32m+[m[32m    nullif(u.raw_user_meta_data ->> 'full_name', ''),[m
[32m+[m[32m    nullif(u.raw_user_meta_data ->> 'name', ''),[m
[32m+[m[32m    nullif(split_part(coalesce(u.email, ''), '@', 1), ''),[m
[32m+[m[32m    nullif(u.phone, ''),[m
[32m+[m[32m    'Membre BAARO'[m
[32m+[m[32m  ), 80),[m
[32m+[m[32m  left('@user_' || substr(replace(u.id::text, '-', ''), 1, 12), 40),[m
[32m+[m[32m  '🌍'[m
[32m+[m[32mFROM auth.users u[m
[32m+[m[32mLEFT JOIN public.profiles p ON p.id = u.id[m
[32m+[m[32mWHERE p.id IS NULL;[m
[32m+[m
[32m+[m
