[32m+[m[32m-- SOURCE: 0019_live_integrity_realtime.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO 2.0 v12 — Live/Debates integrity, role requests and realtime[m
[32m+[m[32m-- Execute after 017_messaging_calls_integrity.sql.[m
[32m+[m
[32m+[m[32m-- 1. Normalize role request schema used by the current API/UI.[m
[32m+[m[32malter table public.debate_role_requests[m
[32m+[m[32m  add column if not exists from_user_id uuid references auth.users(id) on delete cascade;[m
[32m+[m[32malter table public.debate_role_requests[m
[32m+[m[32m  add column if not exists to_user_id uuid references auth.users(id) on delete cascade;[m
[32m+[m[32malter table public.debate_role_requests[m
[32m+[m[32m  add column if not exists responded_at timestamptz;[m
[32m+[m
[32m+[m[32m-- Keep legacy user_id as a compatibility alias for installations created by 011.[m
[32m+[m[32malter table public.debate_role_requests alter column user_id drop not null;[m
[32m+[m
[32m+[m[32m-- Backfill legacy rows when the old schema had only user_id.[m
[32m+[m[32mupdate public.debate_role_requests r[m
[32m+[m[32mset to_user_id = coalesce(r.to_user_id, r.user_id)[m
[32m+[m[32mwhere r.to_user_id is null and r.user_id is not null;[m
[32m+[m
[32m+[m[32mupdate public.debate_role_requests r[m
[32m+[m[32mset user_id = coalesce(r.user_id, r.to_user_id),[m
[32m+[m[32m    from_user_id = coalesce(r.from_user_id, dr.host_id)[m
[32m+[m[32mfrom public.debate_rooms dr[m
[32m+[m[32mwhere r.room_id = dr.id and r.from_user_id is null;[m
[32m+[m
[32m+[m[32m-- Current API statuses are pending/accepted/refused/cancelled.[m
[32m+[m[32malter table public.debate_role_requests drop constraint if exists debate_role_requests_status_check;[m
[32m+[m[32malter table public.debate_role_requests[m
[32m+[m[32m  add constraint debate_role_requests_status_check[m
[32m+[m[32m  check (status in ('pending','accepted','refused','cancelled','approved','rejected'));[m
[32m+[m
[32m+[m[32mcreate unique index if not exists uq_role_request_pending_target[m
[32m+[m[32m  on public.debate_role_requests(room_id, to_user_id)[m
[32m+[m[32m  where status = 'pending';[m
[32m+[m[32mcreate index if not exists idx_role_requests_target_status[m
[32m+[m[32m  on public.debate_role_requests(to_user_id, status, created_at desc);[m
[32m+[m
[32m+[m[32malter table public.debate_role_requests enable row level security;[m
[32m+[m[32mdrop policy if exists role_requests_read on public.debate_role_requests;[m
[32m+[m[32mcreate policy role_requests_read on public.debate_role_requests[m
[32m+[m[32m  for select using ([m
[32m+[m[32m    auth.uid() = to_user_id[m
[32m+[m[32m    or auth.uid() = from_user_id[m
[32m+[m[32m    or exists (select 1 from public.debate_rooms r where r.id = debate_role_requests.room_id and r.host_id = auth.uid())[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32mdrop policy if exists role_requests_insert on public.debate_role_requests;[m
[32m+[m[32mcreate policy role_requests_insert on public.debate_role_requests[m
[32m+[m[32m  for insert with check ([m
[32m+[m[32m    auth.uid() = from_user_id[m
[32m+[m[32m    and exists ([m
[32m+[m[32m      select 1 from public.debate_rooms r[m
[32m+[m[32m      where r.id = room_id and r.host_id = auth.uid() and r.status = 'active'[m
[32m+[m[32m    )[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32m-- Server-only mutation: prevents a client from changing status/target directly.[m
[32m+[m[32mdrop policy if exists role_requests_update on public.debate_role_requests;[m
[32m+[m[32mcreate policy role_requests_update on public.debate_role_requests[m
[32m+[m[32m  for update using (auth.role() = 'service_role')[m
[32m+[m[32m  with check (auth.role() = 'service_role');[m
[32m+[m
[32m+[m[32m-- 2. Atomic join with row lock to prevent concurrent capacity bypass.[m
[32m+[m[32mcreate or replace function public.join_debate_room(p_room_id uuid, p_user_id uuid)[m
[32m+[m[32mreturns jsonb[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  room public.debate_rooms%rowtype;[m
[32m+[m[32m  participant public.debate_participants%rowtype;[m
[32m+[m[32m  active_count integer;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if p_room_id is null or p_user_id is null then raise exception 'INVALID_JOIN_REQUEST'; end if;[m
[32m+[m
[32m+[m[32m  select * into room from public.debate_rooms where id = p_room_id for update;[m
[32m+[m[32m  if not found or room.status not in ('active','paused') then raise exception 'LIVE_NOT_FOUND'; end if;[m
[32m+[m
[32m+[m[32m  select * into participant[m
[32m+[m[32m  from public.debate_participants[m
[32m+[m[32m  where room_id = p_room_id and user_id = p_user_id[m
[32m+[m[32m  for update;[m
[32m+[m
[32m+[m[32m  if found then[m
[32m+[m[32m    update public.debate_participants set left_at = null, joined_at = now()[m
[32m+[m[32m    where room_id = p_room_id and user_id = p_user_id;[m
[32m+[m[32m  else[m
[32m+[m[32m    select count(*) into active_count from public.debate_participants[m
[32m+[m[32m    where room_id = p_room_id and left_at is null;[m
[32m+[m[32m    if active_count >= room.max_participants then raise exception 'LIVE_FULL'; end if;[m
[32m+[m
[32m+[m[32m    insert into public.debate_participants(room_id,user_id,role)[m
[32m+[m[32m    values (p_room_id,p_user_id,case when room.host_id = p_user_id then 'host' else 'viewer' end);[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  select * into participant from public.debate_participants[m
[32m+[m[32m  where room_id = p_room_id and user_id = p_user_id;[m
[32m+[m
[32m+[m[32m  return jsonb_build_object([m
[32m+[m[32m    'room_id', room.id,[m
[32m+[m[32m    'daily_room_name', room.daily_room_name,[m
[32m+[m[32m    'host_id', room.host_id,[m
[32m+[m[32m    'status', room.status,[m
[32m+[m[32m    'max_participants', room.max_participants,[m
[32m+[m[32m    'role', participant.role[m
[32m+[m[32m  );[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m[32mrevoke all on function public.join_debate_room(uuid,uuid) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.join_debate_room(uuid,uuid) to service_role;[m
[32m+[m
[32m+[m[32m-- 3. Secure join-by-code: authenticated users only, uppercase comparison, locked capacity.[m
[32m+[m[32mcreate or replace function public.join_debate_by_code(p_code text)[m
[32m+[m[32mreturns public.debate_rooms[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_room public.debate_rooms;[m
[32m+[m[32m  v_count int;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.uid() is null then raise exception 'AUTH_REQUIRED'; end if;[m
[32m+[m[32m  select * into v_room from public.debate_rooms[m
[32m+[m[32m  where invite_code = upper(trim(p_code)) and status in ('active','paused')[m
[32m+[m[32m  for update;[m
[32m+[m[32m  if not found then raise exception 'LIVE_NOT_FOUND'; end if;[m
[32m+[m
[32m+[m[32m  if exists (select 1 from public.debate_participants where room_id = v_room.id and user_id = auth.uid()) then[m
[32m+[m[32m    update public.debate_participants set left_at = null, joined_at = now()[m
[32m+[m[32m    where room_id = v_room.id and user_id = auth.uid();[m
[32m+[m[32m    return v_room;[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  select count(*) into v_count from public.debate_participants[m
[32m+[m[32m  where room_id = v_room.id and left_at is null;[m
[32m+[m[32m  if v_count >= v_room.max_participants then raise exception 'LIVE_FULL'; end if;[m
[32m+[m
[32m+[m[32m  insert into public.debate_participants(room_id,user_id,role)[m
[32m+[m[32m  values(v_room.id,auth.uid(),'viewer');[m
[32m+[m[32m  return v_room;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m[32mrevoke all on function public.join_debate_by_code(text) from public, anon;[m
[32m+[m[32mgrant execute on function public.join_debate_by_code(text) to authenticated;[m
[32m+[m
[32m+[m[32m-- 4. Atomic role request response. Only the intended recipient may accept/refuse.[m
[32m+[m[32mcreate or replace function public.respond_debate_role_request([m
[32m+[m[32m  p_request_id uuid,[m
[32m+[m[32m  p_user_id uuid,[m
[32m+[m[32m  p_accept boolean[m
[32m+[m[32m)[m
[32m+[m[32mreturns jsonb[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  req public.debate_role_requests%rowtype;[m
[32m+[m[32m  room public.debate_rooms%rowtype;[m
[32m+[m[32m  participant public.debate_participants%rowtype;[m
[32m+[m[32mbegin[m
[32m+[m[32m  select * into req from public.debate_role_requests where id = p_request_id for update;[m
[32m+[m[32m  if not found or req.status <> 'pending' then raise exception 'ROLE_REQUEST_NOT_FOUND'; end if;[m
[32m+[m[32m  if req.to_user_id <> p_user_id then raise exception 'ROLE_REQUEST_FORBIDDEN'; end if;[m
[32m+[m
[32m+[m[32m  select * into room from public.debate_rooms where id = req.room_id for update;[m
[32m+[m[32m  if not found or room.status <> 'active' then[m
[32m+[m[32m    update public.debate_role_requests set status='cancelled', responded_at=now() where id=req.id;[m
[32m+[m[32m    raise exception 'LIVE_NOT_FOUND';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  if not p_accept then[m
[32m+[m[32m    update public.debate_role_requests set status='refused', responded_at=now() where id=req.id;[m
[32m+[m[32m    return jsonb_build_object('status','refused','daily_room_name',room.daily_room_name);[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  select * into participant from public.debate_participants[m
[32m+[m[32m  where room_id=req.room_id and user_id=p_user_id and left_at is null for update;[m
[32m+[m[32m  if not found then raise exception 'ROLE_REQUEST_FORBIDDEN'; end if;[m
[32m+[m
[32m+[m[32m  update public.debate_participants set role='co_host'[m
[32m+[m[32m  where room_id=req.room_id and user_id=p_user_id;[m
[32m+[m[32m  update public.debate_role_requests set status='accepted', responded_at=now() where id=req.id;[m
[32m+[m
[32m+[m[32m  return jsonb_build_object('status','accepted','role','co_host','daily_room_name',room.daily_room_name);[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m[32mrevoke all on function public.respond_debate_role_request(uuid,uuid,boolean) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.respond_debate_role_request(uuid,uuid,boolean) to service_role;[m
[32m+[m
[32m+[m[32m-- 5. Prevent direct client role-request insertion/update through old permissive policies.[m
[32m+[m[32mdrop policy if exists role_requests_insert on public.debate_role_requests;[m
[32m+[m[32mdrop policy if exists role_requests_update on public.debate_role_requests;[m
[32m+[m
[32m+[m[32m-- 6. Realtime for live gifts/roles.[m
[32m+[m[32mdo $$ begin alter publication supabase_realtime add table public.gifts_sent; exception when duplicate_object then null; end $$;[m
[32m+[m[32mdo $$ begin alter publication supabase_realtime add table public.debate_role_requests; exception when duplicate_object then null; end $$;[m
[32m+[m
[32m+[m[32m-- 7. Gift feed is visible only to participants of the room or the sender/recipient.[m
[32m+[m[32mdrop policy if exists gifts_sent_public_read on public.gifts_sent;[m
[32m+[m[32mcreate policy gifts_sent_read_participants on public.gifts_sent for select using ([m
[32m+[m[32m  auth.uid() = from_user_id or auth.uid() = to_user_id or exists ([m
[32m+[m[32m    select 1 from public.debate_participants dp[m
[32m+[m[32m    where dp.room_id = gifts_sent.room_id and dp.user_id = auth.uid() and dp.left_at is null[m
[32m+[m[32m  )[m
[32m+[m[32m);[m
