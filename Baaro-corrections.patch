[32m+[m[32mbegin[m
[32m+[m[32m  if auth.role() <> 'service_role' then raise exception 'SERVICE_ROLE_REQUIRED'; end if;[m
[32m+[m[32m  select * into i from public.monetization_checkout_intents where id=p_intent_id for update;[m
[32m+[m[32m  if not found then raise exception 'CHECKOUT_NOT_FOUND'; end if;[m
[32m+[m[32m  if i.status='paid' then return true; end if;[m
[32m+[m[32m  if i.status not in ('pending','processing') then raise exception 'CHECKOUT_NOT_PAYABLE'; end if;[m
[32m+[m[32m  if i.expires_at <= now() then raise exception 'CHECKOUT_EXPIRED'; end if;[m
[32m+[m
[32m+[m[32m  select metadata into product_meta from public.monetization_products where code=i.product_code and active=true;[m
[32m+[m[32m  if product_meta is null then raise exception 'PRODUCT_NOT_FOUND'; end if;[m
[32m+[m
[32m+[m[32m  update public.monetization_checkout_intents[m
[32m+[m[32m     set status='paid', provider=p_provider, provider_reference=p_provider_reference, updated_at=now()[m
[32m+[m[32m   where id=i.id;[m
[32m+[m
[32m+[m[32m  if i.product_code='premium_monthly' then[m
[32m+[m[32m    now_end:=now()+interval '30 days';[m
[32m+[m[32m    insert into public.premium_subscriptions(user_id,status,provider,provider_reference,current_period_start,current_period_end)[m
[32m+[m[32m    values(i.user_id,'active',p_provider,p_provider_reference,now(),now_end)[m
