[32m+[m[32mFROM public.poll_options po[m
[32m+[m[32mLEFT JOIN public.poll_votes pv ON po.id = pv.option_id[m
[32m+[m[32mGROUP BY po.poll_id, po.id, po.option_text, po.position;[m
