[32m+[m[32m-- One authenticated view per video per user per UTC day. The client may call[m
[32m+[m[32m-- register_video_view repeatedly; the unique constraint makes it idempotent.[m
[32m+[m[32mcreate table if not exists public.video_views ([m
[32m+[m[32m  video_id uuid not null references public.videos(id) on delete cascade,[m
[32m+[m[32m  viewer_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  view_date date not null default current_date,[m
[32m+[m[32m  viewed_at timestamptz not null default now(),[m
[32m+[m[32m  primary key (video_id, viewer_id, view_date)[m
[32m+[m[32m);[m
[32m+[m
