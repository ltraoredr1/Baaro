[32m+[m[32m-- Suivre / désuivre. La cible est toujours auth.users.id.[m
[32m+[m[32mcreate or replace function public.toggle_follow(p_target uuid)[m
[32m+[m[32mreturns boolean language plpgsql security definer set search_path=public,auth as $$[m
[32m+[m[32mdeclare me uuid:=auth.uid(); following boolean;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if me is null then raise exception 'NOT_AUTHENTICATED'; end if;[m
[32m+[m[32m  if p_target is null or p_target=me then raise exception 'INVALID_TARGET'; end if;[m
[32m+[m[32m  if not exists(select 1 from auth.users where id=p_target) then raise exception 'USER_NOT_FOUND'; end if;[m
[32m+[m[32m  select exists(select 1 from public.follows where follower_id=me and followed_id=p_target and status='accepted') into following;[m
[32m+[m[32m  if following then delete from public.follows where follower_id=me and followed_id=p_target; return false; end if;[m
[32m+[m[32m  insert into public.follows(follower_id,followed_id,status,is_friend) values(me,p_target,'accepted',false)[m
[32m+[m[32m    on conflict(follower_id,followed_id) do update set status='accepted',is_friend=false;[m
[32m+[m[32m  return true;[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.toggle_follow(uuid) from public;[m
[32m+[m[32mgrant execute on function public.toggle_follow(uuid) to authenticated;[m
