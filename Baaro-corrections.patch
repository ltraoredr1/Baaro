[32m+[m[32mcreate or replace function public.record_economy_event([m
[32m+[m[32m  p_idempotency_key text,[m
[32m+[m[32m  p_creator_id uuid,[m
[32m+[m[32m  p_source text,[m
[32m+[m[32m  p_gross_minor bigint,[m
[32m+[m[32m  p_provider_fee_minor bigint default 0,[m
[32m+[m[32m  p_currency text default 'XOF',[m
[32m+[m[32m  p_reference_id uuid default null,[m
[32m+[m[32m  p_metadata jsonb default '{}'::jsonb[m
[32m+[m[32m) returns uuid[m
[32m+[m[32mlanguage plpgsql security definer set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_id uuid; v_net bigint; v_creator bigint; v_share integer;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.role() <> 'service_role' then raise exception 'SERVICE_ROLE_REQUIRED'; end if;[m
[32m+[m[32m  if p_gross_minor <= 0 or p_provider_fee_minor < 0 or p_provider_fee_minor > p_gross_minor then raise exception 'INVALID_AMOUNT'; end if;[m
[32m+[m[32m  select creator_share_bps into v_share from public.economy_policies where source=lower(p_source) and enabled=true;[m
[32m+[m[32m  if v_share is null then raise exception 'ECONOMY_SOURCE_DISABLED'; end if;[m
[32m+[m[32m  select id into v_id from public.economy_ledger where idempotency_key=p_idempotency_key;[m
[32m+[m[32m  if v_id is not null then return v_id; end if;[m
[32m+[m[32m  perform public.ensure_economy_account(p_creator_id,p_currency);[m
[32m+[m[32m  v_net := p_gross_minor-p_provider_fee_minor;[m
[32m+[m[32m  v_creator := floor((v_net*v_share)::numeric/10000);[m
[32m+[m[32m  if v_creator <= 0 then raise exception 'CREATOR_SHARE_ZERO'; end if;[m
[32m+[m[32m  insert into public.economy_ledger(user_id,entry_type,bucket,direction,source,amount_minor,currency,reference_id,idempotency_key,metadata)[m
[32m+[m[32m  values(p_creator_id,'earning','pending','credit',lower(p_source),v_creator,upper(p_currency),p_reference_id,p_idempotency_key,[m
[32m+[m[32m    coalesce(p_metadata,'{}'::jsonb)||jsonb_build_object('gross_minor',p_gross_minor,'provider_fee_minor',p_provider_fee_minor,'creator_share_bps',v_share))[m
[32m+[m[32m  returning id into v_id;[m
[32m+[m[32m  insert into public.economy_platform_ledger(source,gross_minor,provider_fee_minor,creator_minor,platform_minor,currency,reference_id,idempotency_key,metadata)[m
[32m+[m[32m  values(lower(p_source),p_gross_minor,p_provider_fee_minor,v_creator,v_net-v_creator,upper(p_currency),p_reference_id,p_idempotency_key,coalesce(p_metadata,'{}'::jsonb)||jsonb_build_object('creator_share_bps',v_share));[m
[32m+[m[32m  update public.economy_accounts set pending_minor=pending_minor+v_creator,updated_at=now() where user_id=p_creator_id;[m
[32m+[m[32m  insert into public.creator_revenue_events(creator_id,source,gross_minor,creator_minor,status,metadata)[m
[32m+[m[32m  values(p_creator_id,lower(p_source),p_gross_minor,v_creator,'pending',coalesce(p_metadata,'{}'::jsonb))[m
[32m+[m[32m  on conflict do nothing;[m
[32m+[m[32m  return v_id;[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.record_economy_event(text,uuid,text,bigint,bigint,text,uuid,jsonb) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.record_economy_event(text,uuid,text,bigint,bigint,text,uuid,jsonb) to service_role;[m
[32m+[m
[32m+[m[32mcreate or replace function public.settle_economy_event(p_ledger_id uuid)[m
[32m+[m[32mreturns boolean[m
[32m+[m[32mlanguage plpgsql security definer set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare r public.economy_ledger;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.role() <> 'service_role' then raise exception 'SERVICE_ROLE_REQUIRED'; end if;[m
[32m+[m[32m  select * into r from public.economy_ledger where id=p_ledger_id for update;[m
[32m+[m[32m  if not found then raise exception 'LEDGER_NOT_FOUND'; end if;[m
[32m+[m[32m  if r.entry_type <> 'earning' or r.bucket <> 'pending' or r.direction <> 'credit' then return true; end if;[m
[32m+[m[32m  insert into public.economy_ledger(user_id,entry_type,bucket,direction,source,amount_minor,currency,reference_id,metadata)[m
[32m+[m[32m  values(r.user_id,'settlement','available','credit',r.source,r.amount_minor,r.currency,r.reference_id,jsonb_build_object('from_ledger',r.id));[m
[32m+[m[32m  update public.economy_accounts set pending_minor=pending_minor-r.amount_minor,available_minor=available_minor+r.amount_minor,updated_at=now() where user_id=r.user_id;[m
[32m+[m[32m  update public.economy_ledger set metadata=metadata||jsonb_build_object('settled_at',now()) where id=r.id;[m
[32m+[m[32m  return true;[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.settle_economy_event(uuid) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.settle_economy_event(uuid) to service_role;[m
