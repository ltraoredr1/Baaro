[32m+[m[32mcreate or replace function public.award_creator_points([m
[32m+[m[32m  p_user_id uuid,[m
[32m+[m[32m  p_source text,[m
[32m+[m[32m  p_points bigint,[m
[32m+[m[32m  p_reference_id uuid default null,[m
[32m+[m[32m  p_idempotency_key text default null,[m
[32m+[m[32m  p_metadata jsonb default '{}'::jsonb[m
[32m+[m[32m) returns bigint[m
[32m+[m[32mlanguage plpgsql security definer set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare current_points bigint; new_points bigint; new_tier text;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.role()<>'service_role' then raise exception 'SERVICE_ROLE_REQUIRED'; end if;[m
[32m+[m[32m  if p_user_id is null or p_points<=0 or p_points>1000000 then raise exception 'INVALID_REWARD'; end if;[m
[32m+[m[32m  if p_idempotency_key is not null and exists(select 1 from public.creator_reward_events where idempotency_key=p_idempotency_key) then[m
[32m+[m[32m    select points into current_points from public.creator_reward_accounts where user_id=p_user_id;[m
[32m+[m[32m    return coalesce(current_points,0);[m
[32m+[m[32m  end if;[m
[32m+[m[32m  insert into public.creator_reward_accounts(user_id) values(p_user_id) on conflict(user_id) do nothing;[m
[32m+[m[32m  insert into public.creator_reward_events(user_id,source,points,reference_id,idempotency_key,metadata)[m
[32m+[m[32m    values(p_user_id,lower(trim(p_source)),p_points,p_reference_id,p_idempotency_key,coalesce(p_metadata,'{}'::jsonb));[m
[32m+[m[32m  update public.creator_reward_accounts set[m
[32m+[m[32m    points=points+p_points,[m
[32m+[m[32m    lifetime_points=lifetime_points+p_points,[m
[32m+[m[32m    updated_at=now()[m
[32m+[m[32m    where user_id=p_user_id[m
[32m+[m[32m    returning points into new_points;[m
[32m+[m[32m  new_tier:=case when new_points>=100000 then 'elite' when new_points>=50000 then 'pro' when new_points>=20000 then 'creator' when new_points>=5000 then 'rising' else 'starter' end;[m
[32m+[m[32m  update public.creator_reward_accounts set tier=new_tier where user_id=p_user_id;[m
[32m+[m[32m  return new_points;[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.award_creator_points(uuid,text,bigint,uuid,text,jsonb) from public,anon,authenticated;[m
[32m+[m[32mgrant execute on function public.award_creator_points(uuid,text,bigint,uuid,text,jsonb) to service_role;[m
[32m+[m
[32m+[m[32mcreate or replace function public.get_creator_rewards_summary()[m
[32m+[m[32mreturns jsonb language sql security definer set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32m  select jsonb_build_object([m
[32m+[m[32m    'points',coalesce(a.points,0),[m
[32m+[m[32m    'lifetime_points',coalesce(a.lifetime_points,0),[m
[32m+[m[32m    'tier',coalesce(a.tier,'starter'),[m
[32m+[m[32m    'next_tier',case when coalesce(a.points,0)<5000 then 'rising' when a.points<20000 then 'creator' when a.points<50000 then 'pro' when a.points<100000 then 'elite' else 'max' end,[m
[32m+[m[32m    'next_threshold',case when coalesce(a.points,0)<5000 then 5000 when a.points<20000 then 20000 when a.points<50000 then 50000 when a.points<100000 then 100000 else 100000 end[m
[32m+[m[32m  ) from (select auth.uid() as uid) u left join public.creator_reward_accounts a on a.user_id=u.uid;[m
[32m+[m[32m$$;[m
[32m+[m[32mrevoke all on function public.get_creator_rewards_summary() from public,anon;[m
[32m+[m[32mgrant execute on function public.get_creator_rewards_summary() to authenticated;[m
