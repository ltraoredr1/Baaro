[32m+[m[32m-- Atomic referral application. The unique referred_id constraint plus the profile update[m
[32m+[m[32m-- happen in the same transaction as both wallet credits.[m
[32m+[m[32mcreate or replace function public.apply_referral_reward([m
[32m+[m[32m  p_referrer_id uuid,[m
[32m+[m[32m  p_referred_id uuid,[m
[32m+[m[32m  p_code text,[m
[32m+[m[32m  p_referrer_pts numeric default 25,[m
[32m+[m[32m  p_referred_pts numeric default 15[m
[32m+[m[32m)[m
[32m+[m[32mreturns jsonb[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path = public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  reward public.referral_rewards%rowtype;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if p_referrer_id is null or p_referred_id is null or p_referrer_id = p_referred_id then[m
[32m+[m[32m    raise exception 'INVALID_REFERRAL';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  update public.profiles[m
[32m+[m[32m    set referred_by = p_referrer_id[m
[32m+[m[32m  where id = p_referred_id and referred_by is null;[m
[32m+[m[32m  if not found then raise exception 'REFERRAL_ALREADY_APPLIED'; end if;[m
[32m+[m
[32m+[m[32m  if not exists (select 1 from public.profiles where id = p_referrer_id and referral_code = upper(trim(p_code))) then[m
[32m+[m[32m    raise exception 'INVALID_REFERRAL_CODE';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  insert into public.referral_rewards(referrer_id, referred_id, pts_referrer, pts_referred)[m
[32m+[m[32m  values (p_referrer_id, p_referred_id, p_referrer_pts, p_referred_pts)[m
[32m+[m[32m  returning * into reward;[m
[32m+[m
[32m+[m[32m  perform public.wallet_earn(p_referrer_id, p_referrer_pts, 'Parrainage — filleul inscrit', 'referral_referrer', 100, false);[m
[32m+[m[32m  perform public.wallet_earn(p_referred_id, p_referred_pts, 'Bonus code parrainage ' || upper(trim(p_code)), 'referral_referred', 100, false);[m
[32m+[m
[32m+[m[32m  return jsonb_build_object('reward', to_jsonb(reward));[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
[32m+[m[32mrevoke all on function public.apply_referral_reward(uuid, uuid, text, numeric, numeric) from public, anon, authenticated;[m
[32m+[m[32mgrant execute on function public.apply_referral_reward(uuid, uuid, text, numeric, numeric) to service_role;[m
