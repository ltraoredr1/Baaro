[32m+[m[32mcreate or replace function public.create_community_channel([m
[32m+[m[32m  p_group_id uuid,[m
[32m+[m[32m  p_name text,[m
[32m+[m[32m  p_type text default 'text',[m
[32m+[m[32m  p_description text default null[m
[32m+[m[32m)[m
[32m+[m[32mreturns public.channels[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_name text;[m
[32m+[m[32m  v_type text;[m
[32m+[m[32m  v_channel public.channels;[m
[32m+[m[32m  v_role text := public.group_role(p_group_id);[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.uid() is null then[m
[32m+[m[32m    raise exception 'Non authentifié';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  if coalesce(v_role, '') not in ('owner', 'admin') then[m
[32m+[m[32m    raise exception 'Seuls les admins peuvent créer un canal';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  v_type := case[m
[32m+[m[32m    when p_type in ('voice', 'announce') then p_type[m
[32m+[m[32m    else 'text'[m
[32m+[m[32m  end;[m
[32m+[m
[32m+[m[32m  v_name := lower(regexp_replace(trim(coalesce(p_name, '')), '\s+', '-', 'g'));[m
[32m+[m[32m  v_name := regexp_replace([m
[32m+[m[32m    v_name,[m
[32m+[m[32m    '[<>"''`&/\\?#%@:;,.!$^*()+=\[\]{}|~]',[m
[32m+[m[32m    '',[m
[32m+[m[32m    'g'[m
[32m+[m[32m  );[m
[32m+[m[32m  v_name := left(v_name, 40);[m
[32m+[m
[32m+[m[32m  if length(v_name) < 1 then[m
[32m+[m[32m    raise exception 'Nom de canal invalide';[m
[32m+[m[32m  end if;[m
[32m+[m
[32m+[m[32m  insert into public.channels (group_id, name, type, description)[m
[32m+[m[32m  values ([m
[32m+[m[32m    p_group_id,[m
[32m+[m[32m    v_name,[m
[32m+[m[32m    v_type,[m
[32m+[m[32m    nullif(left(trim(coalesce(p_description, '')), 200), '')[m
[32m+[m[32m  )[m
[32m+[m[32m  returning * into v_channel;[m
[32m+[m
[32m+[m[32m  return v_channel;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
