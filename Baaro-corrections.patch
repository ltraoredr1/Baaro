[32m+[m[32mcreate or replace function public.report_community_message([m
[32m+[m[32m  p_message uuid,[m
[32m+[m[32m  p_reason text default null[m
[32m+[m[32m)[m
[32m+[m[32mreturns void[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  v_group uuid;[m
[32m+[m[32mbegin[m
[32m+[m[32m  select c.group_id into v_group[m
[32m+[m[32m  from public.channel_messages m[m
