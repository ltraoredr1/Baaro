[32m+[m[32m  values ([m
[32m+[m[32m    p_group,[m
[32m+[m[32m    v_code,[m
[32m+[m[32m    v_uid,[m
[32m+[m[32m    greatest(coalesce(p_max_uses, 0), 0),[m
[32m+[m[32m    case[m
[32m+[m[32m      when p_expires_hours is null or p_expires_hours <= 0 then null[m
[32m+[m[32m      else now() + (p_expires_hours || ' hours')::interval[m
[32m+[m[32m    end[m
[32m+[m[32m  )[m
[32m+[m[32m  returning * into v_row;[m
[32m+[m
[32m+[m[32m  return v_row;[m
[32m+[m[32mend;[m
[32m+[m[32m$$;[m
