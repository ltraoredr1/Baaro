[32m+[m
[32m+[m[32m-- FINAL MONEY HARDENING: payout request must execute server-side with the caller identity.[m
[32m+[m[32m-- SECURITY DEFINER is safe here because auth.uid() is captured before privileged writes,[m
[32m+[m[32m-- search_path is fixed, and every authorization/KYC/risk/amount check remains explicit.[m
[32m+[m[32mcreate or replace function public.request_economy_payout([m
[32m+[m[32m  p_amount_minor bigint,[m
[32m+[m[32m  p_method text,[m
[32m+[m[32m  p_destination_token text default null[m
[32m+[m[32m) returns uuid[m
[32m+[m[32mlanguage plpgsql[m
[32m+[m[32msecurity definer[m
[32m+[m[32mset search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare[m
[32m+[m[32m  uid uuid := auth.uid();[m
[32m+[m[32m  a public.economy_accounts;[m
[32m+[m[32m  p uuid;[m
[32m+[m[32m  min_cash bigint;[m
[32m+[m[32m  k public.creator_payout_profiles;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if uid is null then raise exception 'AUTH_REQUIRED'; end if;[m
[32m+[m[32m  if p_amount_minor <= 0 then raise exception 'INVALID_AMOUNT'; end if;[m
[32m+[m[32m  if p_method not in ('mobile_money','bank_transfer') then raise exception 'INVALID_PAYOUT_METHOD'; end if;[m
[32m+[m[32m  select * into k from public.creator_payout_profiles where user_id=uid for update;[m
[32m+[m[32m  if not found or k.kyc_status <> 'verified' or not k.payout_verified then raise exception 'PAYOUT_KYC_REQUIRED'; end if;[m
[32m+[m[32m  if k.risk_level <> 'normal' then raise exception 'PAYOUT_BLOCKED_FOR_RISK'; end if;[m
[32m+[m[32m  if p_destination_token is null or length(trim(p_destination_token)) < 8 then raise exception 'PAYOUT_DESTINATION_REQUIRED'; end if;[m
[32m+[m[32m  select * into a from public.economy_accounts where user_id=uid for update;[m
[32m+[m[32m  if not found then raise exception 'NO_EARNINGS_ACCOUNT'; end if;[m
[32m+[m[32m  select round(min_cashout*100)::bigint into min_cash from public.creator_monetization where creator_id=uid;[m
[32m+[m[32m  min_cash := coalesce(min_cash,100000);[m
[32m+[m[32m  if p_amount_minor < min_cash then raise exception 'MIN_CASHOUT'; end if;[m
[32m+[m[32m  if p_amount_minor > a.available_minor then raise exception 'INSUFFICIENT_AVAILABLE'; end if;[m
[32m+[m[32m  insert into public.economy_payouts(user_id,amount_minor,currency,method,destination_token)[m
[32m+[m[32m    values(uid,p_amount_minor,a.currency,p_method,nullif(trim(p_destination_token),'')) returning id into p;[m
[32m+[m[32m  insert into public.economy_ledger(user_id,entry_type,bucket,direction,source,amount_minor,currency,reference_id,metadata)[m
[32m+[m[32m    values(uid,'payout_hold','payout_hold','credit','payout',p_amount_minor,a.currency,p,jsonb_build_object('status','reserved'));[m
[32m+[m[32m  update public.economy_accounts[m
[32m+[m[32m    set available_minor=available_minor-p_amount_minor,[m
[32m+[m[32m        payout_hold_minor=payout_hold_minor+p_amount_minor,[m
[32m+[m[32m        updated_at=now()[m
[32m+[m[32m    where user_id=uid;[m
[32m+[m[32m  return p;[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.request_economy_payout(bigint,text,text) from public,anon;[m
[32m+[m[32mgrant execute on function public.request_economy_payout(bigint,text,text) to authenticated;[m
[32m+[m
[32m+[m[32m-- Creator Rewards / Points: non-cash engagement rewards inspired by creator programs.[m
[32m+[m[32m-- Points never represent money, cannot be cashed out, transferred or converted to currency.[m
[32m+[m[32mcreate table if not exists public.creator_reward_accounts ([m
[32m+[m[32m  user_id uuid primary key references auth.users(id) on delete cascade,[m
[32m+[m[32m  points bigint not null default 0 check(points>=0),[m
[32m+[m[32m  lifetime_points bigint not null default 0 check(lifetime_points>=0),[m
[32m+[m[32m  tier text not null default 'starter' check(tier in ('starter','rising','creator','pro','elite')),[m
[32m+[m[32m  updated_at timestamptz not null default now()[m
[32m+[m[32m);[m
[32m+[m[32mcreate table if not exists public.creator_reward_events ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  user_id uuid not null references auth.users(id) on delete cascade,[m
[32m+[m[32m  source text not null,[m
[32m+[m[32m  points bigint not null check(points>0),[m
[32m+[m[32m  reference_id uuid,[m
[32m+[m[32m  idempotency_key text unique,[m
[32m+[m[32m  metadata jsonb not null default '{}'::jsonb,[m
[32m+[m[32m  created_at timestamptz not null default now()[m
[32m+[m[32m);[m
[32m+[m[32mcreate index if not exists idx_creator_reward_events_user_created on public.creator_reward_events(user_id,created_at desc);[m
[32m+[m[32malter table public.creator_reward_accounts enable row level security;[m
[32m+[m[32malter table public.creator_reward_events enable row level security;[m
[32m+[m[32mdrop policy if exists creator_rewards_read_own on public.creator_reward_accounts;[m
[32m+[m[32mcreate policy creator_rewards_read_own on public.creator_reward_accounts for select to authenticated using(user_id=auth.uid());[m
[32m+[m[32mdrop policy if exists creator_reward_events_read_own on public.creator_reward_events;[m
[32m+[m[32mcreate policy creator_reward_events_read_own on public.creator_reward_events for select to authenticated using(user_id=auth.uid());[m
[32m+[m[32mrevoke insert,update,delete on public.creator_reward_accounts from anon,authenticated;[m
[32m+[m[32mrevoke insert,update,delete on public.creator_reward_events from anon,authenticated;[m
