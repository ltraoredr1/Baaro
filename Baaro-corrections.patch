[32m+[m[32mcreate or replace function public.can_post_in_channel(p_channel uuid)[m
[32m+[m[32mreturns boolean[m
[32m+[m[32mlanguage sql stable security definer set search_path = public as $$[m
[32m+[m[32m  select exists ([m
[32m+[m[32m    select 1[m
[32m+[m[32m    from public.channels c[m
[32m+[m[32m    where c.id = p_channel[m
[32m+[m[32m      and public.group_role(c.group_id) is not null[m
[32m+[m[32m      and not public.is_banned(c.group_id, auth.uid())[m
[32m+[m[32m      and ([m
[32m+[m[32m        c.type in ('text', 'voice')[m
[32m+[m[32m        or public.group_role(c.group_id) in ('owner', 'admin', 'moderator')[m
[32m+[m[32m      )[m
[32m+[m[32m  );[m
[32m+[m[32m$$;[m
