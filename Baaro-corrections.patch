[32m+[m[32m-- ÉTAPE 7 : VÉRIFICATION FINALE[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32m-- Afficher un résumé des compteurs après correction[m
[32m+[m[32mSELECT[m[41m [m
[32m+[m[32m  id,[m
[32m+[m[32m  LEFT(title, 30) as title,[m
[32m+[m[32m  COALESCE(views, 0) as views,[m
