[32m+[m[32m-- ==========================================================[m
[32m+[m[32m-- BAARO — Wallet/Crypto feature permanently decommissioned[m
[32m+[m[32m-- ==========================================================[m
[32m+[m[32m-- The product no longer exposes wallet, BARO/crypto balances, or virtual gifts.[m
[32m+[m[32m-- Keep this in the single coordinated migration so a fresh database never[m
[32m+[m[32m-- leaves a live financial surface behind.[m
[32m+[m[32mDO $$[m
[32m+[m[32mDECLARE r record;[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  FOR r IN[m
[32m+[m[32m    SELECT p.oid::regprocedure AS signature[m
[32m+[m[32m    FROM pg_proc p[m
[32m+[m[32m    JOIN pg_namespace n ON n.oid = p.pronamespace[m
[32m+[m[32m    WHERE n.nspname = 'public'[m
[32m+[m[32m      AND (p.proname LIKE 'wallet\_%' OR p.proname LIKE 'gift\_%')[m
[32m+[m[32m  LOOP[m
[32m+[m[32m    EXECUTE 'DROP FUNCTION IF EXISTS ' || r.signature || ' CASCADE';[m
[32m+[m[32m  END LOOP;[m
[32m+[m[32mEND $$;[m
