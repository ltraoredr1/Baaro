[32m+[m[32mcreate or replace function public.get_profile_stats(p_user_id uuid)[m
[32m+[m[32mreturns table(followers bigint, following bigint, friends bigint, posts bigint, likes bigint)[m
[32m+[m[32mlanguage plpgsql security definer set search_path = public as $$[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.uid() is null then raise exception 'AUTH_REQUIRED'; end if;[m
[32m+[m[32m  if p_user_id is null then raise exception 'USER_REQUIRED'; end if;[m
[32m+[m[32m  if not exists (select 1 from public.profiles where id = p_user_id) then raise exception 'PROFILE_NOT_FOUND'; end if;[m
[32m+[m[32m  return query select[m
[32m+[m[32m    (select count(*) from public.follows f where f.followed_id=p_user_id and f.status='accepted'),[m
[32m+[m[32m    (select count(*) from public.follows f where f.follower_id=p_user_id and f.status='accepted'),[m
[32m+[m[32m    (select count(*) from public.follows f where f.followed_id=p_user_id and f.status='accepted' and f.is_friend=true),[m
[32m+[m[32m    (select count(*) from public.posts p where p.author_id=p_user_id),[m
[32m+[m[32m    (select count(*) from public.post_likes l join public.posts p on p.id=l.post_id where p.author_id=p_user_id);[m
[32m+[m[32mend; $$;[m
[32m+[m[32mrevoke all on function public.get_profile_stats(uuid) from public, anon;[m
[32m+[m[32mgrant execute on function public.get_profile_stats(uuid) to authenticated;[m
