[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0044_add_messaging_improvements.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO — Amélioration messagerie (sans régression)[m
[32m+[m[32m-- À exécuter dans Supabase > SQL Editor, après les scripts existants[m
[32m+[m[32m-- ============================================================[m
[32m+[m
[32m+[m[32m-- 1) Statut en ligne / "vu"[m
[32m+[m[32malter table profiles[m
[32m+[m[32m  add column if not exists last_seen_at timestamptz;[m
[32m+[m
[32m+[m[32malter table messages[m
[32m+[m[32m  add column if not exists read_at timestamptz;[m
[32m+[m
[32m+[m[32m-- 2) Modification / suppression de message (soft delete)[m
[32m+[m[32malter table messages[m
[32m+[m[32m  add column if not exists edited_at timestamptz;[m
[32m+[m
[32m+[m[32malter table messages[m
[32m+[m[32m  add column if not exists deleted_at timestamptz;[m
[32m+[m
[32m+[m[32m-- RLS : autoriser l'expéditeur à modifier/supprimer (soft) son propre message[m
[32m+[m[32mdrop policy if exists "messages_update_own" on messages;[m
[32m+[m[32mcreate policy "messages_update_own"[m
[32m+[m[32m  on messages for update[m
[32m+[m[32m  using (auth.uid() = sender_id)[m
[32m+[m[32m  with check (auth.uid() = sender_id);[m
[32m+[m
[32m+[m[32m-- RLS : autoriser un utilisateur à mettre à jour read_at sur les messages[m
[32m+[m[32m-- qu'il reçoit (pour marquer "vu")[m
[32m+[m[32mdrop policy if exists "messages_mark_read" on messages;[m
[32m+[m[32mcreate policy "messages_mark_read"[m
[32m+[m[32m  on messages for update[m
[32m+[m[32m  using (auth.uid() = recipient_id)[m
[32m+[m[32m  with check (auth.uid() = recipient_id);[m
[32m+[m
[32m+[m[32m-- RLS : autoriser chaque utilisateur à mettre à jour son propre last_seen_at[m
[32m+[m[32mdrop policy if exists "profiles_update_last_seen" on profiles;[m
[32m+[m[32mcreate policy "profiles_update_last_seen"[m
[32m+[m[32m  on profiles for update[m
[32m+[m[32m  using (auth.uid() = id)[m
[32m+[m[32m  with check (auth.uid() = id);[m
[32m+[m
[32m+[m[32m-- 3) Réactions sur les messages[m
[32m+[m[32mcreate table if not exists message_reactions ([m
[32m+[m[32m  id uuid primary key default gen_random_uuid(),[m
[32m+[m[32m  message_id uuid not null references messages(id) on delete cascade,[m
[32m+[m[32m  conversation_id uuid not null references conversations(id) on delete cascade,[m
[32m+[m[32m  user_id uuid not null references profiles(id) on delete cascade,[m
[32m+[m[32m  emoji text not null,[m
[32m+[m[32m  created_at timestamptz not null default now(),[m
[32m+[m[32m  unique (message_id, user_id, emoji)[m
[32m+[m[32m);[m
[32m+[m
[32m+[m[32malter table message_reactions enable row level security;[m
[32m+[m
[32m+[m[32mdrop policy if exists "reactions_select_participants" on message_reactions;[m
[32m+[m[32mcreate policy "reactions_select_participants"[m
[32m+[m[32m  on message_reactions for select[m
[32m+[m[32m  using ([m
[32m+[m[32m    exists ([m
[32m+[m[32m      select 1 from conversations c[m
[32m+[m[32m      where c.id = message_reactions.conversation_id[m
[32m+[m[32m        and (c.user1_id = auth.uid() or c.user2_id = auth.uid())[m
[32m+[m[32m    )[m
[32m+[m[32m  );[m
[32m+[m
[32m+[m[32mdrop policy if exists "reactions_insert_own" on message_reactions;[m
[32m+[m[32mcreate policy "reactions_insert_own"[m
[32m+[m[32m  on message_reactions for insert[m
[32m+[m[32m  with check (auth.uid() = id);[m
[32m+[m
[32m+[m[32mdrop policy if exists "reactions_delete_own" on message_reactions;[m
[32m+[m[32mcreate policy "reactions_delete_own"[m
[32m+[m[32m  on message_reactions for delete[m
[32m+[m[32m  using (auth.uid() = id);[m
[32m+[m
[32m+[m[32m-- 4) Activer le Realtime sur les nouvelles tables / colonnes suivies[m
[32m+[m[32m-- (Database > Replication dans Supabase, ou via SQL si la publication existe déjà) :[m
[32m+[m[32malter publication supabase_realtime add table message_reactions;[m
[32m+[m[32malter publication supabase_realtime add table profiles;[m
[32m+[m
[32m+[m[32m-- NB: la table "messages" est déjà en Realtime (utilisée pour les INSERT) ;[m
[32m+[m[32m-- ce script ne fait qu'ajouter les UPDATE nécessaires aux accusés de[m
[32m+[m[32m-- lecture, à l'édition et à la suppression, qui passent par le même canal.[m
[32m+[m
[32m+[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- SOURCE: 0045_device_accounts_id_only.sql[m
[32m+[m[32m-- ============================================================[m
[32m+[m[32m-- BAARO 047: device_accounts — identité = id (auth.users.id), plus de user_id[m
[32m+[m[32m-- Clés étrangères métier (author_id, sender_id, etc.) non concernées.[m
[32m+[m
[32m+[m[32mDO $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m
[32m+[m[32m    WHERE table_schema = 'public'[m
[32m+[m[32m      AND table_name = 'device_accounts'[m
[32m+[m[32m      AND column_name = 'user_id'[m
[32m+[m[32m  ) AND NOT EXISTS ([m
[32m+[m[32m    SELECT 1 FROM information_schema.columns[m
[32m+[m[32m    WHERE table_schema = 'public'[m
[32m+[m[32m      AND table_name = 'device_accounts'[m
[32m+[m[32m      AND column_name = 'id'[m
[32m+[m[32m  ) THEN[m
[32m+[m[32m    ALTER TABLE public.device_accounts RENAME COLUMN user_id TO id;[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND $$;[m
[32m+[m
[32m+[m[32m-- PK (device_id, id)[m
[32m+[m[32mDO $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF to_regclass('public.device_accounts') IS NOT NULL THEN[m
[32m+[m[32m    ALTER TABLE public.device_accounts DROP CONSTRAINT IF EXISTS device_accounts_pkey;[m
[32m+[m[32m    ALTER TABLE public.device_accounts[m
[32m+[m[32m      ALTER COLUMN id SET NOT NULL,[m
[32m+[m[32m      ALTER COLUMN device_id SET NOT NULL;[m
[32m+[m[32m    BEGIN[m
[32m+[m[32m      ALTER TABLE public.device_accounts[m
[32m+[m[32m        ADD PRIMARY KEY (device_id, id);[m
[32m+[m[32m    EXCEPTION WHEN OTHERS THEN[m
[32m+[m[32m      -- déjà en place[m
[32m+[m[32m      NULL;[m
[32m+[m[32m    END;[m
[32m+[m
[32m+[m[32m    ALTER TABLE public.device_accounts DROP CONSTRAINT IF EXISTS device_accounts_id_fkey;[m
[32m+[m[32m    ALTER TABLE public.device_accounts[m
[32m+[m[32m      ADD CONSTRAINT device_accounts_id_fkey[m
[32m+[m[32m      FOREIGN KEY (id) REFERENCES auth.users(id) ON DELETE CASCADE;[m
[32m+[m
[32m+[m[32m    COMMENT ON COLUMN public.device_accounts.id IS[m
[32m+[m[32m      'Identifiant utilisateur = auth.users.id (plus de user_id)';[m
[32m+[m[32m  END IF;[m
[32m+[m[32mEND $$;[m
