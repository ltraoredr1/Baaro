[32m+[m[32mcreate or replace function public.ensure_economy_account(p_user_id uuid, p_currency text default 'XOF')[m
[32m+[m[32mreturns public.economy_accounts[m
[32m+[m[32mlanguage plpgsql security definer set search_path=public[m
[32m+[m[32mas $$[m
[32m+[m[32mdeclare r public.economy_accounts;[m
[32m+[m[32mbegin[m
[32m+[m[32m  if auth.role() <> 'service_role' and auth.uid() is distinct from p_user_id then raise exception 'FORBIDDEN'; end if;[m
[32m+[m[32m  insert into public.economy_accounts(user_id,currency) values (p_user_id, upper(coalesce(nullif(trim(p_currency),''),'XOF')))[m
[32m+[m[32m  on conflict (user_id) do nothing;[m
[32m+[m[32m  select * into r from public.economy_accounts where user_id=p_user_id;[m
[32m+[m[32m  return r;[m
[32m+[m[32mend $$;[m
[32m+[m[32mrevoke all on function public.ensure_economy_account(uuid,text) from public, anon;[m
[32m+[m[32mgrant execute on function public.ensure_economy_account(uuid,text) to authenticated, service_role;[m
