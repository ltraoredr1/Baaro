diff --git a/src/features/videos/hooks/useVideoFilter.js b/src/features/videos/hooks/useVideoFilter.js
new file mode 100644
index 0000000..67d7283
--- /dev/null
+++ b/src/features/videos/hooks/useVideoFilter.js
@@ -0,0 +1,40 @@
+import { useCallback, useMemo, useState } from "react";
+import {
+  DEFAULT_FILTER_STATE,
+  FILTER_NONE,
+  FILTER_RANDOM,
+  describeFilter,
+  detectQuality,
+  normalizeFilterState,
+  randomSeed,
+  resolveFilter,
+} from "../filters/index.js";
+
+// État du filtre vidéo (caméra, photos/texte, vidéo importée). Gardé en mémoire
+// pour la session : un filtre oublié ne revient pas à la prochaine ouverture.
+export function useVideoFilter() {
+  const [state, setState] = useState(DEFAULT_FILTER_STATE);
+  const quality = useMemo(() => detectQuality(), []);
+  const spec = useMemo(() => resolveFilter(state, { quality }), [state, quality]);
+  const info = useMemo(() => describeFilter(state), [state]);
+
+  const patch = useCallback(
+    (values) => setState((s) => normalizeFilterState({ ...s, ...values })),
+    [],
+  );
+  const pick = useCallback(
+    (id) => setState((s) => normalizeFilterState({ ...s, id, seed: 0 })),
+    [],
+  );
+  const surprise = useCallback(
+    () => setState((s) => normalizeFilterState({ ...s, id: FILTER_RANDOM, seed: randomSeed() })),
+    [],
+  );
+  const step = useCallback(
+    (delta) => setState((s) => normalizeFilterState({ ...s, seed: Math.max(0, s.seed + delta) })),
+    [],
+  );
+  const reset = useCallback(() => setState(DEFAULT_FILTER_STATE), []);
+
+  return { state, spec, info, active: state.id !== FILTER_NONE && !!spec, patch, pick, surprise, step, reset };
+}
diff --git a/src/features/videos/utils/filterRender.js b/src/features/videos/utils/filterRender.js
new file mode 100644
index 0000000..54a98ce
--- /dev/null
+++ b/src/features/videos/utils/filterRender.js
@@ -0,0 +1,157 @@
+import { CANVAS_H, CANVAS_W } from "../constants.js";
+import { drawFiltered } from "../filters/index.js";
+import { pickRecorderMime } from "./videoRenderer.js";
+
+// Application des filtres BAARO à une vidéo réelle (caméra ou fichier importé).
+// Tout se fait dans le navigateur : la vidéo est redessinée image par image sur un
+// canvas 9:16 (filtre + calques animés) puis réenregistrée avec son son d'origine.
+
+const makeCanvas = () => {
+  const canvas = document.createElement("canvas");
+  canvas.width = CANVAS_W;
+  canvas.height = CANVAS_H;
+  if (!canvas.captureStream) {
+    throw new Error("Ce navigateur ne peut pas appliquer de filtre à la vidéo.");
+  }
+  return canvas;
+};
+
+const makeRecorder = (stream) => {
+  const mimeType = pickRecorderMime();
+  const recorder = new MediaRecorder(
+    stream,
+    mimeType ? { mimeType, videoBitsPerSecond: 3500000 } : undefined,
+  );
+  const chunks = [];
+  recorder.ondataavailable = (event) => {
+    if (event.data?.size) chunks.push(event.data);
+  };
+  const finished = new Promise((resolve, reject) => {
+    recorder.onstop = () => resolve();
+    recorder.onerror = (event) =>
+      reject(event.error || new Error("Erreur d'enregistrement."));
+  });
+  const toFile = (prefix) => {
+    const type = (recorder.mimeType || mimeType || "video/webm").split(";")[0];
+    const blob = new Blob(chunks, { type });
+    if (!blob.size) throw new Error("Aucune vidéo n'a été créée.");
+    const ext = type.includes("mp4") ? "mp4" : "webm";
+    return new File([blob], `${prefix}-${Date.now()}.${ext}`, {
+      type,
+      lastModified: Date.now(),
+    });
+  };
+  return { recorder, finished, toFile };
+};
+
+// Caméra en direct : renvoie un flux filtré (image) + pistes audio du micro.
+// getSpec() est relu à chaque image : on peut changer de filtre en filmant.
+export function createFilteredCameraStream(videoEl, sourceStream, getSpec) {
+  const canvas = makeCanvas();
+  const ctx = canvas.getContext("2d");
+  const t0 = performance.now();
+  let raf = 0;
+  let stopped = false;
+
+  const draw = (now) => {
+    if (stopped) return;
+    const vw = videoEl.videoWidth;
+    const vh = videoEl.videoHeight;
+    if (vw && vh && videoEl.readyState >= 2) {
+      drawFiltered(ctx, videoEl, vw, vh, getSpec(), now - t0);
+    }
+    raf = requestAnimationFrame(draw);
+  };
+  draw(performance.now());
+
+  const stream = canvas.captureStream(30);
+  sourceStream.getAudioTracks().forEach((track) => stream.addTrack(track));
+
+  const stop = () => {
+    stopped = true;
+    cancelAnimationFrame(raf);
+    // On n'arrête que la piste image : le micro appartient au flux caméra.
+    stream.getVideoTracks().forEach((track) => track.stop());
+  };
+  return { stream, stop };
+}
+
+// Fichier vidéo importé : relit la vidéo en temps réel à travers le filtre.
+export async function renderVideoWithFilter({
+  file,
+  spec,
+  onProgress,
+  signal,
+}) {
+  if (!window.MediaRecorder) {
+    throw new Error("L'enregistrement vidéo n'est pas supporté par ce navigateur.");
+  }
+  const canvas = makeCanvas();
+  const ctx = canvas.getContext("2d");
+  const url = URL.createObjectURL(file);
+  const video = document.createElement("video");
+  video.playsInline = true;
+  video.preload = "auto";
+  video.src = url;
+
+  let audioCtx = null;
+  let stream = null;
+  try {
+    await new Promise((resolve, reject) => {
+      video.onloadedmetadata = resolve;
+      video.onerror = () => reject(new Error("Vidéo illisible."));
+    });
+    const duration = Number.isFinite(video.duration) ? video.duration : 0;
+
+    stream = canvas.captureStream(30);
+
+    // Son d'origine : branché sur un flux d'enregistrement, jamais sur les haut-parleurs.
+    const AC = window.AudioContext || window.webkitAudioContext;
+    if (AC) {
+      try {
+        audioCtx = new AC();
+        await audioCtx.resume?.();
+        const dest = audioCtx.createMediaStreamDestination();
+        audioCtx.createMediaElementSource(video).connect(dest);
+        dest.stream.getAudioTracks().forEach((track) => stream.addTrack(track));
+      } catch {
+        // Pas de son récupérable : on garde l'image filtrée seule.
+      }
+    }
+
+    const { recorder, finished, toFile } = makeRecorder(stream);
+    ctx.fillStyle = "#000";
+    ctx.fillRect(0, 0, CANVAS_W, CANVAS_H);
+    recorder.start(500);
+
+    await video.play();
+    const t0 = performance.now();
+    await new Promise((resolve, reject) => {
+      let raf = 0;
+      const finish = (error) => {
+        cancelAnimationFrame(raf);
+        error ? reject(error) : resolve();
+      };
+      video.onended = () => finish();
+      video.onerror = () => finish(new Error("Lecture de la vidéo interrompue."));
+      const tick = (now) => {
+        if (signal?.aborted) return finish(new Error("Filtre annulé."));
+        if (video.videoWidth) {
+          drawFiltered(ctx, video, video.videoWidth, video.videoHeight, spec, now - t0);
+        }
+        if (duration) onProgress?.(Math.min(1, video.currentTime / duration));
+        raf = requestAnimationFrame(tick);
+      };
+      raf = requestAnimationFrame(tick);
+    });
+
+    if (recorder.state !== "inactive") recorder.stop();
+    await finished;
+    return toFile("baaro-filtre");
+  } finally {
+    video.pause();
+    stream?.getTracks().forEach((track) => track.stop());
+    audioCtx?.close?.().catch(() => {});
+    URL.revokeObjectURL(url);
+  }
+}
