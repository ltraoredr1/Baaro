+    for (let j = 0; j < rows; j += 1) {
+      const y = cy - R + (j * 2 * R) / rows;
+      const h = ((2 * R) / rows) * (j < rows / 2 ? 1 : 1 - (j - rows / 2) / rows * 1.6);
+      ctx.fillRect(W / 2 - R, y, R * 2, Math.max(1, h * 0.85));
+    }
+    ctx.restore();
+    // Sol sombre + grille en perspective.
+    ctx.globalAlpha = 0.35;
+    ctx.fillStyle = "#000";
