+        const y = head - k * fs;
+        if (y < -fs || y > H) continue;
+        ctx.globalAlpha = e.alpha * (1 - k / tail);
+        ctx.fillStyle = k === 0 ? "#eafff2" : rgba(e.c, 1);
+        ctx.fillText(chars[(Math.floor(t * 10) + i * 7 + k * 3) % chars.length], x, y);
+      }
+    }
+  },
+};
