- * Cette branche nécessite un pipeline média réellement compatible.
- */
-async function invokeGeminiMedia({
-  messages,
-  system,
-  maxTokens,
-}) {
-  const cfg = providerConfig("gemini");
-
-  if (!cfg) {
-    throw Object.assign(
