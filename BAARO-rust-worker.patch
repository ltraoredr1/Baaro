--- /dev/null
+++ b/worker/rust/baaro-media/src/sniff.rs
@@ -0,0 +1,213 @@
+//! Détection du type réel d'un fichier à partir de ses premiers octets.
+//!
+//! Le worker télécharge des fichiers envoyés par des utilisateurs : l'extension
+//! de la clé R2 ne prouve rien. On regarde la signature avant de lancer FFmpeg.
+
+use crate::json;
+
+/// Nombre d'octets lus au début du fichier.
+pub const HEAD_LEN: usize = 4096;
+
+#[derive(Debug, PartialEq, Eq)]
+pub struct Sniffed {
+    pub kind: &'static str,
+    pub mime: &'static str,
+    /// Média que le worker sait traiter (vidéo, audio, image).
+    pub media: bool,
+    /// Type connu comme n'étant PAS un média : à refuser (exécutable, archive, page web…).
+    pub danger: bool,
+}
+
+const fn media(kind: &'static str, mime: &'static str) -> Sniffed {
+    Sniffed {
+        kind,
+        mime,
+        media: true,
+        danger: false,
+    }
+}
+
+const fn danger(kind: &'static str, mime: &'static str) -> Sniffed {
+    Sniffed {
+        kind,
+        mime,
+        media: false,
+        danger: true,
+    }
+}
+
+const UNKNOWN: Sniffed = Sniffed {
+    kind: "unknown",
+    mime: "application/octet-stream",
+    media: false,
+    danger: false,
+};
+
+fn contains(haystack: &[u8], needle: &[u8]) -> bool {
+    haystack.windows(needle.len()).any(|w| w == needle)
+}
+
+fn starts_with_ci(haystack: &[u8], needle: &[u8]) -> bool {
+    haystack.len() >= needle.len() && haystack[..needle.len()].eq_ignore_ascii_case(needle)
+}
+
+/// Texte HTML ou script déguisé : on ignore les espaces de tête.
+fn looks_like_html(head: &[u8]) -> bool {
+    let start = head
+        .iter()
+        .position(|b| !b.is_ascii_whitespace())
+        .unwrap_or(head.len());
+    let t = &head[start..];
+    [
+        &b"<!doctype html"[..],
+        b"<html",
+        b"<script",
+        b"<?xml",
+        b"<svg",
+    ]
+    .iter()
+    .any(|p| starts_with_ci(t, p))
+}
+
+pub fn sniff(head: &[u8]) -> Sniffed {
+    // Conteneur ISO (MP4, M4A, MOV) : taille (4 octets) puis "ftyp" puis marque.
+    if head.len() >= 12 && &head[4..8] == b"ftyp" {
+        return match &head[8..12] {
+            b"M4A " | b"M4B " => media("m4a", "audio/mp4"),
+            b"qt  " => media("mov", "video/quicktime"),
+            _ => media("mp4", "video/mp4"),
+        };
+    }
+    // EBML : WebM ou Matroska.
+    if head.starts_with(&[0x1A, 0x45, 0xDF, 0xA3]) {
+        let window = &head[..head.len().min(64)];
+        return if contains(window, b"webm") {
+            media("webm", "video/webm")
+        } else {
+            media("mkv", "video/x-matroska")
+        };
+    }
+    if head.starts_with(&[0xFF, 0xD8, 0xFF]) {
+        return media("jpg", "image/jpeg");
+    }
+    if head.starts_with(&[0x89, b'P', b'N', b'G', 0x0D, 0x0A, 0x1A, 0x0A]) {
+        return media("png", "image/png");
+    }
+    if head.len() >= 12 && &head[0..4] == b"RIFF" && &head[8..12] == b"WAVE" {
+        return media("wav", "audio/wav");
+    }
+    if head.starts_with(b"ID3") || (head.len() >= 2 && head[0] == 0xFF && head[1] & 0xE0 == 0xE0) {
+        return media("mp3", "audio/mpeg");
+    }
+
+    // Types qui ne sont jamais un média valide.
+    if head.starts_with(&[0x7F, b'E', b'L', b'F']) {
+        return danger("elf", "application/x-elf");
+    }
+    if head.starts_with(b"MZ") {
+        return danger("pe", "application/x-msdownload");
+    }
+    if head.starts_with(b"PK\x03\x04") || head.starts_with(b"PK\x05\x06") {
+        return danger("zip", "application/zip");
+    }
+    if head.starts_with(&[0x1F, 0x8B]) {
+        return danger("gzip", "application/gzip");
+    }
+    if head.starts_with(b"%PDF") {
+        return danger("pdf", "application/pdf");
+    }
+    if head.starts_with(b"#!") {
+        return danger("script", "text/x-script");
+    }
+    if looks_like_html(head) {
+        return danger("html", "text/html");
+    }
+
+    UNKNOWN
+}
+
+/// Sortie JSON de la commande `sniff`.
+pub fn to_json(s: &Sniffed, size: u64) -> String {
+    let mut out = String::from("{\"kind\":");
+    json::push_str(&mut out, s.kind);
+    out.push_str(",\"mime\":");
+    json::push_str(&mut out, s.mime);
+    out.push_str(&format!(
+        ",\"media\":{},\"danger\":{},\"size\":{}}}",
+        s.media, s.danger, size
+    ));
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn kind(b: &[u8]) -> &'static str {
+        sniff(b).kind
+    }
+
+    #[test]
+    fn mp4_family() {
+        assert_eq!(kind(b"\0\0\0\x20ftypisom\0\0\0\0"), "mp4");
+        assert_eq!(kind(b"\0\0\0\x20ftypM4A \0\0\0\0"), "m4a");
+        assert_eq!(kind(b"\0\0\0\x14ftypqt  \0\0\0\0"), "mov");
+    }
+
+    #[test]
+    fn webm_vs_mkv() {
+        let mut webm = vec![0x1A, 0x45, 0xDF, 0xA3, 0x42, 0x82, 0x84];
+        webm.extend_from_slice(b"webm");
+        assert_eq!(kind(&webm), "webm");
+        let mut mkv = vec![0x1A, 0x45, 0xDF, 0xA3, 0x42, 0x82, 0x88];
+        mkv.extend_from_slice(b"matroska");
+        assert_eq!(kind(&mkv), "mkv");
+    }
+
+    #[test]
+    fn images_and_audio() {
+        assert_eq!(kind(&[0xFF, 0xD8, 0xFF, 0xE0]), "jpg");
+        assert_eq!(
+            kind(&[0x89, b'P', b'N', b'G', 0x0D, 0x0A, 0x1A, 0x0A]),
+            "png"
+        );
+        assert_eq!(kind(b"RIFF\x24\0\0\0WAVEfmt "), "wav");
+        assert_eq!(kind(b"ID3\x04\0\0"), "mp3");
+        assert_eq!(kind(&[0xFF, 0xFB, 0x90, 0x00]), "mp3");
+    }
+
+    #[test]
+    fn dangerous_types_are_flagged() {
+        for (bytes, k) in [
+            (&b"\x7FELF\x02\x01"[..], "elf"),
+            (b"MZ\x90\0", "pe"),
+            (b"PK\x03\x04\x14", "zip"),
+            (b"\x1F\x8B\x08", "gzip"),
+            (b"%PDF-1.7", "pdf"),
+            (b"#!/bin/sh\n", "script"),
+            (b"  \n<!DOCTYPE html><html>", "html"),
+            (b"<svg xmlns=", "html"),
+        ] {
+            let s = sniff(bytes);
+            assert_eq!(s.kind, k);
+            assert!(s.danger && !s.media);
+        }
+    }
+
+    #[test]
+    fn unknown_is_not_dangerous() {
+        let s = sniff(b"\x01\x02\x03 random bytes");
+        assert_eq!(s, UNKNOWN);
+        assert!(!s.danger);
+        assert_eq!(sniff(b""), UNKNOWN);
+    }
+
+    #[test]
+    fn json_shape() {
+        let s = sniff(&[0xFF, 0xD8, 0xFF]);
+        assert_eq!(
+            to_json(&s, 3),
+            "{\"kind\":\"jpg\",\"mime\":\"image/jpeg\",\"media\":true,\"danger\":false,\"size\":3}"
+        );
+    }
+}
diff --git a/worker/rust/baaro-media/src/vtt.rs b/worker/rust/baaro-media/src/vtt.rs
new file mode 100644
index 0000000..99c025e
--- /dev/null
+++ b/worker/rust/baaro-media/src/vtt.rs
@@ -0,0 +1,172 @@
+//! Découpage WebVTT en blocs, identique à `parseVtt` de `lib/vtt.mjs` (version JS de repli).
+//!
+//! Un bloc est soit une ligne d'en-tête/NOTE sans horodatage (conservée telle quelle),
+//! soit un « cue » : lignes de préfixe (identifiant), ligne d'horodatage, lignes de texte.
+
+use crate::json;
+
+#[derive(Debug, PartialEq, Eq)]
+pub enum Block<'a> {
+    Raw(&'a str),
+    Cue {
+        prefix: Vec<&'a str>,
+        timing: &'a str,
+        text: Vec<&'a str>,
+    },
+}
+
+/// Même notion d'espace que `String.prototype.trim` en JavaScript (BOM compris).
+fn is_js_space(c: char) -> bool {
+    c.is_whitespace() || c == '\u{FEFF}'
+}
+
+/// Équivalent de `.replace(/^﻿/, "").replace(/\r/g, "").trim()`.
+pub fn normalize(input: &str) -> String {
+    let no_bom = input.strip_prefix('\u{FEFF}').unwrap_or(input);
+    no_bom
+        .replace('\r', "")
+        .trim_matches(is_js_space)
+        .to_string()
+}
+
+/// Équivalent de `/^WEBVTT(?:\s|$)/`.
+fn has_header(s: &str) -> bool {
+    match s.strip_prefix("WEBVTT") {
+        Some(rest) => rest.chars().next().is_none_or(is_js_space),
+        None => false,
+    }
+}
+
+/// Équivalent de `split(/\n{2,}/)`.
+fn split_blocks(s: &str) -> Vec<&str> {
+    let bytes = s.as_bytes();
+    let mut out = Vec::new();
+    let (mut start, mut i) = (0, 0);
+    while i < bytes.len() {
+        if bytes[i] == b'\n' {
+            let mut j = i;
+            while j < bytes.len() && bytes[j] == b'\n' {
+                j += 1;
+            }
+            if j - i >= 2 {
+                out.push(&s[start..i]);
+                start = j;
+            }
+            i = j;
+        } else {
+            i += 1;
+        }
+    }
+    out.push(&s[start..]);
+    out
+}
+
+pub fn parse(normalized: &str) -> Result<Vec<Block<'_>>, &'static str> {
+    if !has_header(normalized) {
+        return Err("La transcription ne contient pas un WebVTT valide");
+    }
+    Ok(split_blocks(normalized)
+        .into_iter()
+        .map(|block| {
+            let lines: Vec<&str> = block.split('\n').collect();
+            match lines.iter().position(|l| l.contains("-->")) {
+                None => Block::Raw(block),
+                Some(i) => Block::Cue {
+                    prefix: lines[..i].to_vec(),
+                    timing: lines[i],
+                    text: lines[i + 1..].to_vec(),
+                },
+            }
+        })
+        .collect())
+}
+
+/// Sortie JSON, même forme que les objets renvoyés par la version JS.
+pub fn to_json(blocks: &[Block<'_>]) -> String {
+    let mut out = String::from("[");
+    for (i, b) in blocks.iter().enumerate() {
+        if i > 0 {
+            out.push(',');
+        }
+        match b {
+            Block::Raw(raw) => {
+                out.push_str("{\"raw\":");
+                json::push_str(&mut out, raw);
+                out.push_str(",\"timing\":null,\"text\":[]}");
+            }
+            Block::Cue {
+                prefix,
+                timing,
+                text,
+            } => {
+                out.push_str("{\"raw\":null,\"prefix\":");
+                json::push_str_array(&mut out, prefix);
+                out.push_str(",\"timing\":");
+                json::push_str(&mut out, timing);
+                out.push_str(",\"text\":");
+                json::push_str_array(&mut out, text);
+                out.push('}');
+            }
+        }
+    }
+    out.push(']');
+    out
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const SAMPLE: &str = "\u{FEFF}WEBVTT\r\n\r\nNOTE hello\r\n\r\n1\r\n00:00:00.000 --> 00:00:02.000\r\nBonjour\r\nle monde\r\n\r\n00:00:02.000 --> 00:00:04.000\r\nSalut\r\n";
+
+    #[test]
+    fn rejects_missing_header() {
+        assert!(parse(&normalize("Bonjour")).is_err());
+        assert!(parse(&normalize("WEBVTTX\n\n")).is_err());
+        assert!(parse(&normalize("WEBVTT")).is_ok());
+        assert!(parse(&normalize("WEBVTT - titre\n")).is_ok());
+    }
+
+    #[test]
+    fn splits_cues_and_raw_blocks() {
+        let n = normalize(SAMPLE);
+        let blocks = parse(&n).unwrap();
+        assert_eq!(blocks.len(), 4);
+        assert_eq!(blocks[0], Block::Raw("WEBVTT"));
+        assert_eq!(blocks[1], Block::Raw("NOTE hello"));
+        assert_eq!(
+            blocks[2],
+            Block::Cue {
+                prefix: vec!["1"],
+                timing: "00:00:00.000 --> 00:00:02.000",
+                text: vec!["Bonjour", "le monde"],
+            }
+        );
+        assert_eq!(
+            blocks[3],
+            Block::Cue {
+                prefix: vec![],
+                timing: "00:00:02.000 --> 00:00:04.000",
+                text: vec!["Salut"],
+            }
+        );
+    }
+
+    #[test]
+    fn single_blank_line_with_spaces_does_not_split() {
+        // Comme en JS : "\n \n" n'est pas une coupure /\n{2,}/.
+        let n = normalize("WEBVTT\n\n00:00:00.000 --> 00:00:01.000\na\n \nb\n");
+        let blocks = parse(&n).unwrap();
+        assert_eq!(blocks.len(), 2);
+    }
+
+    #[test]
+    fn json_output() {
+        let n = normalize("WEBVTT\n\n00:00:00.000 --> 00:00:01.000\n\"a\"\n");
+        let j = to_json(&parse(&n).unwrap());
+        assert_eq!(
+            j,
+            "[{\"raw\":\"WEBVTT\",\"timing\":null,\"text\":[]},{\"raw\":null,\"prefix\":[],\"timing\":\"00:00:00.000 --> 00:00:01.000\",\"text\":[\"\\\"a\\\"\"]}]"
+        );
+    }
+}
diff --git a/worker/test/rust-parity.mjs b/worker/test/rust-parity.mjs
new file mode 100644
index 0000000..096bbee
--- /dev/null
+++ b/worker/test/rust-parity.mjs
@@ -0,0 +1,95 @@
+// Vérifie que le binaire Rust se comporte comme l'implémentation JS de référence.
+// Usage : BAARO_MEDIA_BIN=rust/baaro-media/target/release/baaro-media node test/rust-parity.mjs
+import assert from "node:assert/strict";
+import { mkdtemp, writeFile, rm } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { parseVttJs } from "../lib/vtt.mjs";
+import { parseVttNative, sniffFile } from "../lib/native.mjs";
+
+let checks = 0;
+
+function sameAsJs(input, label) {
+  let expected;
+  let jsFailed = false;
+  try {
+    expected = parseVttJs(input);
+  } catch {
+    jsFailed = true;
+  }
+
+  const actual = parseVttNative(input);
+
+  if (jsFailed) {
+    assert.equal(actual, null, `${label} : le JS refuse, Rust doit refuser`);
+  } else {
+    assert.notEqual(actual, null, `${label} : Rust a échoué alors que le JS accepte`);
+    assert.deepEqual(actual, expected, `${label} : résultat différent`);
+  }
+  checks++;
+}
+
+// --- Cas ciblés -------------------------------------------------------------
+const fixtures = {
+  simple: "WEBVTT\n\n00:00:00.000 --> 00:00:02.000\nBonjour\n",
+  bom_crlf: "﻿WEBVTT\r\n\r\n1\r\n00:00:00.000 --> 00:00:01.000\r\nA\r\nB\r\n",
+  titre: "WEBVTT - un titre\n\nNOTE commentaire\n\n00:00:01.000 --> 00:00:02.000\nx",
+  entete_seul: "WEBVTT",
+  tab_apres_entete: "WEBVTT\tx\n\n00:00:00.000 --> 00:00:01.000\nx",
+  blanc_avec_espace: "WEBVTT\n\n00:00:00.000 --> 00:00:01.000\na\n \nb\n",
+  plusieurs_vides: "WEBVTT\n\n\n\n00:00:00.000 --> 00:00:01.000\na\n\n\n\n\n00:00:01.000 --> 00:00:02.000\nb",
+  echappements: 'WEBVTT\n\n00:00:00.000 --> 00:00:01.000\n"citation" \\ antislash\ttab\n',
+  unicode: "WEBVTT\n\n00:00:00.000 --> 00:00:01.000\nߒߞߏ — é — 😀 —  \n",
+  espaces_autour: "  \n\nWEBVTT\n\n00:00:00.000 --> 00:00:01.000\nx\n\n  ",
+  pas_vtt: "Bonjour",
+  entete_colle: "WEBVTTX\n\n",
+  vide: "",
+};
+for (const [name, input] of Object.entries(fixtures)) sameAsJs(input, name);
+
+// --- Fuzz déterministe ------------------------------------------------------
+let seed = 12345;
+const rand = (n) => {
+  seed = (seed * 1664525 + 1013904223) >>> 0;
+  return seed % n;
+};
+const pieces = [
+  "WEBVTT", "\n", "\n", "\n\n", "\r\n", " ", "\t", "-->", "00:00:01.000 --> 00:00:02.000",
+  "texte", "NOTE x", "é", "😀", '"', "\\", "﻿", " ", "1",
+];
+for (let i = 0; i < 3000; i++) {
+  let s = rand(4) === 0 ? "" : "WEBVTT";
+  const n = rand(25);
+  for (let k = 0; k < n; k++) s += pieces[rand(pieces.length)];
+  sameAsJs(s, `fuzz#${i}`);
+}
+
+// --- sniff ------------------------------------------------------------------
+const dir = await mkdtemp(join(tmpdir(), "baaro-sniff-"));
+try {
+  const cases = [
+    ["a.mp4", Buffer.from("\0\0\0\x20ftypisom\0\0\0\0"), { kind: "mp4", media: true, danger: false }],
+    ["b.jpg", Buffer.from([0xff, 0xd8, 0xff, 0xe0]), { kind: "jpg", media: true, danger: false }],
+    ["c.mp4", Buffer.from("\x7fELF\x02\x01\x01"), { kind: "elf", media: false, danger: true }],
+    ["d.mp4", Buffer.from("<html><script>alert(1)</script>"), { kind: "html", media: false, danger: true }],
+    ["e.mp4", Buffer.from("PK\x03\x04rest"), { kind: "zip", media: false, danger: true }],
+    ["f.bin", Buffer.from("rien de connu"), { kind: "unknown", media: false, danger: false }],
+  ];
+  for (const [name, bytes, want] of cases) {
+    const path = join(dir, name);
+    await writeFile(path, bytes);
+    const got = await sniffFile(path);
+    assert.ok(got, `sniff ${name} : pas de résultat`);
+    assert.equal(got.kind, want.kind, `sniff ${name}`);
+    assert.equal(got.media, want.media, `sniff ${name} media`);
+    assert.equal(got.danger, want.danger, `sniff ${name} danger`);
+    assert.equal(got.size, bytes.length, `sniff ${name} size`);
+    checks++;
+  }
+  assert.equal(await sniffFile(join(dir, "inexistant")), null);
+  checks++;
+} finally {
+  await rm(dir, { recursive: true, force: true });
+}
+
+console.log(`OK : ${checks} vérifications (VTT JS/Rust identiques, sniff conforme)`);
