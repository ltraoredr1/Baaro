select
  t.tablename as table_name,
  (select count(*) from pg_policies p where p.tablename = t.tablename and p.schemaname = 'public') as rls_policies,
  case when t.rowsecurity then '✅ OUI' else '❌ NON' end as rls_active
from pg_tables t
where t.schemaname = 'public'
  and t.tablename in (
    'groups','group_members','channels','channel_messages',
    'group_invites','group_bans','community_reports',
    'notifications','notification_preferences','push_tokens',
