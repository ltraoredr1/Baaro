--- /dev/null
+++ b/worker/rust/baaro-media/build.rs
@@ -0,0 +1,75 @@
+use std::env;
+use std::path::PathBuf;
+use std::process::Command;
+
+fn output(command: &str, args: &[&str]) -> String {
+    let result = Command::new(command)
+        .args(args)
+        .output()
+        .unwrap_or_else(|error| panic!("Impossible d’exécuter {command}: {error}"));
+    if !result.status.success() {
+        panic!(
+            "{command} {} a échoué: {}",
+            args.join(" "),
+            String::from_utf8_lossy(&result.stderr)
+        );
+    }
+    String::from_utf8(result.stdout)
+        .unwrap_or_else(|error| panic!("Sortie UTF-8 invalide de {command}: {error}"))
+}
+
+fn main() {
+    let manifest = PathBuf::from(env::var_os("CARGO_MANIFEST_DIR").expect("CARGO_MANIFEST_DIR"));
+    let out_dir = PathBuf::from(env::var_os("OUT_DIR").expect("OUT_DIR"));
+    let source = manifest.join("csrc/media_probe.c");
+    let object = out_dir.join("media_probe.o");
+    let archive = out_dir.join("libbaaro_media_probe.a");
+
+    println!("cargo:rerun-if-changed={}", source.display());
+    println!("cargo:rerun-if-env-changed=CC");
+    println!("cargo:rerun-if-env-changed=AR");
+    println!("cargo:rerun-if-env-changed=PKG_CONFIG");
+
+    let pkg_config = env::var("PKG_CONFIG").unwrap_or_else(|_| "pkg-config".to_owned());
+    let cflags = output(&pkg_config, &["--cflags", "libavformat"]);
+    let libs = output(
+        &pkg_config,
+        &["--libs", "libavformat", "libavcodec", "libavutil"],
+    );
+
+    let cc = env::var("CC").unwrap_or_else(|_| "cc".to_owned());
+    let mut compile = Command::new(cc);
+    compile
+        .args([
+            "-std=c11", "-O2", "-fPIC", "-Wall", "-Wextra", "-Werror", "-c",
+        ])
+        .arg(&source)
+        .arg("-o")
+        .arg(&object);
+    compile.args(cflags.split_whitespace());
+    let status = compile
+        .status()
+        .expect("Impossible de lancer le compilateur C");
+    assert!(status.success(), "La compilation du validateur C a échoué");
+
+    let ar = env::var("AR").unwrap_or_else(|_| "ar".to_owned());
+    let status = Command::new(ar)
+        .args(["crs"])
+        .arg(&archive)
+        .arg(&object)
+        .status()
+        .expect("Impossible de lancer ar");
+    assert!(status.success(), "La création de l’archive C a échoué");
+
+    println!("cargo:rustc-link-search=native={}", out_dir.display());
+    println!("cargo:rustc-link-lib=static=baaro_media_probe");
+    for flag in libs.split_whitespace() {
+        if let Some(path) = flag.strip_prefix("-L") {
+            println!("cargo:rustc-link-search=native={path}");
+        } else if let Some(name) = flag.strip_prefix("-l") {
+            println!("cargo:rustc-link-lib={name}");
+        } else if flag == "-pthread" || flag.starts_with("-Wl,") {
+            println!("cargo:rustc-link-arg={flag}");
+        }
+    }
+}
diff --git a/worker/rust/baaro-media/csrc/media_probe.c b/worker/rust/baaro-media/csrc/media_probe.c
new file mode 100644
index 0000000..62390ed
--- /dev/null
+++ b/worker/rust/baaro-media/csrc/media_probe.c
@@ -0,0 +1,85 @@
+#include <libavformat/avformat.h>
+#include <libavutil/mathematics.h>
+
+#include <stdint.h>
+#include <string.h>
+
+typedef struct {
+    int has_video;
+    int has_audio;
+    int width;
+    int height;
+    int64_t duration_ms;
+} BaaroProbeInfo;
+
+enum {
+    BAARO_PROBE_OK = 0,
+    BAARO_PROBE_BAD_ARGUMENT = 1,
+    BAARO_PROBE_OPEN_FAILED = 2,
+    BAARO_PROBE_STREAM_INFO_FAILED = 3,
+    BAARO_PROBE_NO_MEDIA_STREAM = 4,
+    BAARO_PROBE_NO_MEMORY = 5
+};
+
+/* Called only for local files whose header matched BAARO's media allowlist. */
+int baaro_probe_media(const char *path, BaaroProbeInfo *out) {
+    AVFormatContext *format = NULL;
+    int status = BAARO_PROBE_OK;
+
+    if (path == NULL || out == NULL) {
+        return BAARO_PROBE_BAD_ARGUMENT;
+    }
+    memset(out, 0, sizeof(*out));
+    av_log_set_level(AV_LOG_QUIET);
+
+    format = avformat_alloc_context();
+    if (format == NULL) {
+        return BAARO_PROBE_NO_MEMORY;
+    }
+    /* Bound header probing; actual decoding remains isolated in ffmpeg. */
+    format->probesize = 1024 * 1024;
+    format->max_analyze_duration = 3 * AV_TIME_BASE;
+
+    if (avformat_open_input(&format, path, NULL, NULL) < 0) {
+        status = BAARO_PROBE_OPEN_FAILED;
+        goto cleanup;
+    }
+    if (avformat_find_stream_info(format, NULL) < 0) {
+        status = BAARO_PROBE_STREAM_INFO_FAILED;
+        goto cleanup;
+    }
+
+    for (unsigned int i = 0; i < format->nb_streams; i++) {
+        const AVCodecParameters *codec = format->streams[i]->codecpar;
+        if (codec->codec_type == AVMEDIA_TYPE_VIDEO &&
+            codec->width > 0 && codec->height > 0) {
+            out->has_video = 1;
+            if (out->width == 0) {
+                out->width = codec->width;
+                out->height = codec->height;
+            }
+        } else if (codec->codec_type == AVMEDIA_TYPE_AUDIO &&
+                   codec->codec_id != AV_CODEC_ID_NONE && codec->sample_rate > 0) {
+            out->has_audio = 1;
+        }
+    }
+
+    if (!out->has_audio && !out->has_video) {
+        status = BAARO_PROBE_NO_MEDIA_STREAM;
+        goto cleanup;
+    }
+    if (format->duration != AV_NOPTS_VALUE && format->duration > 0) {
+        out->duration_ms = av_rescale_q(format->duration, AV_TIME_BASE_Q,
+                                        (AVRational){1, 1000});
+    }
+
+cleanup:
+    if (format != NULL) {
+        avformat_close_input(&format);
+    }
+    return status;
+}
+
+unsigned int baaro_libavformat_version(void) {
+    return avformat_version();
+}
