diff --git a/supabase/migrations/20261105230300_unread_notification_badge_counts.sql b/supabase/migrations/20261105230300_unread_notification_badge_counts.sql
new file mode 100644
index 0000000..d110881
--- /dev/null
+++ b/supabase/migrations/20261105230300_unread_notification_badge_counts.sql
@@ -0,0 +1,20 @@
+-- Le schéma public.notifications et son index partiel
+-- idx_notifications_user_unread ont été vérifiés dans la base cible.
+-- Cette migration ne crée que la fonction RPC absente.
+CREATE OR REPLACE FUNCTION public.get_unread_notification_counts(p_user_ids uuid[])
+RETURNS TABLE (user_id uuid, unread_count bigint)
+LANGUAGE sql
+STABLE
+SECURITY INVOKER
+SET search_path = ''
+AS $$
+  SELECT n.user_id, COUNT(*)::bigint AS unread_count
+  FROM public.notifications AS n
+  WHERE n.user_id = ANY(COALESCE(p_user_ids, ARRAY[]::uuid[]))
+    AND n.read = false
+  GROUP BY n.user_id;
+$$;
+
+REVOKE ALL ON FUNCTION public.get_unread_notification_counts(uuid[]) FROM PUBLIC;
+REVOKE ALL ON FUNCTION public.get_unread_notification_counts(uuid[]) FROM anon, authenticated;
+GRANT EXECUTE ON FUNCTION public.get_unread_notification_counts(uuid[]) TO service_role;
